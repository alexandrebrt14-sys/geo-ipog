---
interface Props {
  label: string;
  panelWidth?: string;
  id?: string;
  highlight?: boolean;
  badge?: string;
  active?: boolean;
}
const { label, panelWidth = '640', id, highlight = false, badge, active = false } = Astro.props;
const menuId = id ?? `mega-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const triggerClass = highlight
  ? 'nav-link inline-flex items-center gap-1.5 text-brand-800 font-semibold bg-brand-50 hover:bg-brand-100 ring-1 ring-brand-200/70'
  : `nav-link inline-flex items-center gap-1${active ? ' is-section-active text-brand-800' : ''}`;
---

<div class="relative group/menu" data-mega data-mega-id={menuId}>
  <button
    type="button"
    class={triggerClass}
    aria-expanded="false"
    aria-controls={`${menuId}-panel`}
    aria-current={active ? 'true' : undefined}
    data-mega-trigger>
    {label}
    {badge && (
      <span class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-sun-500 text-brand-900 text-[9px] font-bold uppercase tracking-wider leading-none">{badge}</span>
    )}
    <svg class="w-3.5 h-3.5 text-ink-500 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M5.5 7.5 10 12l4.5-4.5z"/>
    </svg>
  </button>
  <div
    id={`${menuId}-panel`}
    role="region"
    aria-label={`Menu ${label}`}
    data-mega-panel
    hidden
    class="absolute left-0 top-full pt-2 z-40"
    style={`width: ${panelWidth}px; max-width: calc(100vw - 2rem);`}>
    <div class="card shadow-lift p-4 animate-fade-in mega-panel-content">
      <slot name="panel" />
    </div>
  </div>
</div>

<script>
  function positionPanel(group: HTMLElement, panel: HTMLElement) {
    const gutter = 16;
    const groupLeft = group.getBoundingClientRect().left;
    const viewportWidth = document.documentElement.clientWidth;
    const left = Math.max(gutter, Math.min(groupLeft, viewportWidth - panel.offsetWidth - gutter));
    panel.style.left = `${left - groupLeft}px`;
    const availableHeight = window.innerHeight - panel.getBoundingClientRect().top - gutter - 8;
    panel.style.setProperty('--mega-panel-height', `${Math.max(0, availableHeight)}px`);
  }

  function closeMenu(group: HTMLElement, restoreFocus = false) {
    const trigger = group.querySelector<HTMLButtonElement>('[data-mega-trigger]');
    const panel = group.querySelector<HTMLElement>('[data-mega-panel]');
    if (restoreFocus && panel?.contains(document.activeElement)) trigger?.focus();
    trigger?.setAttribute('aria-expanded', 'false');
    if (panel) {
      panel.hidden = true;
      panel.removeAttribute('data-open');
    }
  }

  function closeAll(except?: HTMLElement, restoreFocus = false) {
    document.querySelectorAll<HTMLElement>('[data-mega]').forEach(group => {
      if (group !== except) closeMenu(group, restoreFocus);
    });
  }

  function initMegaMenus() {
    document.querySelectorAll<HTMLElement>('[data-mega]').forEach(group => {
      if (group.dataset.megaBound === '1') return;
      group.dataset.megaBound = '1';
      const trigger = group.querySelector<HTMLButtonElement>('[data-mega-trigger]');
      const panel = group.querySelector<HTMLElement>('[data-mega-panel]');
      if (!trigger || !panel) return;
      const panelLinks = () => Array.from(panel.querySelectorAll<HTMLAnchorElement>('a[href]'));
      let openedByPointer = false;

      const openMenu = (focusFirst = false) => {
        closeAll(group);
        panel.hidden = false;
        panel.setAttribute('data-open', 'true');
        trigger.setAttribute('aria-expanded', 'true');
        positionPanel(group, panel);
        if (focusFirst) panelLinks()[0]?.focus();
      };

      group.addEventListener('pointerenter', event => {
        if (event.pointerType === 'mouse' && panel.hidden) {
          openMenu();
          openedByPointer = true;
        }
      });
      group.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse' && !group.contains(document.activeElement)) closeMenu(group);
      });
      group.addEventListener('focusout', event => {
        if (!(event.relatedTarget instanceof Node) || !group.contains(event.relatedTarget)) closeMenu(group);
      });
      trigger.addEventListener('click', () => {
        if (panel.hidden || openedByPointer) openMenu();
        else closeMenu(group);
        openedByPointer = false;
      });
      trigger.addEventListener('keydown', event => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          openedByPointer = false;
          openMenu(event.key === 'ArrowDown');
          if (event.key === 'ArrowUp') {
            const links = panelLinks();
            links[links.length - 1]?.focus();
          }
        }
      });
      panel.addEventListener('keydown', event => {
        const links = panelLinks();
        if (!links.length) return;
        const index = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          links[(index + 1) % links.length]?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          links[(index - 1 + links.length) % links.length]?.focus();
        } else if (event.key === 'Home') {
          event.preventDefault();
          links[0]?.focus();
        } else if (event.key === 'End') {
          event.preventDefault();
          links[links.length - 1]?.focus();
        }
      });
      panel.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('a')) closeMenu(group, true);
      });
    });
  }

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeAll(undefined, true);
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Element && !event.target.closest('[data-mega]')) closeAll();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth < 1024) {
      closeAll();
      return;
    }
    document.querySelectorAll<HTMLElement>('[data-mega]').forEach(group => {
      const panel = group.querySelector<HTMLElement>('[data-mega-panel]');
      if (panel && !panel.hidden) positionPanel(group, panel);
    });
  });
  initMegaMenus();
  document.addEventListener('astro:before-swap', () => closeAll());
  document.addEventListener('astro:after-swap', initMegaMenus);
</script>
