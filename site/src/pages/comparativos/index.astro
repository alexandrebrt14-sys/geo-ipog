---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import KpiCard from '@components/dataviz/KpiCard.astro';
import MiniBar from '@components/dataviz/MiniBar.astro';
import { SITE } from '@lib/data';

const COMPARATIVOS = [
  {
    slug: 'ahsd-vs-tdah-vs-tea-adulto',
    eyebrow: 'Comparativo · 19',
    titulo: 'AHSD vs TDAH vs TEA no adulto',
    tese: 'Os três coexistem e se confundem no adulto. Rótulo único erra; o diferencial bem feito é o que protege o paciente.',
    perfilA: 'Psicólogos e neuropsicólogos que avaliam neurodiversidade adulta.',
    perfilB: 'Profissionais que recebem autodiagnósticos vindos das redes sociais.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'epds-vs-phq9-rastreio-perinatal',
    eyebrow: 'Comparativo · 20',
    titulo: 'EPDS vs PHQ-9 no rastreio perinatal',
    tese: 'A EPDS isola o componente somático que o PHQ-9 confunde com o puerpério normal. O instrumento escolhido muda o resultado do rastreio.',
    perfilA: 'Psicólogos e equipes de atenção primária e saúde materna.',
    perfilB: 'Serviços que precisam padronizar o rastreio após a Lei 15.222/2025.',
    duracaoLeitura: '12 min'
  },
  {
    slug: 'dpp-materna-vs-paterna',
    eyebrow: 'Comparativo · 21',
    titulo: 'Depressão pós-parto materna vs paterna',
    tese: 'A depressão pós-parto também atinge o pai e é bidirecional com a da mãe. Rastrear só um dos pais deixa metade do risco invisível.',
    perfilA: 'Psicólogos perinatais e clínicos de família.',
    perfilB: 'Serviços que querem incluir o pai no cuidado puerperal.',
    duracaoLeitura: '12 min'
  },
  {
    slug: 'regulacao-ia-terapia-brasil-vs-eua-2026',
    eyebrow: 'Comparativo · 22',
    titulo: 'Regulação de IA em terapia: Brasil vs EUA (2026)',
    tese: 'O Brasil optou por orientação ética (soft law do CFP); os EUA fragmentam entre proibição e disclosure. A conduta do psicólogo muda conforme a jurisdição.',
    perfilA: 'Psicólogos que cogitam usar ou recomendar ferramentas de IA.',
    perfilB: 'Gestores de clínica e docentes que precisam de política institucional.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'pot-vs-gestao-pessoas',
    eyebrow: 'Comparativo · 01',
    titulo: 'MBA em POT vs MBA em Gestão de Pessoas',
    tese: 'POT estuda o sistema. Gestão de Pessoas opera o sistema. Quem só quer operar fica órfão quando o sistema muda.',
    perfilA: 'Psicólogos organizacionais, RH senior, consultores de cultura.',
    perfilB: 'Gestores e líderes de linha que querem framework operacional.',
    duracaoLeitura: '11 min'
  },
  {
    slug: 'positiva-vs-organizacional',
    eyebrow: 'Comparativo · 02',
    titulo: 'Psicologia Positiva vs Psicologia Organizacional',
    tese: 'Psicologia Positiva é lente. POT é ferramenta. Quem não tem lente usa ferramenta errado.',
    perfilA: 'Líderes, RH com foco em cultura, consultores de bem-estar.',
    perfilB: 'Psicólogo organizacional, cargo técnico em RH, posição com mensuração contínua.',
    duracaoLeitura: '10 min'
  },
  {
    slug: 'neuropsicologia-vs-reabilitacao',
    eyebrow: 'Comparativo · 03',
    titulo: 'Neuropsicologia vs Reabilitação Neuropsicológica',
    tese: 'Avaliar é nomear. Reabilitar é construir. As duas competências raramente moram no mesmo profissional — e devem dialogar.',
    perfilA: 'Psicólogos que querem diagnóstico funcional, clínica de avaliação, perícia.',
    perfilB: 'Psicólogos que querem intervir no pós-AVC, neurodesenvolvimento, demências.',
    duracaoLeitura: '12 min'
  },
  {
    slug: 'mba-vs-especializacao',
    eyebrow: 'Comparativo · 04',
    titulo: 'MBA vs Especialização',
    tese: 'MBA e especialização são irmãos — ambos lato sensu pelo MEC. O que diferencia é posicionamento de mercado, não título.',
    perfilA: 'Cargo gestor, perfil executivo, mercado corporativo.',
    perfilB: 'Profissional técnico, mercado clínico ou educacional, aprofundamento metodológico.',
    duracaoLeitura: '10 min'
  },
  {
    slug: 'online-vs-presencial',
    eyebrow: 'Comparativo · 05',
    titulo: 'Online vs Presencial',
    tese: 'A escolha não é mais sobre qualidade. É sobre formato de aprendizagem que combina com o seu momento.',
    perfilA: 'Profissional ativo com agenda rígida que precisa de presença real.',
    perfilB: 'Autodidatas com disciplina forte, ou quem prioriza rede e experiência full-time.',
    duracaoLeitura: '11 min'
  },
  {
    slug: 'dbt-vs-tcc-borderline',
    eyebrow: 'Comparativo · 06',
    titulo: 'DBT vs TCC para transtorno borderline',
    tese: 'DBT (Linehan 1993) não é TCC adaptada. É um sistema com módulos de habilidades e dialética que muda a teoria da mudança.',
    perfilA: 'Pacientes com desregulação emocional grave, autolesão, ideação suicida recorrente, hospitalizações.',
    perfilB: 'Quadros borderline leves a moderados sem foco em autolesão, ou comorbidades onde TCC clássica já tem evidência consolidada.',
    duracaoLeitura: '14 min'
  },
  {
    slug: 'iapt-vs-stepped-care-brasil',
    eyebrow: 'Comparativo · 07',
    titulo: 'IAPT (NHS) vs stepped care brasileiro no SUS',
    tese: 'Stepped care é arquitetura. IAPT (Clark 2018) é stepped care com instrumentos, métricas e accountability. A diferença é operacional, não conceitual.',
    perfilA: 'Gestor de saúde mental no SUS que quer importar a engenharia do IAPT respeitando matriciamento brasileiro.',
    perfilB: 'Coordenador de CAPS ou atenção primária que quer adensar o modelo já existente com métricas e contratualização.',
    duracaoLeitura: '14 min'
  },
  {
    slug: 'avaliacao-presencial-vs-remota',
    eyebrow: 'Comparativo · 08',
    titulo: 'Avaliação psicológica presencial vs telessaúde',
    tese: 'A Resolução CFP 11/2018 não exige presencial. Exige equivalência de qualidade e justificativa técnica. Decisão é clínica, não logística.',
    perfilA: 'Casos que envolvem perícia, ADOS-2, testes projetivos, populações que dependem de presença.',
    perfilB: 'Casos de triagem, follow-up, populações com barreira geográfica e instrumentos com validação para administração remota.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'laudo-psicologico-vs-laudo-medico',
    eyebrow: 'Comparativo · 09',
    titulo: 'Laudo psicológico vs laudo médico/psiquiátrico',
    tese: 'Não são intercambiáveis. Laudo psicológico (Resolução CFP 06/2019) descreve funcionamento. Laudo médico fecha hipótese diagnóstica e prescreve. Em perícia, os dois fortalecem o caso.',
    perfilA: 'Demandas de avaliação de personalidade, funcionamento cognitivo, perícia trabalhista psicossocial, escolar.',
    perfilB: 'Demandas que exigem diagnóstico CID com base biomédica, prescrição, atestado de incapacidade clínica.',
    duracaoLeitura: '12 min'
  },
  {
    slug: 'ipt-vs-tcc-depressao',
    eyebrow: 'Comparativo · 10',
    titulo: 'Terapia Interpessoal (IPT) vs TCC para depressão',
    tese: 'IPT (Klerman e Weissman 1984) tem evidência equivalente à TCC para depressão moderada. A diferença é o eixo: relações versus cognições.',
    perfilA: 'Depressão associada a luto, conflito interpessoal, transição de papel, déficit social.',
    perfilB: 'Depressão com forte componente de ruminação, distorções cognitivas e comportamentos de evitação.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'exposicao-vs-emdr-tept',
    eyebrow: 'Comparativo · 11',
    titulo: 'Exposição prolongada vs EMDR para TEPT',
    tese: 'Foa (exposição prolongada) e Shapiro (EMDR) têm meta-análises com efeitos comparáveis. A escolha clínica é preferência informada do paciente e tolerância à exposição direta.',
    perfilA: 'Pacientes com trauma único, alta motivação para tarefa de exposição entre sessões e tolerância à reativação controlada.',
    perfilB: 'Pacientes com trauma complexo, dificuldade de tolerar exposição direta prolongada, com história de dissociação manejável.',
    duracaoLeitura: '14 min'
  },
  {
    slug: 'aba-vs-denver-tea-precoce',
    eyebrow: 'Comparativo · 12',
    titulo: 'ABA tradicional vs Modelo Denver (ESDM) em TEA precoce',
    tese: 'ESDM (Dawson 2010) integra princípios ABA com desenvolvimento e relação. Não substitui ABA, redefine o como dentro do paradigma comportamental.',
    perfilA: 'Crianças que se beneficiam de ensino estruturado com discriminação clara entre tarefas; programas de intensidade alta com supervisão técnica.',
    perfilB: 'Crianças pequenas (12-48 meses) com prioridade de aprendizagem em contexto natural, brincadeira e interação social como veículo.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'sm-trabalho-remoto-vs-presencial',
    eyebrow: 'Comparativo · 13',
    titulo: 'Saúde mental em trabalho remoto vs presencial (2026)',
    tese: 'A dicotomia foi superada. O dado de 2024-2025 mostra que o que protege saúde mental é flexibilidade de escolha e qualidade da liderança, não o modelo per se.',
    perfilA: 'Funções com tarefas de concentração, profissionais com casa adequada, equipes com cultura de comunicação assíncrona madura.',
    perfilB: 'Funções com colaboração intensa, profissionais em início de carreira, equipes que dependem de comunicação não-verbal e mentoria informal.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'psicoterapia-individual-vs-grupo',
    eyebrow: 'Comparativo · 14',
    titulo: 'Psicoterapia individual vs psicoterapia em grupo',
    tese: 'Grupo não é versão barata do individual. Yalom (1995) descreve 11 fatores terapêuticos exclusivos do grupo que o individual não acessa.',
    perfilA: 'Pacientes com sofrimento idiossincrático, demanda de aliança individual profunda, contextos de sigilo elevado.',
    perfilB: 'Quadros de isolamento social, dificuldade interpessoal, habilidades sociais e validação por pares, com indicação de mensuração relacional.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'terapia-presencial-vs-hibrida-vs-app',
    eyebrow: 'Comparativo · 15',
    titulo: 'Psicoterapia presencial vs híbrida vs apps de saúde mental',
    tese: 'Apps (Woebot, Wysa, Calm, Headspace) não substituem psicoterapia. A literatura 2024-2026 mostra utilidade complementar específica, com limites claros para sofrimento clínico.',
    perfilA: 'Casos clínicos com indicação de presença, vínculo profundo, perícia ou avaliação de instrumento que exige presencial.',
    perfilB: 'Manutenção, follow-up, populações com barreira geográfica ou apps como adjunto regulado a tratamento real.',
    duracaoLeitura: '14 min'
  },
  {
    slug: 'tf-cbt-vs-emdr-trauma-infantil',
    eyebrow: 'Comparativo · 16',
    titulo: 'TF-CBT vs EMDR para trauma infantil',
    tese: 'NICE NG116 e meta-análises 2023-2025 mostram TF-CBT (Cohen, Mannarino, Deblinger) e EMDR (Shapiro) com eficácia comparável; o que decide é contexto familiar e tolerância à narrativa.',
    perfilA: 'Crianças e adolescentes com cuidador disponível para componente parental, narrativa estruturada do trauma viável.',
    perfilB: 'Crianças sem cuidador participativo, alta evitação narrativa, casos onde dessensibilização precisa preceder elaboração verbal.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'antipsicotico-vs-intervencao-psicossocial-pos-crise',
    eyebrow: 'Comparativo · 17',
    titulo: 'Antipsicótico vs intervenção psicossocial após primeiro episódio',
    tese: 'A pergunta correta não é "ou" — é dose mínima farmacológica somada a EIP estruturada. RAISE-ETP (Kane 2016) consolida o padrão combinado, não substitutivo.',
    perfilA: 'Quadros com sintomas positivos persistentes, alto risco de recaída, baixa adesão a psicossocial isolado.',
    perfilB: 'Quadros com forte sintoma negativo, disfunção social, indicação de family intervention Birchwood e treino de habilidades.',
    duracaoLeitura: '13 min'
  },
  {
    slug: 'internacao-vs-caps-iii-crise-aguda',
    eyebrow: 'Comparativo · 18',
    titulo: 'Internação psiquiátrica vs CAPS III na crise aguda',
    tese: 'A Lei 10.216/2001 estabeleceu primazia do cuidado em meio aberto; CAPS III oferece acolhimento 24h e leitos noturnos como alternativa real à internação, com indicações específicas.',
    perfilA: 'Crises com risco grave imediato, falha do extra-hospitalar, contexto familiar inviável, indicação de internação breve.',
    perfilB: 'Crises agudas mas estabilizáveis em rede, vínculo territorial, suporte familiar e CAPS III com leito noturno disponível.',
    duracaoLeitura: '12 min'
  }
];

// ─────────────────────────────────────────────
// Métricas derivadas do próprio catálogo (sem inventar dados)
// ─────────────────────────────────────────────
const minutos = COMPARATIVOS.map(c => parseInt(c.duracaoLeitura, 10)).filter(n => !Number.isNaN(n));
const totalComparativos = COMPARATIVOS.length;
const tempoTotal = minutos.reduce((a, b) => a + b, 0);
// Distribuição por faixa de profundidade (tempo de leitura)
const faixas = [
  { rotulo: 'Rápidos · 10–11 min', n: minutos.filter(m => m <= 11).length, cor: 'accent' as const },
  { rotulo: 'Médios · 12–13 min', n: minutos.filter(m => m === 12 || m === 13).length, cor: 'brand' as const },
  { rotulo: 'Profundos · 14 min', n: minutos.filter(m => m >= 14).length, cor: 'ink' as const }
];

const ldItemList = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: COMPARATIVOS.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.titulo,
    url: `${SITE.url}/comparativos/${c.slug}`
  }))
});

---

<Base
  title="Comparativos — quando dois caminhos parecem o mesmo (e não são) | 18 análises independentes"
  description="18 comparativos independentes em Psicologia clínica, organizacional e regulatória. POT vs Gestão, DBT vs TCC, IAPT vs stepped care, exposição vs EMDR, ABA vs Denver, laudo psicológico vs médico, remoto vs presencial, individual vs grupo, presencial vs apps, TF-CBT vs EMDR infantil, antipsicótico vs psicossocial, internação vs CAPS III.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Comparativos' }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Decisão · Comparativos</span>
          <h1 class="section-h text-3xl sm:text-4xl">Comparativos — quando dois caminhos parecem o mesmo (e não são).</h1>
          <p class="mt-3 text-ink-700 text-lg">
            A indústria de educação executiva produz comparações em formato de ranking. Pouco rigor, muito superlativo. Aqui o método é outro: nomear a diferença real entre duas opções que confundem e descrever o tipo de profissional que se beneficia de cada uma.
          </p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver MBAs no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-8 space-y-6">
        <div class="prose prose-ink max-w-none">
          <h2 class="section-h text-2xl">Por que comparativo imparcial é mais útil que ranking</h2>
          <p>
            Ranking pressupõe que existe uma resposta objetivamente melhor. Em pós-graduação aplicada, isso é falso. Um MBA em Psicologia Organizacional não é melhor que um MBA em Gestão de Pessoas — eles formam profissionais diferentes para perfis de carreira diferentes. O psicólogo que vai liderar diagnóstico de cultura escolhe um caminho. O gestor de linha que vai operacionalizar políticas escolhe outro. Os dois podem estar certos.
          </p>
          <p>
            A literatura de decisão de carreira reforça o ponto. Schein (2017) descreve "âncoras de carreira" — padrões estáveis de talento, motivação e valor que orientam escolha profissional. Quando o profissional ignora a própria âncora e escolhe pelo curso "melhor avaliado", o desfecho é arrependimento três anos depois. A literatura de aprendizagem adulta vai na mesma direção: Knowles (1980) demonstrou que adulto aprende quando o conteúdo dialoga com problema real de sua prática. Curso descolado do contexto vira diploma decorativo.
          </p>
          <p>
            Os comparativos abaixo seguem a mesma estrutura: tese contraintuitiva, três tabelas lado a lado (mecanismo, evidência por condição, perfil de paciente), mini-caso composto, erros comuns na decisão e síntese final. Sem dizer qual é melhor. Apenas dizendo para quem cada um é. Os comparativos clínicos (DBT vs TCC, IPT vs TCC, exposição vs EMDR, ABA vs Denver) e regulatórios (laudo psicológico vs médico, telessaúde, IAPT vs stepped care) foram desenhados em diálogo com a literatura 2024-2026.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mt-8">
          {COMPARATIVOS.map((c, i) => (
            <a href={`/comparativos/${c.slug}`} class="card-lift card-shine reveal p-6 block group" data-reveal-delay={Math.min(i, 8) * 40}>
              <div class="flex items-start justify-between gap-2 mb-3">
                <span class="section-eyebrow">{c.eyebrow}</span>
                <span class="text-xs text-ink-500">{c.duracaoLeitura}</span>
              </div>
              <h3 class="font-display font-semibold text-lg text-ink-900 group-hover:text-brand-700 transition">{c.titulo}</h3>
              <p class="mt-3 text-sm text-ink-700 italic border-l-4 border-sun-500 pl-3">{c.tese}</p>
              <div class="mt-4 space-y-2 text-xs text-ink-500">
                <p><strong class="text-ink-700">Lado A:</strong> {c.perfilA}</p>
                <p><strong class="text-ink-700">Lado B:</strong> {c.perfilB}</p>
              </div>
              <span class="mt-4 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">
                Ler comparativo <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <aside class="lg:col-span-4 space-y-5">
        <div class="card p-6 sticky top-20">
          <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Como usar esta seção</p>
          <h3 class="font-display font-semibold text-lg mt-1">Três perguntas antes de escolher</h3>
          <ol class="mt-3 space-y-3 text-sm text-ink-700 list-decimal list-inside">
            <li>Qual problema vou resolver no dia seguinte ao certificado?</li>
            <li>Que tipo de profissional eu admiro hoje — e o que esse profissional fez de pós?</li>
            <li>Que formato de aprendizagem combina com a minha agenda real, não a ideal?</li>
          </ol>
          <p class="mt-4 text-xs text-ink-500 italic">Se a resposta às três é clara, o comparativo confirma. Se é incerta, ele revela.</p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <KpiCard
            rotulo="Comparativos"
            valor={String(totalComparativos)}
            direcao="neutro"
            contexto="Análises independentes."
          />
          <KpiCard
            rotulo="Leitura total"
            valor={`${tempoTotal} min`}
            direcao="positivo"
            contexto="Soma das durações estimadas."
          />
        </div>

        <MiniBar
          titulo="Comparativos por profundidade"
          subtitulo="Distribuição pela duração de leitura estimada"
          unidade=""
          max={totalComparativos}
          tabelaCols={['Faixa de leitura', 'Quantidade']}
          dados={faixas.map(f => ({ rotulo: f.rotulo, valor: f.n, cor: f.cor }))}
        />

        <div class="card p-6">
          <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Próximo passo</p>
          <p class="text-sm text-ink-700">
            Os comparativos são instrumentos de decisão. A oferta oficial — grade, valor, modalidade e turma — é tratada em ipog.edu.br.
          </p>
          <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">
            Ver MBAs no IPOG
          </a>
          <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">
            Home IPOG
          </a>
        </div>

        <div class="card p-6">
          <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Conteúdo relacionado</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/regulacao" class="text-brand-700 hover:text-brand-800 font-medium">Regulação, ética e escopo profissional</a></li>
            <li><a href="/mbas" class="text-brand-700 hover:text-brand-800 font-medium">Todos os MBAs em Psicologia</a></li>
            <li><a href="/areas" class="text-brand-700 hover:text-brand-800 font-medium">As 18 áreas mapeadas</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-brand-900 text-white relative overflow-hidden">
    <div class="absolute -top-20 -right-10 w-72 h-72 rounded-full" aria-hidden="true" style="background: radial-gradient(closest-side, rgba(245,180,0,.30), transparent);"></div>
    <div class="container-page py-14 lg:py-20 relative">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <span class="tag mb-4"><span class="w-1.5 h-1.5 rounded-full bg-sun-500"></span> Próximo passo</span>
          <h2 class="font-display font-bold text-3xl sm:text-4xl leading-tight">
            Decidiu? O caminho oficial é <span class="text-sun-500">ipog.edu.br</span>.
          </h2>
          <p class="mt-4 text-white/85 text-lg max-w-xl">
            O IPOG mantém MBAs nas duas famílias comparadas neste guia, com formato Ao Vivo síncrono e corpo docente nominal — o que ajuda a comparar in loco antes de decidir.
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-3">
          <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary btn-lg">
            Ver pós-graduações do IPOG
