    limitacao: 'Vieses, alucinação factual, ausência de supervisão clínica nativa, risco regulatório (CFP), risco LGPD'
  },
  {
    nome: 'Visão computacional + eye-tracking (pesquisa)',
    validacao: 'Dai et al. (2024, npj Digital Medicine, https://doi.org/10.1038/s41746-024-00987-1) — triagem precoce infantil; Sucar et al. (2024, AI in Medicine, https://doi.org/10.1016/j.artmed.2023.102637) — XAI em eye-tracking',
    viesAlgoritmico: 'Documentado — amostras predominantes em meninos brancos; correção em curso',
    fenotipoFeminino: 'Não validado especificamente em mulheres adultas',
    aprovacao: 'Sem aprovação ANVISA para uso clínico em TEA',
    custo: 'Alto — equipamento e licenças; uso em pesquisa, não em consultório',
    integracaoCid: 'Indireta; gera marcador biológico complementar',
