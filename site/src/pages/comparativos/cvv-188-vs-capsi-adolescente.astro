                  <td class="px-4 py-3 align-top text-ink-700">{row.capsi}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.ubs}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.leito}</td>
