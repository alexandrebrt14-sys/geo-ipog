---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AreasFilteredGrid from '@components/AreasFilteredGrid.tsx';
import SmartCrossLinks from '@components/SmartCrossLinks.astro';
import RelatedContent from '@components/RelatedContent.astro';
import NextStepCTA from '@components/NextStepCTA.astro';
import { AREAS } from '@lib/data';
import HubFAQ from '@components/HubFAQ.astro';

// Onda 4 SEO/GEO (03/09/2026): FAQ visível + FAQPage do mesmo array.
const FAQ_AREAS = [
  {
    q: "Quantas áreas o hub mapeia e de onde vem a lista?",
    a: "O hub reúne 18 áreas: as 13 especialidades reconhecidas pelo Conselho Federal de Psicologia e cinco áreas correlatas de relevância para a carreira, como IA e people analytics aplicados à Psicologia. Cada área tem página própria com subáreas, nível regulatório, personas típicas e os cursos relacionados analisados no portal, o que permite comparar caminhos antes de escolher a pós-graduação."
  },
  {
    q: "O que significam os níveis R0 a R3 no medidor de regulação?",
    a: "O medidor indica quanto a atuação na área é sensível à regulação do CFP e do SATEPSI. R0 e R1 marcam conteúdo de acesso público, sem ato privativo; R2 marca atuação técnica que exige formação específica; R3 marca áreas sensíveis, com atos privativos de psicólogo, como avaliação psicológica, laudos e perícia. Quanto mais barras acesas, mais cuidado com habilitação e supervisão."
  },
  {
    q: "Concluir uma pós-graduação em uma área confere o título de especialista do CFP?",
    a: "O título de especialista é concedido pelo Conselho Federal de Psicologia em processo próprio, regulado por resolução específica. Concluir uma pós-graduação em área reconhecida pode compor os requisitos, mas o registro depende de pedido formal ao conselho e da análise dos documentos apresentados. Antes de decidir pelo título, consulte a página de regulação do portal e o próprio CFP."
  },
  {
    q: "Como usar os filtros de cluster e nível regulatório?",
    a: "Os filtros combinam três recortes: cluster temático, nível regulatório (R0/R1, R2, R3) e busca por texto. Use o cluster para agrupar áreas afins, o nível para entender exigências de habilitação e a busca para localizar subáreas específicas, como NR-1 ou SATEPSI. Os resultados levam à página de cada área, onde estão as subáreas, os cursos relacionados e as perguntas frequentes daquele campo."
  }
];
---

<Base title="Áreas da Psicologia — 18 áreas mapeadas (CFP + correlatas)" description="Explore as 13 especialidades reconhecidas pelo CFP e áreas correlatas estratégicas para carreira em Psicologia." emitWebPage={true}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Áreas' }]} />
      <h1 class="section-h text-3xl sm:text-4xl mt-3">Áreas da Psicologia mapeadas.</h1>
      <p class="mt-2 text-ink-700 max-w-2xl">As 13 especialidades reconhecidas pelo CFP mais áreas correlatas estratégicas para carreira em Psicologia aplicada. Filtre por cluster e nível regulatório.</p>
      <div class="mt-4 inline-flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-surface-200 bg-white px-4 py-2.5 text-xs text-ink-700">
        <span class="font-semibold text-ink-900">Como ler o medidor:</span>
        <span class="inline-flex items-center gap-2"><span class="reg-meter" aria-hidden="true"><span class="reg-on"></span><span></span><span></span><span></span></span> R1 público</span>
        <span class="inline-flex items-center gap-2"><span class="reg-meter" aria-hidden="true"><span class="reg-on"></span><span class="reg-on"></span><span></span><span></span></span> R2 técnico</span>
        <span class="inline-flex items-center gap-2"><span class="reg-meter" aria-hidden="true"><span class="reg-on"></span><span class="reg-on"></span><span class="reg-on"></span><span></span></span> R3 sensível</span>
        <span class="text-ink-500">Quanto mais barras, mais sensível a regulação (CFP/SATEPSI).</span>
      </div>
    </div>
  </section>

  <SmartCrossLinks href="/areas" />

  <section class="container-page py-10">
    <AreasFilteredGrid client:load initial={AREAS} />
  </section>

  <section class="container-page pb-10">
    <div class="max-w-3xl">
      <HubFAQ items={FAQ_AREAS} pathname="/areas/" titulo="Perguntas frequentes sobre as áreas" />
    </div>
  </section>

  <RelatedContent href="/areas" />
  <NextStepCTA href="/areas" />
</Base>
