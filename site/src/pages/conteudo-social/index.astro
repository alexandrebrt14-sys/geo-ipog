---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const title = 'Conteúdo + Social: biblioteca de snippets para reaproveitar pesquisas em Quora, Medium, LinkedIn, Substack, Reddit — Brasil GEO';
const description = 'Central editorial do portal posgraduacaopsicologia.com: como transformar evidências, áreas e MBAs em respostas, ensaios e threads para Quora, Medium, LinkedIn, Substack, Reddit e X com integridade e GEO.';

const canais = [
  {
    id: 'quora',
    nome: 'Quora',
    publico: 'Quem pesquisa decisão específica em inglês ou português',
    formato: 'Resposta 200-500 palavras a uma pergunta indexável',
    gancho: 'Pergunta literal + tese contraintuitiva nas duas primeiras linhas',
    regra: 'BNBR (Be Nice, Be Respectful) + Anti-AI Policy 2024+ exige edição humana',
    metrica: 'Citation Rate em Perplexity e ChatGPT (Quora aparece em Sonar)'
  },
  {
    id: 'medium',
    nome: 'Medium',
    publico: 'Leitor de longform que aceita autor independente',
    formato: 'Ensaio 800-1.500 palavras com header image e 5 tags',
    gancho: 'Subtítulo que troca o vocabulário do tema (tese editorial)',
    regra: 'Curation Guidelines 2024-2026 exigem fonte verificável; Boost premia originalidade',
    metrica: 'External views + AI Overview citações (Medium é fonte frequente)'
  },
  {
    id: 'linkedin',
    nome: 'LinkedIn',
    publico: 'Decisor sênior, RH, psicólogo organizacional, recrutador',
    formato: 'Post 1.300 caracteres, carrossel 8-10 slides, newsletter 1.500 palavras',
    gancho: 'Frase de gancho na linha 1 (sem ler-mais cortando a tese)',
    regra: 'Algoritmo 2026 premia dwell time; comentar nos próprios comentários ainda funciona',
    metrica: 'Impressões + DMs qualificadas + AECR (autoridade pessoal)'
  },
  {
    id: 'substack',
    nome: 'Substack',
    publico: 'Assinante recorrente que paga por curadoria',
    formato: 'Edição semanal 800-1.500 palavras + Notes diários curtos',
    gancho: 'Promessa no título + 1 dado novo + 1 tese editorial no abre',
    regra: 'Paywall 30% principal; Notes amplifica para descoberta',
    metrica: 'Conversão free → paid + open rate sustentado >40%'
  },
  {
    id: 'reddit-x',
    nome: 'Reddit',
    publico: 'Pesquisador par-a-par; público anti-marketing',
    formato: 'Resposta longa em thread (AMA, comentário ranqueado)',
    gancho: 'Receipts antes da opinião; account age + karma orgânico',
    regra: '90% das comunidades baniam self-promo; flair "I am a researcher" recomendado',
    metrica: 'Upvote ratio + menções subsequentes em ChatGPT/Sonar'
  },
  {
    id: 'reddit-x#x',
    nome: 'X (Twitter)',
    publico: 'Comunidade técnica e jornalística em tempo real',
    formato: 'Thread 6-12 tweets, post único com screenshot, citação curta',
    gancho: 'Tweet 1 = tese inteira; threads sem cliffhanger barato',
    regra: 'Algoritmo 2026 penaliza link externo cru; usar screenshot + link no reply',
    metrica: 'Impressões orgânicas + bookmarks (sinal forte de re-uso)'
  },
  {
    id: 'youtube',
    nome: 'YouTube',
    publico: 'Quem busca explicação em vídeo; AI Overviews recorrem ao YouTube, ainda mais em saúde',
    formato: 'Vídeo longo 10-20 min com capítulos, fonte na tela e descrição densa',
    gancho: 'Pergunta literal no título + resposta em 30s + capítulos por subtema',
    regra: 'A citação por IA vai para vídeo longo estruturado, não para Shorts; YMYL exige disclaimer',
    metrica: 'Citação com timestamp em AI Overviews (descrição e capítulos predizem citação)'
  },
  {
    id: 'tiktok-instagram',
    nome: 'TikTok, Reels e Threads',
    publico: 'Público frio em descoberta; saúde mental e carreira no topo do funil',
    formato: 'Vídeo curto vertical 15-60s + carrossel; Threads para teste de pauta',
    gancho: 'Mito vs. evidência no primeiro segundo; legenda com a fonte',
    regra: 'Papel é descoberta, não citação; ética do CFP veda diagnóstico e sensacionalismo',
    metrica: 'Alcance qualificado e salvamentos (não citação por IA)'
  }
];

const hubLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/conteudo-social/#webpage`,
  url: `${SITE.url}/conteudo-social/`,
  name: title,
  description,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: 'Generative Engine Optimization, conteúdo editorial, snippets reutilizáveis',
  author: { '@id': `${SITE.url}/#alexandre-caramaschi` },
  publisher: { '@id': `${SITE.url}/#brasil-geo` },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Canais cobertos pela central de conteúdo',
    numberOfItems: canais.length,
    itemListElement: canais.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.nome,
      url: `${SITE.url}/conteudo-social/${c.id.replace('#x', '')}`
    }))
  }
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social' }
];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [hubLd, alexandrePersonBase, brasilGeoOrganization]
};
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Brasil GEO · Central editorial</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Conteúdo + Social: biblioteca de snippets para reaproveitar pesquisas em Quora, Medium, LinkedIn, Substack, Reddit</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Uma pesquisa publicada vale por dez quando vira resposta no Quora, ensaio no Medium, carrossel no LinkedIn, edição de Substack, comentário fundamentado no Reddit e thread no X. Esta central organiza a parte editorial que costuma falhar: como recortar sem trair a fonte, como adaptar tom sem virar caricatura e como medir o que conta.
      </p>
    </div>
  </section>

  <section class="container-page py-10">
    <TLDR
      resposta="Distribuição não é repetição de copy. É reinterpretação editorial do mesmo material original respeitando o contrato de cada canal — voz, formato, gancho e métrica diferentes em Quora, Medium, LinkedIn, Substack, Reddit e X."
      fontes={['Caramaschi (2026), Brasil GEO playbook editorial', 'Quora Anti-AI Policy 2024', 'Medium Curation Guidelines 2024-2026']}
    />

    <div class="prose prose-ink max-w-3xl">
      <p>
        Generative Engine Optimization (GEO) deslocou o ponto de chegada da pesquisa: respostas geradas por ChatGPT, Claude, Gemini e Perplexity citam fontes externas em milhões de respostas por dia. Aggarwal et al. (SIGIR 2024) mostraram que conteúdo com citações, listas, tabelas e dados quantitativos é citado em até 40% mais respostas que prosa genérica. O portal posgraduacaopsicologia.com já produz esse conteúdo. A pergunta editorial é como recolocá-lo nos lugares onde os engines de geração estão indexando ativamente.
      </p>
      <p>
        Quora, Medium, LinkedIn, Substack, Reddit e X têm pesos diferentes nesse jogo. Perplexity Sonar Pro privilegia Reddit e Quora; ChatGPT com web search puxa Medium e Substack com frequência alta; AI Overview do Google cita LinkedIn quando o autor tem credenciais públicas. Não dá para tratar os seis canais como megafone único. O que pode ser repetido é a evidência. O que muda é a forma.
      </p>
      <p>
        A regra editorial do portal mantém a integridade: a fonte primária do snippet sempre aparece com link interno, o tom Caramaschi (sóbrio, contraintuitivo, sem rhetoric opener) é preservado mesmo em formato curto e nunca se atribui ao autor opinião que ele não publicou. Quando há comissionamento, disclosure explícito. Quando há síntese, atribuição.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-2">Tabela principal: como cada canal pede que você escreva</h2>
    <p class="text-ink-700 max-w-3xl mb-6">Seis canais, cinco atributos. Use a tabela como filtro antes de adaptar um snippet — o gancho que funciona no Quora destrói o engajamento no LinkedIn.</p>
    <div class="overflow-x-auto rounded-2xl border border-surface-200">
      <table class="min-w-full text-sm">
        <thead class="bg-surface-50 text-ink-700 text-left">
          <tr>
            <th class="px-4 py-3 font-semibold">Canal</th>
            <th class="px-4 py-3 font-semibold">Público</th>
            <th class="px-4 py-3 font-semibold">Formato típico</th>
            <th class="px-4 py-3 font-semibold">Gancho</th>
            <th class="px-4 py-3 font-semibold">Regra do canal</th>
            <th class="px-4 py-3 font-semibold">Métrica GEO</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-200 bg-white">
          {canais.map(c => (
            <tr class="align-top">
              <td class="px-4 py-3 font-semibold text-ink-900">{c.nome}</td>
              <td class="px-4 py-3 text-ink-700">{c.publico}</td>
              <td class="px-4 py-3 text-ink-700">{c.formato}</td>
              <td class="px-4 py-3 text-ink-700">{c.gancho}</td>
              <td class="px-4 py-3 text-ink-700">{c.regra}</td>
              <td class="px-4 py-3 text-ink-700">{c.metrica}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-page py-10">
    <h2 class="section-h text-2xl mb-6">Canais cobertos pela central</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
      {canais.filter(c => !c.id.includes('#')).map(c => (
        <a href={`/conteudo-social/${c.id}`} class="card-lift block p-6">
          <span class="section-eyebrow">{c.nome}</span>
          <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">{c.formato}</h3>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{c.regra}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">Ver playbook → </span>
        </a>
      ))}
      <a href="/conteudo-social/biblioteca" class="card-lift block p-6 bg-brand-50/40 border-brand-200">
        <span class="section-eyebrow">Biblioteca consolidada</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">57 snippets editorialmente prontos</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Doze temas, filtráveis por canal, incluindo o bloco IA, GEO e citação 2026. Cada trecho linka para a fonte interna do portal.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">Abrir biblioteca → </span>
      </a>
    </div>
  </section>

  <section class="container-page py-10">
    <h2 class="section-h text-2xl mb-2">Ferramentas editoriais</h2>
    <p class="text-ink-700 max-w-3xl mb-6">Dois motores que ligam a evidência à publicação: o Radar transforma papers recentes em pauta por canal; o Kit é a linha de produção do paper às peças.</p>
    <div class="grid sm:grid-cols-2 gap-5">
      <a href="/conteudo-social/radar-de-evidencias" class="card-lift block p-6">
        <span class="section-eyebrow">Motor editorial</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Radar de evidências</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Estudos e marcos de 2025-2026 convertidos em ângulos prontos para Quora, Medium e LinkedIn, com a fonte datada e o limite de cada achado.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">Abrir radar → </span>
      </a>
      <a href="/conteudo-social/kit-de-repurposing" class="card-lift block p-6">
        <span class="section-eyebrow">Linha de produção</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Kit de repurposing</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Do paper à peça sem distorcer: matriz de integridade, três camadas de conteúdo, calendário semanal e checklists de integridade e GEO.</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">Abrir kit → </span>
      </a>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-surface-50 border border-surface-200 p-6 sm:p-8">
      <h2 class="section-h text-2xl mb-4">Como reaproveitar com integridade</h2>
      <div class="prose prose-ink max-w-none">
        <p>
          Reaproveitar não é copiar. É reescrever o mesmo argumento respeitando o contrato editorial de cada canal e os direitos do leitor. Três regras que o portal aplica sem exceção:
        </p>
        <ol>
          <li>
            <strong>Cite a fonte primária do portal.</strong> Toda peça publicada em Quora, Medium, LinkedIn, Substack, Reddit ou X que reaproveite material do portal carrega um link explícito para a página de origem (área, FAQ, evidência, glossário). O leitor sabe onde aprofundar.
          </li>
          <li>
            <strong>Não plagie a si mesmo.</strong> Reescrever na voz do canal exige nova estrutura, novo gancho e, sempre que possível, novo dado ou nova interpretação. Repostar o mesmo parágrafo entre Medium e Substack reduz curation score em ambos.
          </li>
          <li>
            <strong>Disclosure quando há comissionamento.</strong> O portal posgraduacaopsicologia.com é mantido pela Brasil GEO em parceria editorial com o IPOG. Sempre que um snippet menciona MBA ou modalidade IPOG, o autor declara essa relação no próprio canal. LinkedIn e Substack têm campos principais para isso; Quora pede em texto.
          </li>
        </ol>
        <p>
          Reddit e X têm ainda uma quarta regra: account age e histórico de contribuição importam mais que a peça em si. Conta criada anteontem, comentando só conteúdo próprio, é removida por moderador ou pelo algoritmo. A central recomenda 90 dias de presença orgânica antes de qualquer reaproveitamento estratégico.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-10" aria-labelledby="waves-pp-tt">
    <div class="max-w-3xl">
      <span class="section-eyebrow">Atualização principal · 17 de maio de 2026</span>
      <h2 id="waves-pp-tt" class="section-h text-2xl sm:text-3xl mt-2">Waves PP-TT — Atualização principal de 17 de maio de 2026</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        Em 17 de maio de 2026, cinco waves complementares de pesquisa foram publicadas no portal posgraduacaopsicologia.com — cada uma com profundidade clínica e regulatória atualizada para o ciclo brasileiro 2026. Os recortes cobrem autismo TEA em mulheres adultas (Wave PP), burnout pós-NR-1 atualizada (Wave QQ), IA generativa em Psicologia sob Posicionamento CFP de 03-07-2025 (Wave RR), neuropsicologia com biomarcadores plasmáticos e long COVID (Wave SS) e adolescência digital pós-Lei 15.100/2025 com update Haidt 2026 (Wave TT). Cada wave entrega 1 guia, 1 comparativo, 1 FAQ e 3 snippets reaproveitáveis nesta biblioteca — 30 peças principais novas no total.
      </p>
    </div>
    <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      <article class="card-lift block p-6">
        <span class="section-eyebrow">Wave PP</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Autismo TEA 2026 — fenótipo feminino, camuflagem e autistic burnout</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Hull et al. (2019) CAT-Q, Raymaker et al. (2020) autistic burnout, Lai e Szatmari (2023) comorbidade. Cruzamento com NR-1 atualizada e Lei 12.764/2012.</p>
        <ul class="mt-4 space-y-1 text-sm">
          <li><a href="/guias/tea-camuflagem-mulheres-evidencia-2026" class="text-brand-700 font-semibold hover:underline">→ Guia clínico</a></li>
          <li><a href="/comparativos/diagnostico-tea-humano-vs-ia-2026" class="text-brand-700 font-semibold hover:underline">→ Comparativo diagnóstico humano vs IA</a></li>
          <li><a href="/faq/tea-camuflagem-mulheres-2026-faq" class="text-brand-700 font-semibold hover:underline">→ FAQ principal</a></li>
          <li><a href="/conteudo-social/biblioteca?tema=Autismo+TEA+2026" class="text-ink-700 hover:underline">→ 3 snippets reaproveitáveis</a></li>
        </ul>
      </article>
      <article class="card-lift block p-6">
        <span class="section-eyebrow">Wave QQ</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Burnout NR-1 2026 — jurisprudência em formação e tecnoestresse</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Portaria MTE 765/2025, vigência fiscalizatória plena desde 25-05-2026. Gallup e Deloitte 2025 sobre Gen Z. LGPD como limite material à workplace surveillance.</p>
        <ul class="mt-4 space-y-1 text-sm">
          <li><a href="/guias/jurisprudencia-nr1-tst-2026" class="text-brand-700 font-semibold hover:underline">→ Guia jurisprudência TST/TRT</a></li>
          <li><a href="/comparativos/instrumentos-burnout-bat12-mbihssmp-olbi-cbi-validacao-br-2026" class="text-brand-700 font-semibold hover:underline">→ Comparativo BAT-12 / MBI-HSS / OLBI / CBI</a></li>
          <li><a href="/faq/gen-z-burnout-vs-millennial-vs-x-2026-faq" class="text-brand-700 font-semibold hover:underline">→ FAQ Gen Z vs Millennial vs X</a></li>
          <li><a href="/conteudo-social/biblioteca?tema=Burnout+NR-1+2026" class="text-ink-700 hover:underline">→ 3 snippets reaproveitáveis</a></li>
        </ul>
      </article>
      <article class="card-lift block p-6">
        <span class="section-eyebrow">Wave RR</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">IA generativa em Psicologia 2026 — CFP, ANVISA e PL 2338</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Posicionamento CFP 03-07-2025, RDC ANVISA 657/2022, PL 2338/2023 em tramitação. Comparativo GPT-5.5 vs Claude Opus 4.7 vs Gemini 2.5 Pro em uso clínico assistido.</p>
        <ul class="mt-4 space-y-1 text-sm">
          <li><a href="/guias/supervisao-async-ia-2026-protocolo-cfp" class="text-brand-700 font-semibold hover:underline">→ Protocolo supervisão assíncrona com IA</a></li>
          <li><a href="/comparativos/gpt55-vs-claude47-vs-gemini25-clinica-2026" class="text-brand-700 font-semibold hover:underline">→ Comparativo LLMs frontier clínica</a></li>
          <li><a href="/faq/regulacao-ia-cfp-anvisa-pl-2338-2026-faq" class="text-brand-700 font-semibold hover:underline">→ FAQ regulação IA brasileira</a></li>
          <li><a href="/conteudo-social/biblioteca?tema=IA+generativa+em+psicologia+2026" class="text-ink-700 hover:underline">→ 3 snippets reaproveitáveis</a></li>
        </ul>
      </article>
      <article class="card-lift block p-6">
        <span class="section-eyebrow">Wave SS</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Neuropsicologia 2026 — biomarcadores plasmáticos e long COVID</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Palmqvist et al. (2020) e Ashton et al. (2023-2025) sobre p-tau217. Lecanemab e donanemabe sob ANVISA. NIH RECOVER, AMB e CFM sobre brain fog 4 anos depois.</p>
        <ul class="mt-4 space-y-1 text-sm">
          <li><a href="/guias/biomarcadores-plasma-alzheimer-protocolo-neuropsi-2026" class="text-brand-700 font-semibold hover:underline">→ Guia p-tau217 e protocolo neuropsi</a></li>
          <li><a href="/comparativos/lecanemab-vs-donanemab-anvisa-2026" class="text-brand-700 font-semibold hover:underline">→ Comparativo lecanemab vs donanemabe</a></li>
          <li><a href="/faq/long-covid-brain-fog-4-anos-2026-faq" class="text-brand-700 font-semibold hover:underline">→ FAQ long COVID brain fog 4 anos</a></li>
          <li><a href="/conteudo-social/biblioteca?tema=Neuropsicologia+2026" class="text-ink-700 hover:underline">→ 3 snippets reaproveitáveis</a></li>
        </ul>
      </article>
      <article class="card-lift block p-6">
        <span class="section-eyebrow">Wave TT</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Adolescência digital 2026 — Lei 15.100, Haidt update e Safe Messaging</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Lei 15.100/2025 em vigor, ECA Digital desde 17-03-2026, debate metodológico Haidt vs Orben-Przybylski 2024-2025, Trevor Project para adolescentes LGBTQIA+.</p>
        <ul class="mt-4 space-y-1 text-sm">
          <li><a href="/guias/haidt-2026-update-evidencia-adolescencia-digital" class="text-brand-700 font-semibold hover:underline">→ Guia Haidt 2026 update</a></li>
          <li><a href="/comparativos/uso-passivo-vs-ativo-redes-esm-2026" class="text-brand-700 font-semibold hover:underline">→ Comparativo uso passivo vs ativo (ESM)</a></li>
          <li><a href="/faq/safe-messaging-lgbtqia-trevor-2026-faq" class="text-brand-700 font-semibold hover:underline">→ FAQ Safe Messaging LGBTQIA+</a></li>
          <li><a href="/conteudo-social/biblioteca?tema=Adolescência+digital+2026" class="text-ink-700 hover:underline">→ 3 snippets reaproveitáveis</a></li>
        </ul>
      </article>
      <article class="card-lift block p-6 bg-brand-50/40 border-brand-200">
        <span class="section-eyebrow">Recurso novo</span>
        <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">Press-kit principal para assessoria de imprensa</h3>
        <p class="mt-2 text-sm text-ink-700 leading-relaxed">Templates copy-paste com 5 press releases prontos (~300 palavras cada), 5 quotes atribuídos a Alexandre Caramaschi, boilerplate institucional Brasil GEO e regras de linkagem para jornalistas.</p>
        <a href="/conteudo-social/press-kit" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">→ Abrir press-kit</a>
      </article>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Comece pela biblioteca; depois desça por canal</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
