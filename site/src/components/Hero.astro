---
import { SITE, PERSONAS } from '@lib/data';

const PERSONA_LINES: Record<string, string> = {
  psicologos: 'Sou <strong>psicólogo(a)</strong>',
  rh: 'Trabalho com <strong>RH</strong>',
  lideres: 'Lidero <strong>pessoas e cultura</strong>',
  consultores: 'Atuo em <strong>saúde / educação / consultoria</strong>'
};
---

<section class="relative overflow-hidden hero-grad text-white">
  <div class="absolute inset-0 opacity-[.07]" aria-hidden="true"
    style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="container-page py-12 sm:py-20 lg:py-24 grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-7 animate-slide-up">
      <span class="tag mb-5">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sun-500"></span>
        Portal independente · referência IPOG
      </span>
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
        Pós-Graduações em Psicologia:
        <span class="bg-gradient-to-r from-sun-500 to-amber-300 bg-clip-text text-transparent">o guia amplo</span>
        para MBA, Especialização, Mestrado Profissional e Clínica certificada.
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-white/85 max-w-2xl">
        Inúmeras pós-graduações em Psicologia — MBA é apenas uma das cinco modalidades cobertas.
        Especialização Lato Sensu (CFP), MBA aplicado, Mestrado Profissional (CAPES), Especialização Clínica certificada
        (ACT, EMDR, DBT) e Residência Multiprofissional, organizadas por área, persona e momento de carreira.
        Caminho oficial das matrículas: portal IPOG.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="/tipos-de-pos-graduacao" class="btn btn-primary btn-lg">
          Ver tipos de pós-graduação
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M11 4l6 6-6 6-1.4-1.4L13.2 11H3V9h10.2L9.6 5.4 11 4z"/></svg>
        </a>
        <a href="/mbas" class="btn btn-ghost-dark btn-lg">
          Ver MBAs em destaque
        </a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost-dark btn-lg">
          Portal oficial IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-2xl">
        <div class="glass-dark rounded-xl p-4 border border-white/10">
          <dt class="text-[11px] uppercase tracking-wider text-white/60">Modalidades cobertas</dt>
          <dd class="text-2xl font-display font-bold mt-1" data-countup="5">0</dd>
        </div>
        <div class="glass-dark rounded-xl p-4 border border-white/10">
          <dt class="text-[11px] uppercase tracking-wider text-white/60">Áreas da Psicologia</dt>
          <dd class="text-2xl font-display font-bold mt-1" data-countup="18">0</dd>
        </div>
        <div class="glass-dark rounded-xl p-4 border border-white/10">
          <dt class="text-[11px] uppercase tracking-wider text-white/60">Especialidades CFP</dt>
          <dd class="text-2xl font-display font-bold mt-1" data-countup="13">0</dd>
        </div>
        <div class="glass-dark rounded-xl p-4 border border-white/10">
          <dt class="text-[11px] uppercase tracking-wider text-white/60">Estados cobertos</dt>
          <dd class="text-2xl font-display font-bold mt-1" data-countup="27">0</dd>
        </div>
      </dl>
    </div>

    <aside class="lg:col-span-5">
      <div class="glass-dark rounded-3xl border border-white/15 p-6 sm:p-7 shadow-lift animate-scale-in">
        <div class="flex items-start gap-3">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-sun-500 text-brand-900">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.6 4.9H19l-4.2 3 1.6 5L12 11.9 7.6 14.9l1.6-5L5 6.9h5.4z"/></svg>
          </span>
          <div>
            <p class="text-[11px] uppercase tracking-wider text-white/60 font-semibold">Mapa rápido de decisão</p>
            <h2 class="font-display font-bold text-xl sm:text-2xl mt-0.5">Por onde você está chegando?</h2>
          </div>
        </div>
        <p class="mt-3 text-white/75 text-sm">
          Em três cliques, levamos você ao MBA ou pós que faz sentido para o seu momento.
        </p>
        <div class="mt-5 grid gap-2">
          {PERSONAS.map(p => (
            <a href={`/#${p.id}`} class="group flex items-center justify-between rounded-xl bg-white/8 hover:bg-white/14 border border-white/10 px-4 py-3 transition">
              <span class="flex items-center gap-3 text-sm">
                <span class="text-sun-500">●</span>
                <span set:html={PERSONA_LINES[p.id] || p.name} />
              </span>
              <span class="opacity-50 group-hover:translate-x-0.5 transition">→</span>
            </a>
          ))}
        </div>
        <p class="mt-5 text-[10px] uppercase tracking-wider text-white/50">
          Portal não-oficial. Matrículas em ipog.edu.br.
        </p>
      </div>
    </aside>
  </div>

  <div class="relative">
    <div class="container-page -mb-8 sm:-mb-10">
      <div class="glass-strong rounded-2xl border border-surface-200 shadow-soft p-4 sm:p-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
        <div class="flex items-center gap-3 text-ink-700">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-brand-50 text-brand-700">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <div>
            <p class="text-[11px] uppercase tracking-wider text-ink-500 font-semibold">Busca facetada</p>
            <p class="text-sm">Procure por área, persona, estado ou tema regulatório.</p>
          </div>
        </div>
        <button data-open-search class="sm:ml-auto btn btn-secondary text-sm">
          Abrir busca
          <span class="kbd bg-white/20 border-white/30 text-white">⌘ K</span>
        </button>
      </div>
    </div>
  </div>
</section>
