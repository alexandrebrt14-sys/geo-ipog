---
/**
 * YMYLDisclaimer.astro
 *
 * Disclaimer canônico para páginas YMYL clínicas (autismo, transtornos mentais,
 * avaliação psicológica, etc.).
 *
 * Explica os limites do conteúdo educativo e orienta a procura de atendimento.
 * A identificação de revisor só deve ser informada quando houver revisão
 * documentada daquela página. A ausência do campo não atribui revisão pessoal.
 * O componente não emite JSON-LD; metadados devem refletir fatos verificáveis.
 *
 * Uso típico:
 *   <YMYLDisclaimer
 *     domain="autismo"
 *   />
 *
 * Domain controla a copy do disclaimer:
 *   - "autismo" → foca em TEA, diagnóstico, identidade
 *   - "saude-mental" → foca em transtornos mentais comuns
 *   - "neuropsicologia" → foca em avaliação cognitiva
 *   - "geral" → genérico clínico
 */
interface Props {
  domain?: 'autismo' | 'saude-mental' | 'neuropsicologia' | 'geral';
  reviewerName?: string;
  reviewerHref?: string;
  lastReviewed?: string;
  compact?: boolean;
}

const {
  domain = 'geral',
  reviewerName = '',
  reviewerHref = '/autismo/sobre-larissa/',
  lastReviewed,
  compact = false
} = Astro.props;

const COPY: Record<NonNullable<Props['domain']>, { title: string; body: string }> = {
  autismo: {
    title: 'Aviso clínico · conteúdo educacional',
    body: 'Este conteúdo é educacional e não substitui avaliação clínica ou supervisão profissional. A investigação de autismo em adultos considera história do desenvolvimento, contexto, necessidades de apoio e hipóteses alternativas. Questionários isolados não estabelecem diagnóstico. A seleção de métodos e testes exige profissional habilitado, fundamentação técnica e consulta ao SATEPSI quando aplicável, conforme a Resolução CFP 31/2022.'
  },
  'saude-mental': {
    title: 'Aviso clínico · conteúdo educacional',
    body: 'Este conteúdo é educacional e não substitui avaliação clínica, prescrição médica, psicoterapia ou supervisão profissional. Em emergência ou risco imediato à vida, acione o SAMU 192 ou procure pronto atendimento. O CVV 188 oferece apoio emocional e não substitui atendimento de emergência. Para acompanhamento, procure profissional de saúde habilitado.'
  },
  neuropsicologia: {
    title: 'Aviso clínico · conteúdo educacional',
    body: 'Este conteúdo é educacional e não substitui avaliação neuropsicológica. A avaliação psicológica segue a Resolução CFP 31/2022; documentos psicológicos seguem a Resolução CFP 6/2019. O uso profissional de testes psicológicos exige habilitação e verificação do parecer vigente, do público e da modalidade de aplicação no SATEPSI. Este portal não reproduz itens restritos nem oferece interpretação individual de resultados.'
  },
  geral: {
    title: 'Aviso clínico · conteúdo educacional',
    body: 'Este conteúdo é editorial e educacional. Não substitui avaliação clínica, psicoterapia, supervisão profissional, parecer regulatório do CFP ou prescrição médica. Decisões clínicas, profissionais ou de matrícula em pós-graduação devem ser tomadas com fonte oficial e profissional habilitado.'
  }
};

const c = COPY[domain];

function formatarData(iso?: string): string | null {
  if (!iso) return null;
  const partes = iso.split('-');
  if (partes.length !== 3) return iso;
  const [ano, mes, dia] = partes;
  return `${dia}/${mes}/${ano}`;
}

const lastReviewedFmt = formatarData(lastReviewed);
---

<aside
  class={`not-prose ${compact ? 'mt-4 mb-4 p-4' : 'mt-6 mb-6 p-5'} border-l-4 border-sun-500 bg-sun-50 rounded-r-2xl max-w-3xl`}
  role="note"
  aria-label={c.title}
  data-ymyl-disclaimer
  data-domain={domain}
>
  <p class={`${compact ? 'text-xs' : 'text-xs'} uppercase tracking-wider font-semibold text-sun-800 mb-2`}>
    {c.title}
  </p>
  <p class={`${compact ? 'text-sm' : 'text-sm sm:text-base'} text-ink-800 leading-relaxed`}>
    {c.body}
  </p>
  {(reviewerName || lastReviewedFmt) && (
    <p class="mt-3 text-xs text-ink-600 leading-relaxed">
      {reviewerName && (
        <>
          Revisão clínica: <a
            href={reviewerHref}
            class="font-semibold underline decoration-sun-500 underline-offset-2 hover:text-brand-700"
          >{reviewerName}</a>
        </>
      )}
      {reviewerName && lastReviewedFmt && ' · '}
      {lastReviewedFmt && <>Revisado em {lastReviewedFmt}</>}
    </p>
  )}
</aside>
