---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const titulo = 'Autismo nível 1 de suporte em adultos, conduzido por Larissa Caramaschi, psicóloga clínica em Goiânia';
const descricao = 'Portal de psicoeducação sobre autismo nível 1 de suporte em adultos, com ênfase em identidade, relacionamentos amorosos e vida cotidiana. Conteúdo editorial conduzido por Larissa Caramaschi, psicóloga clínica em Goiânia, mestre em Psicologia pela USP, com 26 anos de prática em terapia individual, familiar e de casal.';

const ldBreadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' }
  ]
});

const larissaPerson = {
  '@type': 'Person',
  '@id': SITE.url + '/autismo/sobre-larissa/#larissa-caramaschi',
  name: 'Larissa Caramaschi',
  jobTitle: 'Psicóloga clínica',
  description: 'Psicóloga clínica em Goiânia, mestre em Psicologia pela USP, com 26 anos de prática em psicoterapia individual, familiar e de casal. Lente clínica atual em autismo nível 1 de suporte em adultos.',
  url: SITE.url + '/autismo/sobre-larissa/',
  knowsAbout: [
    'Autismo nível 1 de suporte em adultos',
    'Diagnóstico tardio em adultos',
    'Casais NT-autista',
    'Camuflagem (masking) em adultos autistas',
    'Terapia familiar e de casal',
    'Psicoeducação neuroafirmativa'
  ]
};

const ldHomeGraph = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': SITE.url + '/#webpage',
      url: SITE.url + '/',
      name: titulo,
      description: descricao,
      isPartOf: { '@id': SITE.url + '/#website' },
      inLanguage: 'pt-BR',
      about: [
        { '@type': 'MedicalCondition', name: 'Transtorno do Espectro Autista nível 1 de suporte em adultos' },
        { '@type': 'Thing', name: 'Relacionamentos amorosos NT-autista' },
        { '@type': 'Thing', name: 'Camuflagem (masking) em adultos autistas' }
      ],
      mainEntity: { '@id': SITE.url + '/autismo/sobre-larissa/#larissa-caramaschi' }
    },
    larissaPerson
  ]
});

interface ArtigoCard {
  slug: string;
  titulo: string;
  resumo: string;
}

const ARTIGOS: ArtigoCard[] = [
  {
    slug: 'diagnostico-tardio-adulto-2026',
    titulo: 'Diagnóstico tardio em adultos',
    resumo: 'Reorganização biográfica, custos invisíveis e o que muda quando se nomeia o que sempre esteve lá.'
  },
  {
    slug: 'relacionamentos-amorosos-nt-autista-2026',
    titulo: 'Casais NT-autista',
    resumo: 'Relacionamentos amorosos entre pessoa neurotípica e pessoa autista, sob a lente da dupla empatia e da regulação relacional.'
  },
  {
    slug: 'camuflagem-masking-cat-q-adulto-2026',
    titulo: 'Camuflagem (masking) em adultos',
    resumo: 'Três dimensões da camuflagem, instrumento CAT-Q, e a clínica do desmascaramento gradual em adultos autistas.'
  },
  {
    slug: 'vida-cotidiana-trabalho-autista-adulto-2026',
    titulo: 'Trabalho e vida cotidiana',
    resumo: 'Acomodações razoáveis, gestão de energia social, sobrecarga sensorial e funcionamento profissional no Brasil em 2026.'
  },
  {
    slug: 'clinica-tea-adulto-evidencia-2026',
    titulo: 'Clínica do TEA adulto',
    resumo: 'O que a evidência clínica recente sustenta sobre avaliação, acompanhamento e prognóstico em adultos com autismo nível 1.'
  },
  {
    slug: 'fronteira-pesquisa-tea-adulto-2026',
    titulo: 'Fronteira de pesquisa 2026',
    resumo: 'Linhas de pesquisa abertas em 2026, do biomarcador molecular à dupla empatia, com leitura crítica do estado da arte.'
  }
];

interface PortaCard {
  href: string;
  rotulo: string;
  titulo: string;
  resumo: string;
}

const PORTAS: PortaCard[] = [
  {
    href: '/autismo/para-pacientes/',
    rotulo: 'Porta 01',
    titulo: 'Para pacientes e famílias',
    resumo: 'Entrada acessível para adultos recém-diagnosticados, parceiros e familiares que querem entender o terreno antes da decisão clínica.'
  },
  {
    href: '/autismo/para-profissionais/',
    rotulo: 'Porta 02',
    titulo: 'Para profissionais de psicologia',
    resumo: 'Material clínico de referência para psicólogos, psiquiatras, neuropsicólogos e terapeutas que atendem adultos autistas.'
  },
  {
    href: '/autismo/para-pesquisadores/',
    rotulo: 'Porta 03',
    titulo: 'Para pesquisadores',
    resumo: 'Mapas de literatura, fontes primárias e questões abertas em autismo adulto, voltado a quem investiga ou orienta pesquisa.'
  }
];

interface Deslocamento {
  numero: string;
  de: string;
  para: string;
}

const DESLOCAMENTOS: Deslocamento[] = [
  { numero: '01', de: 'Da culpa', para: 'para compreensão funcional' },
  { numero: '02', de: 'Da patologização', para: 'para tradução' },
  { numero: '03', de: 'Do conserto do parceiro', para: 'para construção de linguagem relacional' },
  { numero: '04', de: 'Do jargão clínico fechado', para: 'para vocabulário acessível e tecnicamente honesto' }
];
---

<Base title={titulo} description={descricao}>

  <!-- HERO -->
  <section class="bg-gradient-to-b from-brand-50 to-white border-b border-surface-200">
    <div class="container-page py-16 lg:py-24">
      <div class="max-w-4xl">
        <span class="section-eyebrow">Portal de psicoeducação</span>
        <h1 class="section-h text-3xl sm:text-4xl lg:text-5xl xl:text-6xl leading-tight">
          Autismo nível 1 de suporte em adultos, identidade, relacionamentos amorosos e vida cotidiana, com profundidade clínica e respeito à comunidade adulta.
        </h1>
        <p class="mt-6 text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl" style="text-align: justify;">
          Portal de psicoeducação conduzido por Larissa Caramaschi, psicóloga clínica em Goiânia, mestre em Psicologia pela Universidade de São Paulo, com vinte e seis anos de prática em psicoterapia individual, familiar e de casal. O material reunido aqui é de leitura aberta, escrito em vocabulário identity-first, com foco em adultos brasileiros que reconhecem traços autísticos em si ou em pessoas próximas, e em profissionais que querem aprofundar a clínica neuroafirmativa.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/autismo/" class="btn btn-primary btn-lg">
            Conhecer o material
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 10h12.5l-4.3-4.3 1.4-1.4L19.4 10l-6.8 6.7-1.4-1.4 4.3-4.3H3z"/></svg>
          </a>
          <a href="/autismo/sobre-larissa/" class="btn btn-ghost-dark btn-lg">
            Sobre Larissa Caramaschi
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 PORTAS DE AUDIÊNCIA -->
  <section class="container-page py-16 lg:py-20">
    <div class="max-w-3xl mb-10">
      <span class="section-eyebrow">01 · Três portas por onde entrar</span>
      <h2 class="section-h text-3xl sm:text-4xl">Material organizado por intenção de leitura.</h2>
      <p class="mt-3 text-ink-700 text-base sm:text-lg" style="text-align: justify;">
        O mesmo corpo de conhecimento ganha contornos diferentes conforme quem chega. Escolha a porta que dialoga com a sua intenção atual, sem hierarquia entre as três.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {PORTAS.map(p => (
        <a href={p.href} class="card-lift block p-7 group">
          <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">{p.rotulo}</p>
          <h3 class="font-display font-semibold text-xl mt-2 text-ink-900 group-hover:text-brand-800 transition leading-snug">{p.titulo}</h3>
          <p class="mt-3 text-sm sm:text-base text-ink-700 leading-relaxed" style="text-align: justify;">{p.resumo}</p>
          <span class="mt-5 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">
            Entrar por aqui <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ARTIGOS PUBLICADOS -->
  <section class="bg-surface-50 border-y border-surface-200">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <span class="section-eyebrow">02 · Artigos publicados</span>
          <h2 class="section-h text-3xl sm:text-4xl">Seis leituras longas sobre autismo adulto.</h2>
          <p class="mt-3 text-ink-700 text-base sm:text-lg" style="text-align: justify;">
            Cada artigo combina referência técnica explícita e vocabulário acessível. A profundidade é proposital, são textos para leitura cuidadosa, não para escaneio rápido.
          </p>
        </div>
        <a href="/autismo/" class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800">
          Ver hub completo <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {ARTIGOS.map((a, i) => (
          <a href={`/autismo/artigos/${a.slug}/`} class="card-lift block p-6 group bg-white">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">Artigo · {String(i + 1).padStart(2, '0')}</p>
            <h3 class="font-display font-semibold text-lg mt-2 text-ink-900 group-hover:text-brand-800 transition leading-snug">{a.titulo}</h3>
            <p class="mt-3 text-sm text-ink-700 leading-relaxed" style="text-align: justify;">{a.resumo}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">
              Ler <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GLOSSÁRIO -->
  <section class="container-page py-16 lg:py-20">
    <div class="max-w-4xl mx-auto">
      <a href="/autismo/glossario/" class="card-lift block p-8 sm:p-12 group bg-brand-50">
        <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
          <div class="flex-1">
            <span class="section-eyebrow">03 · Glossário em construção</span>
            <h2 class="section-h text-2xl sm:text-3xl lg:text-4xl mt-2 group-hover:text-brand-800 transition">Cinquenta e quatro verbetes sobre autismo adulto.</h2>
            <p class="mt-4 text-base sm:text-lg text-ink-700 leading-relaxed" style="text-align: justify;">
              Vocabulário técnico, ético e atualizado em 2026, do diagnóstico tardio à dupla empatia, da camuflagem ao apego, em definições operacionais escritas para pacientes, profissionais e pesquisadores. O glossário segue em construção contínua.
            </p>
            <span class="mt-6 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">
              Abrir glossário <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span>
            </span>
          </div>
          <div class="flex-shrink-0 hidden lg:flex items-center justify-center w-32 h-32 rounded-full bg-white text-brand-800">
            <span class="font-display font-bold text-5xl">54</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- PRINCÍPIOS EDITORIAIS -->
  <section class="bg-brand-900 text-white relative overflow-hidden">
    <div class="absolute -top-20 -right-10 w-72 h-72 rounded-full" aria-hidden="true" style="background: radial-gradient(closest-side, rgba(245,180,0,.25), transparent);"></div>
    <div class="container-page py-16 lg:py-20 relative">
      <div class="max-w-3xl mb-10">
        <span class="tag mb-4"><span class="w-1.5 h-1.5 rounded-full bg-sun-500"></span> 04 · Princípios editoriais</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight">Quatro deslocamentos que orientam toda a linha editorial.</h2>
        <p class="mt-4 text-white/85 text-base sm:text-lg leading-relaxed" style="text-align: justify;">
          Cada texto deste portal foi escrito com a intenção explícita de deslocar quatro pontos de partida frequentes no debate público sobre autismo adulto no Brasil.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
        {DESLOCAMENTOS.map(d => (
          <div class="bg-white/5 border border-white/10 rounded-lg p-6 lg:p-8">
            <p class="text-sun-500 font-display font-bold text-sm">Deslocamento · {d.numero}</p>
            <p class="mt-3 text-white/70 text-base">{d.de}</p>
            <p class="mt-2 font-display font-semibold text-xl sm:text-2xl text-white leading-snug">{d.para}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTEÚDO COMPLEMENTAR -->
  <section class="container-page py-14 lg:py-16">
    <div class="max-w-3xl mx-auto text-center">
      <span class="section-eyebrow">05 · Conteúdo complementar</span>
      <p class="mt-4 text-base sm:text-lg text-ink-700 leading-relaxed" style="text-align: justify;">
        O portal também mantém material amplo sobre pós-graduações em Psicologia (áreas, modalidades, FAQ) em <a href="/areas/" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">áreas de atuação</a>, <a href="/tipos-de-pos-graduacao" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">cinco modalidades de pós-graduação</a>, <a href="/guias/" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">guias práticos</a> e <a href="/faq/" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">perguntas frequentes</a>.
      </p>
    </div>
  </section>

  <!-- DISCLAIMER CFP -->
  <section class="bg-surface-50 border-t border-surface-200">
    <div class="container-page py-10 max-w-3xl mx-auto">
      <div class="rounded-lg border border-surface-200 bg-white p-6 sm:p-8">
        <p class="text-sm sm:text-base font-display font-semibold text-ink-900">Aviso ético e clínico</p>
        <p class="mt-3 text-sm text-ink-700 leading-relaxed" style="text-align: justify;">
          Este portal é independente e tem finalidade exclusivamente informativa e de psicoeducação. O conteúdo aqui exposto não substitui consulta, avaliação, diagnóstico ou acompanhamento psicológico individualizado. A divulgação respeita a Resolução CFP nº 03/2007, que regulamenta a publicidade de serviços psicológicos no Brasil, sem promessa de cura, sem comparação com outros profissionais, sem garantia de resultado e sem sensacionalismo. A modalidade de atendimento clínico online de Larissa Caramaschi é oferecida nos termos da Resolução CFP nº 11/2018.
        </p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={ldBreadcrumb} />
  <script type="application/ld+json" set:html={ldHomeGraph} />
</Base>
