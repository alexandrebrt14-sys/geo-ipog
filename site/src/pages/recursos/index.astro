---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';

const title = 'Recursos para decidir sobre pós-graduação em Psicologia';
const description =
  'Quiz, checklist e guia executivo para quem está escolhendo um MBA ou uma especialização em Psicologia em 2026. Portal independente.';

const RECURSOS = [
  {
    id: 'quiz',
    eyebrow: 'Quiz interativo · 3 minutos',
    href: '/recursos/quiz-qual-mba-psicologia',
    title: 'Qual MBA em Psicologia combina com você',
    desc:
      'Dez perguntas mapeiam formação, área de atuação, problema central e momento de carreira para sugerir um MBA principal e um secundário entre os cinco programas cobertos por este portal.',
    cta: 'Fazer o quiz'
  },
  {
    id: 'checklist',
    eyebrow: 'Checklist de elegibilidade',
    href: '/recursos/checklist-escolher-pos-psicologia',
    title: 'Você está pronto para fazer uma pós em Psicologia?',
    desc:
      'Doze itens objetivos para evitar a decisão por inércia. Pré-requisito acadêmico, ajuste de horário, orçamento real, alinhamento com gestor e o que um MBA não entrega.',
    cta: 'Ver checklist'
  },
  {
    id: 'guia',
    eyebrow: 'Guia executivo · pillar longo',
    href: '/recursos/guia-pos-psicologia',
    title: 'Como escolher uma pós em Psicologia em 2026',
    desc:
      'Lato sensu, MBA, especialização, modalidades, áreas reconhecidas pelo CFP, custo, prazo, ROI e o que avaliar no corpo docente. Quinze seções com tabelas e fontes.',
    cta: 'Ler guia executivo'
  }
];

const MAIS_RECURSOS = [
  { href: '/comparativos', label: 'Comparativos editoriais' },
  { href: '/glossario', label: 'Glossário técnico' },
  { href: '/regulacao', label: 'Regulação, CFP e SATEPSI' },
  { href: '/areas', label: 'Áreas reconhecidas' },
  { href: '/mbas', label: 'Os cinco MBAs cobertos' },
  { href: '/para-quem', label: 'Personas e trilhas' }
];

const ldCollection = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `${SITE.url}/recursos`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  hasPart: RECURSOS.map((r) => ({
    '@type': 'CreativeWork',
    name: r.title,
    url: `${SITE.url}${r.href}`
  }))
});

---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Recursos' }]} />
      <div class="mt-3 max-w-3xl">
        <span class="section-eyebrow">Recursos · decisão</span>
        <h1 class="section-h text-3xl sm:text-4xl">
          Decida com método, não com ranking.
        </h1>
        <p class="mt-3 text-ink-700">
          Escolher uma pós em Psicologia é menos sobre marca da instituição e
          mais sobre encaixe com o seu problema atual. Esta página reúne três
          ferramentas para sair da decisão por inércia: um quiz que mapeia
          perfil, um checklist que confronta pré-requisitos e um guia executivo
          que cobre lato sensu, MBA, modalidades, custo, regulação e ROI. Tudo
          editorial, independente, sem promessa de carreira nem reprodução de
          página de venda. Para matrícula e oferta vigente, o caminho oficial é
          <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="text-brand-700 underline decoration-sun-500 underline-offset-2 hover:text-brand-800">ipog.edu.br</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="grid md:grid-cols-3 gap-6">
      {RECURSOS.map((r) => (
        <a href={r.href} class="card-lift p-6 sm:p-7 flex flex-col">
          <span class="section-eyebrow">{r.eyebrow}</span>
          <h2 class="section-h text-xl mt-3">{r.title}</h2>
          <p class="mt-3 text-ink-700 text-sm leading-relaxed flex-1">{r.desc}</p>
          <span class="btn btn-ghost btn-sm mt-5 self-start">
            {r.cta} →
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-page pb-12">
    <div class="card bg-surface-50 border-surface-200 p-6 sm:p-8">
      <span class="section-eyebrow">Mais recursos</span>
      <h2 class="section-h text-xl mt-2">Outras páginas editoriais úteis na decisão</h2>
      <p class="mt-2 text-ink-700 text-sm">
        Conteúdo de apoio para aprofundar o que o quiz ou o guia indicarem.
      </p>
      <ul class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {MAIS_RECURSOS.map((m) => (
          <li>
            <a href={m.href} class="chip w-full justify-between">
              <span>{m.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-brand-800 text-white">
    <div class="container-page py-12 grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8">
        <span class="tag tag-dark uppercase">Caminho oficial</span>
        <h2 class="section-h text-white text-2xl sm:text-3xl mt-3">
          Os recursos te ajudam a decidir. A matrícula é no IPOG.
        </h2>
        <p class="mt-3 text-white/85 max-w-2xl">
          Este portal é independente e cobre cinco MBAs em Psicologia do IPOG.
          Grade vigente, calendário de turmas, valor e modalidade são tratados
          diretamente em ipog.edu.br. Recomenda-se decidir aqui e confirmar lá.
        </p>
      </div>
      <div class="lg:col-span-4 flex lg:justify-end">
        <a
          href={SITE.ipogOfficial}
          target="_blank"
          rel="noopener external"
          class="btn btn-primary btn-lg">
          Acessar ipog.edu.br ↗
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={ldCollection} />
</Base>
