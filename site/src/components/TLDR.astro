---
interface Props {
  resposta: string;
  fontes?: string[];
}
const { resposta, fontes = [] } = Astro.props;
---
<aside aria-label="Resposta curta — TL;DR" class="tldr my-6 rounded-2xl border border-brand-200 bg-brand-50/40 p-5 sm:p-6">
  <p class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-800 mb-2">
    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm1 12H9v-2h2v2Zm0-3.5H9V6h2v4.5Z"/></svg>
    Resposta curta
  </p>
  <p class="tldr-resposta max-w-prose text-base sm:text-lg text-ink-900 leading-relaxed font-medium text-pretty">{resposta}</p>
  {fontes.length > 0 && (
    <p class="mt-3 max-w-prose text-xs text-ink-600 text-pretty">
      <span class="font-semibold">Fonte:</span> {fontes.join(' · ')}
    </p>
  )}
</aside>
