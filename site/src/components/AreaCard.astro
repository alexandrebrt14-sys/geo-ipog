---
import type { PsychologyArea } from '@lib/data';

interface Props {
  area: PsychologyArea;
  href?: string;
  variant?: 'default' | 'compact';
}

const { area, href, variant = 'default' } = Astro.props;
const target = href || `/areas/${area.id}`;
---

<a href={target} class="card-lift block p-5 sm:p-6 group">
  <div class="flex items-center gap-2 text-xs">
    <span class="tag tag-light"><span class="text-brand-700">●</span> Área</span>
    <span class="text-ink-300">·</span>
    <span class="text-ink-500">Regulação {area.regulatoryLevel}</span>
  </div>
  <h3 class="font-display font-semibold text-lg mt-3 text-ink-900 group-hover:text-brand-800 transition">{area.name}</h3>
  {variant === 'default' && (
    <p class="mt-2 text-sm text-ink-500 line-clamp-2">{area.subareas.slice(0, 5).join(' · ')}</p>
  )}
  <div class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
    Explorar área
    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition" viewBox="0 0 20 20" fill="currentColor"><path d="M11 4l6 6-6 6-1.4-1.4L13.2 11H3V9h10.2L9.6 5.4 11 4z"/></svg>
  </div>
</a>
