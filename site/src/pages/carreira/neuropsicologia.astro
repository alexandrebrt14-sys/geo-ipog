---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Carreira em Neuropsicologia: formação, supervisão e planejamento",
  "description": "Planeje a trajetória em Neuropsicologia com critérios de competência, registro profissional, custos e portfólio educativo, sem promessas de salário.",
  "route": "/carreira/neuropsicologia/",
  "label": "Carreira em Neuropsicologia",
  "section": "Carreira",
  "sectionPath": "/carreira/",
  "faqs": [
    {
      "q": "O registro de especialista é obrigatório para exercer Psicologia?",
      "a": "O CFP informa que não. Ainda assim, a atuação exige competência e observância das normas, e o uso de título registrado depende do processo específico."
    },
    {
      "q": "Há salário garantido após uma pós em Neuropsicologia?",
      "a": "Não. Remuneração depende de vínculo, local, escopo, recursos e condições de trabalho. Esta página não usa faixas sem fonte para prever renda."
    },
    {
      "q": "O que pode entrar em um portfólio educativo?",
      "a": "Leituras críticas, comparações de formação e casos simulados. Não inclua prontuários, materiais protegidos de testes ou registros identificáveis de pacientes."
    }
  ],
  "worksheet": {
    "title": "Plano de desenvolvimento em Neuropsicologia",
    "description": "Relacione uma competência a recursos, evidências de progresso e dúvidas profissionais.",
    "fields": [
      {
        "label": "Competência prioritária",
        "hint": "Que tarefa profissional você precisa aprender a justificar?"
      },
      {
        "label": "Forma de acompanhamento",
        "hint": "Que supervisão ou feedback será necessário?"
      },
      {
        "label": "Recursos e custos",
        "hint": "Separe itens iniciais, recorrentes e ainda sem orçamento."
      },
      {
        "label": "Próxima decisão",
        "hint": "Que evidência falta antes de escolher curso ou serviço?"
      }
    ],
    "checklist": [
      "Delimitei a população de interesse.",
      "Separei competência e registro de especialista.",
      "Incluí custos além da mensalidade.",
      "Não baseei o plano em promessa de renda."
    ]
  },
  "sources": [
    [
      "CFP: registro de especialista e condições gerais",
      "https://site.cfp.org.br/servicos/titulo-de-especialista/"
    ],
    [
      "CFP: relatório de gestão 2025 e Resolução nº 17/2025",
      "https://site.cfp.org.br/wp-content/uploads/2026/06/relatorio_gestao_2025.pdf"
    ],
    [
      "SATEPSI: referências para avaliação psicológica",
      "https://satepsi.cfp.org.br/faq.cfm"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma psicóloga recém-formada quer trabalhar com avaliação de adultos. Ela compara duas pós e encontra uma promessa de consultório rentável em poucos meses. Para decidir, precisa de um mapa de competências, supervisão e recursos, além do valor da mensalidade.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>O planejamento da carreira começa pelas competências e pelos recursos disponíveis.</h2>
<p>A Neuropsicologia oferece possibilidades em serviços clínicos, hospitalares e outros contextos, conforme a demanda e a organização local. O ingresso não tem cronograma universal. Uma trajetória pode combinar estudo, prática compatível com a competência, supervisão e colaboração com equipes; concluir um curso não garante agenda, cargo ou remuneração.</p>
<p>Defina primeiro a população com que pretende trabalhar e as perguntas que deseja aprender a responder. Avaliação de crianças, adultos e pessoas idosas envolve desafios próprios. Uma formação ampla pode oferecer fundamentos, mas a decisão sobre aceitar uma demanda concreta exige reconhecer limites e buscar apoio quando necessário.</p></section>
<section><h2>Certificado, competência e registro de especialista</h2>
<p>O <a href="https://site.cfp.org.br/servicos/titulo-de-especialista/">CFP informa que o registro de especialista não é condição obrigatória para o exercício profissional</a>. Isso não dispensa competência técnica, inscrição profissional regular ou observância das normas. O título registrado exige processo próprio; uma pós não o concede automaticamente.</p>
<p>A Resolução CFP nº 23/2022 foi alterada pela nº 17/2025, incluindo a residência entre as possibilidades previstas para comprovação, conforme o <a href="https://site.cfp.org.br/wp-content/uploads/2026/06/relatorio_gestao_2025.pdf">relatório oficial do CFP de 2025</a>. Consulte o CRP sobre sua trajetória e documentação atual. Não reduza as possibilidades a uma única rota acadêmica anunciada por um curso.</p>
<p>Na divulgação profissional, descreva com precisão a formação concluída e a condição de registro. Evite anunciar experiência que ainda não possui. Em processos seletivos, verifique os requisitos específicos do edital ou da vaga, que podem ser diferentes das condições gerais de exercício.</p></section>
<section><h2>Um mapa de desenvolvimento sem prazo fictício</h2>
<div class="table-wrap"><table><thead><tr><th>Frente</th><th>Evidência de progresso</th><th>Pergunta de revisão</th></tr></thead><tbody>
<tr><td>Fundamentos</td><td>Leitura crítica e justificativa de decisões em casos simulados</td><td>Consigo explicar o limite de uma conclusão?</td></tr>
<tr><td>Prática acompanhada</td><td>Feedback documentado sobre atividades compatíveis com a formação</td><td>Que tipo de demanda ainda exige apoio?</td></tr>
<tr><td>Comunicação</td><td>Exercícios de integração, escrita e devolutiva com supervisão</td><td>A conclusão responde à pergunta do encaminhamento?</td></tr>
<tr><td>Organização do trabalho</td><td>Estimativa de recursos, tempo e responsabilidades</td><td>A atividade é viável sem reduzir etapas necessárias?</td></tr>
</tbody></table></div>
<p>O portfólio educativo pode conter resenhas de estudos, matrizes de comparação de formações e casos inteiramente simulados. Não publique protocolos de testes, registros de pacientes ou materiais protegidos para demonstrar experiência. A proteção da informação faz parte da competência, inclusive durante seleção e divulgação de trabalho.</p></section>
<section><h2>Como estimar o investimento</h2>
<p>Liste mensalidade, supervisão, deslocamentos, materiais, instrumentos e licenças, quando necessários. Inclua também tempo para estudo, integração das informações, escrita e devolutiva. O preço de uma sessão não descreve o custo de todo o processo de trabalho.</p>
<p>Solicite orçamentos atuais dos itens relevantes ao seu plano. Separe despesa inicial, custo recorrente e gasto por atividade. Não use uma faixa salarial sem fonte local, vínculo e data como previsão de retorno. Uma oportunidade assalariada, um contrato de prestação de serviços e uma clínica própria têm responsabilidades e custos diferentes.</p>
<p>No caso hipotético, a profissional pode comparar as duas pós pelo feedback sobre raciocínio e pela viabilidade do conjunto de despesas. Também pode perceber que precisa ajustar o público inicial ou priorizar supervisão. Esse planejamento permite uma escolha informada sem prometer velocidade ou renda.</p></section>
<section><h2>Escolha a próxima ação com uma lacuna concreta</h2>
<p>Se a dúvida é sobre métodos, estude o <a href="/areas/neuropsicologia/">escopo da Neuropsicologia</a>. Se a dificuldade é obter feedback sobre decisões, use os critérios de <a href="/guias/escolher-supervisor-clinico/">escolha de supervisão</a>. Se o interesse está em cuidado longitudinal, compare a formação em <a href="/areas/reabilitacao-neuropsicologica/">reabilitação</a>. Cada pergunta pede um recurso diferente.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/segundo-cerebro-agentes-pessoais">Segundo cérebro e agentes pessoais</a>, do portal de Alexandre Caramaschi, pode apoiar a organização de referências públicas, ementas e tarefas de estudo. Mantenha documentos clínicos fora dessa biblioteca de aprendizado.</p>
<p>Preencha a ficha com uma competência a desenvolver, a evidência que demonstrará progresso e os recursos necessários. Revise o plano quando mudar de público, serviço ou condição de trabalho; não o transforme em uma corrida para acumular certificados.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
