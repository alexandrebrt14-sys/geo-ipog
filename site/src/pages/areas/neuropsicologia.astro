---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Neuropsicologia: avaliação, formação e critérios para escolher uma pós",
  "description": "Entenda o escopo da Neuropsicologia, as normas atuais de avaliação e como comparar formação, supervisão e instrumentos com uma ficha prática.",
  "route": "/areas/neuropsicologia/",
  "label": "Neuropsicologia",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "Uma pós concede automaticamente registro de especialista?",
      "a": "Não. A conclusão acadêmica e o registro no conselho são processos distintos. Confirme com o CRP a documentação aplicável à sua trajetória."
    },
    {
      "q": "Todo encaminhamento exige a mesma bateria?",
      "a": "Não. O planejamento depende da pergunta, da pessoa e das condições de avaliação. A seleção precisa ser justificada pelo profissional responsável."
    },
    {
      "q": "Como usar a ficha desta página?",
      "a": "Compare ementas, supervisão e custos de formação. Registre somente informações públicas ou fictícias, sem dados de pacientes."
    }
  ],
  "worksheet": {
    "title": "Comparador de formação em Neuropsicologia",
    "description": "Documente critérios e dúvidas antes de escolher uma formação.",
    "fields": [
      {
        "label": "População e demanda",
        "hint": "Qual público e pergunta profissional a formação precisa atender?"
      },
      {
        "label": "Evidências de supervisão",
        "hint": "Registre formato e feedback descritos na proposta pública."
      },
      {
        "label": "Recursos e custos",
        "hint": "Liste instrumentos, licenças e atividades que precisam de confirmação."
      },
      {
        "label": "Dúvidas para a instituição",
        "hint": "Anote o que falta para comparar as propostas."
      }
    ],
    "checklist": [
      "Conferi a ementa para a população pretendida.",
      "Identifiquei como ocorre o feedback sobre casos simulados.",
      "Separei certificado acadêmico de registro profissional.",
      "Registrei os custos que ainda precisam de orçamento."
    ]
  },
  "sources": [
    [
      "SATEPSI: dúvidas frequentes e avaliação psicológica",
      "https://satepsi.cfp.org.br/faq.cfm"
    ],
    [
      "CFP: registro de especialista",
      "https://site.cfp.org.br/servicos/titulo-de-especialista/"
    ],
    [
      "CFP: relatório de gestão 2025, alteração pela Resolução nº 17/2025",
      "https://site.cfp.org.br/wp-content/uploads/2026/06/relatorio_gestao_2025.pdf"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Em um caso hipotético, uma psicóloga recebe encaminhamento por queixa de memória e encontra ofertas de cursos centradas em listas de testes. A decisão de formação começa antes da compra: que perguntas clínicas ela precisa aprender a responder e em quais populações poderá fazê-lo com competência?</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A pergunta clínica organiza a avaliação neuropsicológica.</h2>
<p>A Neuropsicologia investiga relações entre funcionamento cognitivo, comportamento e vida cotidiana. Seu valor aparece quando a conclusão esclarece uma demanda: compreender uma dificuldade, apoiar decisões de cuidado ou orientar adaptações. Um resultado isolado não explica toda a trajetória de uma pessoa. Escolaridade, língua, condições de aplicação e contexto precisam entrar no raciocínio.</p>
<p>Para comparar formações, peça um exemplo anonimizado ou simulado do percurso entre encaminhamento, escolha de métodos, integração dos achados e devolutiva. A instituição deve explicar como o aluno recebe feedback sobre esse raciocínio. Uma demonstração comercial de instrumento revela pouco sobre a capacidade de integrar informações contraditórias.</p></section>
<section><h2>Normas e instrumentos: verifique o requisito exato</h2>
<p>A <a href="https://satepsi.cfp.org.br/faq.cfm">orientação oficial do SATEPSI</a> remete à Resolução CFP nº 31/2022 para avaliação psicológica. Consulte a situação do teste, a população e o formato autorizado antes do uso. Aprovação informatizada não equivale automaticamente à aplicação remota.</p>
<p>O <a href="https://site.cfp.org.br/servicos/titulo-de-especialista/">registro de especialista no CFP</a> segue a Resolução nº 23/2022, alterada pela nº 17/2025. Certificado acadêmico e registro profissional são etapas diferentes. Confira no CRP os documentos exigidos para a sua trajetória; a apresentação de um curso como “reconhecido” deve identificar quem reconhece e para qual finalidade.</p>
<p>Ao avaliar uma plataforma digital, solicite informação sobre permissões, armazenamento, exportação e acesso aos registros. Um relatório automático continua exigindo interpretação profissional. Dados identificáveis de pacientes não devem ser usados em exercícios abertos de IA ou em uma demonstração comercial sem as condições apropriadas de proteção e autorização.</p></section>
<section><h2>Como comparar duas propostas de formação</h2>
<div class="table-wrap"><table><thead><tr><th>Critério</th><th>Evidência a solicitar</th><th>Decisão que permite</th></tr></thead><tbody>
<tr><td>Público atendido</td><td>Ementas e casos de adultos, crianças ou pessoas idosas</td><td>Verificar correspondência com a população em que você pretende atuar</td></tr>
<tr><td>Supervisão</td><td>Formato, qualificação do supervisor e tipo de feedback</td><td>Distinguir discussão de caso de mera exposição de slides</td></tr>
<tr><td>Integração clínica</td><td>Atividade que articule entrevista, observação e resultados</td><td>Avaliar se o aluno precisa justificar conclusões e limites</td></tr>
<tr><td>Condições materiais</td><td>Custos de instrumentos, licenças, deslocamentos e prática</td><td>Calcular o investimento completo, além da mensalidade</td></tr>
</tbody></table></div>
<p>Se uma resposta depender de informação que não está publicada, registre a lacuna e peça esclarecimento escrito. Ausência de prova não demonstra que o curso é ruim; impede uma comparação segura naquele item. Não transforme reputação, número de seguidores ou um selo sem explicação em substituto da documentação.</p></section>
<section><h2>Do estudo ao trabalho em equipe</h2>
<p>No caso hipotético de abertura, a profissional pode começar delimitando a queixa e discutindo sua competência para aquele atendimento com supervisão. A conclusão pode indicar necessidade de informação adicional ou de interlocução com outra profissão. Não há obrigação de chegar a um diagnóstico em todo encaminhamento, nem garantia de que uma bateria extensa produzirá resposta mais útil.</p>
<p>O encaminhamento para <a href="/areas/reabilitacao-neuropsicologica/">reabilitação neuropsicológica</a> exige objetivos de cuidado próprios. Para suspeita de autismo, o <a href="/guias/avaliacao-tea-adulto/">guia de avaliação de TEA em adultos</a> ajuda a distinguir triagem, avaliação e comunicação dos resultados. Essas demandas não se resolvem por um pacote único de testes.</p></section>
<section id="leitura-relacionada-neuro"><h2>Leituras para qualificar suas perguntas</h2>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/eeat-qualidade">E-E-A-T e qualidade, no portal educacional de Alexandre Caramaschi</a>, pode apoiar a checagem de autoria e evidências em materiais de formação. É complemento de leitura crítica, sem equivalência a treinamento clínico.</p>
<p>Para a experiência de quem procura atendimento, veja a <a href="https://larissacaramaschi.com/trilhas/suspeita-tea-adultos/orientacao-diagnostica">leitura sobre orientação diagnóstica de adultos no portal de Larissa Caramaschi</a>. Use-a para levantar perguntas ao serviço. A duração, a composição da equipe e o custo precisam ser confirmados individualmente; esse texto complementar não estabelece requisitos universais.</p>
<p>Retome agora as duas formações que está considerando e preencha a ficha com informações públicas e dúvidas pendentes. Ela organiza sua decisão educacional, sem registrar casos de pacientes.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
