---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';

const carreiras = [
  {
    id: 'psicologia-organizacional',
    name: 'Psicologia Organizacional',
    tag: 'Cultura, liderança, NR-1',
    description: 'Trilha clássica de quem move de Psicólogo Júnior para Diretor de Pessoas. Lê sistema antes de indivíduo. Mistura ciência comportamental com vocabulário de negócio.',
    salaryRange: 'R$ 4-7k júnior · R$ 18-35k+ sênior',
    progression: 'Analista R&S/T&D → Business Partner → Head de DHO → VP de Pessoas'
  },
  {
    id: 'neuropsicologia',
    name: 'Neuropsicologia',
    tag: 'Avaliação cognitiva, laudo, supervisão',
    description: 'Especialidade mais técnica e mais regulada da Psicologia aplicada. Exige hora-aula supervisionada acima da média e integração com equipe médica.',
    salaryRange: 'R$ 5-8k júnior · R$ 25-50k+ sênior',
    progression: 'Estagiário em serviço → Neuropsicólogo clínico → Coordenador → Pesquisador docente'
  },
  {
    id: 'saude-mental-corporativa',
    name: 'Saúde mental corporativa',
    tag: 'NR-1, prevenção, ESG',
    description: 'Carreira nascida nos últimos cinco anos. Desenho de sistema de prevenção e cuidado em escala — não clínica em escritório de empresa.',
    salaryRange: 'R$ 5-8k júnior · R$ 20-35k+ sênior',
    progression: 'Analista de QV/SST → Coordenador de bem-estar → Head de SST → Diretor de ESG'
  },
  {
    id: 'avaliacao-psicologica',
    name: 'Avaliação psicológica',
    tag: 'SATEPSI, laudo, ética',
    description: 'Especialidade mais sensível a ética e contexto. Quem confunde regra com técnica vira processo no CRP. Quem domina o conjunto define o padrão da praça.',
    salaryRange: 'R$ 500-2.500 por avaliação · R$ 5-15k CLT pleno',
    progression: 'Clínico que adiciona aval. → Avaliador em seleção → Perito → Coordenador técnico'
  },
  {
    id: 'pericia-psicologica',
    name: 'Perícia psicológica',
    tag: 'Forense, contraditório, audiência',
    description: 'Especialidade de quem tolera contraditório jurídico. Quem não suporta defesa pública de laudo, sofre. Quem domina, vira referência regional.',
    salaryRange: 'R$ 1.000-5.000+ por perícia',
    progression: 'Avaliador → Perito assistente → Perito do juízo → Coordenador técnico em vara'
  },
  {
    id: 'consultoria-organizacional',
    name: 'Consultoria organizacional',
    tag: 'Framework, vendas, marca',
    description: 'Trilha de saída do CLT que falha com mais frequência. Quem sai sem retaguarda teórica vende o que aprendeu em workshop. Quem sai com método, escala.',
    salaryRange: 'R$ 250-2.000 por hora · projeto comissionado',
    progression: 'Psicólogo interno → Consultor associado → Independente → Sócio de boutique'
  }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Carreira em Psicologia aplicada — trajetórias por área de atuação',
  description: 'Mapeamento das seis carreiras mais demandadas em Psicologia aplicada: faixa salarial, progressão e MBA que combina com cada trilha.',
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
  inLanguage: 'pt-BR'
};
---

<Base
  title="Carreira em Psicologia aplicada — trajetórias por área de atuação"
  description="Mapa das seis carreiras mais demandadas em Psicologia aplicada. Faixa salarial, progressão típica e MBA que combina com cada trilha.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Carreira' }
      ]} />
      <span class="section-eyebrow mt-3">Carreira · Trajetórias profissionais · Faixa salarial · MBA combinado</span>
      <h1 class="section-h text-3xl sm:text-4xl">Carreira em Psicologia aplicada — trajetórias por área de atuação</h1>
      <p class="mt-3 text-ink-700 text-lg max-w-3xl">
        Seis carreiras, seis lógicas distintas de progressão. Quem confunde uma trilha com outra perde anos. Quem entende o mapa decide melhor.
      </p>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          Carreira em Psicologia aplicada não é linear. Existem seis trilhas com regras distintas — três corporativas (Organizacional, Saúde Mental, Consultoria) e três técnicas reguladas (Neuropsicologia, Avaliação, Perícia). Cada uma tem progressão, faixa salarial e formação combinada própria. Confundir as regras de uma com outra é o erro mais comum em transição de carreira.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Por que a carreira em Psicologia aplicada é não linear</h2>
        <p>
          A formação base do psicólogo é generalista por desenho do CFP — cinco anos de graduação que tocam clínica, organizacional, social, escolar e hospitalar. O choque acontece na saída: o mercado não contrata generalistas, contrata recortes. O profissional descobre, em geral entre o terceiro e o sétimo ano de prática, que precisa decidir um nicho. Sem decisão de nicho, a carreira estagna em torno de R$ 6 a 8 mil mensais — o teto histórico do psicólogo médio brasileiro segundo os levantamentos do CFP (CFP, 2022).
        </p>
        <p>
          A inversão necessária: escolher carreira é escolher conjunto de regras, não tema favorito. Carreira em avaliação psicológica é regida pelo SATEPSI e pelas resoluções do CFP — qualquer movimento depende de domínio dessa regulação. Carreira corporativa é regida por vocabulário de negócio, indicadores e ciclo de planejamento da empresa — o profissional que não aprende OKR, OPEX e RH analytics fica preso na função técnica. Carreira em consultoria é regida pelo mercado de venda consultiva — sem framework próprio e marca pessoal, o consultor vira freelancer mal pago. Em 2026 essa marca também precisa ser legível para os motores de IA, e o guia sobre <a href="https://alexandrecaramaschi.com/insights/personal-branding-ia" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">como consultores e especialistas passam a ser citados por ChatGPT e Gemini</a> descreve esse caminho em cinco etapas.
        </p>
        <p>
          Cada uma das seis trilhas abaixo tem progressão típica, faixa salarial e formação combinada distintas. Escolher uma exige olhar para a regra do jogo, não só para o tema. A leitura abaixo cobre as seis com a mesma estrutura: tese contraintuitiva, trajetória, competências, mini-caso e formação relacionada.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">As seis trilhas mapeadas</h2>
        <p class="text-ink-700 mt-2">
          Cada card abaixo abre uma análise completa da trilha. Salários são faixas observadas em portais públicos como referência inicial — confirme com pesquisa salarial setorial atualizada antes de decidir migração.
        </p>
        <div class="grid sm:grid-cols-2 gap-5 mt-6">
          {carreiras.map((c, i) => (
            <a href={`/carreira/${c.id}`} class="card card-lift card-shine reveal p-6 hover:border-brand-300 transition-colors group" data-reveal-delay={i * 50}>
              <p class="text-xs uppercase tracking-wider text-brand-700 font-semibold">{c.tag}</p>
              <h3 class="font-display font-semibold text-lg text-ink-900 mt-1 group-hover:text-brand-800">{c.name}</h3>
              <p class="text-sm text-ink-700 mt-2 leading-relaxed">{c.description}</p>
              <div class="mt-4 pt-4 border-t border-surface-200 space-y-2">
                <p class="text-xs text-ink-500 font-semibold uppercase tracking-wider">Faixa salarial</p>
                <p class="text-sm text-ink-900 font-medium">{c.salaryRange}</p>
                <p class="text-xs text-ink-500 font-semibold uppercase tracking-wider mt-2">Progressão típica</p>
                <p class="text-sm text-ink-700">{c.progression}</p>
              </div>
              <p class="mt-4 text-sm text-brand-700 font-medium">Ler análise completa →</p>
            </a>
          ))}
        </div>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Três regras que valem para todas as trilhas</h2>
        <p>
          Primeira regra: a transição custa tempo, não só dinheiro. Migrar de clínica para organizacional, ou de organizacional para consultoria, leva entre dois e quatro anos de exposição e construção de portfólio. O MBA acelera, não substitui esse tempo. Quem espera curto-prazo se frustra e abandona a transição no meio.
        </p>
        <p>
          Segunda regra: profissional sem produção pública estagna. Independente da trilha, quem não publica caso, artigo, palestra ou laudo modelo perde para quem publica. O ciclo de carreira em Psicologia aplicada é cada vez mais influenciado por visibilidade técnica — o profissional que documenta seu trabalho cresce três a quatro vezes mais rápido que o que apenas executa.
        </p>
        <p>
          Terceira regra: especialização vence generalismo após o quinto ano. O profissional generalista é útil até o sexto ano. A partir daí, o mercado paga para quem é referência num recorte. O MBA do IPOG ajuda a definir esse recorte porque organiza a teoria em torno de uma área de atuação concreta — POT, Positiva, Neuro, Liderança ou Neurociência aplicada.
        </p>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese</p>
        <h3 class="font-display font-semibold text-xl">Carreira é decisão sobre conjunto de regras, não sobre tema favorito</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          O profissional que escolhe trilha sem ler as regras do jogo perde anos. Cada análise abaixo cobre uma trilha com a mesma estrutura: tese contraintuitiva, progressão típica, competências diferenciais, mini-caso e formação combinada. O IPOG mantém cinco MBAs Ao Vivo síncronos cobrindo as principais trilhas — relevante para profissional ativo que precisa cursar enquanto trabalha.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-sun">Ver MBAs no IPOG</a>
          <a href="/mbas" class="btn btn-ghost text-white border-white/30 hover:bg-white/10">Comparar MBAs do IPOG</a>
        </div>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">IPOG · Pós-graduação</h3>
        <p class="text-sm text-ink-700 mt-2">
          Cinco MBAs do IPOG cobrem as três trilhas corporativas e a trilha neuro. Avaliação e perícia são tratadas em especializações curtas. Formato Ao Vivo síncrono.
        </p>
        <p class="text-xs text-ink-500 mt-2 italic">Portal independente. Não é o site oficial do IPOG.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Áreas relacionadas</p>
        <ul class="space-y-1">
          <li><a href="/areas/psicologia-organizacional-trabalho" class="mega-link"><strong class="text-ink-900 text-sm">Psicologia Organizacional e do Trabalho</strong></a></li>
          <li><a href="/areas/neuropsicologia" class="mega-link"><strong class="text-ink-900 text-sm">Neuropsicologia</strong></a></li>
          <li><a href="/areas/saude-mental-organizacoes" class="mega-link"><strong class="text-ink-900 text-sm">Saúde Mental nas Organizações</strong></a></li>
          <li><a href="/areas/avaliacao-psicologica" class="mega-link"><strong class="text-ink-900 text-sm">Avaliação Psicológica</strong></a></li>
          <li><a href="/areas/psicologia-juridica-forense" class="mega-link"><strong class="text-ink-900 text-sm">Psicologia Jurídica e Forense</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Para quem</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/para-quem/psicologos" class="text-brand-700 hover:text-brand-800 font-medium">Psicólogos em transição</a></li>
          <li><a href="/para-quem/rh" class="text-brand-700 hover:text-brand-800 font-medium">Profissionais de RH</a></li>
          <li><a href="/para-quem/lideres" class="text-brand-700 hover:text-brand-800 font-medium">Líderes e executivos</a></li>
          <li><a href="/para-quem/consultores" class="text-brand-700 hover:text-brand-800 font-medium">Consultores</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
</Base>
