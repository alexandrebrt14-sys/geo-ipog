---
import Base from '@layouts/Base.astro';

const title = 'Você está offline · posgraduacaopsicologia.com';
const description = 'Sem conexão no momento. Tente novamente quando a internet voltar ou navegue pelo conteúdo já visitado.';
---

<Base title={title} description={description} noindex={true} showSearchInHeader={false}>
  <section class="container-page py-16 sm:py-24">
    <div class="max-w-2xl mx-auto text-center">
      <span class="section-eyebrow">Conexão indisponível</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Você está offline</h1>
      <p class="mt-4 text-ink-700 text-lg leading-relaxed">
        Não foi possível carregar esta página porque o seu dispositivo está sem
        conexão com a internet. Assim que a rede voltar, você pode tentar de novo —
        as páginas que você já visitou continuam acessíveis.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <button id="offline-retry" type="button" class="btn-primary">
          Tentar novamente
        </button>
        <a href="/" class="btn-ghost">Voltar para a página inicial</a>
      </div>

      <div class="card text-left p-6 mt-12">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-3">
          Enquanto isso, explore
        </p>
        <ul class="space-y-2 text-ink-700">
          <li>
            <a href="/areas/" class="font-semibold text-brand-800 hover:underline underline-offset-2">Áreas da Psicologia</a>
            — campos de atuação e especialização.
          </li>
          <li>
            <a href="/mbas/" class="font-semibold text-brand-800 hover:underline underline-offset-2">MBAs e pós-graduações</a>
            — modalidades e programas em destaque.
          </li>
          <li>
            <a href="/busca/" class="font-semibold text-brand-800 hover:underline underline-offset-2">Busca no portal</a>
            — encontre áreas, temas e termos do glossário.
          </li>
        </ul>
        <p class="mt-4 text-sm text-ink-500">
          Algumas seções podem não abrir offline caso você ainda não as tenha visitado.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('offline-retry');
      if (btn) {
        btn.addEventListener('click', function () { location.reload(); });
      }
      // Recarrega automaticamente quando a conexão voltar.
      window.addEventListener('online', function () { location.reload(); });
    })();
  </script>
</Base>
