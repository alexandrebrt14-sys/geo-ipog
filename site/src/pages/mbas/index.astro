---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { MBAS, SITE, AREAS } from '@lib/data';

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: MBAS.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.name,
    url: `${SITE.url}/mbas/${m.id}`
  }))
});
---
<Base
  title="MBAs e pós-graduações em Psicologia — guia independente IPOG"
  description="Os 5 MBAs em destaque do IPOG (POT, Positiva, Reabilitação Neuro, Neurociência, Liderança) com perfis recomendados, competências desenvolvidas e páginas detalhe.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Cursos IPOG</span>
          <h1 class="section-h text-3xl sm:text-4xl">MBAs e pós-graduações em Psicologia.</h1>
          <p class="mt-2 text-ink-700">
            Cinco MBAs em destaque do portfólio IPOG mais pós-graduações correlatas em áreas técnicas reguladas.
            Para grade, valor, modalidade e turma vigentes, sempre consulte
            <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">ipog.edu.br</a>.
          </p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver todos no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="grid md:grid-cols-2 gap-4">
      {MBAS.map(m => (
        <article id={m.id} class="card-lift p-6 scroll-mt-24">
          <div class="flex items-start gap-3 mb-3">
            <span class="tag"><span class="text-brand-700">●</span> {m.tag}</span>
          </div>
          <h3 class="font-display font-semibold text-xl text-ink-900">
            <a href={`/mbas/${m.id}`} class="hover:text-brand-700 transition">{m.name}</a>
          </h3>
          <p class="mt-3 text-sm text-ink-500">{m.description}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {m.topics.slice(0, 6).map(t => (
              <li class="text-[11px] px-2.5 py-1 rounded-full bg-brand-50 text-brand-700 font-medium">{t}</li>
            ))}
          </ul>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-surface-200">
            <div class="text-xs text-ink-500">
              Para: <span class="font-medium text-ink-700">{m.personas.join(' · ')}</span>
            </div>
            <div class="flex items-center gap-2">
              <a href={`/mbas/${m.id}`} class="btn btn-primary btn-sm">
                Ler análise completa
              </a>
              <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary btn-sm">
                IPOG
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 rounded-2xl bg-brand-800 text-white p-6 sm:p-8">
      <span class="tag bg-sun-500/20 text-sun-400 mb-3"><span class="w-1.5 h-1.5 rounded-full bg-sun-500"></span> Pós-graduações complementares</span>
      <h2 class="font-display font-semibold text-2xl">Áreas técnicas e regulamentadas</h2>
      <p class="mt-2 text-white/75 text-sm sm:text-base">Conteúdo informacional sobre Neuropsicologia, Avaliação Psicológica, Perícia Forense e ABA/TEA. Inscrições vigentes em ipog.edu.br.</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {['neuropsicologia', 'avaliacao-psicologica', 'psicologia-juridica-forense', 'aba-tea-neurodesenvolvimento'].map(slug => {
          const a = AREAS.find(x => x.id === slug);
          return a && <a href={`/areas/${a.id}`} class="px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-sm font-medium transition">{a.short}</a>;
        })}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={ld} />
</Base>
