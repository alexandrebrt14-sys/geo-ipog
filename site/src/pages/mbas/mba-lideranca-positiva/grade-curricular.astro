---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS } from '@lib/data';

const mba = MBAS.find(m => m.id === 'mba-lideranca-positiva')!;
const others = MBAS.filter(m => m.id !== 'mba-lideranca-positiva');

const title = 'Grade curricular do MBA em Gestão de Pessoas e Liderança Positiva — eixos esperados';
const description = 'Eixos disciplinares típicos de um MBA em Liderança Positiva: people-first, cultura, segurança psicológica, gestão por significado, performance saudável. Grade vigente em ipog.edu.br.';

const FAQS_PAGINA = [
  {
    q: 'Qual a diferença entre liderança positiva e liderança tradicional?',
    a: 'Liderança tradicional centra-se em metas, controle e correção de desempenho. Liderança positiva — proposta originalmente por Kim Cameron (2008) na Positive Organizational Scholarship — sustenta que ambientes que cultivam virtudes organizacionais, conexões de alta qualidade (Dutton, 2003), segurança psicológica (Edmondson, 2019) e propósito sustentado entregam performance superior de forma mais sustentável. Não é liderança permissiva ou apenas afetuosa: é liderança que reconhece o substrato psicológico da produtividade e opera com indicadores específicos. A grade vigente do programa do IPOG está em ipog.edu.br.'
  },
  {
    q: 'A grade aborda inteligência emocional e gestão de conflito?',
    a: 'Sim. Inteligência emocional (Goleman, 1995, 2002) é um dos eixos clássicos em programas de liderança positiva, geralmente conectado à neurobiologia da regulação emocional e à prática de conversas difíceis. Gestão de conflito aparece tanto na dimensão técnica (mediação, negociação) quanto na dimensão cultural (como ambientes de alta segurança psicológica produzem conflito construtivo de qualidade superior). Ementa específica em ipog.edu.br.'
  },
  {
    q: 'É diferente da grade de um MBA em POT?',
    a: 'Sim. O MBA em POT é mais amplo, cobrindo cultura, NR-1, people analytics, gestão de talentos e mudança como sistema integrado. O MBA em Gestão de Pessoas e Liderança Positiva concentra peso maior em liderança como objeto principal, com mergulho em Cameron, Dutton, Edmondson, Goleman e literatura de positive leadership. Profissionais que querem liderar pessoas com base científica tendem a escolher Liderança Positiva; quem quer ler organização como sistema completo tende a escolher POT. Os dois programas se complementam para perfis muito seniores.'
  }
];

const ldProgram = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  name: `${mba.name} — Grade curricular`,
  programType: 'MBA',
  educationalProgramMode: 'online (Ao Vivo síncrono conforme IPOG)',
  occupationalCategory: 'Líder executivo, Gestor de pessoas, Consultor em liderança',
  description: 'Eixos disciplinares esperados em MBA em Gestão de Pessoas e Liderança Positiva.',
  provider: { '@type': 'EducationalOrganization', name: 'IPOG — Instituto de Pós-Graduação', url: 'https://ipog.edu.br/' }
});

const ldBreadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'MBAs', item: `${SITE.url}/mbas` },
    { '@type': 'ListItem', position: 3, name: mba.shortName, item: `${SITE.url}/mbas/${mba.id}` },
    { '@type': 'ListItem', position: 4, name: 'Grade curricular', item: `${SITE.url}/mbas/${mba.id}/grade-curricular` }
  ]
});

const ldFaq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_PAGINA.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs', href: '/mbas' }, { label: mba.shortName, href: `/mbas/${mba.id}` }, { label: 'Grade curricular' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">MBA · {mba.tag}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Grade curricular esperada em um MBA em Liderança Positiva</h1>
          <p class="mt-2 text-ink-700">Leitura editorial dos eixos disciplinares típicos: liderança positiva, segurança psicológica, gestão por significado, performance saudável, inteligência emocional. Para a grade vigente do programa do IPOG, consulte o portal oficial.</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver grade vigente no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Resposta rápida</p>
        <p class="text-ink-900 font-medium leading-relaxed">Grade típica organiza 9 a 11 eixos: fundamentos de liderança contemporânea, liderança positiva e POS, segurança psicológica, inteligência emocional, gestão por significado, conversas difíceis, equipes de alta performance, cultura people-first, gestão de mudança, ética. Carga típica 432-560h em 18-24 meses. Grade vigente no portal oficial do IPOG.</p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Por que liderança virou objeto formal de pós-graduação</h2>
        <p>Existe uma narrativa antiga que sustenta que liderança não se ensina, se desenvolve. A narrativa não está totalmente errada — desenvolvimento de líder é tema clássico de aprendizagem experiencial. Mas a literatura recente reorganizou o quadro. Estudos longitudinais demonstram que comportamentos de liderança específicos, identificáveis e treináveis predizem variação significativa em engajamento, retenção e performance de equipes (Cameron, 2008; Edmondson, 2019). A consequência é que liderança virou objeto formal de pós-graduação executiva, com taxonomia, evidência e prática supervisionada.</p>
        <p>Uma grade séria nesse campo precisa atender três exigências. Primeiro: presença de autores fundadores do movimento de liderança positiva (Cameron, Dutton, Quinn, Spreitzer, Edmondson, Goleman). Segundo: integração com literatura de psicologia positiva e neurociência afetiva — uma liderança positiva moderna não se confunde com gerenciamento afetuoso, ela tem substrato científico. Terceiro: aplicação supervisionada — exercício real de conversas difíceis, mediação, feedback construtivo, gestão de conflito.</p>
        <p>Esta página descreve o que esperar tecnicamente de uma grade contemporânea de MBA em Liderança Positiva, sem reproduzir documento oficial. Para a grade vigente do programa do IPOG, com disciplinas, ementas e nominata de docentes, consulte ipog.edu.br.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Eixos disciplinares esperados</h2>
        <ol class="space-y-3">
          <li class="card p-5"><strong class="text-brand-800">1. Fundamentos de liderança contemporânea.</strong> Evolução do conceito, modelos clássicos vs contemporâneos, transição comando-controle → líder-coach → líder-servidor → liderança positiva.</li>
          <li class="card p-5"><strong class="text-brand-800">2. Liderança positiva e Positive Organizational Scholarship.</strong> Cameron (2008), virtudes organizacionais, foco em forças, conexões de alta qualidade (Dutton, 2003).</li>
          <li class="card p-5"><strong class="text-brand-800">3. Segurança psicológica como prática gerencial.</strong> Edmondson (1999, 2019), medida e construção, conexão com inovação e aprendizagem organizacional.</li>
          <li class="card p-5"><strong class="text-brand-800">4. Inteligência emocional aplicada.</strong> Goleman (1995, 2002), autoconhecimento, autogestão, consciência social, gestão de relacionamentos, base neurobiológica.</li>
          <li class="card p-5"><strong class="text-brand-800">5. Gestão por significado e propósito.</strong> Frankl, Csikszentmihalyi, gestão articulada ao propósito individual e coletivo, motivação intrínseca (Deci & Ryan).</li>
          <li class="card p-5"><strong class="text-brand-800">6. Conversas difíceis e comunicação organizacional.</strong> Feedback construtivo, comunicação de mudança, demissão humanizada, mediação de conflito.</li>
          <li class="card p-5"><strong class="text-brand-800">7. Equipes de alta performance.</strong> Lencioni, Edmondson, modelos de equipe em ambiente complexo, dinâmica de grupo, alinhamento.</li>
          <li class="card p-5"><strong class="text-brand-800">8. Cultura people-first.</strong> Desenho cultural, ESG na dimensão social, ambiente de cuidado articulado a performance.</li>
          <li class="card p-5"><strong class="text-brand-800">9. Performance sustentável e prevenção de burnout.</strong> Karasek, Maslach, equilíbrio carga-recurso, ciclos de carga e recuperação.</li>
          <li class="card p-5"><strong class="text-brand-800">10. Gestão de mudança liderada.</strong> Modelos de Kotter e correlatos, leitura de poder, sponsorship, comunicação em escala.</li>
          <li class="card p-5"><strong class="text-brand-800">11. Ética, regulação e atuação responsável.</strong> Limites do líder, ética em uso de dados de pessoas, LGPD, regulação brasileira de saúde mental no trabalho.</li>
        </ol>
        <p class="text-sm text-ink-600 mt-4">Ordem e nomes formais variam por edição. Grade vigente em ipog.edu.br.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Distribuição típica de carga horária</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-surface-200 rounded-lg overflow-hidden">
            <thead class="bg-surface-50 text-ink-700">
              <tr>
                <th class="text-left p-3 border-b border-surface-200">Bloco</th>
                <th class="text-left p-3 border-b border-surface-200">Conteúdo dominante</th>
                <th class="text-left p-3 border-b border-surface-200">Carga esperada</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3 align-top font-medium">Fundamentos de liderança</td><td class="p-3 align-top">Evolução do campo, modelos contemporâneos</td><td class="p-3 align-top">48-64h</td></tr>
              <tr><td class="p-3 align-top font-medium">Liderança positiva e POS</td><td class="p-3 align-top">Cameron, Dutton, virtudes organizacionais</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Segurança psicológica</td><td class="p-3 align-top">Edmondson, prática gerencial</td><td class="p-3 align-top">32-48h</td></tr>
              <tr><td class="p-3 align-top font-medium">Inteligência emocional</td><td class="p-3 align-top">Goleman, regulação afetiva</td><td class="p-3 align-top">48-64h</td></tr>
              <tr><td class="p-3 align-top font-medium">Comunicação e conflito</td><td class="p-3 align-top">Conversas difíceis, feedback, mediação</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Equipes e cultura</td><td class="p-3 align-top">Alta performance, cultura people-first</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Performance saudável</td><td class="p-3 align-top">Burnout, ciclos, sustentabilidade</td><td class="p-3 align-top">32-48h</td></tr>
              <tr><td class="p-3 align-top font-medium">Metodologia e TCC</td><td class="p-3 align-top">Projeto aplicado, orientação, defesa</td><td class="p-3 align-top">40-80h</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-ink-600 mt-3">Total típico 432-560h. Mínimo regulatório de 360h para lato sensu (CNE/CES 01/2018).</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">TCC e projeto aplicado</h2>
        <p class="text-ink-700">Em MBA de Liderança Positiva, o TCC tipicamente assume três formatos.</p>
        <div class="grid sm:grid-cols-3 gap-4 mt-4">
          <div class="card p-5"><p class="font-semibold text-brand-800">Programa de desenvolvimento de liderança</p><p class="text-sm text-ink-700 mt-2">Desenho de programa institucional para desenvolver lideranças intermediárias ou seniores, com indicadores próprios de efeito.</p></div>
          <div class="card p-5"><p class="font-semibold text-brand-800">Diagnóstico de cultura de liderança</p><p class="text-sm text-ink-700 mt-2">Aplicação de instrumentos (segurança psicológica, conexões de alta qualidade, engajamento) em organização real, análise por liderança, plano de intervenção.</p></div>
          <div class="card p-5"><p class="font-semibold text-brand-800">Paper analítico</p><p class="text-sm text-ink-700 mt-2">Revisão crítica de literatura aplicada a problema executivo específico, com proposta de intervenção fundamentada.</p></div>
        </div>
      </div>

      <div class="rounded-2xl border-l-4 border-sun-500 bg-sun-50/40 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · TCC aplicado a desenvolvimento de lideranças</p>
        <p class="text-ink-900 leading-relaxed">Um head de RH em uma empresa de tecnologia com cerca de quatrocentos colaboradores escolheu como TCC um programa de doze semanas para lideranças intermediárias. Aplicou Team Psychological Safety Scale (Edmondson, 1999) em 38 equipes antes do programa e identificou que as cinco equipes com pior score tinham em comum supervisão punitiva e ausência de ritual de feedback estruturado. Desenhou intervenção com três módulos: prática de feedback construtivo (Goleman), construção de segurança psicológica em micro-rituais (Edmondson) e conversas difíceis (Stone, Patton, Heen). Em catorze semanas, reaplicou a escala. Os scores de segurança psicológica subiram significativamente, e o turnover voluntário das cinco equipes-piloto caiu sensivelmente nos seis meses seguintes. O programa virou política institucional. O ganho real foi metodológico — ele passou a operar liderança com diagnóstico, indicador e intervenção fundamentada.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
          {FAQS_PAGINA.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-ink-900">
                <span>{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
        <h2 class="font-display font-bold text-2xl">Síntese e próximo passo</h2>
        <ul class="mt-4 space-y-2 text-white/85 text-sm">
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Grade contemporânea precisa de Cameron, Dutton, Edmondson, Goleman e integração com psicologia positiva e neurociência.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>9 a 11 eixos típicos, carga 432-560h em 18-24 meses.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>TCC ideal: programa de desenvolvimento de liderança aplicado, com indicador defensável.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Próximo passo: validar grade, bibliografia e docentes em ipog.edu.br.</span></li>
        </ul>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-5">Conhecer a grade no IPOG →</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Ver grade vigente no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Portal independente. Grade, ementas, bibliografia e docentes no portal oficial.</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outras seções deste MBA</p>
        <ul class="space-y-1">
          <li><a href={`/mbas/${mba.id}`} class="mega-link"><strong class="text-ink-900 text-sm">Visão geral do MBA</strong></a></li>
          <li><a href={`/mbas/${mba.id}/metodologia`} class="mega-link"><strong class="text-ink-900 text-sm">Metodologia</strong></a></li>
          <li><a href={`/mbas/${mba.id}/perfil-do-aluno`} class="mega-link"><strong class="text-ink-900 text-sm">Perfil do aluno</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros MBAs</p>
        <ul class="space-y-1">
          {others.map(o => (
            <li><a href={`/mbas/${o.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{o.shortName}</strong><br/><span class="text-xs text-ink-500">{o.tag}</span></a></li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes</p>
        <ul class="text-xs text-ink-600 space-y-2">
          <li>Cameron, K. (2008). Positive Leadership.</li>
          <li>Dutton, J. (2003). Energize Your Workplace.</li>
          <li>Edmondson, A. (2019). The Fearless Organization.</li>
          <li>Goleman, D. (1995, 2002). Emotional Intelligence.</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldProgram} />
  <script type="application/ld+json" set:html={ldBreadcrumb} />
  <script type="application/ld+json" set:html={ldFaq} />
</Base>
