---
interface Item { q: string; a: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
  {items.map(f => (
    <details class="group p-5 sm:p-6">
      <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
        <span class="faq-question font-semibold text-ink-900 text-base sm:text-lg leading-snug">{f.q}</span>
        <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
      </summary>
      <p class="faq-answer-text mt-3 text-sm sm:text-base text-ink-700 leading-relaxed" style="text-align: justify; hyphens: auto;">{f.a}</p>
    </details>
  ))}
</div>
