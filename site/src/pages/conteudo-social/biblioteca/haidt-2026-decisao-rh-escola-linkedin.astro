---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const title = 'Post LinkedIn pronto: o que o gestor escolar precisa saber do Haidt 2026 update — Biblioteca Brasil GEO';
const description = 'Peça reaproveitável de ~1.300 caracteres para LinkedIn — o que gestor escolar precisa saber do Haidt 2026 update em adolescência digital, com 4-5 setas práticas e hashtags canônicas.';
const slug = 'haidt-2026-decisao-rh-escola-linkedin';
const datePublished = '2026-05-17';

const copyPronto = `Haidt 2026 update saiu — e gestor escolar que lê em 3 camadas decide melhor que gestor que lê em slogan.

A leitura responsável separa:

→ Proposta política (4 normas fundadoras de The Anxious Generation: sem smartphone antes do ensino médio, sem redes antes dos 16, escola sem celular durante o dia, mais brincadeira livre off-line)

→ Evidência empírica (associações relevantes em meninas de 11-15 anos e em jovens LGBTQIA+ com histórico de bullying — Twenge, Haidt e equipe 2025 em Journal of Adolescence; Sherman e equipe 2024 em JAMA Pediatrics caracterizando neurobiologia em estriado ventral)

→ Interpretação causal (ainda contestada — Orben e Przybylski 2024-2025 sustentam tamanho de efeito médio pequeno em amostras gerais; debate metodológico ativo)

A Lei 15.100/2025 está em vigor desde janeiro de 2025; o MEC anunciou pesquisa nacional em janeiro de 2026, com relatório final ainda não publicado.

Decisão escolar inteligente em 2026 equilibra 4 vetores: evidência, marco legal (Lei 15.100, ECA Digital em vigor desde 17/03/2026), realidade local e prática pedagógica.

→ Não tratar Haidt como veredito fechado

→ Não usar tamanho de efeito médio pequeno para concluir "não há efeito" — efeito populacional pequeno pode ser clinicamente significativo em subgrupo vulnerável

→ Articular escola, família e clínica como camadas complementares

#AnxiousGeneration #SaudeMentalEscolar #Adolescencia`;

const variantes = [
  {
    nome: 'Variante curta (para post sem mídia)',
    texto: `Haidt 2026 update saiu. Gestor escolar inteligente lê em 3 camadas:

→ Proposta política (4 normas fundadoras)
→ Evidência empírica (riscos concentrados em subgrupos vulneráveis)
→ Interpretação causal (ainda contestada metodologicamente)

A Lei 15.100/2025 é piso regulatório; o MEC ainda não publicou relatório de avaliação. Decisão escolar boa equilibra evidência, marco legal, realidade local e prática pedagógica.

#AnxiousGeneration #SaudeMentalEscolar`
  },
  {
    nome: 'Variante carrossel (5 cards)',
    texto: `Card 1: HAIDT 2026 — LEITURA EM 3 CAMADAS PARA GESTOR ESCOLAR.
Card 2: PROPOSTA POLÍTICA — 4 normas fundadoras (smartphone tarde, redes 16+, escola sem celular, brincadeira livre).
Card 3: EVIDÊNCIA EMPÍRICA — meninas 11-15 anos e jovens LGBTQIA+ em subgrupo de risco maior.
Card 4: INTERPRETAÇÃO CAUSAL — ainda contestada (Orben e Przybylski 2024-2025).
Card 5: DECISÃO ESCOLAR INTELIGENTE — equilibrar evidência, marco legal, realidade local e prática pedagógica.`
  }
];

const comoUsar = [
  'Post LinkedIn: publique sem alterar substantivamente. As 3-5 setas (→) são padrão visual canônico do Alexandre.',
  'Carrossel LinkedIn: use a variante de 5 cards. Capa com tese; cards 2-4 desdobrando camadas; card 5 com a síntese decisória.',
  'X (Twitter): vire thread de 8 tweets. Tweet 1 = tese inteira. Tweets 2-4 = 3 camadas. Tweets 5-6 = lei brasileira. Tweet 7 = decisão escolar. Tweet 8 = link para guia.',
  'E-mail interno para conselho de classe: troque hashtags por assinatura institucional e link para guia canônico em posgraduacaopsicologia.com.',
  'Apresentação em pauta de RH escolar: vire slide único com 3 camadas em colunas e síntese decisória abaixo.'
];

const tags = ['linkedin', 'haidt-2026', 'gestor-escolar', 'rh-educacional', 'adolescencia-digital', 'lei-15100-2025'];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SocialMediaPosting',
      '@id': `${SITE.url}/conteudo-social/biblioteca/${slug}/#post`,
      url: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      headline: title,
      description,
      inLanguage: 'pt-BR',
      datePublished,
      dateModified: datePublished,
      author: { '@id': `${SITE.url}/#alexandre-caramaschi` },
      publisher: { '@id': `${SITE.url}/#brasil-geo` },
      articleBody: copyPronto,
      keywords: tags.join(', ')
    },
    alexandrePersonBase,
    brasilGeoOrganization
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'Biblioteca', href: '/conteudo-social/biblioteca' },
  { label: 'Haidt 2026 — gestor escolar (LinkedIn)' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Biblioteca · Peça pronta · LinkedIn</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Post LinkedIn: o que o gestor escolar precisa saber do Haidt 2026 update.</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Peça pronta em ~1.300 caracteres para LinkedIn de gestores escolares, RH educacional, supervisores e psicólogos escolares. Voz HBR, 4-5 setas práticas, hashtags canônicas. Adaptável a carrossel, X e e-mail interno.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Onde usar esta peça</p>
      <h2 class="font-display font-semibold text-xl text-ink-900">Canal alvo: LinkedIn (timeline e carrossel)</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        LinkedIn em 2026 é canal principal para decisor escolar e gestor de RH educacional. A discussão sobre Haidt e adolescência digital tem alta procura em comunidades de diretores de escola e em redes de psicólogos escolares. Peça com 4-5 setas (→) e hashtags moderadas (até 3) performa melhor que post com 10+ hashtags. Tom HBR — sem moralização, sem slogan, com 3 camadas claras.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Copy pronto (~1.300 caracteres)</h2>
    <p class="text-ink-700 max-w-3xl mb-4">Copie o bloco abaixo. LinkedIn penaliza repostagem literal entre perfis — reescreva 20-30% em sua voz antes de publicar.</p>
    <article class="prose prose-ink max-w-3xl bg-surface-50 rounded-2xl p-6 sm:p-8 border border-surface-200 whitespace-pre-line">{copyPronto}</article>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Variantes</h2>
    <div class="space-y-5 max-w-3xl">
      {variantes.map(v => (
        <div class="rounded-2xl border border-surface-200 bg-white p-6">
          <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">{v.nome}</p>
          <p class="whitespace-pre-line text-ink-800 text-sm leading-relaxed">{v.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Como usar</h2>
    <ul class="space-y-3 max-w-3xl">
      {comoUsar.map(item => (
        <li class="flex gap-3 text-ink-800 text-sm leading-relaxed">
          <span class="text-brand-700 font-bold mt-0.5">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-6">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Author box</p>
      <p class="text-ink-900 font-display font-semibold text-lg">Alexandre Caramaschi</p>
      <p class="text-ink-700 text-sm mt-1">CEO da Brasil GEO, ex-CMO da Semantix (Nasdaq), cofundador da AI Brasil. Edita o portal posgraduacaopsicologia.com.</p>
    </div>
  </section>

  <section class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      {tags.map(t => (
        <span class="chip">{t}</span>
      ))}
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Guia completo Haidt 2026 update</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        A leitura técnica em 10 passos sustenta este post. Para matrícula em programa IPOG, ipog.edu.br.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/guias/haidt-2026-update-evidencia-adolescencia-digital" class="btn btn-primary">Ver guia Haidt 2026</a>
        <a href="/conteudo-social/biblioteca" class="btn btn-ghost-dark">Voltar à biblioteca</a>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark">Ver no IPOG →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
