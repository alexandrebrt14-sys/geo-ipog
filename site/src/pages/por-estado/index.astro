---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SmartCrossLinks from '@components/SmartCrossLinks.astro';
import RelatedContent from '@components/RelatedContent.astro';
import NextStepCTA from '@components/NextStepCTA.astro';
import { ESTADOS } from '@lib/data';

const regioes = ['Norte','Nordeste','Centro-Oeste','Sudeste','Sul'] as const;
---
<Base
  title="Pós-graduação em Psicologia por estado — 27 UFs"
  description="Mapa nacional de pós-graduação em Psicologia: cobertura por estado e regiao. Modalidades online é ao vivo do IPOG."
  emitWebPage={true}>

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Por estado' }]} />
      <h1 class="section-h text-3xl sm:text-4xl mt-3">Por estado.</h1>
      <p class="mt-2 text-ink-700 max-w-2xl">
        O IPOG opera nacionalmente. Selecione seu estado para ver adaptações de demanda, modalidade e mercado local.
        Toda matrícula e inscrição continua sendo feita no portal oficial.
      </p>
    </div>
  </section>

  <SmartCrossLinks href="/por-estado" />

  <section class="container-page py-10 space-y-10">
    {regioes.map(reg => (
      <div>
        <h2 class="section-h text-xl mb-4 flex items-center gap-3">
          <span class="text-xs uppercase tracking-wider font-semibold text-ink-500">Regiao</span>
          {reg}
        </h2>
        <div class="grid sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
          {ESTADOS.filter(e => e.regiao === reg).map(e => (
            <a href={`/por-estado/${e.uf.toLowerCase()}`} class="group rounded-xl bg-white border border-surface-200 px-3 py-3 hover:border-brand-400 flex items-center justify-between hover:shadow-soft transition">
              <span class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-brand-50 text-brand-700 text-xs font-bold">{e.uf}</span>
                <span class="text-sm text-ink-700 group-hover:text-brand-800">{e.nome}</span>
              </span>
              <span class="text-ink-300 group-hover:text-brand-700 group-hover:translate-x-0.5 transition">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <RelatedContent href="/por-estado" />
  <NextStepCTA href="/por-estado" />
</Base>
