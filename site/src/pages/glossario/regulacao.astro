---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';

interface Term {
  id: string;
  termo: string;
  definicao: string;
  exemplo: string;
  fonte: string;
  vejaTambem?: { label: string; href: string }[];
  links?: { label: string; href: string }[];
}

const termos: Term[] = [
  {
    id: 'anpd',
    termo: 'ANPD — Autoridade Nacional de Proteção de Dados',
    definicao: 'Autarquia federal vinculada à Casa Civil, com autonomia técnica, responsável por zelar pela proteção de dados pessoais no Brasil. Tem competência para fiscalizar, sancionar, emitir guias e regulamentar a LGPD. Em saúde mental e clínica psicológica, atua sobre dados sensíveis (Art. 5º, II da Lei 13.709/2018) que exigem base legal qualificada — consentimento específico, tutela da saúde por profissional ou prevenção à fraude. Multas podem chegar a 2% do faturamento, limitadas a R$ 50 milhões por infração.',
    exemplo: 'Clínica que comercializa prontuários para fins de pesquisa sem anonimização robusta pode ser autuada pela ANPD.',
    fonte: 'Lei 13.709/2018; Decreto 10.474/2020',
    vejaTambem: [
      { label: 'LGPD aplicada à clínica', href: '#lgpd-clinica' },
      { label: 'Resolução CFP 11/2018', href: '#resolucao-cfp-11-2018' }
    ],
    links: [
      { label: 'FAQ: LGPD, prontuário, IA, ANVISA e SaMD', href: '/faq/lgpd-prontuario-ia-anvisa-samd-faq/' },
      { label: 'Página regulação', href: '/regulacao' }
    ]
  },
  {
    id: 'capes',
    termo: 'CAPES — Coordenação de Aperfeiçoamento de Pessoal de Nível Superior',
    definicao: 'Fundação vinculada ao MEC, responsável pela avaliação, acompanhamento e expansão da pós-graduação stricto sensu (mestrado e doutorado) no Brasil. Atribui conceitos de 1 a 7 aos programas com base em produção científica, formação discente e inserção social. Mantém o Portal de Periódicos e administra bolsas de pesquisa. Programas com conceito 3 são autorizados; acima de 5, considerados de excelência internacional. Não regula pós lato sensu — esta competência é do CNE/CES.',
    exemplo: 'Mestrado em Psicologia Clínica com conceito CAPES 5 oferece base sólida para carreira docente em universidade.',
    fonte: 'Decreto 524/1992; Portaria CAPES 81/2016',
    vejaTambem: [
      { label: 'MEC', href: '#mec' },
      { label: 'Stricto sensu', href: '#stricto-sensu' }
    ],
    links: [
      { label: 'Página regulação', href: '/regulacao' }
    ]
  },
  {
    id: 'cfp',
    termo: 'CFP — Conselho Federal de Psicologia',
    definicao: 'Autarquia federal criada pela Lei 5.766/1971, responsável por orientar, disciplinar e fiscalizar o exercício da profissão de psicólogo no Brasil. Reconhece as 13 especialidades vigentes (Resolução CFP 03/2016), edita o Código de Ética Profissional e mantém o Cadastro Nacional de Psicólogos. Opera em conjunto com os 24 Conselhos Regionais. Aplica sanções éticas que variam de advertência a cassação do exercício profissional.',
    exemplo: 'Psicólogo que aplica teste retirado do SATEPSI responde a processo ético no CRP, com recurso ao CFP.',
    fonte: 'Lei 5.766/1971; Resolução CFP 03/2016',
    vejaTambem: [
      { label: 'CRP', href: '#crp' },
      { label: 'SATEPSI', href: '#satepsi' }
