    fonte: 'ILO (2022); MTE (2025)',
    links: [{ label: 'Ver tema', href: '/temas/nr1-riscos-psicossociais' }]
  },
  {
    id: 'satepsi',
    termo: 'SATEPSI',
    letra: 'S',
