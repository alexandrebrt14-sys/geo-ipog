---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Psicologia Escolar e Educacional: atuação, Lei 13.935 e formação",
  "description": "Entenda o alcance da Lei 13.935/2019 e compare formações em Psicologia Escolar com critérios de participação, trabalho institucional e proteção de dados.",
  "route": "/areas/psicologia-escolar-educacional/",
  "label": "Psicologia Escolar e Educacional",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "A Lei 13.935 exige um psicólogo em cada escola?",
      "a": "O texto prevê serviços nas redes públicas por equipes multiprofissionais. A distribuição de profissionais e os fluxos devem ser verificados na implementação local."
    },
    {
      "q": "Toda dificuldade escolar exige diagnóstico?",
      "a": "Não. É preciso compreender condições de ensino, barreiras e necessidades. Algumas situações requerem avaliação individual, mas uma nota baixa não define um transtorno."
    },
    {
      "q": "A ficha pode registrar nomes de alunos?",
      "a": "Não. Use apenas informações públicas, agregadas sem possibilidade de identificação ou um cenário fictício."
    }
  ],
  "worksheet": {
    "title": "Mapa de uma demanda escolar",
    "description": "Prepare uma discussão educativa sobre contexto, participação e responsabilidades.",
    "fields": [
      {
        "label": "Pedido inicial",
        "hint": "Descreva uma demanda fictícia sem identificar escola ou estudantes."
      },
      {
        "label": "Condições de aprendizagem",
        "hint": "Que barreiras e oportunidades precisam ser compreendidas?"
      },
      {
        "label": "Participantes e responsabilidades",
        "hint": "Quais funções devem contribuir para a discussão?"
      },
      {
        "label": "Pergunta de acompanhamento",
        "hint": "O que será observado para revisar a proposta institucional?"
      }
    ],
    "checklist": [
      "Não atribuí diagnóstico a uma nota ou comportamento isolado.",
      "Incluí condições de ensino e acessibilidade.",
      "Distingui atuação escolar e encaminhamento clínico.",
      "Evitei dados pessoais na ficha."
    ]
  },
  "sources": [
    [
      "Lei nº 13.935/2019: Psicologia e Serviço Social nas redes públicas",
      "https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2019/lei/l13935.htm"
    ],
    [
      "CFP: referências técnicas para a Educação Básica",
      "https://site.cfp.org.br/publicacao/referencias-tecnicas-para-atuacao-de-psicologasos-na-educacao-basica/"
    ],
    [
      "Lei nº 13.146/2015: Lei Brasileira de Inclusão",
      "https://www.planalto.gov.br/ccivil_03/_ato2015-2018/2015/lei/l13146.htm"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma escola solicita que a psicóloga avalie todos os estudantes com notas baixas. Antes de transformar a lista em encaminhamentos, é preciso compreender o ensino, as barreiras de acesso e o que alunos, famílias e professores relatam.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A demanda escolar precisa ser lida junto às condições de aprendizagem.</h2>
<p>A Psicologia Escolar e Educacional pode contribuir com ações institucionais, coletivas e atenção a demandas individuais articuladas à rede. O ponto de partida é uma pergunta que permita compreender o contexto. Uma dificuldade escolar não prova, por si só, um transtorno, falta de esforço ou falha da família.</p>
<p>As <a href="https://site.cfp.org.br/publicacao/referencias-tecnicas-para-atuacao-de-psicologasos-na-educacao-basica/">referências técnicas do CFP para a Educação Básica</a> situam a atuação no direito à educação e na análise das relações escolares. Essa perspectiva pede diálogo com o projeto pedagógico e com diferentes participantes da comunidade, evitando reduzir problemas institucionais a características individuais.</p></section>
<section><h2>O alcance real da Lei nº 13.935/2019</h2>
<p>A <a href="https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2019/lei/l13935.htm">Lei nº 13.935/2019</a> prevê serviços de Psicologia e Serviço Social nas redes públicas de Educação Básica, por equipes multiprofissionais. O texto não determina um psicólogo em cada escola nem garante abertura automática de vagas. A organização local do serviço precisa ser consultada na rede de interesse.</p>
<p>Para quem escolhe uma pós, isso muda a pesquisa: procure estudar como a rede define território, prioridades, fluxo de encaminhamento e colaboração entre profissionais. Um curso que promete emprego apenas por citar a lei está omitindo etapas de implementação e seleção. Confirme também o público admitido no edital; acesso acadêmico não amplia atribuições de profissão.</p></section>
<section><h2>Um roteiro para discutir a demanda com a escola</h2>
<ol><li>Descreva o pedido em termos observáveis e identifique quem o formulou.</li><li>Levante como os estudantes tiveram acesso ao conteúdo, às atividades e às adaptações.</li><li>Inclua escuta dos envolvidos com finalidade clara e proteção da informação.</li><li>Discuta ações possíveis no cotidiano escolar e os casos que exigem atenção individual ou interlocução com a saúde.</li><li>Combine responsáveis, momento de revisão e critérios de acompanhamento.</li></ol>
<p>Esse roteiro serve ao estudo e ao planejamento institucional, sem funcionar como triagem diagnóstica. Em situações concretas, os procedimentos dependem das responsabilidades do profissional e da rede. Não é necessário aguardar um rótulo diagnóstico para examinar uma barreira de acesso ao ensino.</p>
<p>No caso hipotético, a primeira entrega pode ser um mapa das perguntas que a escola ainda não respondeu. Ele pode mostrar que estudantes tiveram oportunidades diferentes de aprender, que há dificuldade de comunicação entre setores ou que algumas situações merecem cuidado individual. O exemplo não presume uma causa única nem um resultado numérico.</p></section>
<section><h2>O que observar na formação</h2>
<div class="table-wrap"><table><thead><tr><th>Dimensão</th><th>O que pedir à instituição</th></tr></thead><tbody>
<tr><td>Análise institucional</td><td>Uma atividade que examine organização escolar, participação e condições de ensino</td></tr>
<tr><td>Inclusão e acessibilidade</td><td>Discussão de barreiras e adaptações com participação dos estudantes</td></tr>
<tr><td>Trabalho em rede</td><td>Exemplos de articulação com educação, saúde e assistência social</td></tr>
<tr><td>Prática e supervisão</td><td>Como o aluno recebe feedback sobre decisões e devolutivas à comunidade</td></tr>
</tbody></table></div>
<p>Uma disciplina sobre testes não cobre, sozinha, essas competências. Por outro lado, valorizar a atuação institucional não significa negar sofrimento individual. A formação precisa ensinar a sustentar os dois níveis de análise e a reconhecer limites de atuação, sem transformar a escola em clínica improvisada.</p>
<p>Conheça também o escopo da <a href="/areas/psicopedagogia/">Psicopedagogia</a> e os critérios de evidência em <a href="/temas/neurociencia-aplicada-aprendizagem/">aprendizagem</a>. As áreas podem dialogar, mas suas funções e responsabilidades precisam permanecer claras.</p></section>
<section><h2>Dados para compreender a escola</h2>
<p>Ao analisar frequência ou participação, defina primeiro a pergunta e o que a informação permite concluir. Uma mudança de média entre turmas não prova que uma intervenção causou o resultado. Evite rankings que exponham estudantes ou simplifiquem histórias de aprendizagem.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/dados-com-python">Dados com Python</a>, no portal de Alexandre Caramaschi, pode apoiar exercícios com bases públicas ou sintéticas. Ele não substitui conhecimento educacional nem autoriza compartilhar planilhas identificáveis de alunos. Use a ficha abaixo para elaborar um pedido de informação e uma pergunta de formação, sem inserir dados reais da comunidade escolar.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
