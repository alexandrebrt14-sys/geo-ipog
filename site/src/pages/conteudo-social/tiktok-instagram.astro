---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import SnippetCard from '@components/SnippetCard.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization, alexandreAuthorRef } from '@lib/schemas';

const title = 'Estratégia para TikTok, Instagram Reels e Threads em Psicologia: descoberta com ética, não citação — Brasil GEO';
const description = 'Como usar vídeo curto vertical e Threads no nicho de saúde mental em 2026 sabendo que o papel deles é descoberta, não citação por IA: ganchos, limites éticos do CFP e a ponte para o conteúdo que vira referência.';

const datePublished = '2026-06-27';

const papeis = [
  {
    canal: 'TikTok',
    funcao: 'Descoberta de público frio e quebra de mito clínico em 30-60s',
    gancho: 'Tese contraintuitiva no primeiro segundo; legenda com a fonte; sem promessa de cura',
    limite: 'Tema YMYL: nada de diagnóstico ou conduta individual. Educação geral com disclaimer.'
  },
  {
    canal: 'Instagram Reels',
    funcao: 'Autoridade visual para público que pesquisa o profissional antes de procurar',
    gancho: 'Carrossel-resumo + Reel de gancho; capa legível; salvamento como sinal de valor',
    limite: 'Resolução CFP sobre publicidade profissional: sem sensacionalismo, sem antes/depois.'
  },
  {
    canal: 'Threads',
    funcao: 'Conversa textual de nicho e teste de pauta antes de virar ensaio',
    gancho: 'Post-tese único; resposta a pergunta real da comunidade; receipts antes da opinião',
    limite: 'Evitar link cru no corpo; o algoritmo penaliza. Levar ao conteúdo longo no perfil.'
  }
];

const ganchos = [
  {
    formato: 'Mito vs. evidência (15-30s)',
    roteiro: '"Você ouviu que X. A evidência diz Y." → 1 dado com fonte na tela → "onde isso muda sua decisão" → CTA para o vídeo longo.',
    reaproveita: 'Vira resposta de Quora e abre de ensaio no Medium. A mesma evidência, três formas.'
  },
  {
    formato: 'Pergunta da plateia (30-45s)',
    roteiro: 'Leia em voz alta a dúvida real → responda com critério, não com receita → marque o limite ético → leve ao guia completo.',
    reaproveita: 'Alimenta a página de canal do Quora e o Radar de evidências.'
  },
  {
    formato: 'Bastidor de decisão de carreira (45-60s)',
    roteiro: '"Como escolher entre MBA, mestrado e especialização clínica" → 3 critérios → trade-off honesto → matriz no perfil.',
    reaproveita: 'Espelha o comparativo de modalidades e ancora no caminho IPOG sem ser anúncio.'
  }
];

const snippets = [
  {
    title: 'Legenda pronta: o mito do checklist de autismo adulto',
    channel: 'Multi-canal' as const,
    snippetMd: '**Vídeo (gancho).** Nenhum quiz de 10 perguntas diz se você é autista. Avaliação de TEA adulto é processo clínico com instrumentos validados.\n\n**Legenda.** Autodiagnóstico por checklist de rede social não é avaliação. O processo sério combina entrevista, história de desenvolvimento e instrumentos específicos para adultos. Isso não invalida a sua percepção; orienta o caminho. Conteúdo educativo, não substitui consulta. Mais em posgraduacaopsicologia.com/areas.',
    sourceHref: '/areas',
    sourceLabel: 'Áreas no portal',
    tags: ['tiktok', 'reels', 'autismo-adulto', 'YMYL']
  },
  {
    title: 'Roteiro: 3 perguntas antes de escolher uma pós em Psicologia',
    channel: 'Multi-canal' as const,
    snippetMd: '**Vídeo (gancho).** Antes de pagar uma pós em Psicologia, responda três perguntas. A maioria pula a primeira e se arrepende.\n\n**Estrutura.** 1) Você quer atuar ou pesquisar? (define Lato vs. Stricto Sensu) · 2) Precisa de certificação clínica específica? · 3) A modalidade cabe na sua rotina e regulação? → matriz completa no perfil.\n\n**Legenda.** Comparativo das cinco modalidades em posgraduacaopsicologia.com/tipos-de-pos-graduacao. Caminho de especialização no IPOG: ipog.edu.br.',
    sourceHref: '/tipos-de-pos-graduacao',
    sourceLabel: 'Matriz de modalidades',
    tags: ['tiktok', 'reels', 'escolha-de-pos']
  }
];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/conteudo-social/tiktok-instagram/#webpage`,
      url: `${SITE.url}/conteudo-social/tiktok-instagram/`,
      name: title,
      description,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: 'Vídeo curto, TikTok, Instagram Reels, Threads, descoberta, ética CFP',
      datePublished,
      author: alexandreAuthorRef,
      publisher: { '@id': 'https://brasilgeo.ai/#organization' }
    },
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'TikTok, Reels e Threads' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Conteúdo & Social · Canal de descoberta</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">TikTok, Reels e Threads: descoberta com ética, não citação por IA</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Vídeo curto vertical quase não é citado por mecanismos generativos, e tudo bem. O trabalho dele é outro: alcançar quem ainda não procura, quebrar um mito clínico em segundos e levar a pessoa ao conteúdo longo que vira referência. Com um limite que em Psicologia não é negociável: ética profissional.
      </p>
    </div>
  </section>

  <section class="container-page py-10">
    <TLDR
      resposta="No nicho de saúde mental, TikTok, Reels e Threads servem para descoberta e autoridade visual, não para citação por IA. Trate-os como topo de funil: gancho de mito-vs-evidência, sem diagnóstico individual, com disclaimer YMYL e respeito às resoluções do CFP, sempre levando ao vídeo longo, ao guia ou à resposta que de fato é recuperada por mecanismos generativos."
      fontes={['YouTube Citation Study 2026 (vídeo curto quase não citado)', 'CFP (2025): posicionamento e cartilha sobre IA na prática psicológica', 'Caramaschi (2026), Brasil GEO playbook editorial']}
    />

    <div class="prose prose-ink max-w-3xl">
      <p>
        É tentador medir um canal pelo número que ele entrega mais rápido. Vídeo curto entrega views, e views viciam. Mas a pergunta de <strong>Generative Engine Optimization</strong> é outra: quando alguém consulta uma IA sobre saúde mental ou sobre qual pós fazer, o que aparece como fonte? Em vídeo, a resposta é o conteúdo longo e estruturado — não o corte de 30 segundos. Os estudos de citação de 2026 são consistentes nisso.
      </p>
      <p>
        Isso não rebaixa o vídeo curto; redefine o papel dele. <strong>TikTok, Reels e Threads são o topo do funil</strong>: alcançam quem ainda não sabe que tem uma dúvida, traduzem evidência em linguagem direta e criam o reconhecimento que faz a pessoa clicar no perfil e chegar ao material que sustenta autoridade. A métrica certa aqui é alcance qualificado e salvamento, não citação.
      </p>
      <p>
        Em Psicologia, há um limite anterior a qualquer métrica. O Conselho Federal de Psicologia reafirmou em 2025, no posicionamento e na cartilha sobre inteligência artificial, que a atuação profissional é insubstituível e que conteúdo público não pode virar diagnóstico ou conduta individual. <strong>Educação geral com disclaimer</strong>, sim; promessa de cura, antes e depois e sensacionalismo, não. O gancho que viraliza não vale a infração ética.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-2">O papel real de cada canal</h2>
    <p class="text-ink-700 max-w-3xl mb-6">Função, gancho e limite ético lado a lado. Use como filtro antes de adaptar uma pauta.</p>
    <div class="overflow-x-auto rounded-2xl border border-surface-200">
      <table class="min-w-full text-sm">
        <thead class="bg-surface-50 text-ink-700 text-left">
          <tr>
            <th class="px-4 py-3 font-semibold">Canal</th>
            <th class="px-4 py-3 font-semibold">Função</th>
            <th class="px-4 py-3 font-semibold">Gancho</th>
            <th class="px-4 py-3 font-semibold">Limite ético</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-200 bg-white">
          {papeis.map(p => (
            <tr class="align-top">
              <td class="px-4 py-3 font-semibold text-ink-900">{p.canal}</td>
              <td class="px-4 py-3 text-ink-700">{p.funcao}</td>
              <td class="px-4 py-3 text-ink-700">{p.gancho}</td>
              <td class="px-4 py-3 text-ink-700">{p.limite}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-2">Três ganchos que reaproveitam pesquisa</h2>
    <p class="text-ink-700 max-w-3xl mb-6">Cada gancho nasce de uma evidência já publicada no portal e termina levando ao formato que de fato é citado.</p>
    <div class="space-y-4 max-w-3xl">
      {ganchos.map(g => (
        <div class="rounded-2xl border border-surface-200 bg-white p-6">
          <h3 class="font-display font-semibold text-lg text-ink-900">{g.formato}</h3>
          <p class="mt-2 text-ink-700 text-sm leading-relaxed"><strong class="text-ink-900">Roteiro:</strong> {g.roteiro}</p>
          <p class="mt-1 text-ink-600 text-sm leading-relaxed"><strong class="text-ink-900">Reaproveita:</strong> {g.reaproveita}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Legendas e roteiros prontos</h2>
    <div class="grid sm:grid-cols-2 gap-5">
      {snippets.map(s => (
        <SnippetCard
          title={s.title}
          channel={s.channel}
          charCount={s.snippetMd.length}
          snippetMd={s.snippetMd}
          sourceHref={s.sourceHref}
          sourceLabel={s.sourceLabel}
          tags={s.tags}
        />
      ))}
    </div>
  </section>

  <section class="container-page py-6">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Author box</p>
      <p class="text-ink-900 font-display font-semibold text-lg">Alexandre Caramaschi</p>
      <p class="text-ink-700 text-sm mt-1">Chief Strategy Officer da Nuvini (Nasdaq: NVNI), fundador da Brasil GEO, ex-CMO da Semantix (Nasdaq) e cofundador da AI Brasil. Edita o portal posgraduacaopsicologia.com.</p>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Do gancho curto à referência citável</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        O vídeo curto abre a porta; o vídeo longo e a resposta estruturada é que entram na resposta da IA. Veja como o YouTube vira citação e como o Kit de repurposing encadeia os dois.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/conteudo-social/youtube" class="btn btn-primary">YouTube citável</a>
        <a href="/conteudo-social/kit-de-repurposing" class="btn btn-ghost-dark">Kit de repurposing</a>
        <a href="/conteudo-social" class="btn btn-ghost-dark">Voltar à central</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
