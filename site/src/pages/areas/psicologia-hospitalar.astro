---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Psicologia Hospitalar: cuidado em equipe, paliativos e formação",
  "description": "Compare formação em Psicologia Hospitalar com referências do CFP e a Política Nacional de Cuidados Paliativos. Inclui ficha de planejamento educativo.",
  "route": "/areas/psicologia-hospitalar/",
  "label": "Psicologia Hospitalar",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "Cuidados paliativos se limitam aos últimos dias de vida?",
      "a": "Não. A política nacional contempla cuidado em condições que ameaçam ou limitam a continuidade da vida e sua articulação na rede."
    },
    {
      "q": "A CFP 09/2018 era uma norma exclusiva da Psicologia Hospitalar?",
      "a": "Não. Ela tratava de avaliação psicológica. A formação deve consultar referências específicas do contexto hospitalar e normas vigentes de exercício."
    },
    {
      "q": "A ficha substitui um protocolo hospitalar?",
      "a": "Não. É uma ferramenta educativa para simulação e comparação de formação, sem dados de pacientes ou decisões clínicas."
    }
  ],
  "worksheet": {
    "title": "Planejamento educativo de comunicação hospitalar",
    "description": "Prepare uma reunião simulada e identifique competências a estudar.",
    "fields": [
      {
        "label": "Finalidade da conversa",
        "hint": "Qual dúvida existe no cenário fictício?"
      },
      {
        "label": "Papéis envolvidos",
        "hint": "Que funções precisam contribuir e com qual informação?"
      },
      {
        "label": "Condições de comunicação",
        "hint": "O que considerar sobre privacidade e acessibilidade?"
      },
      {
        "label": "Continuidade",
        "hint": "Quem deverá acompanhar as perguntas ainda abertas?"
      }
    ],
    "checklist": [
      "Usei situação inteiramente fictícia.",
      "Distingui responsabilidades das profissões.",
      "Incluí participação e compreensão da pessoa.",
      "Evitei presumir consenso ou desfecho clínico."
    ]
  },
  "sources": [
    [
      "CFP: referências para serviços hospitalares do SUS",
      "https://site.cfp.org.br/publicacao/referencias-tecnicas-para-atuacao-de-psicologasos-nos-servicos-hospitalares-do-sus/"
    ],
    [
      "Portaria GM/MS nº 3.681/2024: Política Nacional de Cuidados Paliativos",
      "https://bvsms.saude.gov.br/bvs/saudelegis/gm/2024/prt3681_22_05_2024.html"
    ],
    [
      "Ministério da Saúde: princípios e diretrizes de cuidados paliativos",
      "https://www.gov.br/saude/pt-br/composicao/saes/cuidados-paliativos/cuidados-paliativos/"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma família recebe informações fragmentadas durante uma internação e passa a evitar reuniões com a equipe. A demanda dirigida à Psicologia é “acalmar os familiares”. Para responder, é preciso compreender o que foi comunicado, quais dúvidas permanecem e quem participa do cuidado.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A Psicologia Hospitalar participa do cuidado e da comunicação em equipe.</h2>
<p>A hospitalização pode alterar autonomia, rotina, vínculos e possibilidades de decisão. A atuação psicológica considera a experiência da pessoa, suas relações e as condições do serviço. Não começa apenas quando há finitude ou quando a equipe esgota outras possibilidades; pode contribuir em diferentes momentos do percurso de cuidado.</p>
<p>As <a href="https://site.cfp.org.br/publicacao/referencias-tecnicas-para-atuacao-de-psicologasos-nos-servicos-hospitalares-do-sus/">referências técnicas do CFP para serviços hospitalares do SUS</a> são uma base específica de leitura profissional. Elas devem integrar a avaliação da formação, junto às normas de exercício e às rotinas do serviço. A antiga Resolução CFP nº 09/2018 tratava de avaliação psicológica, e não de uma regulamentação exclusiva da Psicologia Hospitalar.</p></section>
<section><h2>Cuidados paliativos: uma política que precisa entrar na grade</h2>
<p>A <a href="https://bvsms.saude.gov.br/bvs/saudelegis/gm/2024/prt3681_22_05_2024.html">Portaria GM/MS nº 3.681/2024</a> instituiu a Política Nacional de Cuidados Paliativos no SUS. A política aborda alívio do sofrimento em condições que ameaçam ou limitam a continuidade da vida, com atenção à pessoa, familiares e cuidadores e trabalho multiprofissional.</p>
<p>O <a href="https://www.gov.br/saude/pt-br/composicao/saes/cuidados-paliativos/cuidados-paliativos/">Ministério da Saúde</a> destaca autonomia, comunicação e continuidade na rede. Cuidados paliativos não devem ser apresentados apenas como cuidado nos últimos dias de vida. A dimensão espiritual também não é responsabilidade exclusiva de uma profissão; deve ser considerada respeitando crenças, preferências e articulação da equipe.</p>
<p>Para escolher formação, procure discussão de comunicação, participação e limites profissionais, além de conceitos sobre luto. O aprendizado precisa incluir situações em que a pessoa e a família têm prioridades diferentes e a equipe deve trabalhar sem presumir consenso.</p></section>
<section><h2>Competências que mudam conforme o contexto</h2>
<div class="table-wrap"><table><thead><tr><th>Contexto</th><th>Pergunta para a formação</th></tr></thead><tbody>
<tr><td>Enfermaria e internação prolongada</td><td>Como compreender rotina, autonomia, vínculos e condições de participação?</td></tr>
<tr><td>UTI e alta complexidade</td><td>Como colaborar com a equipe diante de comunicação limitada e incerteza?</td></tr>
<tr><td>Oncologia e cuidado continuado</td><td>Como articular demandas ao longo de diferentes etapas do tratamento?</td></tr>
<tr><td>Cuidados paliativos</td><td>Como trabalhar preferências, sofrimento e comunicação em equipe?</td></tr>
<tr><td>Alta e transição</td><td>Como organizar informações e continuidade com a rede?</td></tr>
</tbody></table></div>
<p>O contato com vários setores durante um curso não demonstra, sozinho, competência em todos eles. Peça informação sobre supervisão, responsabilidades do aluno e modo de avaliação. Observe se a instituição ensina a reconhecer necessidades de outras profissões e evita atribuir ao psicólogo decisões que são compartilhadas ou pertencem a outro campo.</p></section>
<section><h2>Um roteiro educativo para uma reunião</h2>
<ol><li>Defina a finalidade da conversa e as dúvidas que precisam ser compreendidas.</li><li>Identifique funções que devem participar e quem pode esclarecer cada informação.</li><li>Considere condições de comunicação, privacidade e acessibilidade.</li><li>Planeje como registrar os encaminhamentos pertinentes e confirmar compreensão.</li><li>Combine quem dará continuidade às questões ainda abertas.</li></ol>
<p>Esse roteiro organiza uma simulação de formação; não substitui protocolo institucional ou decisão clínica. No caso hipotético inicial, o resultado pode ser identificar uma falha na circulação da informação e preparar uma reunião mais compreensível. Não se presume concordância com um plano nem mudança de prognóstico.</p>
<p>Ao discutir a saúde dos trabalhadores, diferencie colaboração com a equipe de atendimento psicológico aos próprios colegas. O serviço precisa esclarecer responsabilidades, acesso e confidencialidade, evitando sobrepor papéis sem organização.</p></section>
<section><h2>Escolha a formação pelas oportunidades de aprendizagem</h2>
<p>Compare prática acompanhada, feedback, participação em discussões e bibliografia. O formato presencial ou online, isoladamente, não demonstra qualidade. Pergunte quais competências dependem de atividade no serviço e como isso é assegurado.</p>
<p>Aprofunde o contexto em <a href="/areas/psicologia-saude/">Psicologia em Saúde</a> e os critérios de <a href="/guias/escolher-supervisor-clinico/">supervisão clínica</a>. O curso <a href="https://alexandrecaramaschi.com/educacao/escrever-bem-com-ia">Escrever bem com IA</a>, do portal de Alexandre Caramaschi, pode apoiar revisão de clareza em textos educativos públicos. Não use dados de pacientes para esse exercício. Na ficha, planeje uma discussão inteiramente fictícia e registre as competências que deseja desenvolver.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
