---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import { SITE, MBAS, AREAS } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const frentes = [
  {
    slug: 'terapia-digital-chatbots-clinicos-2026',
    eyebrow: 'Frente 1 · Clínica direta',
    titulo: 'Terapia digital e chatbots clínicos em 2026',
    resumo: 'Woebot, Wysa e Replika passaram da promessa à evidência mista. Heinz et al. (NEJM AI, 2025) registrou ganho real em sintomas leves; o Posicionamento CFP de 03/07/2025 fixou a linha sobre IA generativa em psicoterapia.',
    quemLe: 'Psicólogos clínicos, gestores de saúde mental digital, profissionais de telessaúde.'
  },
  {
    slug: 'avaliacao-psicologica-ia-satepsi-2026',
    eyebrow: 'Frente 2 · Avaliação',
    titulo: 'Avaliação psicológica com IA e o debate SATEPSI em 2026',
    resumo: 'LLMs leem laudo, interpretam Rorschach e propõem hipótese — mas o sistema SATEPSI (Resolução CFP 09/2018, atualizada 2025) ainda não normatiza IA como instrumento. O vácuo regulatório define onde o uso é defensável.',
    quemLe: 'Psicólogos avaliadores, peritos, coordenadores de programas em RH e saúde.'
  },
  {
    slug: 'papers-2025-2026-saude-mental-ia',
    eyebrow: 'Frente 3 · Estado da arte',
    titulo: '5 papers 2025-2026 que mudaram a leitura de IA em saúde mental',
    resumo: 'Terapia digital randomizada, biomarcador p-tau217 com ML, depressão associada ao uso intenso de chatbot, automação na pontuação de WAIS. Síntese técnica com DOI e arXiv para cada estudo.',
    quemLe: 'Pesquisadores, supervisores clínicos, alunos de pós em Psicologia, jornalistas de ciência.'
  },
  {
    slug: 'ia-na-formacao-do-psicologo-2026',
    eyebrow: 'Frente 4 · Formação',
    titulo: 'IA na formação do psicólogo brasileiro em 2026',
    resumo: 'Pós-graduações e MBAs em Psicologia começaram a integrar IA aplicada — IPOG, PUC e FGV em movimentos distintos. O que efetivamente entrou na grade, o que ficou em workshop e o que continua ausente.',
    quemLe: 'Coordenadores de curso, futuros pós-graduandos, gestores de carreira em Psicologia.'
  },
  {
    slug: 'gpt5-claude47-em-psicoterapia-2026',
    eyebrow: 'Frente 5 · Modelos de fronteira',
    titulo: 'GPT-5.4 e Claude 4.7 em psicoterapia: capacidades e riscos sutis',
    resumo: 'Janela de 1M tokens, voice em tempo real, memory persistente. Salto técnico real; vetor de risco clínico ficou mais sutil — sicofancia polida, alucinação afetiva, reforço de delírio.',
    quemLe: 'Psicólogos que usam ou avaliam IA de fronteira na prática clínica.',
    external: true
  }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'IA e Psicologia em 2026: 5 frentes que todo psicólogo deveria conhecer',
  description: 'Cluster editorial sobre IA aplicada à Psicologia em 2026 — terapia digital, avaliação psicológica, papers 2025-2026, formação do psicólogo e modelos de fronteira. Ancorado no Posicionamento CFP de 03/07/2025, RDC 657/2022 e literatura recente.',
  author: alexandrePersonBase,
  publisher: brasilGeoOrganization,
  inLanguage: 'pt-BR',
  datePublished: '2026-05-17',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.tldr-resposta']
  }
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Temas', item: SITE.url + '/temas/' },
    { '@type': 'ListItem', position: 3, name: 'IA e Psicologia em 2026', item: SITE.url + '/temas/ia-psicologia-2026/' }
  ]
};

const mbaPot = MBAS.find(m => m.id === 'mba-pot');
const areaIa = AREAS.find(a => a.id === 'ia-people-analytics-psicologia-digital');
---
<Base
  title="IA e Psicologia em 2026: 5 frentes que todo psicólogo deveria conhecer"
  description="Cluster editorial sobre IA aplicada à Psicologia em 2026: terapia digital, avaliação psicológica, papers 2025-2026, formação do psicólogo e modelos de fronteira. CFP, SATEPSI e literatura recente.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Temas', href: '/temas' },
        { label: 'IA e Psicologia em 2026' }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Cluster temático · IA e Psicologia · 2026</span>
          <h1 class="section-h text-3xl sm:text-4xl">IA e Psicologia em 2026: 5 frentes que todo psicólogo deveria conhecer.</h1>
          <TLDR
            resposta="Em 2026, IA deixou de ser tema lateral em Psicologia. Cinco frentes definem o que efetivamente mudou: chatbots terapêuticos com evidência mista, avaliação psicológica em vácuo regulatório SATEPSI, papers 2025-2026 com achados acionáveis, integração nas pós-graduações brasileiras e modelos de fronteira (GPT-5.4, Claude 4.7) com risco clínico mais sutil. O profissional que conhece as cinco opera com vantagem técnica e legal; quem trata IA como bloco único subestima o risco e perde a oportunidade."
            fontes={['CFP — Posicionamento sobre IA generativa em psicoterapia (03/07/2025)', 'Anvisa RDC 657/2022 (SaMD)', 'PL 2338/2023 (Marco Legal da IA, Senado)', 'Heinz et al. NEJM AI 2025']}
          />
          <p class="mt-3 text-ink-700 text-lg">5 peças principais, ancoradas em literatura 2025-2026 verificável e marco regulatório brasileiro. Para psicólogos clínicos, organizacionais, avaliadores e coordenadores de pós-graduação.</p>
          <p class="mt-3 inline-flex items-center gap-2 bg-brand-50 border border-brand-100 text-brand-800 text-xs font-semibold px-3 py-1.5 rounded-full">5 frentes · Última revisão · 2026-05-17</p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver cursos no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Tese contraintuitiva</h2>
        <p>
          A leitura predominante sobre IA em Psicologia em 2026 é binária: ou é hype de Silicon Valley, ou é revolução iminente que substitui o clínico. Ambas as leituras erram pelo mesmo motivo — tratam IA como bloco único. O profissional que conhece a literatura empírica recente percebe que IA em Psicologia já é cinco coisas distintas, com regulação, evidência e risco diferentes em cada frente. Quem entende as cinco opera com vantagem técnica e jurídica; quem trata como bloco subestima o risco e perde oportunidade.
        </p>
        <p>
          A inversão é prática. Chatbot terapêutico estruturado (Woebot, Wysa) tem trial randomizado favorável; LLM aberto (ChatGPT) usado como confidente tem sinal de risco em casos vulneráveis (Replika). Avaliação psicológica com IA opera em vácuo SATEPSI; modelo de fronteira com voice e memory mudou o vetor de dependência. O psicólogo que olha "IA em Psicologia" precisa olhar cada frente sob marco regulatório próprio — Posicionamento CFP 03/07/2025 para psicoterapia, Resolução CFP 09/2018 para avaliação, Anvisa RDC 657/2022 para software clínico, PL 2338/2023 (Marco Legal da IA, em tramitação no Senado).
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">As 5 frentes — escolha por onde começar</h2>
        <div class="mt-4 grid sm:grid-cols-2 gap-5">
          {frentes.map(f => (
            <a href={f.external ? `/temas/${f.slug}` : `/temas/ia-psicologia-2026/${f.slug}`} class="card p-5 hover:border-brand-300 transition-colors">
              <span class="section-eyebrow text-xs">{f.eyebrow}</span>
              <h3 class="font-display font-semibold text-lg text-ink-900 mt-2">{f.titulo}</h3>
              <p class="text-sm text-ink-700 mt-2 leading-relaxed">{f.resumo}</p>
              <p class="text-xs text-ink-500 mt-3 italic">Para: {f.quemLe}</p>
              <span class="text-sm text-brand-700 font-semibold mt-3 inline-block">Ler a peça →</span>
            </a>
          ))}
        </div>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">O marco regulatório brasileiro em uma página</h2>
        <p>
          O Brasil tem hoje, em 2026, um arranjo regulatório fragmentado, mas legível, para IA em Psicologia. Quatro normas formam o piso de decisão. Primeiro, o Posicionamento do Conselho Federal de Psicologia sobre IA generativa em psicoterapia, publicado em 03/07/2025 — é um posicionamento, não resolução, mas opera como referência ética em fiscalização. Segundo, a Resolução CFP 09/2018, que normatiza a avaliação psicológica e mantém o sistema SATEPSI como autoridade para parecer técnico sobre instrumentos — IA generativa ainda não tem parecer SATEPSI favorável. Terceiro, a Anvisa RDC 657/2022, que classifica software como dispositivo médico (SaMD) e exige registro para produtos com finalidade diagnóstica ou terapêutica. Quarto, o PL 2338/2023, Marco Legal da IA, em tramitação no Senado em 2026, que pode reclassificar IA em saúde mental como sistema de alto risco.
        </p>
        <p>
          A leitura prática para o psicólogo: psicoterapia conduzida por IA generativa autônoma é, em 2026, vedada na fiscalização do CFP; avaliação psicológica por IA é tolerada como apoio sob responsabilidade do psicólogo habilitado, sem registro SATEPSI próprio; chatbot terapêutico estruturado pode ser dispositivo médico Anvisa se reivindica eficácia clínica. As cinco frentes deste cluster aplicam essas linhas a casos concretos.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Cross-links internos</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/temas/ia-psicodiagnostico-2026" class="text-brand-700 hover:text-brand-800 font-medium">Tema — IA generativa em psicodiagnóstico em 2026 (validade, viés, CFP, LGPD)</a></li>
          <li><a href="/temas/supervisao-clinica-async-ia-2026" class="text-brand-700 hover:text-brand-800 font-medium">Tema — supervisão clínica assíncrona apoiada por IA em 2026</a></li>
          <li><a href="/temas/ia-saude-mental-supervisao-clinica-humana-mba-trilha" class="text-brand-700 hover:text-brand-800 font-medium">Tema — IA em saúde mental e supervisão clínica humana</a></li>
          <li><a href="/temas/ia-generativa-rh" class="text-brand-700 hover:text-brand-800 font-medium">Tema — IA generativa em RH</a></li>
          <li><a href="/guias/uso-etico-ia-generativa-2026" class="text-brand-700 hover:text-brand-800 font-medium">Guia — protocolo em 9 passos para uso ético de IA generativa</a></li>
        </ul>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese do cluster</p>
        <h3 class="font-display font-semibold text-xl">IA em Psicologia já é cinco coisas. Trate cada uma sob seu marco próprio.</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          Terapia digital, avaliação, papers 2025-2026, formação e modelos de fronteira. Cinco frentes, cinco vetores de risco e cinco oportunidades distintas. O profissional treinado opera com governança escrita por frente. O MBA em POT do IPOG aborda IA aplicada com rigor técnico em modalidade Ao Vivo síncrona com corpo docente nominal.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary mt-4">Ver MBAs no IPOG</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho aplicado</p>
        <h3 class="font-display font-semibold text-lg mt-1">{mbaPot ? mbaPot.shortName : 'MBA em POT'}</h3>
        <p class="text-sm text-ink-700 mt-2">
          {mbaPot ? mbaPot.description : 'O IPOG opera MBA em Psicologia Organizacional e do Trabalho em formato Ao Vivo síncrono.'}
        </p>
        <p class="text-xs text-ink-500 mt-2 italic">Portal independente. Não é o site oficial do IPOG.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">Home IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Área correlata</p>
        <ul class="space-y-1">
          {areaIa && <li><a href={`/areas/${areaIa.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{areaIa.name}</strong></a></li>}
        </ul>
        <a href="/areas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todas as áreas →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Marco regulatório brasileiro</p>
        <ul class="space-y-2 text-xs text-ink-700">
          <li>CFP — Posicionamento sobre IA generativa em psicoterapia (03/07/2025).</li>
          <li>CFP — Resolução 09/2018 sobre avaliação psicológica (SATEPSI).</li>
          <li>Anvisa — RDC 657/2022 (software como dispositivo médico).</li>
          <li>Senado — PL 2338/2023 (Marco Legal da IA, em tramitação 2026).</li>
          <li>LGPD — Lei 13.709/2018, art. 11 (dado sensível de saúde).</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
</Base>
