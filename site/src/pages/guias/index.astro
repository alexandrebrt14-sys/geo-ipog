---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SmartCrossLinks from '@components/SmartCrossLinks.astro';
import RelatedContent from '@components/RelatedContent.astro';
import NextStepCTA from '@components/NextStepCTA.astro';
import { SITE, MBAS } from '@lib/data';

const guias = [
  {
    slug: 'implementar-nr1-em-empresa',
    titulo: 'Implementar a NR-1 atualizada na empresa',
    resumo: 'Roteiro de 9 passos para integrar riscos psicossociais ao GRO: mapeamento, instrumentos, treinamento de líder e ciclo PDCA.',
    passos: 9,
    tempo: 22,
    persona: 'RH, SESMT, líderes',
    mba: 'mba-pot',
    mbaLabel: 'MBA em POT'
  },
  {
    slug: 'construir-programa-bem-estar',
    titulo: 'Construir programa de bem-estar evidence-based',
    resumo: 'Como desenhar programa corporativo de bem-estar com base em Job Crafting, PERMA e segurança psicológica — sem cair em wellness genérico.',
    passos: 9,
    tempo: 20,
    persona: 'RH, líderes, consultores',
    mba: 'mba-positiva',
    mbaLabel: 'MBA em Psicologia Positiva'
  },
  {
    slug: 'retorno-ao-trabalho-pos-burnout',
    titulo: 'Conduzir retorno ao trabalho pós-burnout',
    resumo: 'Protocolo de retorno gradual após licença por saúde mental: comunicação com líder, ajustes razoáveis, acompanhamento 90 e 180 dias.',
    passos: 9,
    tempo: 18,
    persona: 'Psicólogos, RH, médicos do trabalho',
    mba: 'mba-positiva',
    mbaLabel: 'MBA em Psicologia Positiva'
  },
  {
    slug: 'avaliacao-tea-adulto',
    titulo: 'Conduzir avaliação de TEA em adulto',
    resumo: 'Trajeto técnico de avaliação para diagnóstico tardio de TEA: AQ-50, ADOS-2 módulo 4, RAADS-R, RBANS, laudo e encaminhamento sob a LBI.',
    passos: 9,
    tempo: 24,
    persona: 'Psicólogos clínicos e neuropsicólogos',
    mba: 'mba-neuro',
    mbaLabel: 'MBA em Reabilitação Neuropsicológica'
  },
  {
    slug: 'escolher-supervisor-clinico',
    titulo: 'Escolher supervisor clínico com método',
    resumo: 'Critérios técnicos para selecionar supervisor em clínica, POT ou neuropsicologia: filiação teórica, contrato, frequência e ética CFP.',
    passos: 8,
    tempo: 16,
    persona: 'Psicólogos em início ou transição de área',
    mba: 'mba-pot',
    mbaLabel: 'MBA em POT'
  },
  {
    slug: 'uso-etico-ia-clinica',
    titulo: 'Usar IA generativa na prática clínica com ética',
    resumo: 'Protocolo de uso de ChatGPT, Claude e similares em consultório: sigilo, LGPD, viés, alertas APA 2024-2026 e Resolução CFP.',
    passos: 9,
    tempo: 19,
    persona: 'Psicólogos clínicos e organizacionais',
    mba: 'mba-pot',
    mbaLabel: 'MBA em POT'
  },
  {
    slug: 'avaliacao-tdah-adulto',
    titulo: 'Conduzir avaliação de TDAH em adulto',
    resumo: 'Trajeto técnico: anamnese retrospectiva, ASRS-18, DIVA-5, perfil executivo, diferenciais com TEA e ansiedade, prejuízo funcional em cinco domínios e laudo CFP defensável.',
    passos: 9,
    tempo: 22,
    persona: 'Psicólogos clínicos e neuropsicólogos',
    mba: 'mba-neuro',
    mbaLabel: 'MBA em Reabilitação Neuropsicológica'
  },
  {
    slug: 'conduzir-supervisao-stepped-care',
    titulo: 'Conduzir supervisão clínica em modelo stepped-care',
    resumo: 'Como organizar supervisão técnica e ética em equipes de atenção primária: discrimination model de Bernard e Goodyear, competency-based de Falender e Shafranske e lições do IAPT para o matriciamento brasileiro.',
    passos: 9,
    tempo: 20,
    persona: 'Psicólogos supervisores, coordenadores de CAPS e atenção primária',
    mba: 'mba-pot',
    mbaLabel: 'MBA em POT'
  },
  {
    slug: 'protocolo-act-burnout-saude',
    titulo: 'Aplicar protocolo ACT de 8 sessões para burnout',
    resumo: 'Adaptação da Terapia de Aceitação e Compromisso (Hayes, Strosahl, Wilson) para burnout em profissionais da saúde: psicoeducação CID-11 QD85, valores, desfusão, ações comprometidas e mensuração com MBI e WAAQ.',
    passos: 9,
    tempo: 21,
    persona: 'Psicólogos clínicos, organizacionais e profissionais da saúde',
    mba: 'mba-positiva',
    mbaLabel: 'MBA em Psicologia Positiva'
  },
  {
    slug: 'integracao-ia-psicodiagnostico-clinica',
    titulo: 'Integrar IA generativa no psicodiagnóstico clínico',
    resumo: 'Como usar LLMs como ferramenta auxiliar em avaliação psicológica sem ferir a Resolução CFP 11/2018 e a LGPD: prompts auditáveis, registro técnico, gestão de vieses e limites éticos do uso assistencial.',
    passos: 9,
    tempo: 23,
    persona: 'Psicólogos clínicos e avaliadores',
    mba: 'mba-pot',
    mbaLabel: 'MBA em POT'
  },
  {
    slug: 'atendimento-primeiro-episodio-psicose',
    titulo: 'Conduzir primeiro atendimento em primeiro episódio psicótico',
    resumo: 'Roteiro técnico para o primeiro contato em primeiro episódio psicótico: avaliação da duração de psicose não tratada, articulação com CAPS, intervenção familiar e modelos de Early Intervention (Birchwood, Kane RAISE-ETP).',
    passos: 9,
    tempo: 24,
    persona: 'Psicólogos clínicos, CAPS, urgência psiquiátrica',
    mba: 'mba-neuro',
    mbaLabel: 'MBA em Reabilitação Neuropsicológica'
  },
  {
    slug: 'avaliacao-saude-mental-perinatal',
    titulo: 'Avaliar saúde mental perinatal com método',
    resumo: 'Protocolo de avaliação de depressão e ansiedade perinatais: screening universal com EPDS e GAD-7, fatores de risco, articulação com pré-natal, encaminhamento e diálogo com PNAISC.',
    passos: 9,
    tempo: 19,
    persona: 'Psicólogos, equipes de pré-natal, atenção primária',
    mba: 'mba-positiva',
    mbaLabel: 'MBA em Psicologia Positiva'
  }
];

const faqs = [
  {
    q: 'O que diferencia um guia HowTo de um artigo comum?',
    a: 'Um guia HowTo segue o leitor passo a passo até resolver um problema operacional definido. O artigo discute o tema, o guia entrega um caminho. Em termos de schema, a página marca cada passo com HowToStep, o que ajuda motores de busca e LLMs a apresentarem o conteúdo no formato de procedimento. O guia funciona quando o leitor sai com decisão tomada e próxima ação clara.'
  },
  {
    q: 'Esses guias substituem uma pós-graduação?',
    a: 'Não. Os guias resolvem demandas operacionais específicas — implementar uma norma, conduzir uma avaliação, montar um programa. A pós-graduação dá fundamento teórico, supervisão prolongada e diploma lato sensu reconhecido. Em geral o guia funciona como entrada técnica e a pós como consolidação. Para formação completa, o caminho oficial está em ipog.edu.br.'
  },
  {
    q: 'Profissional de RH sem formação em Psicologia pode aplicar esses guias?',
    a: 'Pode, com limites. Guias sobre NR-1, programa de bem-estar, retorno ao trabalho e uso ético de IA dialogam com RH, lideranças e SESMT. Os guias de avaliação de TEA e supervisão clínica pressupõem habilitação em Psicologia. Sempre que o guia toca em ato privativo do psicólogo, há indicação explícita.'
  },
  {
    q: 'As fontes citadas estão atualizadas?',
    a: 'Sim. Cada guia cita NR-1 (Brasil, 2024), CFP (Resolução IA 2024), APA (Statement on AI in clinical practice 2024-2026), NICE (guidelines de saúde mental), OMS mhGAP e literatura primária (Maslach, Demerouti, Lyubomirsky, Wrzesniewski & Dutton, Linehan, Hofmann). Datas e veículos estão indicados no texto.'
  }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guias práticos · passo-a-passo para profissionais',
  description: 'Coleção de 13 guias HowTo para profissionais de Psicologia e RH: NR-1, programa de bem-estar, retorno pós-burnout, avaliação de TEA e TDAH adultos, supervisão clínica e stepped-care, uso ético de IA, integração de IA no psicodiagnóstico, protocolo ACT para burnout, primeiro episódio psicótico e saúde mental perinatal.',
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
  inLanguage: 'pt-BR',
  hasPart: guias.map(g => ({
    '@type': 'HowTo',
    name: g.titulo,
    url: `${SITE.url}/guias/${g.slug}`
  }))
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Guias', item: `${SITE.url}/guias` }
  ]
};
---

<Base
  title="Guias práticos passo-a-passo para Psicologia e RH — NR-1, TEA, TDAH, IA clínica, ACT, psicose, perinatal"
  description="Coleção de 13 guias HowTo para Psicologia e RH: NR-1, bem-estar, retorno pós-burnout, TEA e TDAH adultos, supervisão stepped-care, IA clínica e em psicodiagnóstico, ACT para burnout, primeiro episódio psicótico, saúde mental perinatal.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7 md:py-10">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Guias' }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Guias · Howto · 6 trajetos práticos</span>
          <h1 class="section-h text-3xl sm:text-4xl">Guias práticos · passo-a-passo para profissionais</h1>
          <p class="mt-3 text-ink-700 text-base sm:text-lg">Trajetos operacionais para resolver demandas concretas de Psicologia e RH com método, evidência e referência regulatória.</p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0 h-11">
          Ver MBAs no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <SmartCrossLinks href="/guias" />

  <section class="container-page py-10 md:py-12 grid lg:grid-cols-12 gap-8 lg:gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          Um guia HowTo é um documento que segue o leitor pelo problema inteiro, do diagnóstico à execução, com passos numerados, indicadores e armadilhas. Os 6 guias desta seção cobrem demandas frequentes de Psicologia aplicada e RH: implementação de NR-1, programa de bem-estar, retorno ao trabalho pós-burnout, avaliação de TEA em adulto, escolha de supervisor clínico e uso ético de IA generativa. Cada guia entrega checklist de execução e referências canônicas.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Por que um guia bem feito vence um curso longo</h2>
        <p>
          A leitura comum sobre conteúdo profissional supõe que mais horas equivalem a mais aprendizado. Em problema operacional específico — implementar uma norma, montar um programa, conduzir uma avaliação — essa equivalência se quebra. O profissional precisa do caminho mais curto entre dúvida e decisão defensável. Cursos longos são desenhados para fundamento amplo; guias HowTo são desenhados para execução pontual.
        </p>
        <p>
          A literatura de instructional design chama isso de procedural knowledge transfer (Clark e Mayer, 2016). Quando a tarefa é bem definida e o resultado é mensurável, conteúdo procedural curto, com passos enumerados e checagem de execução, transfere mais. Cursos longos voltam ao jogo quando o profissional precisa do porquê — e é aí que MBA, especialização e supervisão se justificam. Os dois formatos são complementares, não substitutos.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Os 6 guias</h2>
        <p class="text-ink-700 mt-2">Cada cartão abre o guia completo. Os passos são enumerados, com tabela de checklist, armadilhas comuns e fontes oficiais.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5">
          {guias.map(g => (
            <a href={`/guias/${g.slug}`} class="card p-5 border-surface-200 hover:border-brand-200 transition group">
              <div class="flex items-center gap-2 text-xs text-ink-500 mb-2">
                <span class="inline-flex items-center justify-center rounded-full bg-brand-50 text-brand-800 font-semibold w-7 h-7">{g.passos}</span>
                <span class="font-medium">passos</span>
                <span aria-hidden="true">·</span>
                <span>~{g.tempo} min de leitura</span>
              </div>
              <h3 class="font-display font-semibold text-lg text-ink-900 group-hover:text-brand-800">{g.titulo}</h3>
              <p class="text-sm text-ink-700 mt-2 leading-relaxed">{g.resumo}</p>
              <p class="text-xs text-ink-500 mt-3"><span class="font-semibold text-ink-700">Persona:</span> {g.persona}</p>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl">Mapa dos guias × persona × MBA correlato</h2>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Guia</th>
                <th class="text-left px-4 py-3">Tempo</th>
                <th class="text-left px-4 py-3">Persona alvo</th>
                <th class="text-left px-4 py-3">MBA correlato</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {guias.map(g => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink-900"><a href={`/guias/${g.slug}`} class="hover:text-brand-800">{g.titulo}</a></td>
                  <td class="px-4 py-3 text-ink-700 whitespace-nowrap">~{g.tempo} min</td>
                  <td class="px-4 py-3 text-ink-700">{g.persona}</td>
                  <td class="px-4 py-3 text-ink-700"><a href={`/mbas#${g.mba}`} class="text-brand-700 hover:text-brand-800">{g.mbaLabel}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-2xl bg-sun-500/10 border border-sun-500/30 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Caso composto · ilustrativo</p>
        <h3 class="font-display font-semibold text-lg text-ink-900">A profissional de RH que destravou a auditoria NR-1 em 11 dias</h3>
        <p class="mt-3 text-ink-700 leading-relaxed">
          Indústria têxtil de médio porte, 420 colaboradores, foi notificada em fiscalização preliminar do MTE sobre ausência de avaliação de riscos psicossociais no GRO. A profissional de RH, sem formação prévia em POT, tinha 30 dias para apresentar plano. Em vez de contratar consultoria genérica, percorreu o guia de implementação de NR-1 desta seção. Em 11 dias, mapeou demandas, aplicou JCQ-22 (Karasek), treinou 6 líderes em entrevista de risco e produziu o documento de GRO atualizado. A fiscalização aprovou o plano. Em seguida, ela ingressou no MBA em POT do IPOG para consolidar o fundamento. O guia abriu a porta; a pós deu o lastro técnico.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white mt-4">
          {faqs.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <span class="font-semibold text-ink-900">{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese</p>
        <h3 class="font-display font-semibold text-xl">Guia entrega execução. Pós entrega lastro.</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          Esta seção foi desenhada para profissionais que precisam decidir e executar com método. Cada guia segue arquitetura HowTo com passos enumerados, tabela de execução, armadilhas comuns e referências canônicas. Quando o tema exigir formação consolidada, há indicação direta do MBA correlato do IPOG, com formato Ao Vivo síncrono e corpo docente nominal. Próximo passo: abrir o guia mais próximo da sua demanda atual.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 h-11 inline-flex">
          Ver MBAs no IPOG
        </a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 lg:sticky lg:top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Formação consolidada no IPOG</h3>
        <p class="text-sm text-ink-700 mt-2">
          O IPOG oferece MBA em Psicologia Organizacional, Psicologia Positiva, Reabilitação Neuropsicológica, Neurociência e Liderança Positiva em formato Ao Vivo síncrono. Para grade, valor e turma vigentes, consulte o portal oficial.
        </p>
        <p class="text-xs text-ink-500 mt-2 italic">Portal independente. Não é o site oficial do IPOG.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full h-11">
          Ver no IPOG
        </a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full h-11">
          Home IPOG
        </a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">MBAs correlatos</p>
        <ul class="space-y-2">
          {MBAS.map(m => (
            <li>
              <a href={`/mbas#${m.id}`} class="mega-link">
                <strong class="text-ink-900 text-sm">{m.shortName}</strong>
              </a>
            </li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes canônicas</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP — Conselho Federal de Psicologia</a></li>
          <li><a href="https://www.gov.br/trabalho-e-emprego/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">MTE — NR-1 atualizada</a></li>
          <li><a href="https://www.who.int/teams/mental-health-and-substance-use/treatment-care/mental-health-gap-action-programme" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">OMS — mhGAP</a></li>
          <li><a href="https://www.nice.org.uk/guidance" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">NICE — guidelines</a></li>
          <li><a href="https://www.apa.org/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">APA — American Psychological Association</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <RelatedContent href="/guias" />
  <NextStepCTA href="/guias" />

  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
</Base>
