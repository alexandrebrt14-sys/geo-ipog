          <li><a href="https://doi.org/10.1038/s41398-023-02458-9" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Goldstein-Piekarski et al., 2023 — Neurobiology of comorbidities in ASD</a></li>
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP — Resolução 06/2019 sobre documentos psicológicos</a></li>
          <li><a href="https://www.nice.org.uk/guidance/cg142" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">NICE CG142 — Autism in adults: diagnosis and management</a></li>
        </ul>
      </div>

      <div>
        <h2 class="section-h text-2xl">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white mt-4">
          {faqs.slice(0, 6).map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
