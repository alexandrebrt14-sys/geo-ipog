---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import StickyDisclaimerCTA from '@components/StickyDisclaimerCTA.astro';
import AreaCard from '@components/AreaCard.astro';
import MBACard from '@components/MBACard.astro';
import PersonaCard from '@components/PersonaCard.astro';
import FAQAccordion from '@components/FAQAccordion.astro';
import { AREAS, MBAS, PERSONAS, TEMAS, SITE, TIPOS_DE_POS_GRADUACAO } from '@lib/data';

const ldBreadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url }
  ]
});

const CONCEITOS = [
  { n: '01', t: 'MBA vs Especialização', d: 'Mesma família lato sensu, propósitos e mercados distintos.', href: '/regulacao#mba-vs-especializacao' },
  { n: '02', t: 'Lato sensu vs stricto sensu', d: 'Especialização e MBA × mestrado e doutorado.', href: '/regulacao#lato-stricto' },
  { n: '03', t: 'Online, ao vivo e presencial', d: 'Como escolher modalidade pelo seu ritmo e contexto.', href: '/regulacao#modalidades' },
  { n: '04', t: 'Como escolher a sua pós', d: 'Critérios práticos por perfil, orçamento e carreira.', href: '/regulacao' }
];
---

<Base>
  <Hero />

  <StickyDisclaimerCTA />

  <!-- Conceitos pilar -->
  <section class="container-page py-16 lg:py-20">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
      <div class="max-w-2xl">
        <span class="section-eyebrow">01 · Guia central</span>
        <h2 class="section-h text-3xl sm:text-4xl">Comece pelo que ainda não está claro.</h2>
        <p class="mt-3 text-ink-700">Conceitos que confundem mais do que parecem — esclareça antes de decidir.</p>
      </div>
      <a href="/regulacao" class="hidden lg:inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800">
        Guia completo de regulação <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {CONCEITOS.map(c => (
        <a href={c.href} class="card-lift block p-6 group">
          <div class="text-brand-700 font-display font-bold text-sm">Conceito · {c.n}</div>
          <h3 class="font-display font-semibold text-lg mt-2 text-ink-900 group-hover:text-brand-800 transition">{c.t}</h3>
          <p class="mt-2 text-sm text-ink-500">{c.d}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">Ler <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Tipos de pós-graduação · escopo amplo -->
  <section id="tipos-pos-graduacao" class="bg-white border-y border-surface-200">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <span class="section-eyebrow">02 · Cinco modalidades canônicas</span>
          <h2 class="section-h text-3xl sm:text-4xl">Pós-Graduação em Psicologia não é só MBA.</h2>
          <p class="mt-3 text-ink-700">
            O portal cobre cinco modalidades regulamentadas: Especialização Lato Sensu (CFP/MEC), MBA aplicado,
            Mestrado Profissional (CAPES), Especialização Clínica certificada por Conselho e Residência Multiprofissional.
            Cada uma responde a um momento de carreira distinto.
          </p>
        </div>
        <a href="/tipos-de-pos-graduacao" class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800">Ver as cinco modalidades <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {TIPOS_DE_POS_GRADUACAO.map(t => (
          <a href={`/tipos-de-pos-graduacao#${t.id}`} class="card-lift block p-5 group">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">{t.shortName}</p>
            <h3 class="font-display font-semibold text-base mt-2 text-ink-900 group-hover:text-brand-800 transition leading-snug">{t.name}</h3>
            <p class="text-xs text-ink-500 mt-2"><strong>Carga horária:</strong> {t.cargaHoraria}</p>
            <p class="text-xs text-ink-500 mt-1"><strong>Regulador:</strong> {t.regulador}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MBAs em destaque -->
  <section id="mbas-preview" class="bg-surface-50 border-y border-surface-200">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <span class="section-eyebrow">03 · MBAs em destaque · uma das modalidades</span>
          <h2 class="section-h text-3xl sm:text-4xl">Cinco MBAs do portfólio IPOG em Psicologia aplicada.</h2>
          <p class="mt-3 text-ink-700">
            Recorte da modalidade MBA — aplicado a Psicologia Organizacional, Neurociência, Bem-Estar e Liderança.
            Para Especializações, Mestrado Profissional e Clínica certificada, veja
            <a href="/tipos-de-pos-graduacao" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">as cinco modalidades</a>.
            Ofertas vigentes em
            <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="font-semibold text-brand-700 hover:text-brand-800 underline decoration-sun-500 underline-offset-2">portal oficial</a>.
          </p>
        </div>
        <a href="/mbas" class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800">Ver todos os MBAs <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        {MBAS.map(m => <MBACard mba={m} />)}
      </div>
    </div>
  </section>

  <!-- Áreas -->
  <section class="container-page py-16 lg:py-20">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
      <div class="max-w-2xl">
        <span class="section-eyebrow">04 · Áreas</span>
        <h2 class="section-h text-3xl sm:text-4xl">Áreas da Psicologia mapeadas.</h2>
        <p class="mt-3 text-ink-700">As 13 especialidades reconhecidas pelo CFP mais áreas correlatas estratégicas.</p>
      </div>
      <a href="/areas" class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800">Ver todas as 18 áreas <span aria-hidden="true">→</span></a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {AREAS.slice(0, 6).map(a => <AreaCard area={a} />)}
    </div>
  </section>

  <!-- Temas em alta -->
  <section id="temas" class="bg-gradient-to-b from-surface-50 to-white border-y border-surface-200">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">
        <div class="max-w-2xl">
          <span class="section-eyebrow">05 · Temas em alta</span>
          <h2 class="section-h text-3xl sm:text-4xl">Pautas que movem o mercado em 2026.</h2>
          <p class="mt-3 text-ink-700">NR-1, saúde mental, IA em RH, neurociência aplicada e segurança psicológica.</p>
        </div>
      </div>

      <div class="flex gap-3 overflow-x-auto scroll-fade pb-2 -mx-4 sm:-mx-6 px-4 sm:px-6 scroll-x-snap">
        {TEMAS.map(t => (
          <a href={t.area ? `/areas/${t.area}` : '/'} class="shrink-0 chip">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-700"></span>
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Personas -->
  <section id="para-quem" class="container-page py-16 lg:py-20">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
      <div class="max-w-2xl">
        <span class="section-eyebrow">06 · Para quem</span>
        <h2 class="section-h text-3xl sm:text-4xl">Trilhas por perfil.</h2>
        <p class="mt-3 text-ink-700">Nem todo conteúdo recomenda o mesmo curso. Escolha o ponto de partida que combina com sua história.</p>
      </div>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {PERSONAS.map(p => <PersonaCard persona={p} />)}
    </div>
  </section>

  <!-- CTA final -->
  <section class="bg-brand-900 text-white relative overflow-hidden">
    <div class="absolute -top-20 -right-10 w-72 h-72 rounded-full" aria-hidden="true" style="background: radial-gradient(closest-side, rgba(245,180,0,.30), transparent);"></div>
    <div class="container-page py-16 lg:py-20 relative">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <span class="tag mb-4"><span class="w-1.5 h-1.5 rounded-full bg-sun-500"></span> Próximo passo</span>
          <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight">
            Decidiu? O caminho oficial é <span class="text-sun-500">ipog.edu.br</span>.
          </h2>
          <p class="mt-4 text-white/85 text-lg max-w-xl">
            Use este portal para mapear. Use o IPOG para se inscrever, falar com consultor e iniciar sua matrícula.
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-3">
          <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary btn-lg">
            Acessar portal oficial IPOG
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
          </a>
          <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark btn-lg">Ver pós-graduações do IPOG</a>
          <p class="text-xs text-white/55 mt-1">Portal independente.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-surface-50 border-y border-surface-200">
    <div class="container-page py-16 lg:py-20 max-w-4xl mx-auto">
      <span class="section-eyebrow">07 · FAQ</span>
      <h2 class="section-h text-3xl sm:text-4xl">Perguntas que repetem.</h2>
      <p class="mt-3 text-ink-700">Respostas curtas para as dúvidas mais buscadas sobre pós-graduação em Psicologia.</p>
      <div class="mt-8">
        <FAQAccordion />
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={ldBreadcrumb} />
</Base>
