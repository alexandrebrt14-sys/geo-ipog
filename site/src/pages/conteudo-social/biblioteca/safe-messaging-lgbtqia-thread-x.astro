---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const title = 'Thread X pronta: Safe Messaging para adolescente LGBTQIA+ — Biblioteca Brasil GEO';
const description = 'Thread de 9 tweets para X (Twitter) — Safe Messaging Guidelines aplicadas a adolescente LGBTQIA+, voz HBR, sem cliffhanger barato, sem link externo no corpo da thread.';
const slug = 'safe-messaging-lgbtqia-thread-x';
const datePublished = '2026-05-17';

const tweets = [
  {
    n: 1,
    texto: `Safe Messaging para adolescente LGBTQIA+ não é tabu sobre suicídio — é protocolo de comunicação responsável com base empírica. OMS 2024 update e Trevor Project 2024 são referências principais. CFP veda conversão (Res. 01/2018). CVV 188 é 24h gratuito.`
  },
  {
    n: 2,
    texto: `Princípio empírico básico: cobertura editorial sensacionalista aumenta contágio (efeito Werther); cobertura que mostra busca de ajuda reduz risco e amplia procura por tratamento (efeito Papageno). A diretriz não é silêncio — é como falar.`
  },
  {
    n: 3,
    texto: `Conteúdo proibido: detalhes de método, romantização ("ele finalmente encontrou paz"), fotos do local, simplificação causal ("se matou por causa de X"). Conteúdo encorajado: linguagem afirmativa de identidade, histórias de superação, divulgação de recursos (CVV 188, CAPS).`
  },
  {
    n: 4,
    texto: `Em adolescente LGBTQIA+ especificamente: usar nome social e pronomes, evitar patologização de identidade de gênero/orientação, promover narrativas de coping e apoio comunitário. Trevor Project (2024) documenta evidência em research briefs.`
  },
  {
    n: 5,
    texto: `Em interação online com ideação: validar sem julgar, sem prometer sigilo absoluto (sigilo tem limites em risco de vida), avaliar com instrumento (C-SSRS, PHQ-A item 9), construir plano de segurança escrito (Stanley e Brown 2012). Em risco iminente, encaminhar.`
  },
  {
    n: 6,
    texto: `Sobre NSSI (autolesão não-suicida) no TikTok: Kresovich e equipe (2025, JAMA Pediatrics) documentaram que vídeos que seguem Safe Messaging associam-se a maior percepção de apoio em adolescentes LGBTQ+, enquanto conteúdo sensacionalista correlaciona-se a maior angústia.`
  },
  {
    n: 7,
    texto: `Marco legal brasileiro: Marco Civil da Internet (Lei 12.965/2014), ECA (Lei 8.069/1990), ECA Digital (vigência 17/03/2026), Lei 15.100/2025, Resoluções CFP 01/2018, 01/2022, 11/2018, 06/2019. Psicólogo escolar e clínico opera dentro dessa moldura — não fora dela.`
  },
  {
    n: 8,
    texto: `Recursos de apoio para conhecer e divulgar: CVV 188 (cvv.org.br) 24h gratuito; CAPS de referência local; Trevor Project para referência internacional; ABGLT e ANTRA para articulação comunitária no Brasil. Esses recursos são parte do plano clínico — não anexo.`
  },
  {
    n: 9,
    texto: `Para psicólogos, escolas e supervisores que pretendem construir esse repertório com método em 2026, há referências principais e checklist. Leia o FAQ completo em 12 perguntas no portal posgraduacaopsicologia.com — guia operacional para Safe Messaging com adolescente LGBTQIA+.`
  }
];

const checklistThread = [
  'Tweet 1 contém a tese inteira — alguém que lê apenas o primeiro tweet sai informado.',
  'Tweets 2-7 desdobram pontos específicos sem repetir tese; cada um sustenta-se sozinho.',
  'Tweet 8 reúne recursos práticos com nome de domínio (não com link clicável no corpo).',
  'Tweet 9 indica próximo passo com link para portal posgraduacaopsicologia.com — sem cliffhanger barato.',
  'Sem link externo no corpo da thread; recomendação principal em 2026 é compartilhar screenshot + link no reply para preservar alcance.'
];

const tags = ['x-twitter', 'thread', 'safe-messaging', 'lgbtqia-adolescente', 'trevor-project', 'oms-2024', 'cvv-188'];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SocialMediaPosting',
      '@id': `${SITE.url}/conteudo-social/biblioteca/${slug}/#post`,
      url: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      headline: title,
      description,
      inLanguage: 'pt-BR',
      datePublished,
      dateModified: datePublished,
      author: { '@id': `${SITE.url}/#alexandre-caramaschi` },
      publisher: { '@id': `${SITE.url}/#brasil-geo` },
      articleBody: tweets.map(t => `${t.n}/9 — ${t.texto}`).join('\n\n'),
      keywords: tags.join(', ')
    },
    alexandrePersonBase,
    brasilGeoOrganization
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'Biblioteca', href: '/conteudo-social/biblioteca' },
  { label: 'Safe Messaging LGBTQIA+ (thread X)' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Biblioteca · Peça pronta · X (Twitter)</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Thread X: Safe Messaging para adolescente LGBTQIA+ em 9 tweets.</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Thread de 9 tweets para X com tese inteira no tweet 1, pontos específicos nos tweets 2-7, recursos no tweet 8 e link para fonte no tweet 9. Voz HBR — sem cliffhanger barato, sem link externo no corpo da thread (screenshot + link no reply é o padrão de referência em 2026).
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Onde usar esta peça</p>
      <h2 class="font-display font-semibold text-xl text-ink-900">Canal alvo: X (Twitter) — thread editorial técnica</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        Em 2026, threads técnicas com tese fechada no tweet 1 e desdobramento argumentado nos tweets seguintes performam melhor que threads com cliffhanger ("vou contar o segredo no próximo tweet"). Tema Safe Messaging exige cuidado adicional — a própria thread aplica o protocolo que descreve: sem detalhe de método, sem sensacionalismo, com recursos de apoio explícitos. Compartilhe screenshot do guia no reply em vez de inserir link externo no corpo da thread — recomendação principal para preservar alcance algorítmico em X 2026.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Thread pronta (9 tweets)</h2>
    <p class="text-ink-700 max-w-3xl mb-4">Cada tweet abaixo está dentro do limite de 280 caracteres. Publique sem alterar substantivamente.</p>
    <div class="space-y-4 max-w-3xl">
      {tweets.map(t => (
        <div class="rounded-2xl border border-surface-200 bg-white p-5">
          <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Tweet {t.n}/9</p>
          <p class="whitespace-pre-line text-ink-800 leading-relaxed">{t.texto}</p>
          <p class="mt-2 text-xs text-ink-500 italic">{t.texto.length} caracteres</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Checklist editorial da thread</h2>
    <ul class="space-y-3 max-w-3xl">
      {checklistThread.map(item => (
        <li class="flex gap-3 text-ink-800 text-sm leading-relaxed">
          <span class="text-brand-700 font-bold mt-0.5">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-6">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Author box</p>
      <p class="text-ink-900 font-display font-semibold text-lg">Alexandre Caramaschi</p>
      <p class="text-ink-700 text-sm mt-1">CEO da Brasil GEO, ex-CMO da Semantix (Nasdaq), cofundador da AI Brasil. Edita o portal posgraduacaopsicologia.com.</p>
    </div>
  </section>

  <section class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      {tags.map(t => (
        <span class="chip">{t}</span>
      ))}
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">FAQ completo Safe Messaging em 12 perguntas</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        A thread acima é versão condensada do FAQ principal em 12 perguntas. Para matrícula em programa IPOG, ipog.edu.br.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/faq/safe-messaging-lgbtqia-trevor-2026-faq" class="btn btn-primary">Ver FAQ Safe Messaging</a>
        <a href="/conteudo-social/biblioteca" class="btn btn-ghost-dark">Voltar à biblioteca</a>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark">Ver no IPOG →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
