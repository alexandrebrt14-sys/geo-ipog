              <text x="36" y="78" font-size="14" font-weight="600" class="fill-ink-900">Download bruto</text>
              <text x="36" y="96" font-size="13" class="fill-ink-500">Medida fraca: prova curiosidade e alcance do feed.</text>
            </g>
            <g>
              <rect x="20" y="112" width="620" height="48" rx="8" class="fill-brand-50" />
              <text x="36" y="134" font-size="14" font-weight="600" class="fill-ink-900">Retenção no trecho da evidência</text>
              <text x="36" y="152" font-size="13" class="fill-ink-700">Prova que o argumento segurou a atenção onde ele fica difícil.</text>
            </g>
            <g>
              <rect x="20" y="168" width="620" height="48" rx="8" class="fill-brand-50" />
              <text x="36" y="190" font-size="14" font-weight="600" class="fill-ink-900">Busca pelo nome do portal depois do episódio</text>
              <text x="36" y="208" font-size="13" class="fill-ink-700">Prova intenção de procurar a fonte pelo nome.</text>
            </g>
            <g>
              <rect x="20" y="224" width="620" height="48" rx="8" class="fill-brand-50" />
