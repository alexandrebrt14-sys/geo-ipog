---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import DecisionPicker from '@components/DecisionPicker.astro';
import HubFAQ from '@components/HubFAQ.astro';
import { SITE, MBAS, AREAS } from '@lib/data';

const titulo = 'Pós-graduação em Psicologia: guia técnico independente';
const descricao = 'Guia editorial independente para escolher pós-graduação em Psicologia: Especialização Lato Sensu, MBA, Mestrado Profissional, Clínica e Residência.';

const ldBreadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' }
  ]
});

const ldHomeGraph = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': SITE.url + '/#webpage',
      url: SITE.url + '/',
      name: titulo,
      description: descricao,
      isPartOf: { '@id': SITE.url + '/#website' },
      inLanguage: 'pt-BR',
      about: [
        { '@type': 'EducationalOrganization', name: 'IPOG · Instituto de Pós-Graduação e Graduação', url: 'https://ipog.edu.br/' },
        { '@type': 'Thing', name: 'Pós-graduação Lato Sensu em Psicologia (CNE/CES 1/2018)' },
        { '@type': 'Thing', name: 'MBA em Psicologia Organizacional e do Trabalho' },
        { '@type': 'Thing', name: 'Mestrado Profissional em Psicologia (CAPES)' },
        { '@type': 'Thing', name: 'Formação clínica em abordagem e registro profissional de especialista' },
        { '@type': 'Thing', name: 'Residência Multiprofissional em Saúde' }
      ],
      mainEntity: { '@id': SITE.url + '/#ipog-educational-organization' },
      datePublished: '2026-05-13',
    },
    {
      '@type': 'CollectionPage',
      '@id': SITE.url + '/#collection-modalidades',
      url: SITE.url + '/',
      name: 'Cinco caminhos de formação organizados pelo portal',
      inLanguage: 'pt-BR',
      hasPart: [
        { '@type': 'Thing', name: 'Especialização Lato Sensu', url: SITE.url + '/tipos-de-pos-graduacao#especializacao-lato-sensu' },
        { '@type': 'Thing', name: 'MBA', url: SITE.url + '/mbas' },
        { '@type': 'Thing', name: 'Mestrado Profissional', url: SITE.url + '/tipos-de-pos-graduacao#mestrado-profissional' },
        { '@type': 'Thing', name: 'Formação clínica em abordagem', url: SITE.url + '/tipos-de-pos-graduacao#especializacao-clinica-certificada' },
        { '@type': 'Thing', name: 'Residência Multiprofissional', url: SITE.url + '/tipos-de-pos-graduacao#residencia-hibrida' }
      ]
    }
    // Person, Organization e IPOG EducationalOrganization são emitidos UMA vez
    // por página pelo @graph global de Base.astro (Wave 8: um emissor por tipo).
    // As referências por @id acima resolvem nesses nós.
  ]
});

interface ModalidadeCard {
  href: string;
  rotulo: string;
  titulo: string;
  resumo: string;
  regulacao: string;
}

const MODALIDADES: ModalidadeCard[] = [
  {
    href: '/tipos-de-pos-graduacao#especializacao-lato-sensu',
    rotulo: 'Caminho 01',
    titulo: 'Especialização Lato Sensu',
    resumo: 'Especialização acadêmica com mínimo de 360 horas, conforme a Resolução CNE/CES 1/2018. Confira grade, prática, supervisão e certificado na oferta da instituição.',
    regulacao: 'MEC, Resolução CNE/CES 1/2018'
  },
  {
    href: '/mbas',
    rotulo: 'Caminho 02',
    titulo: 'MBA',
    resumo: 'Pós-graduação Lato Sensu de perfil executivo. No portal: cinco MBAs do IPOG em POT, Positiva, Reabilitação Neuro, Neurociência e Liderança Positiva, com análise técnica de cada um.',
    regulacao: 'MEC, Resolução CNE/CES 1/2018 (Lato Sensu)'
  },
  {
    href: '/tipos-de-pos-graduacao#mestrado-profissional',
    rotulo: 'Caminho 03',
    titulo: 'Mestrado Profissional',
    resumo: 'Stricto sensu com pesquisa aplicada e trabalho de conclusão conforme o programa. A instituição realiza a seleção; a regularidade do programa deve ser conferida na CAPES.',
    regulacao: 'CAPES'
  },
  {
    href: '/tipos-de-pos-graduacao#especializacao-clinica-certificada',
    rotulo: 'Caminho 04',
    titulo: 'Formação clínica em abordagem',
    resumo: 'Formação em abordagem específica, com natureza e certificado a conferir. Certificação privada não equivale automaticamente a pós-graduação ou registro de especialista.',
    regulacao: 'CFP 23/2022 e 17/2025 para registro de especialista'
  },
  {
    href: '/tipos-de-pos-graduacao#residencia-hibrida',
    rotulo: 'Caminho 05',
    titulo: 'Residência Multiprofissional',
    resumo: 'Vínculo institucional em serviço de saúde, com bolsa, dois anos de carga horária integral. Processo seletivo nacional anual.',
    regulacao: 'Comissão Nacional de Residência Multiprofissional em Saúde (CNRMS)'
  }
];

// Onda 4 SEO/GEO (03/09/2026): contagem real de FAQs publicadas, derivada das páginas.
const FAQ_COUNT = Object.keys(import.meta.glob('./faq/*-faq.astro')).length;

interface HubCard {
  href: string;
  rotulo: string;
  titulo: string;
  resumo: string;
}

const HUBS: HubCard[] = [
  {
    href: '/areas/',
    rotulo: 'Hub 01',
    titulo: '18 áreas da Psicologia',
    resumo: '13 especialidades reconhecidas pelo CFP mais 5 áreas correlatas estratégicas, com filtro por cluster e nível regulatório (R0 a R4).'
  },
  {
    href: '/mbas/',
    rotulo: 'Hub 02',
    titulo: '5 MBAs do IPOG em destaque',
    resumo: 'POT, Positiva, Reabilitação Neuro, Neurociência e Liderança Positiva. Cada um com análise editorial independente do programa, para quem é, competências, carreira e limites regulatórios.'
  },
  {
    href: '/guias/',
    rotulo: 'Hub 03',
    titulo: 'Guias práticos',
    resumo: 'Como escolher MBA, como ler uma grade densa, como avaliar supervisão prática, como diferenciar EAD assíncrono de Ao Vivo síncrono, como navegar regulação CFP, MEC, CAPES e NR-1.'
  },
  {
    href: '/comparativos/',
    rotulo: 'Hub 04',
    titulo: 'Comparativos editoriais',
    resumo: 'MBA versus Especialização Lato Sensu, Mestrado Profissional versus Acadêmico, Formação clínica em abordagem versus pós-graduação genérica, Residência versus Especialização em Saúde.'
  },
  {
    href: '/faq/',
    rotulo: 'Hub 05',
    titulo: `${FAQ_COUNT} FAQs estruturadas`,
    resumo: 'Perguntas frequentes por área e modalidade, com respostas técnicas ancoradas em regulação real (CFP 23/2022 e 31/2022, SATEPSI, CNE/CES 1/2018, NR-1, LBI 13.146/2015, LGPD).'
  },
  {
    href: '/temas/',
    rotulo: 'Hub 06',
    titulo: 'Temas clínicos transversais',
    resumo: 'NR-1 riscos psicossociais, burnout CID-11, TEA adulto nível 1, TDAH adulto, CPTSD, perinatal, primeiro episódio psicótico, prevenção de suicídio, neurodiversidade no trabalho. Cada tema atravessa várias das 18 áreas mapeadas.'
  }
];

interface AreaCard {
  href: string;
  titulo: string;
  cluster: string;
}

const AREAS_DESTAQUE: AreaCard[] = [
  { href: '/areas/psicologia-clinica', titulo: 'Psicologia Clínica', cluster: 'CFP R3' },
  { href: '/areas/psicologia-organizacional-trabalho', titulo: 'Psicologia Organizacional e do Trabalho', cluster: 'CFP R3' },
  { href: '/areas/neuropsicologia', titulo: 'Neuropsicologia', cluster: 'CFP R3' },
  { href: '/areas/psicologia-hospitalar', titulo: 'Psicologia Hospitalar', cluster: 'CFP R3' },
  { href: '/areas/psicologia-juridica-forense', titulo: 'Psicologia Jurídica e Forense', cluster: 'CFP R3' },
  { href: '/areas/avaliacao-psicologica', titulo: 'Avaliação Psicológica', cluster: 'SATEPSI' }
];

// Onda 26: H1 do hero dividido em palavras para revelação em cascata.
// Índices 3 e 4 ("guia", "técnico") recebem o gradiente animado (Onda 29).
const heroWords = 'Pós-graduação em Psicologia, guia técnico para escolher MBA, Especialização Lato Sensu, Mestrado Profissional, Especialização Clínica e Residência.'.split(' ');

// Onda 28: âncoras regulatórias e de evidência citadas no portal (marquee).
// Onda 4 SEO/GEO (03/09/2026): FAQ visível + FAQPage do mesmo array.
const FAQ_HOME = [
  {
    q: "Este portal é o site oficial do IPOG?",
    a: "O portal posgraduacaopsicologia.com é um guia editorial independente, publicado pela Brasil GEO sob responsabilidade editorial de Alexandre Caramaschi. O IPOG aparece como instituição provedora dos cinco MBAs analisados, mas matrícula, valores, calendário e turmas vigentes são tratados exclusivamente em ipog.edu.br. Aqui você encontra análise técnica das modalidades, das áreas e da regulação para decidir com critério antes de procurar a instituição."
  },
  {
    q: "Quais caminhos de formação o guia compara?",
    a: "O guia compara especialização lato sensu, MBA, mestrado profissional, formação em abordagem clínica e residência. São caminhos editoriais, não cinco categorias acadêmicas independentes: MBA integra lato sensu, e formação clínica pode ser curso livre ou especialização. O certificado acadêmico e o registro profissional de especialista no CRP têm requisitos distintos."
  },
  {
    q: "Por onde começar se ainda não sei qual área escolher?",
    a: "Comece pelo hub de áreas, que mapeia as 13 especialidades reconhecidas pelo CFP e áreas correlatas com filtro por cluster e nível regulatório. Depois leia o comparativo dos caminhos de formação e, se o interesse for MBA, as análises independentes dos cinco programas do IPOG. Os guias práticos e as FAQs por tema fecham o percurso com perguntas objetivas sobre regulação, supervisão e carreira."
  },
  {
    q: "Como o conteúdo é verificado e atualizado?",
    a: "Cada página segue padrão editorial com citação no formato (Autor, Ano) para afirmações não triviais, acentuação completa em português do Brasil e revisão antes da publicação. A data de última modificação exibida nos dados estruturados e no sitemap vem do histórico de versões do repositório, o que permite conferir quando o texto mudou. Correções podem ser enviadas pelos canais indicados na página Sobre."
  }
];

const SELOS = ['CFP', 'SATEPSI', 'MEC', 'CAPES', 'NR-1', 'LGPD', 'CID-11 (OMS)', 'NICE', 'Cochrane', 'SciELO', 'PubMed'];
---

<Base title={titulo} description={descricao}>

  <!-- HERO -->
  <section class="home-hero relative overflow-hidden bg-gradient-to-b from-brand-50 to-white border-b border-surface-200">
    <div class="hero-parallax absolute inset-0 opacity-[.5]" aria-hidden="true">
      <span class="orb" style="width:280px;height:280px;top:-60px;left:-40px;background:radial-gradient(closest-side,rgba(30,136,229,.20),transparent);"></span>
      <span class="orb" style="width:220px;height:220px;top:40px;right:6%;background:radial-gradient(closest-side,rgba(245,180,0,.18),transparent);animation-delay:-3s;"></span>
      <span class="orb" style="width:180px;height:180px;bottom:-40px;left:35%;background:radial-gradient(closest-side,rgba(44,71,145,.16),transparent);animation-delay:-6s;"></span>
    </div>
    <div class="home-hero-shell container-page relative">
      <div class="home-hero-layout">
        <div class="home-hero-intro">
          <span class="section-eyebrow hero-enter">Portal editorial independente</span>
          <h1 class="section-h home-hero-title">
            <span class="home-hero-subject">{heroWords.slice(0, 3).join(' ')}</span>{' '}
            <span class="home-hero-summary">{heroWords.slice(3).join(' ')}</span>
          </h1>
          <div class="home-hero-actions hero-enter" style="animation-delay:.21s">
          <a href="/tipos-de-pos-graduacao" class="btn btn-primary btn-lg">
            Ver as cinco modalidades
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 10h12.5l-4.3-4.3 1.4-1.4L19.4 10l-6.8 6.7-1.4-1.4 4.3-4.3H3z"/></svg>
          </a>
          <a href="/mbas/" class="btn btn-secondary btn-lg">
            Ver os 5 MBAs do IPOG
          </a>
        </div>
          <p class="home-hero-disclaimer text-xs text-ink-500 hero-enter" style="animation-delay:.27s">
          Portal independente. Não é o site oficial do IPOG (ipog.edu.br). Matrículas, valores, modalidade e turma vigente sempre no portal oficial.
        </p>
        </div>
        <div class="home-hero-context hero-enter">
          <p class="text-base text-ink-700 leading-relaxed" style="text-align: justify; animation-delay:.14s">
          Portal editorial independente sobre pós-graduação em Psicologia no Brasil, com foco em densidade técnica e clareza regulatória sobre as ofertas do IPOG (Instituto de Pós-Graduação e Graduação). Compara cinco caminhos de formação, incluindo MBA dentro do lato sensu, os 5 MBAs do IPOG em Psicologia em destaque, 18 áreas mapeadas (13 reconhecidas pelo CFP e cinco correlatas estratégicas) e comparativos editoriais entre formatos. Liderança editorial: Alexandre Caramaschi, fundador da Brasil GEO e Chief Strategy Officer da Nuvini (Nasdaq: NVNI).
        </p>
        </div>
      </div>
      <!-- Barra de números com contagem animada -->
      <dl class="home-hero-stats hero-enter" style="animation-delay:.33s">
        {[
          { n: 5, suf: '', label: 'Modalidades canônicas' },
          { n: 18, suf: '', label: 'Áreas mapeadas' },
          { n: 13, suf: '', label: 'Especialidades CFP' },
          { n: 27, suf: '', label: 'Estados cobertos' },
          { n: 300, suf: '+', label: 'Páginas editoriais' }
        ].map(s => (
          <div class="card bg-white/80 border-surface-200 p-4 sm:p-5">
            <dd class="text-2xl sm:text-3xl font-display font-bold text-brand-800" data-countup={s.n} data-countup-suffix={s.suf}>{s.n}{s.suf}</dd>
            <dt class="mt-1 text-[11px] sm:text-xs uppercase tracking-wider text-ink-500 font-semibold">{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- MAPA RÁPIDO DE DECISÃO (por persona) -->
  <section class="home-persona-map bg-brand-900 text-white">
    <div class="container-page py-10 lg:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
        <div class="lg:w-1/3">
          <span class="tag tag-dark mb-3"><span class="w-1.5 h-1.5 rounded-full bg-sun-500"></span> Mapa rápido</span>
          <h2 class="font-display font-bold text-2xl sm:text-3xl leading-tight">Por onde você está chegando?</h2>
          <p class="mt-2 text-white/75 text-sm">Escolha o seu perfil e abrimos a trilha de pós, MBA e área que faz sentido para o seu momento.</p>
        </div>
        <div class="lg:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            { href: '/para-quem/psicologos', titulo: 'Sou psicólogo(a)', desc: 'Aprofundar área clínica, avaliação ou neuro' },
            { href: '/para-quem/rh', titulo: 'Trabalho com RH', desc: 'NR-1, riscos psicossociais, people analytics' },
            { href: '/para-quem/lideres', titulo: 'Lidero pessoas e cultura', desc: 'Liderança positiva, clima e segurança psicológica' },
            { href: '/para-quem/consultores', titulo: 'Atuo em saúde, educação ou consultoria', desc: 'Trilhas aplicadas e certificações' }
          ].map(p => (
            <a href={p.href} class="home-persona-link group flex items-center justify-between gap-3 rounded-xl border border-white/10 px-4 py-3.5">
              <span>
                <span class="block text-sm font-semibold">{p.titulo}</span>
                <span class="block text-[12px] text-white/65 mt-0.5">{p.desc}</span>
              </span>
              <span aria-hidden="true" class="home-persona-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REFERÊNCIAS REGULATÓRIAS -->
  <section class="border-y border-surface-200 bg-surface-50/70 py-4" aria-label="Referências regulatórias e de evidência">
    <div class="container-page flex flex-col sm:flex-row sm:items-center gap-3">
      <span class="shrink-0 text-[11px] uppercase tracking-wider font-semibold text-ink-500">Ancorado em</span>
      <ul class="reference-list text-sm font-semibold text-ink-700">
        {SELOS.map(s => (
          <li><span class="w-1.5 h-1.5 rounded-full bg-brand-300 shrink-0" aria-hidden="true"></span>{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 MODALIDADES CANÔNICAS -->
  <section class="container-page py-16 lg:py-20">
    <div class="max-w-3xl mb-10">
      <span class="section-eyebrow">01 · Cinco caminhos de formação</span>
      <h2 class="section-h text-3xl sm:text-4xl">Pós-graduação em Psicologia no Brasil tem cinco caminhos formais.</h2>
      <p class="mt-3 text-ink-700 text-base sm:text-lg" style="text-align: justify;">
        Cada modalidade tem regulação, carga horária, processo seletivo e saída profissional distintos. Escolher entre elas é a decisão estrutural de carreira; trocar de modalidade no meio do percurso custa tempo e dinheiro.
      </p>
    </div>
    <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {MODALIDADES.map((m, i) => (
        <a href={m.href} class="card-lift card-shine reveal block p-7 group" data-reveal-delay={i * 70}>
          <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">{m.rotulo}</p>
          <h3 class="font-display font-semibold text-xl mt-2 text-ink-900 group-hover:text-brand-800 transition leading-snug">{m.titulo}</h3>
          <p class="mt-3 text-sm sm:text-base text-ink-700 leading-relaxed" style="text-align: justify;">{m.resumo}</p>
          <p class="mt-3 text-xs text-ink-500">Regulação: {m.regulacao}</p>
          <span class="mt-5 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">
            Entrar nesta modalidade <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- SELETOR DE DECISÃO INTERATIVO -->
  <DecisionPicker />

  <!-- HUBS EDITORIAIS -->
  <section class="bg-surface-50 border-y border-surface-200">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <span class="section-eyebrow">02 · Hubs editoriais</span>
          <h2 class="section-h text-3xl sm:text-4xl">Seis entradas, conforme a sua dúvida atual.</h2>
          <p class="mt-3 text-ink-700 text-base sm:text-lg" style="text-align: justify;">
            O portal tem mais de trezentas páginas, organizadas em seis hubs. Escolha pela natureza da sua pergunta agora, sem hierarquia entre eles.
          </p>
        </div>
        <a href="/mapa-do-site" class="inline-flex items-center gap-2 text-brand-700 font-semibold hover:text-brand-800">
          Ver mapa completo <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {HUBS.map((h, i) => (
          <a href={h.href} class="card-lift card-shine reveal block p-6 group bg-white" data-reveal-delay={i * 60}>
            <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">{h.rotulo}</p>
            <h3 class="font-display font-semibold text-lg mt-2 text-ink-900 group-hover:text-brand-800 transition leading-snug">{h.titulo}</h3>
            <p class="mt-3 text-sm text-ink-700 leading-relaxed" style="text-align: justify;">{h.resumo}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm text-brand-700 font-semibold">
              Abrir hub <span aria-hidden="true" class="group-hover:translate-x-0.5 transition">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ÁREAS EM DESTAQUE -->
  <section class="container-page py-16 lg:py-20">
    <div class="max-w-3xl mb-8">
      <span class="section-eyebrow">03 · Áreas em destaque</span>
      <h2 class="section-h text-3xl sm:text-4xl">Seis áreas para explorar sua formação.</h2>
      <p class="mt-3 text-ink-700 text-base sm:text-lg" style="text-align: justify;">
        Seleção editorial para comparar contextos de atuação. Para o mapa completo das 18 áreas, com filtro por cluster e nível regulatório, abra o hub de áreas.
      </p>
    </div>
    <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {AREAS_DESTAQUE.map((a, i) => (
        <a href={a.href} class="card-lift reveal block p-5 group bg-white" data-reveal-delay={i * 50}>
          <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">{a.cluster}</p>
          <h3 class="font-display font-semibold text-base mt-1 text-ink-900 group-hover:text-brand-800 transition leading-snug">{a.titulo}</h3>
        </a>
      ))}
    </div>
    <div class="mt-6">
      <a href="/areas/" class="btn btn-secondary">Ver as 18 áreas mapeadas</a>
    </div>
  </section>

  <!-- DESTAQUE IPOG -->
  <section class="bg-brand-50 border-y border-brand-100">
    <div class="container-page py-16 lg:py-20">
      <div class="max-w-4xl">
        <span class="section-eyebrow">04 · Instituição em destaque</span>
        <h2 class="section-h text-3xl sm:text-4xl">IPOG: cinco programas analisados no portal.</h2>
        <p class="mt-4 text-base sm:text-lg text-ink-700 leading-relaxed" style="text-align: justify;">
          O portal reúne análises independentes de cinco programas relacionados à Psicologia: Psicologia Organizacional e do Trabalho (POT), Psicologia Positiva e Bem-Estar, Reabilitação Neuropsicológica, Neurociência e Psicologia Positiva (NCPP) e Liderança Positiva. As páginas ajudam a examinar grade, metodologia, perfil do aluno e aplicação profissional. Confirme a oferta vigente, a modalidade, as datas e as condições de matrícula diretamente em ipog.edu.br.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="/mbas/" class="btn btn-primary">Ver os 5 MBAs do IPOG</a>
