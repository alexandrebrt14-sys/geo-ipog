      <div>
        <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Tabela 3 — Matriz de risco e encaminhamento</p>
        <div class="overflow-x-auto -mx-4 sm:mx-0">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-100 sticky top-0">
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Nível de risco</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Combinação recomendada</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Racional</th>
              </tr>
