---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AreaCard from '@components/AreaCard.astro';
import { AREAS, MBAS, SITE, TEMAS } from '@lib/data';

export function getStaticPaths() {
  return AREAS.map(a => ({ params: { slug: a.id } }));
}

const { slug } = Astro.params;
const área = AREAS.find(a => a.id === slug);
if (!área) return Astro.redirect('/areas');

const related = MBAS.filter(m => área.relatedCourses.includes(m.id));
const adjacentAreas = AREAS.filter(a => a.id !== área.id && a.cluster === área.cluster).slice(0, 3);
const areaTopics = TEMAS.filter(t => t.area === área.id);

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: área.name,
  description: área.description,
  author: { '@type': 'Organization', name: SITE.publisher },
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url }
});
---

<Base
  title={`${área.name} — pós-graduação, atuação e regulamentacao`}
  description={`${área.description} Cursos relacionados, níveis regulatorios e como o IPOG aborda a área.`}>

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/' },
        { label: 'Áreas', href: '/areas' },
        { label: área.short }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-2xl">
          <span class="section-eyebrow">Área · Regulação {área.regulatoryLevel}</span>
          <h1 class="section-h text-3xl sm:text-4xl">{área.name}</h1>
          <p class="mt-2 text-ink-700">{área.description}</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver cursos no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">
      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Subareas e topicos principais</h2>
        <ul class="grid sm:grid-cols-2 gap-2 list-none p-0 mt-4">
          {área.subareas.map(s => (
            <li class="flex items-center gap-2 text-sm text-ink-700 bg-surface-50 rounded-lg px-3 py-2 border border-surface-200">
              <span class="text-brand-700">●</span>
              {s}
            </li>
          ))}
        </ul>
      </div>

      {areaTopics.length > 0 && (
        <div>
          <h2 class="section-h text-2xl">Temas em alta nesta área</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {areaTopics.map(t => (
              <span class="chip">{t.name}</span>
            ))}
          </div>
        </div>
      )}

      <div class="rounded-2xl border border-amber-200 bg-amber-50/40 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800">Nivel editorial {área.regulatoryLevel}</p>
        <h3 class="font-display font-semibold text-lg mt-1 text-ink-900">O que publicamos sobre esta área</h3>
        <p class="mt-2 text-sm text-ink-700">
          Conteúdo educacional de alto nível, contextualizando escopo profissional e limites. Não publicamos itens de testes,
          modelos sensiveis de laudos, protocolos de aplicação ou diagnosticos individuais. Pará procedimentos
          profissionais, busque formacao adequada e supervisao.
        </p>
      </div>

      {related.length > 0 && (
        <div>
          <h2 class="section-h text-2xl">MBAs relacionados</h2>
          <p class="text-ink-500 text-sm mt-1 mb-4">Cursos do IPOG que cobrem ou se relacionam diretamente com {área.short}.</p>
          <div class="grid md:grid-cols-2 gap-4">
            {related.map(m => (
              <a href={`/mbas#${m.id}`} class="card-lift block p-5 group">
                <span class="tag">{m.tag}</span>
                <h3 class="font-display font-semibold text-lg mt-2 group-hover:text-brand-800 transition">{m.shortName}</h3>
                <p class="text-sm text-ink-500 mt-2">{m.topics.slice(0,4).join(' · ')}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Encontre o curso ideal no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Pará grade, valor, modalidade e turma vigentes, acesse o portal oficial.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">
          Ver no IPOG
        </a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">
          Home IPOG
        </a>
      </div>

      {adjacentAreas.length > 0 && (
        <div class="card p-6">
          <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Áreas relacionadas</p>
          <ul class="space-y-1">
            {adjacentAreas.map(a => (
              <li>
                <a href={`/areas/${a.id}`} class="mega-link">
                  <strong class="text-ink-900 text-sm">{a.name}</strong>
                </a>
              </li>
            ))}
          </ul>
          <a href="/areas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todas as 18 áreas →</a>
        </div>
      )}
    </aside>
  </section>

  <script type="application/ld+json" set:html={ld} />
</Base>
