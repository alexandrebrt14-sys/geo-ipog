---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Psicomotricidade: regulamentação, formação e critérios de prática",
  "description": "Conheça a Lei 13.794/2019, diferencie formação e habilitação e compare propostas de Psicomotricidade com uma ficha de leitura crítica.",
  "route": "/areas/psicomotricidade/",
  "label": "Psicomotricidade",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "A Psicomotricidade é uma profissão regulamentada?",
      "a": "Sim. A Lei nº 13.794/2019 regulamenta a profissão de psicomotricista. A elegibilidade depende das condições previstas no texto legal."
    },
    {
      "q": "Qualquer pós atual habilita automaticamente como psicomotricista?",
      "a": "Não se deve fazer essa inferência. É necessário examinar a trajetória de formação, as regras legais e a base específica apresentada pela instituição."
    },
    {
      "q": "Uma dificuldade motora confirma um diagnóstico?",
      "a": "Não. Uma observação isolada exige contextualização e não substitui avaliação qualificada."
    }
  ],
  "worksheet": {
    "title": "Verificação de uma formação em Psicomotricidade",
    "description": "Documente o que o curso oferece e o que precisa ser esclarecido antes da matrícula.",
    "fields": [
      {
        "label": "Promessa do curso",
        "hint": "Registre a redação pública sobre certificado ou habilitação."
      },
      {
        "label": "Base normativa apresentada",
        "hint": "Anote o dispositivo e o link que a instituição cita."
      },
      {
        "label": "Prática e supervisão",
        "hint": "Que situações e públicos a formação cobre?"
      },
      {
        "label": "Dúvida pendente",
        "hint": "Formule uma pergunta objetiva à coordenação."
      }
    ],
    "checklist": [
      "Consultei a Lei nº 13.794/2019.",
      "Verifiquei a aplicabilidade das regras à minha trajetória.",
      "Separei aprendizado, certificado e habilitação.",
      "Solicitei evidências de supervisão e acessibilidade."
    ]
  },
  "sources": [
    [
      "Lei nº 13.794/2019: regulamentação do psicomotricista",
      "https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2019/lei/l13794.htm"
    ],
    [
      "CFP: registro de especialista",
      "https://site.cfp.org.br/servicos/titulo-de-especialista/"
    ],
    [
      "Lei nº 13.146/2015: inclusão e acessibilidade",
      "https://www.planalto.gov.br/ccivil_03/_ato2015-2018/2015/lei/l13146.htm"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma profissional encontra uma pós que promete habilitar qualquer graduado como psicomotricista. Antes de avaliar a grade ou o preço, ela precisa conferir qual regra permite usar o título e se a promessa corresponde à sua trajetória.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A profissão de psicomotricista é regulamentada pela Lei nº 13.794/2019.</h2>
<p>A <a href="https://www.planalto.gov.br/ccivil_03/_ato2019-2022/2019/lei/l13794.htm">Lei nº 13.794/2019</a> regulamenta a profissão e define condições para o uso do título e o exercício da atividade. Seu artigo 2º contempla formação superior específica e outras situações, incluindo regras de transição. A hipótese relacionada à pós-graduação contém referência temporal de 48 meses após a promulgação. Portanto, uma nova matrícula não pode ser anunciada como habilitação universal apenas porque o curso é uma especialização.</p>
<p>Esse é o primeiro documento a levar à coordenação do curso. Peça que a instituição explique por escrito qual dispositivo se aplica ao seu caso e que resultado acadêmico ou profissional está oferecendo. Não confunda a conclusão de uma disciplina, a especialização em uma área e a habilitação para uma profissão.</p></section>
<section><h2>Corpo e movimento precisam ser lidos no contexto</h2>
<p>A Psicomotricidade aborda relações entre movimento, desenvolvimento e participação em atividades. Uma proposta pode ter finalidade educacional ou de cuidado, conforme contexto e qualificação profissional. A escolha de recursos precisa considerar necessidades, possibilidades e preferências da pessoa, sem interpretar todo comportamento motor como sinal de transtorno.</p>
<p>Uma criança que evita uma brincadeira pode encontrar barreiras de acesso, dificuldades para compreender a atividade ou desconforto naquele ambiente. A observação isolada não permite concluir autismo, ansiedade ou alteração neurológica. O aluno deve aprender a descrever o que vê, reconhecer o que ainda não sabe e formular perguntas adequadas para a equipe.</p>
<p>A <a href="https://www.planalto.gov.br/ccivil_03/_ato2015-2018/2015/lei/l13146.htm">Lei Brasileira de Inclusão</a> oferece referência para discutir participação e acessibilidade. Na análise de uma atividade, pergunte quem consegue participar, quem encontra barreiras e o que precisa ser adaptado. Isso exige escuta e contexto, além de conhecer exercícios.</p></section>
<section><h2>Como comparar propostas de formação</h2>
<div class="table-wrap"><table><thead><tr><th>Critério</th><th>Documento ou resposta a solicitar</th></tr></thead><tbody>
<tr><td>Condição de ingresso e título</td><td>Edital, certificado previsto e fundamento normativo aplicável ao perfil do aluno</td></tr>
<tr><td>Finalidade da prática</td><td>Distinção entre atividades educacionais, avaliação e cuidado especializado</td></tr>
<tr><td>Supervisão</td><td>Quem acompanha a prática e como o aluno recebe feedback</td></tr>
<tr><td>Acessibilidade e segurança</td><td>Como se avaliam ambiente, materiais, participação e necessidade de apoio</td></tr>
<tr><td>Evidência</td><td>Estudos relativos à população e ao resultado anunciado</td></tr>
</tbody></table></div>
<p>A força da proposta aparece na capacidade de explicar escolhas e limites. Um vídeo de atividade prazerosa não prova efeito terapêutico; uma sequência de exercícios sem contexto não prepara o aluno para todas as idades e condições. Peça exemplos de situações em que um recurso precisou ser modificado ou não era apropriado.</p></section>
<section><h2>Especialidade em Psicologia e profissão regulamentada</h2>
<p>O <a href="https://site.cfp.org.br/servicos/titulo-de-especialista/">CFP inclui Psicomotricidade entre suas especialidades</a>. Para a pessoa psicóloga, o registro é uma questão de sua regulamentação profissional. A análise da Lei nº 13.794/2019 e a análise das regras do conselho têm objetos próprios. Uma instituição precisa explicar essas diferenças quando anuncia sua formação a públicos diversos.</p>
<p>Para integrar os campos, consulte <a href="/areas/psicopedagogia/">Psicopedagogia</a> e <a href="/areas/reabilitacao-neuropsicologica/">reabilitação neuropsicológica</a>. A colaboração ganha clareza quando cada profissional sabe a que pergunta pode responder e quando deve solicitar outra contribuição.</p>
<p>No exemplo inicial, a profissional pode decidir adiar a matrícula até receber uma resposta documental sobre a habilitação. Essa é uma decisão completa e útil. Não é necessário supor que uma propaganda imprecisa invalida todo o curso, mas também não é prudente preencher a lacuna com uma interpretação favorável à venda.</p></section>
<section><h2>Transforme a dúvida em uma verificação</h2>
<p>Prepare um registro com a promessa exata, o documento apresentado e o ponto ainda não explicado. Guarde links e datas de consulta. Na comparação, avalie separadamente a utilidade pedagógica do curso e o efeito jurídico anunciado para o certificado.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/eeat-qualidade">E-E-A-T e qualidade</a>, do portal educacional de Alexandre Caramaschi, pode apoiar a identificação de autoria e evidências em páginas de formação. Esse complemento ajuda na leitura crítica; não interpreta sua habilitação individual. Preencha a ficha a seguir com dados públicos e perguntas para a instituição.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
