---
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization, larissaPersonBase, ipogEducationalOrganization } from '@lib/schemas';
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileBottomNav from '@components/MobileBottomNav.tsx';
import SearchOverlay from '@components/SearchOverlay.tsx';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  pageType?: 'website' | 'article';
  showSearchInHeader?: boolean;
  bodyClass?: string;
  searchPrefill?: string;
  noindex?: boolean;
  /**
   * Onda 35: emite um nó WebPage canônico no @graph global desta página.
   * Opt-in (padrão false) PORQUE 315 das 335 páginas já declaram seu próprio
   * nó de página (WebPage/AboutPage/Article/etc.) com @id próprio — emitir por
   * padrão duplicaria esses nós. Ative SOMENTE em páginas que não têm nenhum nó
   * de página (lacuna real). O nó usa @id `#primary-webpage` (distinto de
   * `#webpage` usado por algumas páginas) e inclui speakable para GEO/voz.
   */
  emitWebPage?: boolean;
}

const {
  title = 'Pós-graduação em Psicologia — guia independente para escolher MBA, especialização e área de atuação',
  description = SITE.description,
  canonical = SITE.url + Astro.url.pathname,
  ogImage = SITE.url + '/og-image.jpg',
  pageType = 'website',
  showSearchInHeader = true,
  bodyClass = '',
  searchPrefill = '',
  noindex = false,
  emitWebPage = false
} = Astro.props;

// E-E-A-T: rotas do hub /autismo/* têm Larissa Caramaschi como autora canônica.
// Injeta o Person de Larissa no @graph para que LLMs e Google reconciliem a entidade
// via @id (#larissa-caramaschi), em paralelo ao Person de Alexandre (editor/publisher founder).
const isAutismoRoute = Astro.url.pathname.startsWith('/autismo');
const baseGraph: any[] = [
  {
    '@type': 'WebSite',
    '@id': SITE.url + '/#website',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'pt-BR',
    publisher: { '@id': SITE.url + '/#brasil-geo' },
    copyrightHolder: { '@id': SITE.url + '/#brasil-geo' },
    creator: { '@id': SITE.url + '/#alexandre-caramaschi' },
    disambiguatingDescription: 'Portal independente sobre Pós-Graduações em Psicologia. Não é o site oficial do IPOG (ipog.edu.br). Conteúdo editorial liderado por Alexandre Caramaschi, CEO da Brasil GEO.',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: SITE.url + '/busca?q={search_term}'
      },
      'query-input': 'required name=search_term'
    }
  },
  {
    ...brasilGeoOrganization,
    disambiguatingDescription: 'Brasil GEO opera o portal posgraduacaopsicologia.com como veículo editorial independente. Não é o site oficial do IPOG (ipog.edu.br).'
  },
  alexandrePersonBase,
  // IPOG EducationalOrganization — entidade referenciada por todas as páginas de programa
  // (provider/seller via @id). Injetada globalmente para resolver dangling reference que
  // aparecia em 7+ pontos por página de programa sem definição expandida.
  ipogEducationalOrganization
];
if (isAutismoRoute) {
  baseGraph.push(larissaPersonBase);
}

// Onda 35: nó WebPage opt-in para páginas SEM nó de página próprio (lacuna real).
// @id `#primary-webpage` é estável por URL e distinto de `#webpage` (usado por
// algumas páginas) para nunca colidir/duplicar. url/@id usam a MESMA forma da
// canonical (trailingSlash: 'always'), garantindo coerência com og:url e sitemap.
// speakable (SpeakableSpecification) reusa o conjunto de seletores canônico do
// portal (h1 + TL;DR + perguntas de FAQ) — sinal forte para motores generativos
// e assistentes de voz. NÃO inventa datePublished/dateModified.
if (emitWebPage) {
  baseGraph.push({
    '@type': 'WebPage',
    '@id': canonical + '#primary-webpage',
    url: canonical,
    name: title,
    description,
    inLanguage: 'pt-BR',
    isPartOf: { '@id': SITE.url + '/#website' },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
    publisher: { '@id': SITE.url + '/#brasil-geo' },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.tldr', '.tldr-resposta', '.faq-question']
    }
  });
}
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <script is:inline>
    // Define o tema antes da pintura (evita flash). Padrão: preferência do SO.
    (function () {
      try {
        var t = localStorage.getItem('pp-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) { /* ignora */ }
    })();
  </script>
  {/* Onda 35: theme-color declarativo por esquema de cor. O navegador aplica o
      valor correto ANTES de o JS rodar (sem flash da cor errada na barra do SO).
      O <meta id="meta-theme-color"> abaixo permanece e continua sendo atualizado
      pelo JS quando o usuário alterna o tema manualmente (override sobre o media).
      Light #0F2543 / Dark #0A1626 espelham os valores usados em syncThemeUi(). */}
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0F2543" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A1626" />
  <meta id="meta-theme-color" name="theme-color" content="#0F2543" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Alexandre Caramaschi — Brasil GEO" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />

  <meta property="og:type" content={pageType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Capa do guia independente de pós-graduação em Psicologia" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="image_src" href={ogImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="mask-icon" href="/favicon.svg" color="#0F2543" />
  <!-- Onda 34: PWA manifest (nome/icones/atalhos do app instalavel). -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-title" content="Pós Psicologia" />
  <meta name="application-name" content="posgraduacaopsicologia" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Exo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Onda 33: dns-prefetch para os dominios do Google Analytics. Resolve o DNS
       cedo (handshake mais curto quando o gtag async dispara) sem bloquear o
       render. preconnect adicional ao googletagmanager, que e o primeiro a ser
       requisitado. Nao remove nem atrasa o analytics. -->
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />

  <ViewTransitions />

  {/* Onda 33: Speculation Rules API (navegacao instantanea). Document rules
      com eagerness "moderate" => o navegador faz PRERENDER de links internos
      da mesma origem ao passar o mouse / focar. Complementa (nao duplica) o
      prefetch nativo do Astro: o Astro so PREFETCHA o HTML por viewport; aqui
      adicionamos PRERENDER sob intencao do usuario, um estagio alem. Excluimos
      /busca (resultados dinamicos), ancoras e qualquer URL externa. Progressive
      enhancement: navegadores sem suporte ignoram o bloco silenciosamente. */}
  <script is:inline type="speculationrules" set:html={JSON.stringify({
    prerender: [
      {
        source: 'document',
        where: {
          and: [
            { href_matches: '/*' },
            { not: { href_matches: '/busca*' } },
            { not: { selector_matches: '[rel~="external"]' } },
            { not: { selector_matches: '[target="_blank"]' } }
          ]
        },
        eagerness: 'moderate'
      }
    ]
  })}></script>

  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}></script>
  <script is:inline define:vars={{ gaId: SITE.gaMeasurementId, siteUrl: SITE.url }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', gaId, { send_page_view: true });
    document.addEventListener('astro:after-swap', () => {
      gtag('event', 'page_view', {
        page_title: document.title,
        page_location: window.location.href,
        page_path: window.location.pathname
      });
    });

    function trackOutboundClick(ev) {
      var a = ev.target.closest && ev.target.closest('a[href]');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (!/^https?:\/\//i.test(href)) return;
      var host;
      try { host = new URL(href, location.href).hostname.toLowerCase(); } catch(e) { return; }
      var isIpog = host === 'ipog.edu.br' || host.endsWith('.ipog.edu.br');
      if (!isIpog) return;
      gtag('event', 'click_outbound_ipog', {
        link_url: href,
        link_domain: host,
        link_text: (a.innerText || '').trim().slice(0, 120),
        page_path: location.pathname,
        page_title: document.title
      });
    }
    document.addEventListener('click', trackOutboundClick, { capture: true });
    document.addEventListener('auxclick', trackOutboundClick, { capture: true });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': baseGraph
  })} />
</head>
<body class={`bg-white text-ink-900 ${bodyClass}`} data-search-prefill={searchPrefill || undefined}>
  <div id="reading-progress" role="progressbar" aria-label="Progresso de leitura da página" aria-hidden="true"></div>
  <div id="theme-announce" class="visually-hidden" role="status" aria-live="polite"></div>
  <a href="#main" class="visually-hidden focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:bg-brand-800 focus:text-white focus:px-3 focus:py-2 focus:rounded focus:z-50">
    Pular para o conteúdo principal
  </a>

  <!-- Top utility bar: aviso de portal independente -->
  <div role="region" aria-label="Aviso de portal não oficial" class="bg-brand-900 text-white text-xs sm:text-sm">
    <div class="container-page py-2 flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
      <span class="inline-flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-sun-500" aria-hidden="true"></span>
        <strong class="font-semibold">Portal independente.</strong>
        <span class="opacity-90">Não é o site oficial do IPOG.</span>
      </span>
      <span aria-hidden="true" class="hidden sm:inline opacity-30">|</span>
      <span>Matrículas e ofertas oficiais em
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="font-semibold underline decoration-sun-500 underline-offset-2 hover:text-sun-500">
          ipog.edu.br <span aria-hidden="true">→</span>
        </a>
      </span>
    </div>
  </div>

  <Header showSearch={showSearchInHeader} />

  <main id="main" class="pb-24 lg:pb-0">
    <slot />
  </main>

  <Footer />

  <!-- Mobile bottom navigation (React island for state) -->
  <MobileBottomNav client:load transition:persist transition:name="mobile-nav" />

  <!-- Search overlay (React island) -->
  <SearchOverlay client:idle transition:persist transition:name="search-overlay" />

  <!-- Voltar ao topo (aparece após rolar) -->
  <button id="back-to-top" type="button" aria-label="Voltar ao topo da página">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path d="M12 19V5" /><path d="m5 12 7-7 7 7" />
    </svg>
  </button>

  <!-- Ajuda de atalhos de teclado (tecla ?) -->
  <div id="kbd-help" role="dialog" aria-modal="true" aria-labelledby="kbd-help-title" aria-hidden="true">
    <div class="card shadow-lift max-w-md w-full p-6 animate-scale-in" data-kbd-help-panel>
      <div class="flex items-center justify-between gap-3">
        <h2 id="kbd-help-title" class="font-display font-bold text-lg text-ink-900">Atalhos de teclado</h2>
        <button type="button" data-kbd-help-close class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-surface-200 text-ink-700 hover:border-brand-400" aria-label="Fechar ajuda de atalhos"><span aria-hidden="true" class="text-lg leading-none">×</span></button>
      </div>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-700">
        <li class="flex items-center justify-between gap-4">
          <span>Abrir a busca global</span>
          <span class="shrink-0"><span class="kbd">⌘</span> <span class="kbd">K</span> <span class="text-ink-500 mx-1">ou</span> <span class="kbd">/</span></span>
        </li>
        <li class="flex items-center justify-between gap-4">
          <span>Ir para a página de busca</span>
          <span class="shrink-0"><span class="kbd">G</span> <span class="kbd">S</span></span>
        </li>
        <li class="flex items-center justify-between gap-4">
          <span>Voltar ao topo</span>
          <span class="shrink-0"><span class="kbd">T</span></span>
        </li>
        <li class="flex items-center justify-between gap-4">
          <span>Fechar menus e diálogos</span>
          <span class="shrink-0"><span class="kbd">Esc</span></span>
        </li>
        <li class="flex items-center justify-between gap-4">
          <span>Esta ajuda</span>
          <span class="shrink-0"><span class="kbd">?</span></span>
        </li>
      </ul>
    </div>
  </div>

  <script>
    // Sticky header shadow on scroll
    const onScroll = () => {
      const h = document.getElementById('main-header');
      if (!h) return;
      if (window.scrollY > 6) h.classList.add('shadow-soft', 'is-scrolled');
      else h.classList.remove('shadow-soft', 'is-scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:after-swap', onScroll);
    onScroll();

    // Atalhos de teclado globais: "g" + "s" abre /busca; pré-popula via data-search-prefill quando overlay abre.
    let gPressedAt = 0;
    const isTypingTarget = (target: EventTarget | null) => {
      if (!(target instanceof HTMLElement)) return false;
      const tag = target.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || target.isContentEditable;
    };

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (isTypingTarget(event.target)) return;
      if (event.key === 'g' || event.key === 'G') {
        gPressedAt = Date.now();
        return;
      }
      if ((event.key === 's' || event.key === 'S') && Date.now() - gPressedAt < 1200) {
        event.preventDefault();
        gPressedAt = 0;
        if (window.location.pathname === '/busca') return;
        window.location.assign('/busca');
      }
    });

    // Prefill: quando o overlay abre por trigger [data-open-search], aplicar valor do body[data-search-prefill]
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const trigger = target.closest('[data-open-search]');
      if (!trigger) return;
      const prefill = document.body.getAttribute('data-search-prefill');
      if (!prefill) return;
      // SearchOverlay (Wave 1) lê este atributo após montar o input
      window.setTimeout(() => {
        const input = document.querySelector<HTMLInputElement>('[data-search-input]');
        if (input && !input.value) {
          input.value = prefill;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }, 30);
    });

    // Suporte a timelines de scroll/view em CSS (Ondas 16-17): quando há,
    // o CSS dirige reveal e barra de progresso; o JS só faz o fallback.
    const cssSupports = (prop: string, val: string) => {
      try { return typeof CSS !== 'undefined' && CSS.supports(prop, val); } catch (e) { return false; }
    };
    const supportsScrollTimeline = cssSupports('animation-timeline', 'scroll()');
    const supportsViewTimeline = cssSupports('animation-timeline', 'view()');

    // ── Barra de progresso de leitura + botão "voltar ao topo" ───────────────
    const progressEl = document.getElementById('reading-progress');
    const backTop = document.getElementById('back-to-top');
    const updateScrollUI = () => {
      const doc = document.documentElement;
      if (progressEl && !supportsScrollTimeline) {
        const scrollable = doc.scrollHeight - doc.clientHeight;
        const ratio = scrollable > 0 ? Math.min(1, doc.scrollTop / scrollable) : 0;
        progressEl.style.width = (ratio * 100).toFixed(2) + '%';
      }
      if (backTop) backTop.classList.toggle('is-visible', doc.scrollTop > 600);
    };
    window.addEventListener('scroll', updateScrollUI, { passive: true });
    window.addEventListener('resize', updateScrollUI, { passive: true });
    document.addEventListener('astro:after-swap', updateScrollUI);
    updateScrollUI();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollToTop = () => window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    backTop?.addEventListener('click', scrollToTop);

    // ── Reveal on-scroll (stagger) ───────────────────────────────────────────
    let revealObserver: IntersectionObserver | null = null;
    const initReveal = () => {
      // Navegadores com view-timeline animam .reveal só em CSS (Onda 16).
      if (supportsViewTimeline && !prefersReducedMotion) return;
      const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal:not(.reveal-in)'));
      if (!els.length) return;
      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        els.forEach(el => el.classList.add('reveal-in'));
        return;
      }
      if (!revealObserver) {
        revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const delay = Number(el.dataset.revealDelay || 0);
            window.setTimeout(() => el.classList.add('reveal-in'), delay);
            obs.unobserve(el);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
      }
      els.forEach(el => revealObserver!.observe(el));
    };

    // ── Contadores count-up ──────────────────────────────────────────────────
    const runCountUp = (el: HTMLElement) => {
      const target = Number(el.dataset.countup || el.textContent || '0');
      if (!Number.isFinite(target)) return;
      const suffix = el.dataset.countupSuffix || '';
      const prefix = el.dataset.countupPrefix || '';
      if (prefersReducedMotion) { el.textContent = prefix + target + suffix; return; }
      const duration = 1100;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = prefix + Math.round(target * eased).toString() + suffix;
        if (p < 1) {
          requestAnimationFrame(tick);
        } else if (typeof el.animate === 'function') {
          // WAAPI: pequeno pulso ao concluir a contagem.
          el.animate(
            [{ transform: 'scale(1)' }, { transform: 'scale(1.12)' }, { transform: 'scale(1)' }],
            { duration: 320, easing: 'ease-out' }
          );
        }
      };
      requestAnimationFrame(tick);
    };
    let countObserver: IntersectionObserver | null = null;
    const initCountUp = () => {
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-countup]:not([data-counted])'));
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) { els.forEach(runCountUp); return; }
      if (!countObserver) {
        countObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            el.dataset.counted = '1';
            runCountUp(el);
            obs.unobserve(el);
          });
        }, { threshold: 0.4 });
      }
      els.forEach(el => countObserver!.observe(el));
    };

    const initScrollEffects = () => { initReveal(); initCountUp(); };
    initScrollEffects();
    document.addEventListener('astro:after-swap', initScrollEffects);
    document.addEventListener('astro:page-load', initScrollEffects);

    // ── Overlay de atalhos de teclado (?) ────────────────────────────────────
    const kbdHelp = document.getElementById('kbd-help');
    const openKbdHelp = () => {
      if (!kbdHelp) return;
      kbdHelp.classList.add('is-open');
      kbdHelp.setAttribute('aria-hidden', 'false');
      kbdHelp.querySelector<HTMLButtonElement>('[data-kbd-help-close]')?.focus();
    };
    const closeKbdHelp = () => {
      if (!kbdHelp) return;
      kbdHelp.classList.remove('is-open');
      kbdHelp.setAttribute('aria-hidden', 'true');
    };
    kbdHelp?.addEventListener('click', (event) => {
      const t = event.target as HTMLElement;
      if (t === kbdHelp || t.closest('[data-kbd-help-close]')) closeKbdHelp();
    });

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
      if (isTypingTarget(event.target)) return;
      // "/" abre a busca global
      if (event.key === '/') {
        event.preventDefault();
        document.querySelector<HTMLButtonElement>('[data-open-search]')?.click();
        return;
      }
      // "t" volta ao topo
      if (event.key === 't' || event.key === 'T') {
        if (Date.now() - gPressedAt < 1200) return; // não conflita com a sequência "g"
        event.preventDefault();
        scrollToTop();
        return;
      }
      // "?" abre a ajuda de atalhos
      if (event.key === '?') {
        event.preventDefault();
        if (kbdHelp?.classList.contains('is-open')) closeKbdHelp();
        else openKbdHelp();
        return;
      }
      if (event.key === 'Escape') closeKbdHelp();
    });

    // ── Grupos de FAQ: filtro + expandir/recolher tudo ───────────────────────
    const foldText = (s: string) => (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    const wireFaqGroup = (
      items: HTMLDetailsElement[],
      filter: HTMLInputElement | null,
      toggleAll: HTMLButtonElement | null,
      countEl: HTMLElement | null,
      emptyEl: HTMLElement | null
    ) => {
      const total = items.length;
      const updateCount = (visible: number) => {
        if (countEl) countEl.textContent = visible === total ? `${total} perguntas` : `${visible} de ${total}`;
        if (emptyEl) emptyEl.hidden = visible !== 0;
      };
      updateCount(total);
      filter?.addEventListener('input', () => {
        const term = foldText(filter.value.trim());
        let visible = 0;
        items.forEach(it => {
          const match = !term || foldText(it.textContent || '').includes(term);
          it.hidden = !match;
          if (match) visible++;
        });
        updateCount(visible);
      });
      toggleAll?.addEventListener('click', () => {
        const expand = toggleAll.getAttribute('aria-expanded') !== 'true';
        items.forEach(it => { if (!it.hidden) it.open = expand; });
        toggleAll.setAttribute('aria-expanded', expand ? 'true' : 'false');
        toggleAll.textContent = expand ? 'Recolher tudo' : 'Expandir tudo';
      });
    };

    // Grupos explícitos (componentes FAQAccordion / FAQAccordionInline)
    const initExplicitFaq = () => {
      document.querySelectorAll<HTMLElement>('[data-faq-group]').forEach(group => {
        if (group.dataset.faqBound === '1') return;
        group.dataset.faqBound = '1';
        wireFaqGroup(
          Array.from(group.querySelectorAll<HTMLDetailsElement>('.faq-item')),
          group.querySelector<HTMLInputElement>('[data-faq-filter]'),
          group.querySelector<HTMLButtonElement>('[data-faq-toggle-all]'),
          group.querySelector<HTMLElement>('[data-faq-count]'),
          group.querySelector<HTMLElement>('[data-faq-empty]')
        );
      });
    };

    // Detecção automática: páginas de FAQ que renderizam <details> próprios.
    // Agrupa por contêiner-pai e injeta a barra de filtro + expandir/recolher.
    const TOOLBAR_HTML =
      '<div class="relative flex-1">' +
      '<svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>' +
      '<input type="search" data-faq-filter placeholder="Filtrar perguntas..." aria-label="Filtrar perguntas frequentes" class="w-full pl-10 pr-4 py-2.5 border border-surface-200 rounded-xl text-sm focus:border-brand-400 outline-none bg-white" />' +
      '</div>' +
      '<div class="flex items-center gap-2 shrink-0"><span data-faq-count class="text-xs text-ink-500"></span>' +
      '<button type="button" data-faq-toggle-all class="btn btn-ghost btn-sm" aria-expanded="false">Expandir tudo</button></div>';

    const initAutoFaq = () => {
      const groups = new Map<HTMLElement, HTMLDetailsElement[]>();
      document.querySelectorAll<HTMLDetailsElement>('details').forEach(d => {
        if (d.closest('[data-faq-group]')) return;
        if (!d.querySelector('.faq-answer-text')) return;
        const parent = d.parentElement as HTMLElement | null;
        if (!parent) return;
        if (!groups.has(parent)) groups.set(parent, []);
        groups.get(parent)!.push(d);
      });
      groups.forEach((items, parent) => {
        if (parent.dataset.faqAuto === '1' || items.length < 4) return;
        parent.dataset.faqAuto = '1';
        items.forEach(d => d.classList.add('faq-item'));
        const bar = document.createElement('div');
        bar.className = 'flex flex-col sm:flex-row sm:items-center gap-3 mb-4';
        bar.innerHTML = TOOLBAR_HTML;
        parent.parentElement?.insertBefore(bar, parent);
        const empty = document.createElement('p');
        empty.setAttribute('data-faq-empty', '');
        empty.hidden = true;
        empty.className = 'text-sm text-ink-500 text-center py-6';
        empty.textContent = 'Nenhuma pergunta corresponde ao filtro.';
        parent.parentElement?.insertBefore(empty, parent.nextSibling);
        wireFaqGroup(
          items,
          bar.querySelector<HTMLInputElement>('[data-faq-filter]'),
          bar.querySelector<HTMLButtonElement>('[data-faq-toggle-all]'),
          bar.querySelector<HTMLElement>('[data-faq-count]'),
          empty
        );
      });
    };

    const initFaq = () => { initExplicitFaq(); initAutoFaq(); };
    initFaq();
    document.addEventListener('astro:after-swap', initFaq);

    // ── Alternancia de tema claro/escuro ─────────────────────────────────────
    const themeColorMeta = document.getElementById('meta-theme-color');
    const syncThemeUi = () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (themeColorMeta) themeColorMeta.setAttribute('content', isDark ? '#0A1626' : '#0F2543');
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(btn => {
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        btn.setAttribute('aria-label', isDark ? 'Mudar para tema claro' : 'Mudar para tema escuro');
        btn.setAttribute('title', isDark ? 'Tema claro' : 'Tema escuro');
      });
    };
    syncThemeUi();
    document.addEventListener('click', (event) => {
      const toggle = (event.target as HTMLElement | null)?.closest('[data-theme-toggle]');
      if (!toggle) return;
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      if (next === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('pp-theme', next); } catch (e) { /* ignora */ }
      syncThemeUi();
      const announce = document.getElementById('theme-announce');
      if (announce) announce.textContent = next === 'dark' ? 'Tema escuro ativado.' : 'Tema claro ativado.';
    });
    document.addEventListener('astro:after-swap', syncThemeUi);
  </script>

  <!-- Onda 34: registro do service worker (PWA / offline). Conservador:
       so registra se houver suporte, apos o load, com try/catch, escopo "/".
       Nao forca update loops. -->
  <script is:inline>
    (function () {
      if (!('serviceWorker' in navigator)) return;
      window.addEventListener('load', function () {
        try {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {
            /* falha de registro nao deve quebrar a pagina */
          });
        } catch (e) { /* ignora */ }
      });
    })();
  </script>
</body>
</html>
