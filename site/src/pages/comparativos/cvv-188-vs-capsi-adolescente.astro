              {tabelaRisco.map(row => (
                <tr class="border-b border-surface-200 hover:bg-surface-50">
                  <td class="px-4 py-3 align-top text-ink-900 font-medium">{row.nivel}</td>
                  <td class="px-4 py-3 align-top text-ink-700 font-medium">{row.encaminhamento}</td>
