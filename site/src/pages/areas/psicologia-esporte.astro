---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Psicologia do Esporte: saúde mental, contexto e formação em 2026",
  "description": "Conheça o consenso do COI de 2026 e compare formações em Psicologia do Esporte com critérios de cuidado, confidencialidade e trabalho em equipe.",
  "route": "/areas/psicologia-esporte/",
  "label": "Psicologia do Esporte",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "Psicologia do Esporte trata apenas de desempenho?",
      "a": "Não. O escopo pode incluir participação, relações, saúde mental e contexto esportivo, conforme a demanda e a qualificação profissional."
    },
    {
      "q": "Um wearable avalia sozinho a saúde mental do atleta?",
      "a": "Não. Medidas de dispositivos precisam de contexto e não substituem avaliação profissional."
    },
    {
      "q": "O consenso de 2026 vale como protocolo para qualquer equipe?",
      "a": "Não. Ele se concentra em atletas de elite e exige consideração do contexto. Não autoriza autoaplicação clínica por treinadores."
    }
  ],
  "worksheet": {
    "title": "Mapa de contratação e formação em Psicologia do Esporte",
    "description": "Organize perguntas sobre finalidade, comunicação e qualificação usando um cenário fictício.",
    "fields": [
      {
        "label": "Público e demanda",
        "hint": "Qual contexto esportivo e qual pergunta precisam ser esclarecidos?"
      },
      {
        "label": "Responsabilidades",
        "hint": "Quem solicita, quem participa e quais papéis devem ser definidos?"
      },
      {
        "label": "Confidencialidade",
        "hint": "Que limites de informação precisam constar no acordo?"
      },
      {
        "label": "Formação e apoio",
        "hint": "Que supervisão e rede de encaminhamento serão necessárias?"
      }
    ],
    "checklist": [
      "Distingui desempenho e necessidades de cuidado.",
      "Incluí a participação dos atletas.",
      "Não usei vitória ou dado fisiológico como diagnóstico.",
      "Previ limites de compartilhamento e encaminhamento."
    ]
  },
  "sources": [
    [
      "COI: consenso de saúde mental em atletas de elite, 2026",
      "https://bjsm.bmj.com/content/60/15/1083"
    ],
    [
      "CFP: especialidades e registro profissional",
      "https://site.cfp.org.br/servicos/titulo-de-especialista/"
    ],
    [
      "COI: consenso de 2019, referência histórica substituída pela atualização",
      "https://pubmed.ncbi.nlm.nih.gov/31097450/"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: um clube procura uma psicóloga depois de uma sequência de derrotas. A comissão quer melhorar resultados; alguns atletas relatam receio de pedir ajuda e perder espaço na equipe. O contrato de trabalho precisa esclarecer como o cuidado e a comunicação serão organizados.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>O cuidado no esporte exige objetivos claros e proteção da confidencialidade.</h2>
<p>A Psicologia do Esporte pode abordar aprendizagem, participação, relações de equipe, desempenho e saúde mental, conforme o contexto e a competência profissional. Atuação com esporte de base, lazer e alto rendimento envolve demandas distintas. Uma formação deve mostrar para quais cenários prepara o aluno e quais situações exigem colaboração especializada.</p>
<p>Um pedido para “fortalecer o mental” ainda é pouco definido. Antes de escolher uma técnica, é preciso esclarecer o problema, ouvir os envolvidos e compreender condições de treino, competição e convivência. Uma derrota não permite inferir transtorno, assim como uma vitória não demonstra ausência de sofrimento.</p></section>
<section><h2>O que o consenso do COI de 2026 acrescenta</h2>
<p>O <a href="https://bjsm.bmj.com/content/60/15/1083">consenso do Comitê Olímpico Internacional de 2026 sobre saúde mental em atletas de elite</a> atualiza o documento de 2019. Ele considera fatores individuais e dos ambientes de treinamento e competição, além de barreiras ao acesso ao cuidado. Destaca também necessidades de atletas em transição de carreira, adolescentes e atletas paralímpicos.</p>
<p>As recomendações incluem reconhecimento de dificuldades, avaliação por profissionais qualificados e articulação do cuidado. O documento não é um protocolo de autoaplicação para treinadores. Sua população principal é o esporte de elite; a transferência para outros contextos exige examinar diferenças de recursos, idade, objetivos e condições de participação.</p>
<p>Para a escolha de uma pós, a consequência é concreta: peça que a ementa inclua saúde mental, ambiente e limites profissionais, além de técnicas ligadas ao desempenho. Verifique se a bibliografia discute a atualização de 2026 e como os professores tratam as incertezas da literatura.</p></section>
<section><h2>Separar demandas ajuda a construir o serviço</h2>
<div class="table-wrap"><table><thead><tr><th>Demanda</th><th>Pergunta de planejamento</th><th>Informação que não basta</th></tr></thead><tbody>
<tr><td>Aprendizagem e desempenho</td><td>Que tarefa ou situação precisa ser compreendida?</td><td>Resultado de uma partida isolada</td></tr>
<tr><td>Saúde mental</td><td>Qual fluxo permite acesso a avaliação e cuidado?</td><td>Impressão da comissão sobre motivação</td></tr>
<tr><td>Relações e ambiente</td><td>Como atletas participam e relatam problemas?</td><td>Uma pesquisa sem devolutiva ou possibilidade de ação</td></tr>
<tr><td>Transição e afastamento</td><td>Como a equipe organiza apoio e responsabilidades?</td><td>Um calendário de retorno sem análise individual</td></tr>
</tbody></table></div>
<p>A tabela organiza uma conversa sobre o serviço, sem indicar tratamento ou autorização para treinar e competir. Essas decisões exigem avaliação pertinente e coordenação entre profissionais. Dados fisiológicos de dispositivos não funcionam, sozinhos, como medida diagnóstica de saúde mental.</p></section>
<section><h2>O que uma boa formação deve tornar verificável</h2>
<p>Procure atividades que ensinem a formular demanda, negociar escopo, comunicar limites e receber supervisão. Peça exemplos simulados em que o interesse do contratante difere da necessidade do atleta. O aluno deve aprender a lidar com essa tensão, sem prometer acesso irrestrito da comissão a informações clínicas.</p>
<p>Confirme quem supervisiona, a experiência nos públicos abordados e como a prática será avaliada. A <a href="https://site.cfp.org.br/servicos/titulo-de-especialista/">página do CFP sobre especialidades</a> inclui Psicologia do Esporte. Confira separadamente requisitos acadêmicos, condições de atuação e eventual registro de especialista, sem tratar o certificado como garantia de contratação.</p>
<p>Também peça informação sobre proteção de crianças e adolescentes, acessibilidade e articulação com outros serviços. Uma grade centrada apenas em técnicas de concentração deixa perguntas importantes sem resposta. O plano educativo deve permitir reconhecer quando a demanda ultrapassa a competência disponível.</p></section>
<section><h2>Roteiro para a primeira conversa institucional</h2>
<ol><li>Defina quem solicita o serviço e quais necessidades deverão ser ouvidas.</li><li>Esclareça objetivos, públicos, responsabilidades e limites de compartilhamento.</li><li>Mapeie os recursos de encaminhamento e apoio existentes.</li><li>Combine como avaliar a utilidade do trabalho sem reduzir cuidado a vitórias.</li><li>Preveja revisão do contrato quando a demanda ou o contexto mudar.</li></ol>
<p>No caso hipotético da abertura, a primeira entrega pode ser um acordo sobre finalidade e comunicação, antes de qualquer intervenção. Para aprofundar limites de avaliação, consulte <a href="/areas/avaliacao-psicologica/">Avaliação Psicológica</a>; para acompanhar decisões profissionais, veja <a href="/guias/escolher-supervisor-clinico/">como escolher supervisão</a>.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/letramento-ia-executivos">Letramento em IA</a>, no portal de Alexandre Caramaschi, pode apoiar a análise de riscos e fontes em ferramentas oferecidas a clubes. Não envie registros de atletas a sistemas de IA para obter diagnósticos ou decisões de seleção. Use a ficha para planejar o serviço a partir de informações institucionais públicas ou fictícias.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
