    exemplo: 'MBA em POT com 384 horas, professores 50% mestres/doutores e prova final cumpre os requisitos da Resolução CNE/CES 01/2018.',
    fonte: 'Conselho Nacional de Educação, Câmara de Educação Superior (CNE/CES), Resolução 01/2018',
    vejaTambem: [
      { label: 'MEC', href: '#mec' },
      { label: 'Lato sensu', href: '#lato-sensu' }
    ],
    links: [
      { label: 'Página regulação', href: '/regulacao' },
      { label: 'MBAs mapeados', href: '/mbas' }
