---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, AREAS, MBAS, ESTADOS, PERSONAS, TEMAS } from '@lib/data';

const title = 'Mapa do site — posgraduacaopsicologia.com';
const description = 'Mapa completo do portal independente: áreas da Psicologia, MBAs, comparativos, temas, estados, carreiras, recursos e regulação.';

const groups = [
  {
    heading: 'Guia central',
    items: [
      { href: '/', label: 'Início' },
      { href: '/pos-graduacao-psicologia', label: 'Guia executivo — pós em Psicologia' },
      { href: '/pos-graduacao-psicologia/tipos', label: 'Tipos de pós em Psicologia' },
      { href: '/pos-graduacao-psicologia/como-escolher', label: 'Como escolher uma pós' },
      { href: '/pos-graduacao-psicologia/mba-vs-especializacao', label: 'MBA vs especialização' },
      { href: '/regulacao', label: 'Regulação e ética profissional' }
    ]
  },
  {
    heading: 'Áreas da Psicologia (18)',
    items: [
      { href: '/areas', label: 'Hub de áreas' },
      ...AREAS.map(a => ({ href: `/areas/${a.id}`, label: a.name }))
    ]
  },
  {
    heading: 'MBAs em destaque do IPOG (5)',
    items: [
      { href: '/mbas', label: 'Hub de MBAs' },
      ...MBAS.map(m => ({ href: `/mbas/${m.id}`, label: m.shortName }))
    ]
  },
  {
    heading: 'Comparativos',
    items: [
      { href: '/comparativos', label: 'Hub de comparativos' },
      { href: '/comparativos/pot-vs-gestao-pessoas', label: 'POT vs Gestão de Pessoas' },
      { href: '/comparativos/positiva-vs-organizacional', label: 'Positiva vs Organizacional' },
      { href: '/comparativos/neuropsicologia-vs-reabilitacao', label: 'Neuropsicologia vs Reabilitação' },
      { href: '/comparativos/mba-vs-especializacao', label: 'MBA vs Especialização' },
      { href: '/comparativos/online-vs-presencial', label: 'Online vs Presencial' }
    ]
  },
  {
    heading: 'Temas em alta',
    items: [
      { href: '/temas', label: 'Hub de temas' },
      { href: '/temas/nr1-riscos-psicossociais', label: 'NR-1 e riscos psicossociais' },
      { href: '/temas/saude-mental-trabalho', label: 'Saúde mental no trabalho' },
      { href: '/temas/burnout-prevencao', label: 'Burnout e prevenção' },
      { href: '/temas/ia-em-rh', label: 'IA em RH' },
      { href: '/temas/seguranca-psicologica', label: 'Segurança psicológica' },
      { href: '/temas/cultura-clima-organizacional', label: 'Cultura e clima organizacional' },
      { href: '/temas/people-analytics', label: 'People analytics' },
      { href: '/temas/lideranca-positiva', label: 'Liderança positiva' },
      { href: '/temas/trabalho-hibrido', label: 'Trabalho híbrido' },
      { href: '/temas/diversidade-inclusao', label: 'Diversidade e inclusão' },
      { href: '/temas/neurociencia-aplicada-aprendizagem', label: 'Neurociência aplicada à aprendizagem' }
    ]
  },
  {
    heading: 'Carreira por área',
    items: [
      { href: '/carreira', label: 'Hub de carreira' },
      { href: '/carreira/psicologia-organizacional', label: 'Psicologia Organizacional' },
      { href: '/carreira/neuropsicologia', label: 'Neuropsicologia' },
      { href: '/carreira/saude-mental-corporativa', label: 'Saúde mental corporativa' },
      { href: '/carreira/avaliacao-psicologica', label: 'Avaliação Psicológica' },
      { href: '/carreira/pericia-psicologica', label: 'Perícia Psicológica' },
      { href: '/carreira/consultoria-organizacional', label: 'Consultoria Organizacional' }
    ]
  },
  {
    heading: 'Para quem',
    items: [
      { href: '/para-quem', label: 'Hub de personas' },
      ...PERSONAS.map(p => ({ href: `/para-quem/${p.id}`, label: p.name }))
    ]
  },
  {
    heading: 'Por estado (27)',
    items: [
      { href: '/por-estado', label: 'Hub nacional' },
      ...ESTADOS.map(e => ({ href: `/por-estado/${e.uf.toLowerCase()}`, label: `${e.nome} (${e.uf})` }))
    ]
  },
  {
    heading: 'Recursos',
    items: [
      { href: '/recursos', label: 'Hub de recursos' },
      { href: '/recursos/quiz-qual-mba-psicologia', label: 'Quiz: qual MBA combina com você' },
      { href: '/recursos/checklist-escolher-pos-psicologia', label: 'Checklist de elegibilidade' },
      { href: '/recursos/guia-pos-psicologia', label: 'Guia completo de pós em Psicologia' },
      { href: '/glossario', label: 'Glossário (35 termos)' }
    ]
  },
  {
    heading: 'Cluster IA + Psicologia 2026 (5) — novo',
    items: [
      { href: '/temas/ia-psicologia-2026', label: 'Hub IA + Psicologia 2026' },
      { href: '/temas/ia-psicologia-2026/terapia-digital-chatbots-clinicos-2026', label: 'Terapia digital e chatbots clínicos 2026' },
      { href: '/temas/ia-psicologia-2026/avaliacao-psicologica-ia-satepsi-2026', label: 'Avaliação psicológica com IA e SATEPSI 2026' },
      { href: '/temas/ia-psicologia-2026/papers-2025-2026-saude-mental-ia', label: 'Papers 2025-2026 sobre IA em saúde mental' },
      { href: '/temas/ia-psicologia-2026/ia-na-formacao-do-psicologo-2026', label: 'IA na formação do psicólogo 2026' }
    ]
  },
  {
    heading: 'Conteúdo & Social — Biblioteca (65 trechos)',
    items: [
      { href: '/conteudo-social', label: 'Hub Conteúdo & Social' },
      { href: '/conteudo-social/biblioteca', label: 'Biblioteca — visão geral' },
      { href: '/conteudo-social/biblioteca/mba-vs-especializacao-resposta-quora', label: 'Quora — MBA vs Especialização em Psicologia' },
      { href: '/conteudo-social/biblioteca/5-modalidades-pos-psicologia-ensaio-medium', label: 'Medium — 5 modalidades de pós em Psicologia' },
      { href: '/conteudo-social/biblioteca/nr-1-psicossocial-rh-deveria-saber-linkedin', label: 'LinkedIn — NR-1 psicossocial para RH' },
      { href: '/conteudo-social/biblioteca/psicologo-organizacional-mercado-2026-substack', label: 'Substack — Psicólogo organizacional em 2026' },
      { href: '/conteudo-social/biblioteca/tdc-vs-tcc-vs-act-comparativo-quora', label: 'Quora — TCC vs ACT vs DBT' },
      { href: '/conteudo-social/biblioteca/psicopedagogia-institucional-vs-clinica-reddit', label: 'Reddit — Psicopedagogia institucional ou clínica' },
      { href: '/conteudo-social/biblioteca/avaliacao-psicologica-satepsi-2026-medium', label: 'Medium — Avaliação psicológica e SATEPSI 2026' },
      { href: '/conteudo-social/biblioteca/neuropsicologia-carreira-linkedin', label: 'LinkedIn — Neuropsicologia como carreira' },
      { href: '/conteudo-social/biblioteca/mestrado-profissional-vs-academico-quora', label: 'Quora — Mestrado profissional vs acadêmico' },
      { href: '/conteudo-social/biblioteca/ia-vai-substituir-psicologo-medium', label: 'Medium — IA vai substituir o psicólogo? 5 papers' }
    ]
  },
  {
    heading: 'Territórios clínicos abertos em agosto de 2026 (22) — novo',
    items: [
      { href: '/guias/transtorno-do-jogo-apostas-online-avaliacao-2026', label: 'Guia — transtorno do jogo por apostas online' },
      { href: '/faq/transtorno-do-jogo-apostas-faq', label: 'FAQ — transtorno do jogo e apostas online' },
      { href: '/evidencias/apostas-online-saude-mental-2026', label: 'Evidência — apostas online e saúde mental' },
      { href: '/comparativos/cassino-online-vs-aposta-esportiva-risco-clinico-2026', label: 'Comparativo — cassino online vs aposta esportiva' },
      { href: '/comparativos/entrevista-motivacional-vs-tcc-transtorno-do-jogo', label: 'Comparativo — Entrevista Motivacional vs TCC no jogo' },
      { href: '/metodos/entrevista-motivacional', label: 'Método — Entrevista Motivacional' },
      { href: '/intervencoes/reducao-de-danos', label: 'Intervenção — redução de danos' },
      { href: '/intervencoes/prevencao-de-recaida', label: 'Intervenção — prevenção de recaída' },
      { href: '/guias/insonia-cronica-tcc-i-protocolo-2026', label: 'Guia — TCC-I em insônia crônica' },
      { href: '/comparativos/tcc-i-vs-higiene-do-sono-vs-farmaco-insonia', label: 'Comparativo — TCC-I vs higiene do sono vs fármaco' },
      { href: '/faq/insonia-tcc-i-faq', label: 'FAQ — insônia crônica e TCC-I' },
      { href: '/guias/dor-cronica-manejo-psicologico-2026', label: 'Guia — manejo psicológico da dor crônica' },
      { href: '/comparativos/act-vs-tcc-dor-cronica', label: 'Comparativo — ACT vs TCC na dor crônica' },
      { href: '/faq/dor-cronica-psicologia-faq', label: 'FAQ — dor crônica e psicologia' },
      { href: '/guias/psico-oncologia-cuidados-paliativos-protocolo-2026', label: 'Guia — psico-oncologia e cuidados paliativos' },
      { href: '/intervencoes/cuidados-paliativos-e-fim-de-vida', label: 'Intervenção — cuidados paliativos e fim de vida' },
      { href: '/guias/avaliacao-psicologica-transito-contran-2026', label: 'Guia — perícia em avaliação psicológica no trânsito' },
      { href: '/faq/avaliacao-psicologica-transito-faq', label: 'FAQ — avaliação psicológica no trânsito' },
      { href: '/temas/psicologia-do-transito-mercado-e-regulacao-2026', label: 'Tema — psicologia do trânsito, mercado e regulação' },
      { href: '/evidencias/psicodelicos-assistidos-2026', label: 'Evidência — psicodélicos assistidos' },
      { href: '/evidencias/neuromodulacao-emtr-depressao-2026', label: 'Evidência — neuromodulação em depressão' },
      { href: '/conteudo-social/perguntas-que-a-ia-responde', label: 'Ferramenta — perguntas que a IA responde' }
    ]
  },
  {
    heading: 'Escuta social e pauta (novo)',
    items: [
      { href: '/conteudo-social/dores-que-o-publico-descreve-2026', label: 'Dores que o público descreve em 2026' },
      { href: '/conteudo-social/radar-de-evidencias', label: 'Radar de evidências' },
      { href: '/conteudo-social/kit-de-repurposing', label: 'Kit de repurposing' }
    ]
  }
];
---

<Base title={title} description={description} emitWebPage={true}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Mapa do site' }]} />
      <h1 class="section-h text-3xl sm:text-4xl mt-3">Mapa do site</h1>
      <p class="mt-2 text-ink-700 max-w-3xl">
        Todas as páginas do portal organizadas por categoria. Use este mapa para encontrar rapidamente
        áreas, MBAs, comparativos, temas, estados, carreiras ou recursos. Para a versão XML processada
        por motores de busca, veja <a href="/sitemap.xml" class="text-brand-700 hover:text-brand-800 underline">sitemap.xml</a>.
      </p>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {groups.map(g => (
        <div>
          <h2 class="section-h text-lg mb-3">{g.heading}</h2>
          <ul class="space-y-1.5">
            {g.items.map(it => (
              <li>
                <a href={it.href} class="text-sm text-ink-700 hover:text-brand-800 hover:underline">
                  {it.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
      <h2 class="font-display font-bold text-2xl">Caminho oficial</h2>
      <p class="mt-2 text-white/85 text-sm sm:text-base max-w-2xl">
        Este portal é independente. Para inscrição em qualquer MBA do IPOG, acesse o site oficial.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary">Acessar IPOG oficial →</a>
        <a href="/sitemap.xml" class="btn btn-ghost-dark">Ver sitemap.xml</a>
      </div>
    </div>
  </section>
</Base>
