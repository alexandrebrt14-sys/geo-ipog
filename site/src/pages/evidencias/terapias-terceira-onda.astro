---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Terapias de terceira onda: como comparar ACT, DBT, MBCT e FAP",
  "description": "Compare abordagens por população, intervenção e desfecho. Use uma matriz de leitura crítica com fontes verificáveis e sem equivalência universal.",
  "route": "/evidencias/terapias-terceira-onda/",
  "label": "Terapias de terceira onda",
  "section": "Evidências",
  "sectionPath": "/evidencias/",
  "faqs": [
    {
      "q": "As terapias de terceira onda têm a mesma eficácia?",
      "a": "Não se pode afirmar isso para todas as condições. A comparação depende da intervenção, da população, dos desfechos e do desenho dos estudos."
    },
    {
      "q": "Uma pesquisa de formação comprova efeito clínico?",
      "a": "Não necessariamente. Aprendizagem do terapeuta e resultados para pacientes são desfechos distintos e precisam ser investigados como tais."
    },
    {
      "q": "Como conferir uma referência recente?",
      "a": "Localize o trabalho original e confira título, autores, ano, método e resultado. Não use apenas o resumo comercial de um curso."
    }
  ],
  "worksheet": {
    "title": "Matriz de leitura de evidência em psicoterapia",
    "description": "Relacione uma afirmação à pesquisa que a sustenta e aos seus limites.",
    "fields": [
      {
        "label": "Afirmação e fonte",
        "hint": "Escreva a afirmação e o link do documento original."
      },
      {
        "label": "População e intervenção",
        "hint": "Quem participou e o que foi estudado?"
      },
      {
        "label": "Comparação e desfecho",
        "hint": "Contra o que foi comparado e o que se mediu?"
      },
      {
        "label": "Limite e decisão de estudo",
        "hint": "O que permanece incerto e que leitura falta?"
      }
    ],
    "checklist": [
      "Abri a fonte original.",
      "Distingui estudo clínico, processo e formação.",
      "Não tratei ausência de diferença como equivalência automática.",
      "Minha conclusão respeita a população e o desfecho."
    ]
  },
  "sources": [
    [
      "NICE NG193: ACT e TCC para dor crônica primária",
      "https://www.nice.org.uk/guidance/ng193/chapter/recommendations"
    ],
    [
      "NICE CG78: recomendação específica de DBT",
      "https://www.nice.org.uk/guidance/cg78/chapter/Recommendations"
    ],
    [
      "NICE NG222: MBCT e prevenção de recaída",
      "https://www.nice.org.uk/guidance/ng222/chapter/Recommendations"
    ],
    [
      "Estudo piloto randomizado sobre formação em FAP",
      "https://pubmed.ncbi.nlm.nih.gov/23066926/"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: a coordenação de um ambulatório recebe propostas de formação em ACT, DBT e mindfulness. Todas citam “evidência robusta”, mas se referem a públicos e resultados diferentes. O problema é transformar essas expressões em perguntas comparáveis.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A evidência pertence à intervenção estudada, não ao rótulo de terceira onda.</h2>
<p>Terceira onda é uma expressão usada para agrupar abordagens que dão destaque a contexto, aceitação, atenção, relação terapêutica e outros processos. Esse agrupamento não cria uma unidade clínica: ACT, DBT, MBCT e FAP têm modelos, formatos de trabalho e bases de pesquisa distintos.</p>
<p>Também não é adequado descrever toda TCC como tentativa de “trocar pensamentos negativos por positivos”. Comparações úteis precisam examinar intervenções reais, e não versões simplificadas das escolas. A pergunta é qual proposta tem suporte para a demanda e pode ser oferecida com competência e participação da pessoa.</p></section>
<section><h2>Um mapa de fontes com limites explícitos</h2>
<div class="table-wrap"><table><thead><tr><th>Abordagem</th><th>Exemplo de fonte verificável</th><th>O que não concluir</th></tr></thead><tbody>
<tr><td>ACT</td><td>NICE NG193 considera ACT ou TCC para dor crônica primária em pessoas a partir de 16 anos</td><td>Que ACT seja superior em toda dor ou todo transtorno</td></tr>
<tr><td>DBT</td><td>NICE CG78 descreve uma recomendação específica para programa abrangente</td><td>Que qualquer grupo de habilidades seja equivalente ao programa</td></tr>
<tr><td>MBCT</td><td>NICE NG222 inclui a abordagem em situações de prevenção de recaída em depressão</td><td>Que meditação genérica reproduza a intervenção estudada</td></tr>
<tr><td>FAP</td><td>Há estudos de processos relacionais e de formação de terapeutas</td><td>Que um resultado em treinamento demonstre eficácia para todos os diagnósticos</td></tr>
</tbody></table></div>
<p>As fontes têm finalidades diferentes. O <a href="https://pubmed.ncbi.nlm.nih.gov/23066926/">estudo piloto randomizado sobre treinamento de terapeutas em FAP</a>, por exemplo, examina formação. Não é uma comparação clínica geral entre FAP e outras psicoterapias. Essa distinção evita promover um estudo além do que ele investigou.</p>
<p>Os documentos <a href="https://www.nice.org.uk/guidance/ng193/chapter/recommendations">NG193</a>, <a href="https://www.nice.org.uk/guidance/cg78/chapter/Recommendations">CG78</a> e <a href="https://www.nice.org.uk/guidance/ng222/chapter/Recommendations">NG222</a> permitem conferir a redação completa de cada recomendação. Eles são referências internacionais e devem ser lidos junto ao contexto brasileiro e às necessidades do serviço.</p></section>
<section><h2>Um roteiro para examinar uma afirmação</h2>
<ol><li>Copie a afirmação que pretende avaliar e localize a fonte original.</li><li>Identifique população, intervenção, comparação e desfecho.</li><li>Confira o desenho: estudo clínico, pesquisa de processo, treinamento ou revisão.</li><li>Registre duração do acompanhamento, limitações e conflitos declarados.</li><li>Escreva uma conclusão proporcional aos dados e uma pergunta ainda aberta.</li></ol>
<p>“Não encontrou diferença” não significa automaticamente “provou equivalência”. Da mesma forma, resultado superior a lista de espera não estabelece superioridade sobre outro tratamento. O desenho do estudo e a incerteza das estimativas fazem parte da interpretação.</p>
<p>A preferência da pessoa, a relação terapêutica, a disponibilidade e a acessibilidade importam, mas não apagam diferenças de indicação e competência. Escolher apenas por afinidade entre terapeuta e abordagem pode ignorar o problema que motivou a busca por cuidado.</p></section>
<section><h2>Da revisão para a decisão de formação</h2>
<p>No caso hipotético, o ambulatório pode começar mapeando as demandas efetivamente recebidas e as competências que sua equipe precisa desenvolver. Em seguida, compara programas que apresentem supervisão e atividades compatíveis com esse perfil. O resultado pode ser uma decisão de aprofundar um campo, e não adotar uma escola para todas as pessoas.</p>
<p>Peça aos cursos que demonstrem como ensinam leitura crítica e revisão de decisões. Desconfie de bibliografias com ano recente que não permitem localizar o trabalho citado. Uma edição clássica verificável é mais útil que uma “atualização” sem título, publicação ou link rastreável.</p>
<p>As páginas de <a href="/metodos/act/">ACT</a>, <a href="/metodos/dbt/">DBT</a> e <a href="/metodos/mindfulness/">mindfulness clínico</a> detalham diferenças de formação e serviço. Um curso sobre processos compartilhados pode ampliar repertório, mas não certifica domínio de todos esses modelos.</p></section>
<section><h2>Uma ferramenta simples para a bibliografia</h2>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/segundo-cerebro-agentes-pessoais">Segundo cérebro e agentes pessoais</a>, do portal de Alexandre Caramaschi, pode apoiar uma biblioteca de fontes públicas organizada por pergunta. Mantenha notas de evidência separadas de prontuários. A ficha abaixo funciona como matriz de leitura, sem produzir recomendação clínica automática.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
