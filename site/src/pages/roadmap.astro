const marcosCriticos = [
  { data: '20-05-2026', marco: 'Kit de prompts-âncora principal fechado', detalhe: 'Cobrindo Lato Sensu, MBA, Mestrado Profissional e Especialização Clínica certificada. 50 a 75 prompts.' },
  { data: '30-05-2026', marco: 'Schema Course + EducationalOccupationalProgram validado', detalhe: 'Implementado em ipog.edu.br antes do pico de captação 2026.2. Cobertura para todas as modalidades.' },
