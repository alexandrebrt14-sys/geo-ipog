            <rect x="386" y="44" width="318" height="56" rx="12" fill="none" stroke-width="2" class="stroke-current text-brand-400" />
            <text x="402" y="68" font-size="14" font-weight="600" class="fill-current text-brand-700">Composto ilustrativo, rotulado na tela</text>
