---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS, AREAS } from '@lib/data';

const toc = [
  { id: 'o-que-e', label: '1. O que é pós-graduação em Psicologia' },
  { id: 'lato-stricto', label: '2. Lato sensu vs stricto sensu' },
  { id: 'mba-especializacao-livre', label: '3. MBA, especialização e curso livre' },
  { id: 'areas-cfp', label: '4. As 13 áreas reconhecidas pelo CFP' },
  { id: 'areas-em-alta-2026', label: '5. Áreas em alta em 2026' },
  { id: 'modalidade', label: '6. Como escolher a modalidade' },
  { id: 'corpo-docente', label: '7. Como avaliar o corpo docente' },
  { id: 'mec-cne-ces', label: '8. Como interpretar a regulação do MEC' },
  { id: 'titulo-especialista', label: '9. Título de especialista pelo CFP: o que MBA habilita e o que não' },
  { id: 'satepsi', label: '10. SATEPSI e avaliação psicológica' },
  { id: 'custo-prazo-roi', label: '11. Custo, prazo e ROI honesto' },
  { id: 'diferenciais', label: '12. Diferenciais defensáveis a procurar' },
  { id: 'erros-comuns', label: '13. Erros comuns na decisão' },
  { id: 'ipog-posicionamento', label: '14. Como o IPOG se posiciona' },
  { id: 'portal', label: '15. Como o portal funciona' }
];

const faqs = [
  {
    q: 'O que é pós-graduação lato sensu?',
    a: 'Pós-graduação lato sensu é a família educacional definida pela Resolução CNE/CES 1/2018 do MEC. Reúne especializações e MBAs. Exige carga horária mínima de 360 horas, trabalho de conclusão, corpo docente em parte com stricto sensu. É a formação aplicada típica de quem quer aprofundar prática profissional em campo específico, sem a exigência formal de pesquisa científica.'
  },
  {
    q: 'O que é pós-graduação stricto sensu?',
    a: 'Pós-graduação stricto sensu reúne mestrado e doutorado, regulados pela CAPES. Exige pesquisa científica formal, dissertação ou tese defendida em banca, vinculação a linha de pesquisa de programa avaliado pela CAPES. É a formação típica de quem mira carreira acadêmica, docência em pós-graduação ou pesquisa básica e aplicada. Tem duração tipicamente maior que lato sensu — 24 meses para mestrado, 48 meses para doutorado em média.'
  },
  {
    q: 'MBA em Psicologia dá título de especialista pelo CFP?',
    a: 'Não automaticamente. O título de especialista em Psicologia é tratado pelo Conselho Federal de Psicologia (CFP) com critérios próprios, que envolvem comprovação de experiência profissional e formação teórico-metodológica adequada à especialidade. Um MBA lato sensu pode compor parte dessa formação, mas não substitui o processo formal de obtenção do título. Profissionais que pretendem registro de especialista precisam consultar a resolução vigente do CFP e do CRP da sua jurisdição.'
  },
  {
    q: 'Profissional sem formação em Psicologia pode fazer MBA em Psicologia Organizacional?',
    a: 'Pode. MBAs em Psicologia Organizacional e do Trabalho, em Liderança Positiva ou em Gestão de Pessoas costumam aceitar graduados em Administração, Recursos Humanos, Engenharia, Pedagogia e outras áreas correlatas. A condição é que cada instituição define seus critérios próprios de admissão. A restrição não está no MBA — está no exercício profissional. Avaliação psicológica clínica, aplicação de instrumentos do SATEPSI e psicoterapia são privativos de psicólogos com CRP ativo. O MBA forma repertório, não habilitação clínica.'
  },
  {
    q: 'Qual é o melhor MBA em Psicologia Organizacional reconhecido pelo MEC?',
    a: 'Não existe ranking oficial do MEC para MBAs. O que existe é credenciamento da instituição ofertante. Para avaliar um MBA, observe quatro critérios objetivos: credenciamento da instituição no MEC (lato sensu), composição nominal do corpo docente, formato de aula (Ao Vivo síncrono, gravado, híbrido ou presencial) e rede de egressos. Instituições como o IPOG, que operam há décadas em pós lato sensu reconhecida pelo MEC e mantêm corpo docente nominal com perfil executivo, costumam aparecer no shortlist de profissionais que valorizam presença docente real.'
  },
  {
    q: 'Pós em Avaliação Psicológica é apenas para psicólogos?',
    a: 'A aplicação de instrumentos avaliados pelo SATEPSI é privativa de psicólogos com CRP ativo. Profissionais correlatos podem fazer cursos de fundamentos teóricos em avaliação, mas a aplicação, correção e interpretação clínica de testes psicológicos é regulada. Quem não é psicólogo deve buscar formações em áreas adjacentes que não envolvam psicometria clínica.'
  },
  {
    q: 'Quanto custa uma pós-graduação em Psicologia?',
    a: 'Pós lato sensu em Psicologia tem faixa ampla de preço. Cursos em instituições públicas tendem a ser gratuitos ou ter mensalidade simbólica; cursos em instituições privadas com corpo docente sênior e formato Ao Vivo costumam ter mensalidade entre R$ 600 e R$ 2.500. O total do investimento, em 18 a 24 meses, costuma ficar entre R$ 12.000 e R$ 50.000 [a confirmar com fonte e instituição]. O retorno honesto não está no preço — está no cargo seguinte e na rede formada.'
  },
  {
    q: 'Quanto tempo dura uma pós lato sensu em Psicologia?',
    a: 'A duração padrão é 18 a 24 meses. A Resolução CNE/CES 1/2018 define carga horária mínima de 360 horas; na prática, cursos com 400 a 720 horas se distribuem entre 12 e 24 meses, conforme a intensidade semanal. MBAs executivos costumam manter ritmo de aula quinzenal ou semanal; especializações técnicas variam mais conforme o desenho de cada instituição.'
  },
  {
    q: 'Pós EAD em Psicologia vale a pena?',
    a: 'Depende do formato real. EAD gravado puro tem evasão alta e baixo aprofundamento — quem é autodisciplinado funciona, quem precisa de ritmo externo desiste. EAD Ao Vivo síncrono com docente nominal, em janela definida, é diferente: tem ritmo, troca real, e pode entregar densidade equivalente ao presencial. O critério é o formato, não o rótulo. EAD bom é Ao Vivo, com câmera ligada, com docente presente. EAD ruim é gravação aberta sem ritmo nem suporte.'
  },
  {
    q: 'Posso fazer mais de uma pós em Psicologia?',
    a: 'Pode, e em muitos casos é estratégico. Não existe limite legal. Profissionais que combinam duas pós ao longo da carreira tendem a ocupar posição rara — adquirem profundidade onde tinham apenas amplitude, ou vice-versa. A combinação faz sentido em horizonte de carreira de mais de quinze anos. Em horizonte curto, é mais eficaz concentrar em uma pós bem escolhida do que dispersar em duas medianas.'
  },
  {
    q: 'Vale fazer mestrado ou MBA em Psicologia?',
    a: 'Depende do cargo pretendido. Mestrado é stricto sensu — habilita docência em pós, pesquisa, e sinaliza profundidade acadêmica. MBA é lato sensu — habilita decisão de gestão, sinaliza profundidade executiva. Quem mira universidade, pesquisa ou laboratório: mestrado. Quem mira cargo executivo, gestão de equipe ou consultoria: MBA. Em alguns casos, a carreira pede os dois — primeiro o MBA, depois o mestrado, ou o inverso.'
  },
  {
    q: 'Como saber se a pós é reconhecida pelo MEC?',
    a: 'Pós lato sensu não tem reconhecimento individual de curso — o que existe é credenciamento da instituição. Toda instituição de ensino superior credenciada pelo MEC pode ofertar pós lato sensu desde que cumpra a Resolução CNE/CES 1/2018. Para verificar, consulte o cadastro e-MEC e confirme: a instituição está credenciada, o curso cumpre carga horária mínima de 360 horas, há trabalho de conclusão e corpo docente em parte com stricto sensu. Diplomas emitidos por instituições não credenciadas têm validade questionada.'
  },
  {
    q: 'O que o SATEPSI controla?',
    a: 'O SATEPSI — Sistema de Avaliação de Testes Psicológicos do CFP — avalia a qualidade técnico-científica de instrumentos psicológicos comercializados no Brasil. Cada teste recebe parecer favorável ou desfavorável conforme critérios psicométricos. Apenas testes com parecer favorável podem ser usados profissionalmente por psicólogos. O SATEPSI não regula a formação acadêmica — regula a ferramenta. A formação em avaliação psicológica é tratada nas pós lato sensu específicas.'
  },
  {
    q: 'Carreira em Psicologia Organizacional para psicólogo clínico vale a pena?',
    a: 'Pode valer se a transição responde a uma pergunta concreta. Psicólogos clínicos que migram para POT costumam buscar três coisas: estabilidade de renda em CLT corporativa, escala de impacto que o consultório individual não oferece, e contato com decisão de gestão. A transição funciona quando há leitura honesta — quem ama o consultório clínico não deve migrar; quem busca estrutura organizacional e impacto coletivo, pode. O MBA em POT é a ponte formativa mais comum para essa migração.'
  },
  {
    q: 'A NR-1 muda a demanda por psicólogo no trabalho?',
    a: 'Sim. A NR-1, com a atualização do Anexo sobre gestão de riscos ocupacionais e a incorporação de fatores psicossociais, posiciona o psicólogo organizacional como interlocutor obrigatório no mapeamento e na gestão de riscos psicossociais nas empresas. Empresas estão criando posições específicas para conduzir esse diagnóstico, e RH busca formação técnica para conduzir internamente. Pós em POT, em Psicologia Positiva e em Saúde Mental nas Organizações tendem a destravar essas vagas.'
  },
  {
    q: 'Qual a diferença entre Neuropsicologia e Reabilitação Neuropsicológica?',
    a: 'Neuropsicologia foca em avaliação de funções cognitivas: aplicação de instrumentos, interpretação, laudo. Reabilitação Neuropsicológica foca em intervenção: planos de reabilitação, estimulação cognitiva, reaprendizagem após dano cerebral. As duas áreas se complementam — quem avalia também precisa entender intervenção, e quem reabilita precisa interpretar avaliação. Profissionais experientes costumam transitar entre as duas; pós específicas tendem a aprofundar uma das pontas.'
  },
  {
    q: 'Onde encontro a lista das 13 especialidades reconhecidas pelo CFP?',
    a: 'A lista oficial está no site do CFP, em site.cfp.org.br. As 13 especialidades reconhecidas pelo CFP em Psicologia são: Organizacional e do Trabalho, Neuropsicologia, Avaliação Psicológica, Clínica, Hospitalar, Jurídica, Social, Escolar e Educacional, Psicopedagogia, Psicomotricidade, do Esporte, em Saúde, e de Trânsito e Tráfego. A pós-graduação lato sensu (MBA ou especialização) não concede automaticamente o título de especialista — o registro segue regulação própria do CFP, com comprovação de experiência e formação teórico-metodológica.'
  },
  {
    q: 'Vale fazer pós em IA aplicada à Psicologia?',
    a: 'O campo está em formação. Pós específicas em IA, People Analytics e Psicologia Digital são raras, mas estão surgindo. Para profissionais de RH e de POT, a área é estratégica: dados comportamentais, ética em algoritmos, LGPD aplicada a avaliação, automação de processos seletivos. Para psicólogos clínicos, o campo se aproxima por outra ponta: avaliação digital, chatbots de saúde mental, telessaúde. A decisão deve considerar maturidade do mercado e do próprio currículo do candidato.'
  }
];

const tabelaLatoStricto = [
  { dim: 'Família regulatória', lato: 'Lato sensu (CNE/CES 1/2018)', stricto: 'Stricto sensu (CAPES)' },
  { dim: 'Tipos', lato: 'MBA, especialização', stricto: 'Mestrado, doutorado' },
  { dim: 'Carga horária mínima', lato: '360 horas', stricto: 'Definida por programa CAPES' },
  { dim: 'Duração típica', lato: '12 a 24 meses', stricto: '24 a 48 meses' },
  { dim: 'Trabalho final', lato: 'Monografia ou trabalho de conclusão', stricto: 'Dissertação ou tese com defesa em banca' },
  { dim: 'Foco', lato: 'Aplicação profissional', stricto: 'Produção científica e docência' },
  { dim: 'Habilita docência em pós', lato: 'Em regra, não', stricto: 'Sim' },
  { dim: 'Título de especialista pelo CFP', lato: 'Não automático', stricto: 'Não automático' }
];

const tabelaMbaEspLivre = [
  { dim: 'Validade educacional', mba: 'Lato sensu reconhecida pelo MEC', esp: 'Lato sensu reconhecida pelo MEC', livre: 'Não regulada' },
  { dim: 'Carga horária', mba: '360 a 480 horas', esp: '360 a 720 horas', livre: 'Variável, sem mínimo' },
  { dim: 'Posicionamento', mba: 'Executivo, gestão, decisão', esp: 'Técnico, clínico, acadêmico', livre: 'Atualização ou exploração' },
  { dim: 'Corpo docente', mba: 'Executivos e acadêmicos', esp: 'Predomínio acadêmico/clínico', livre: 'Variável' },
  { dim: 'Emissão de diploma', mba: 'Diploma de pós lato sensu', esp: 'Diploma de pós lato sensu', livre: 'Certificado de extensão' },
  { dim: 'Aceito em concurso público', mba: 'Sim (lato sensu)', esp: 'Sim (lato sensu)', livre: 'Em regra, não' }
];

const especialidadesCFP = [
  { id: 'pot', nome: 'Psicologia Organizacional e do Trabalho', foco: 'Cultura, clima, liderança, saúde mental no trabalho, riscos psicossociais, NR-1' },
  { id: 'neuro', nome: 'Neuropsicologia', foco: 'Avaliação de funções cognitivas, memória, atenção, linguagem, neurodesenvolvimento' },
  { id: 'aval', nome: 'Avaliação Psicológica', foco: 'Psicometria, testes, entrevistas, laudos, pareceres, SATEPSI' },
  { id: 'clinica', nome: 'Psicologia Clínica', foco: 'Psicoterapia individual e em grupo, abordagens, manejo clínico, ética' },
  { id: 'hospitalar', nome: 'Psicologia Hospitalar', foco: 'Atuação em equipe multiprofissional, adesão, luto, humanização do cuidado' },
  { id: 'juridica', nome: 'Psicologia Jurídica', foco: 'Perícia, avaliação em contexto jurídico, vara de família e criminal' },
  { id: 'social', nome: 'Psicologia Social', foco: 'Grupos, comunidade, direitos humanos, vulnerabilidade, políticas públicas' },
  { id: 'escolar', nome: 'Psicologia Escolar e Educacional', foco: 'Aprendizagem, desenvolvimento, inclusão, relação escola-família' },
  { id: 'psicopedagogia', nome: 'Psicopedagogia', foco: 'Dificuldades escolares, intervenção educacional, desenvolvimento infantil' },
  { id: 'psicomotricidade', nome: 'Psicomotricidade', foco: 'Desenvolvimento motor, corpo e movimento, aprendizagem' },
  { id: 'esporte', nome: 'Psicologia do Esporte', foco: 'Performance, motivação, preparação psicológica, carreira esportiva' },
  { id: 'saude', nome: 'Psicologia em Saúde', foco: 'Promoção, prevenção, saúde coletiva, atuação multiprofissional' },
  { id: 'transito', nome: 'Psicologia de Trânsito e Tráfego', foco: 'Avaliação para CNH, segurança, comportamento no trânsito, regulação' }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Pós-graduação em Psicologia no Brasil — guia completo para escolher MBA, especialização e área de atuação',
  description: 'Guia completo e independente sobre pós-graduação em Psicologia no Brasil. Lato sensu vs stricto sensu, MBA vs especialização, as 13 especialidades reconhecidas pelo CFP, regulação do MEC, SATEPSI, custo, prazo e ROI honesto.',
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  about: ['Pós-graduação em Psicologia', 'MBA em Psicologia', 'CFP', 'MEC', 'SATEPSI'],
  audience: { '@type': 'Audience', audienceType: 'Psicólogos, profissionais de RH, líderes, gestores' }
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
