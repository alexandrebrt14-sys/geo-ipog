---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS } from '@lib/data';
import { buildEducationalOccupationalProgram, buildSpeakable } from '@lib/schemas';

const mba = MBAS.find(m => m.id === 'mba-ncpp')!;
const others = MBAS.filter(m => m.id !== 'mba-ncpp');

const title = 'Grade curricular do MBA em Neurociência e Psicologia Positiva — integração ciência e bem-estar';
const description = 'Eixos disciplinares esperados em um MBA que integra neurociência cognitiva e Psicologia Positiva no desenvolvimento humano: cérebro, emoção, aprendizagem, propósito, performance. Grade vigente em ipog.edu.br.';

const FAQS_PAGINA = [
  {
    q: 'Qual a tese epistemológica que une Neurociência e Psicologia Positiva?',
    a: 'A integração contemporânea parte do princípio de que florescimento humano (eudaimonia) tem substrato neurobiológico identificável. Davidson e Lyubomirsky publicaram evidência de que estados afetivos positivos sustentados modificam padrões de ativação cerebral, e que práticas como meditação, gratidão estruturada e cultivo de propósito produzem alterações funcionais mensuráveis (Davidson, 2003). O MBA articula ciência (neurociência cognitivo-afetiva) com aplicação (intervenções positivas em contexto humano), evitando duas armadilhas: a neurociência de palco sem aplicação e a Psicologia Positiva sem evidência neurobiológica.'
  },
  {
    q: 'A grade serve para profissional de educação?',
    a: 'Serve. A grade contemporânea inclui aprendizagem como um dos eixos centrais, articulando bases neuronais (Kandel), emoção e cognição (Damásio), motivação intrínseca (Deci & Ryan) e desenho de ambiente educacional. Educadores que cursam o MBA emergem com vocabulário científico para defender escolhas pedagógicas, desenhar programas socioemocionais com evidência e dialogar com famílias e equipes interdisciplinares. Ementa vigente em ipog.edu.br.'
  },
  {
    q: 'É diferente de uma especialização em Neurociência aplicada?',
    a: 'Sim. Especialização em Neurociência tradicional concentra peso em bases biológicas, métodos de pesquisa e fenômenos cognitivos. O MBA em Neurociência e Psicologia Positiva no Desenvolvimento Humano articula bases científicas com intervenção aplicada para promoção de bem-estar, aprendizagem e desenvolvimento ao longo da vida. O perfil de saída típico do MBA é profissional que opera intervenção fundamentada em ciência, frequentemente em educação, saúde, esporte ou desenvolvimento humano corporativo.'
  }
];

const ldProgram = JSON.stringify({
  '@context': 'https://schema.org',
  ...buildEducationalOccupationalProgram({
    name: `${mba.name} — Grade curricular`,
    slug: `/mbas/${mba.id}/grade-curricular`,
    description: 'Eixos disciplinares esperados em MBA em Neurociência e Psicologia Positiva no Desenvolvimento Humano.',
    programType: 'MBA',
    timeRequired: 'P360H',
    educationalProgramMode: 'blended',
    additionalRecognizedBy: [{
      name: 'IPOG · oferta vigente em ipog.edu.br',
      url: 'https://ipog.edu.br/cursos/pos-graduacao'
    }]
  }),
  occupationalCategory: 'Especialista em desenvolvimento humano, Consultor em aprendizagem, Profissional de performance',
  isPartOf: { '@id': `${SITE.url}/mbas/${mba.id}#program` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.section-h', '#resposta-rapida'] }
});

const ldFaq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_PAGINA.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs', href: '/mbas' }, { label: mba.shortName, href: `/mbas/${mba.id}` }, { label: 'Grade curricular' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">MBA · {mba.tag}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Grade curricular esperada em um MBA em Neurociência e Psicologia Positiva</h1>
          <p class="mt-2 text-ink-700">Análise editorial dos eixos disciplinares típicos: bases neuronais da emoção, aprendizagem, propósito, performance, intervenções positivas com evidência neurobiológica. Para a grade vigente do programa do IPOG, consulte o portal oficial.</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver grade vigente no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Resposta rápida</p>
        <p class="text-ink-900 font-medium leading-relaxed">Grade típica articula 9 a 11 eixos cruzando neurociência (bases neuronais, emoção, memória, aprendizagem) e Psicologia Positiva (PERMA, forças, propósito, intervenções com evidência). Carga 432-560h em 18-24 meses. Diferencial é a integração explícita: aprendizagem com substrato neuronal, bem-estar com correlato neurobiológico. Grade vigente no portal oficial do IPOG.</p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Por que essa grade exige leitura redobrada</h2>
        <p>Programas que prometem integrar Neurociência e Psicologia Positiva são especialmente sensíveis a duas patologias pedagógicas. A primeira é a neurociência de palco: aulas que mostram imagens coloridas de cérebro, mencionam dopamina e ocitocina como ativos de marketing emocional, e não entregam conhecimento aplicável. A segunda é a Psicologia Positiva sem evidência: práticas baseadas em retórica afirmativa, sem correlato neurobiológico estudado nem meta-análise que sustente o efeito (Davidson, 2003). Uma grade séria precisa imunizar contra as duas.</p>
        <p>A imunização passa por três marcas. Primeiro: presença de autores fundadores em ambos os campos (Kandel, Damásio, LeDoux na neurociência; Seligman, Csikszentmihalyi, Fredrickson, Lyubomirsky na Positiva). Segundo: mergulho em mecanismos neuronais de bem-estar com material primário, não divulgação. Terceiro: vínculo explícito com aplicação aplicada — aprendizagem, performance, desenvolvimento humano organizacional, educação. Grade que entrega esses três vetores forma profissional capaz de operar com fundamentação. Grade que entrega apenas vocabulário forma divulgador.</p>
        <p>Esta página descreve o que esperar tecnicamente de uma grade contemporânea, sem reproduzir documento oficial. Para a grade vigente do IPOG, com disciplinas, ementas e bibliografia, consulte ipog.edu.br.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Eixos disciplinares esperados</h2>
        <ol class="space-y-3">
          <li class="card p-5"><strong class="text-brand-800">1. Bases de neurociência cognitivo-afetiva.</strong> Anatomia funcional, sistemas neurais da emoção (LeDoux, 2002), integração emoção-cognição (Damásio, 1994), neuromoduladores.</li>
          <li class="card p-5"><strong class="text-brand-800">2. Memória, aprendizagem e neuroplasticidade.</strong> Kandel (2000), princípios de consolidação, aprendizagem ao longo da vida, mecanismos de mudança.</li>
          <li class="card p-5"><strong class="text-brand-800">3. Fundamentos de Psicologia Positiva.</strong> Seligman, Csikszentmihalyi, Fredrickson, Diener; epistemologia do campo; diferença hedonismo vs eudaimonia.</li>
          <li class="card p-5"><strong class="text-brand-800">4. Bases neurobiológicas do bem-estar.</strong> Davidson (2003), padrões de ativação em estados positivos sustentados, neurobiologia da meditação e regulação emocional.</li>
          <li class="card p-5"><strong class="text-brand-800">5. Motivação, propósito e flow.</strong> Deci & Ryan (autodeterminação), Csikszentmihalyi (flow), neurobiologia da motivação intrínseca.</li>
          <li class="card p-5"><strong class="text-brand-800">6. Aprendizagem ao longo da vida.</strong> Plasticidade adulta, andragogia, desenho de experiência educativa fundamentado em ciência.</li>
          <li class="card p-5"><strong class="text-brand-800">7. Performance, alta performance e recuperação.</strong> Bases neurobiológicas da performance sustentável, ciclos de carga e recuperação, prevenção de exaustão.</li>
          <li class="card p-5"><strong class="text-brand-800">8. Intervenções positivas com evidência neurobiológica.</strong> Práticas com efeito estudado: mindfulness, gratidão, melhor self futuro, propósito articulado.</li>
          <li class="card p-5"><strong class="text-brand-800">9. Aplicações em desenvolvimento humano organizacional.</strong> Programas de desenvolvimento, liderança fundamentada em ciência, cultura de aprendizagem.</li>
          <li class="card p-5"><strong class="text-brand-800">10. Aplicações em educação e desenvolvimento infantil.</strong> Neuroeducação, socioemocional com base científica, desenvolvimento ao longo da vida.</li>
          <li class="card p-5"><strong class="text-brand-800">11. Ética, regulação e atuação responsável.</strong> Limites do não psicólogo, ética em pesquisa aplicada, LGPD em dados de bem-estar.</li>
        </ol>
        <p class="text-sm text-ink-600 mt-4">Ordem e nomes formais variam por edição. Grade vigente em ipog.edu.br.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Distribuição típica de carga horária</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-surface-200 rounded-lg overflow-hidden">
            <thead class="bg-surface-50 text-ink-700">
              <tr>
                <th class="text-left p-3 border-b border-surface-200">Bloco</th>
                <th class="text-left p-3 border-b border-surface-200">Conteúdo dominante</th>
                <th class="text-left p-3 border-b border-surface-200">Carga esperada</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3 align-top font-medium">Bases neurocientíficas</td><td class="p-3 align-top">Anatomia funcional, emoção, memória, plasticidade</td><td class="p-3 align-top">72-96h</td></tr>
              <tr><td class="p-3 align-top font-medium">Fundamentos Positiva</td><td class="p-3 align-top">PERMA, forças, flow, autores fundadores</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Integração científica</td><td class="p-3 align-top">Bases neurobiológicas do bem-estar</td><td class="p-3 align-top">48-64h</td></tr>
              <tr><td class="p-3 align-top font-medium">Aprendizagem e performance</td><td class="p-3 align-top">Aprendizagem ao longo da vida, alta performance</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Aplicações organizacionais</td><td class="p-3 align-top">Desenvolvimento humano, liderança</td><td class="p-3 align-top">32-48h</td></tr>
              <tr><td class="p-3 align-top font-medium">Aplicações educacionais</td><td class="p-3 align-top">Neuroeducação, socioemocional</td><td class="p-3 align-top">32-48h</td></tr>
              <tr><td class="p-3 align-top font-medium">Metodologia e TCC</td><td class="p-3 align-top">Projeto aplicado, orientação, defesa</td><td class="p-3 align-top">40-80h</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-ink-600 mt-3">Total típico 432-560h. Mínimo regulatório de 360h para lato sensu (CNE/CES 01/2018).</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">TCC e projeto aplicado</h2>
        <p class="text-ink-700">Em programas integradores como este, o TCC tende a articular dois polos: revisão de evidência neurobiológica e desenho de intervenção aplicada. Três formatos predominam.</p>
        <div class="grid sm:grid-cols-3 gap-4 mt-4">
          <div class="card p-5"><p class="font-semibold text-brand-800">Programa de desenvolvimento</p><p class="text-sm text-ink-700 mt-2">Desenho de programa institucional (educacional, corporativo ou clínico) com fundamentação em neurociência e Psicologia Positiva, com indicadores de efeito.</p></div>
          <div class="card p-5"><p class="font-semibold text-brand-800">Revisão integrativa</p><p class="text-sm text-ink-700 mt-2">Síntese crítica de literatura conectando achado neurobiológico e intervenção positiva aplicada, com proposta de protocolo testável.</p></div>
          <div class="card p-5"><p class="font-semibold text-brand-800">Estudo piloto</p><p class="text-sm text-ink-700 mt-2">Aplicação preliminar de intervenção em grupo pequeno, com medida pré-pós e análise descritiva.</p></div>
        </div>
      </div>

      <div class="rounded-2xl border-l-4 border-sun-500 bg-sun-50/40 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · TCC integrador</p>
        <p class="text-ink-900 leading-relaxed">Um pedagogo coordenador de séries finais em uma escola particular escolheu como TCC o desenho de um programa socioemocional de doze semanas para alunos do nono ano. Baseou-se em três pilares: práticas de regulação emocional fundamentadas em LeDoux e neurobiologia da amígdala, intervenções positivas com evidência empírica (gratidão, forças, melhor self futuro) e princípios de motivação intrínseca de Deci & Ryan. Aplicou WEMWBS pré e pós em 84 alunos. O programa mostrou ganho significativo em bem-estar autorrelatado e em engajamento acadêmico relatado pelos professores. O TCC foi adotado pela escola e ele virou coordenador pedagógico responsável por desdobramento do programa em outras séries. O ganho real foi metodológico: ele passou a operar com programa fundamentado em ciência, não com atividade isolada inspirada em palestra.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
          {FAQS_PAGINA.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-ink-900">
                <span>{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
        <h2 class="font-display font-bold text-2xl">Síntese e próximo passo</h2>
        <ul class="mt-4 space-y-2 text-white/85 text-sm">
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Grade séria imuniza contra neurociência de palco e contra Positiva sem evidência.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>9 a 11 eixos integrando ciência neurobiológica e intervenção aplicada.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Carga 432-560h. TCC integrador articulando evidência e aplicação.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Próximo passo: validar grade, bibliografia e docentes em ipog.edu.br.</span></li>
        </ul>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-5">Conhecer a grade no IPOG →</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Ver grade vigente no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Portal independente. Grade, ementas, bibliografia e docentes no portal oficial.</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outras seções deste MBA</p>
        <ul class="space-y-1">
          <li><a href={`/mbas/${mba.id}`} class="mega-link"><strong class="text-ink-900 text-sm">Visão geral do MBA</strong></a></li>
          <li><a href={`/mbas/${mba.id}/metodologia`} class="mega-link"><strong class="text-ink-900 text-sm">Metodologia</strong></a></li>
          <li><a href={`/mbas/${mba.id}/perfil-do-aluno`} class="mega-link"><strong class="text-ink-900 text-sm">Perfil do aluno</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros MBAs</p>
        <ul class="space-y-1">
          {others.map(o => (
            <li><a href={`/mbas/${o.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{o.shortName}</strong><br/><span class="text-xs text-ink-500">{o.tag}</span></a></li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes</p>
        <ul class="text-xs text-ink-600 space-y-2">
          <li>Davidson, R. (2003). Affective neuroscience and well-being.</li>
          <li>Kandel, E. (2000). Principles of Neural Science.</li>
          <li>Damásio, A. (1994). Descartes' Error.</li>
          <li>LeDoux, J. (2002). Synaptic Self.</li>
          <li>Lyubomirsky, S. (2008). The How of Happiness.</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldProgram} />
  <script type="application/ld+json" set:html={ldFaq} />
</Base>
