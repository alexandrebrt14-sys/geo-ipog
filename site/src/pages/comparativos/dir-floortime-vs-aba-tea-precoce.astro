---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import { SITE, MBAS } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const faqs = [
  {
    q: 'DIR/Floortime e ABA são abordagens rivais em TEA?',
    a: 'Não. ABA e DIR/Floortime partem de pressupostos teóricos distintos — comportamental clássica (Skinner, Lovaas 1987) e desenvolvimentista relacional (Greenspan e Wieder, 1997) — mas a clínica contemporânea de TEA precoce raramente trabalha com versões puras. Boshoff e colaboradores (2024, Autism Research, DOI 10.1002/aur.2998) revisaram sistematicamente 22 ensaios sobre DIR/Floortime e documentam ganhos moderados em comunicação social (tamanho de efeito 0,65) com evidência ainda limitada quanto a transferência funcional ampla. Rogers e Dawson (2019, Early Start Denver Model) consolidaram NDBI (Naturalistic Developmental Behavioral Interventions) como categoria que integra princípios comportamentais com framework desenvolvimentista. O ABA contemporâneo já incorpora elementos naturalísticos; o DIR/Floortime contemporâneo absorveu coleta sistemática de dados. A escolha responde a perfil clínico, idade, contexto familiar e disponibilidade local de profissional formado.'
  },
  {
    q: 'Qual a evidência específica de DIR/Floortime em TEA precoce?',
    a: 'Boshoff e colaboradores (2024, revisão sistemática de 22 estudos, DOI 10.1002/aur.2998) reportam ganhos moderados em comunicação social (ES 0,65), engajamento relacional e regulação emocional, com 17 dos 22 estudos mostrando efeito positivo em pelo menos um desfecho. Pajareya e Nopmaneejumruslers (2011) randomizaram 32 crianças com TEA precoce para Floortime + intervenção padrão versus apenas padrão por 3 meses, com ganho significativo em FEAS (Functional Emotional Assessment Scale). Solomon e colaboradores (2014) descrevem o programa PLAY Project (Play and Language for Autistic Youngsters) baseado em DIR com gains comparáveis em coorte de 128 crianças. Limitações reconhecidas: variabilidade metodológica entre estudos, amostras pequenas em alguns ensaios, e definição variável de "fidelidade" à abordagem. Para TEA precoce 12-48 meses, evidência é moderada e em consolidação.'
  },
  {
    q: 'ABA em TEA precoce tem corpo de evidência maior que DIR/Floortime?',
    a: 'Sim, com nuance. ABA tradicional (Lovaas 1987) e Modelo Denver/ESDM (Dawson et al., 2010, Pediatrics) acumulam corpo de evidência mais amplo em TEA precoce, com múltiplos RCTs robustos. Dawson e colaboradores (2010) randomizaram 48 crianças entre 18 e 30 meses para ESDM por 20 horas/semana durante 2 anos, com ganho médio de 17,6 pontos em QI versus 7 do controle, além de revisão diagnóstica em 29% das crianças. DIR/Floortime tem corpo menor mas crescente — Boshoff et al. (2024) consolidam 22 estudos, ainda heterogêneos. A nuance: nem todas as variantes de ABA têm a mesma evidência — DTT clássico (Discrete Trial Training) tem volume maior mas crítica metodológica de generalização; NDBIs (que incluem ESDM e absorvem princípios desenvolvimentistas próximos do DIR) têm evidência intermediária e crescente. A comparação justa é ABA-DTT clássico × DIR/Floortime, ou ESDM × DIR/Floortime — não "ABA em geral" × DIR.'
  },
  {
    q: 'Como acessar DIR/Floortime e ABA no Brasil?',
    a: 'ABA tem rede mais consolidada no Brasil — centros especializados em capitais com BCBAs (Board Certified Behavior Analysts) supervisionando RBTs (Registered Behavior Technicians). Cobertura por planos de saúde foi ampliada após decisões da ANS e do STJ (Lei 14.454/2022 sobre rol exemplificativo), com terapias com analista comportamental incluídas em planos sob prescrição médica. DIR/Floortime tem rede menor — formação ICDL (Interdisciplinary Council on Development and Learning) é internacional e tem custo elevado, com profissionais brasileiros certificados concentrados em São Paulo e Rio de Janeiro. SUS oferece intervenções em CAPSi (Centros de Atenção Psicossocial Infantojuvenil) e em CER (Centros Especializados em Reabilitação) com abordagens variadas — frequentemente híbridas, conforme formação do profissional disponível. Acesso é parte da equação clínica responsável — "qual modalidade o profissional disponível domina com supervisão adequada" pode ser mais relevante que "qual é teoricamente melhor".'
  }
];

const tabelaMecanismo = [
  { dimensao: 'Fundador / referência', dir: 'Stanley Greenspan e Serena Wieder (1997, Infant Mental Health Journal)', aba: 'Ivar Lovaas (1987, UCLA) — pioneiro do ABA em TEA; ESDM em 2010 com Rogers e Dawson' },
  { dimensao: 'Pressuposto central', dir: 'Desenvolvimento emocional como matriz da cognição — circuitos de regulação afetiva e engajamento relacional são base para aprendizagem', aba: 'Princípios da análise do comportamento — reforço, modelagem, generalização; ESDM integra desenvolvimentista' },
  { dimensao: 'Contexto de aplicação', dir: 'Naturalístico em interação afetiva — chão, brincadeira simbólica seguindo afeto da criança', aba: 'Estruturado (DTT clássico) ou naturalístico (NDBI, ESDM); ESDM operando em brincadeira e rotinas' },
  { dimensao: 'Foco da intervenção', dir: 'Seis estágios funcionais emocionais (FEAS) — atenção compartilhada, engajamento, reciprocidade afetiva, comunicação proposital, ideias, pensamento lógico-emocional', aba: 'Comportamentos discretos definidos operacionalmente; em ESDM, objetivos em contexto natural' },
  { dimensao: 'Intensidade típica', dir: '20 horas semanais — incluindo sessões com terapeuta e ampliação parental nas rotinas', aba: '20 a 40 horas semanais; ESDM 15 a 25 horas' },
  { dimensao: 'Idade ideal de início', dir: 'Desde primeiros sinais (8-12 meses) até pré-escolar; foco em janelas de plasticidade emocional', aba: 'ABA: qualquer idade, mais consolidado em 4+ anos; ESDM: 12 a 48 meses' },
  { dimensao: 'Envolvimento parental', dir: 'Central — pais treinados como agentes primários do Floortime nas rotinas afetivas diárias', aba: 'Variável; ABA tradicional pode ser baixo; ESDM (P-ESDM) tem treino parental central' },
  { dimensao: 'Coleta de dados', dir: 'FEAS, escalas qualitativas de engajamento, registro narrativo de progresso emocional', aba: 'ABA: dados sistemáticos a cada ensaio discreto (DTT) ou em probes ESDM; Curriculum Checklist em ESDM' },
  { dimensao: 'Profissionais', dir: 'Terapeutas certificados pelo ICDL (Interdisciplinary Council); psicólogos, fonoaudiólogos, terapeutas ocupacionais', aba: 'ABA: BCBA + RBT; ESDM: profissionais ESDM-certificados (MIND Institute, UC Davis)' },
  { dimensao: 'Crítica recorrente', dir: 'Heterogeneidade metodológica em estudos; menor corpo de RCT robusto; definição variável de "fidelidade"', aba: 'ABA-DTT clássico: crítica de generalização e ética sobre normalização forçada (movimento neurodiverso); ESDM: faixa etária restrita' }
];

const tabelaEvidencia = [
  { dimensao: 'Volume de RCT', dir: '5 RCTs e 17 estudos não randomizados em meta-análise (Boshoff et al., 2024)', aba: 'Mais de 30 RCTs em ABA-DTT desde 1987; ESDM com 5+ RCTs robustos desde 2010', vantagem: 'ABA' },
  { dimensao: 'Tamanho de efeito em comunicação social', dir: 'ES 0,65 — moderado (Boshoff et al., 2024)', aba: 'ESDM: ganho QI 17,6 pontos vs 7 no controle (Dawson 2010); ABA-DTT: ganhos variáveis', vantagem: 'ABA/ESDM' },
  { dimensao: 'Generalização para contextos novos', dir: 'Naturalística desde o desenho — generalização embutida', aba: 'ABA-DTT clássico: crítica frequente de generalização limitada; ESDM: generalização melhor que DTT puro', vantagem: 'DIR' },
  { dimensao: 'Regulação emocional', dir: 'Eixo central da abordagem — ganhos consistentes em FEAS', aba: 'ABA: foco em comportamento, regulação emocional não é alvo direto; ESDM: parcial', vantagem: 'DIR' },
  { dimensao: 'Comportamentos restritivos e repetitivos severos', dir: 'Não desenhada como foco principal', aba: 'ABA com avaliação funcional do comportamento (FBA) é padrão-ouro', vantagem: 'ABA' },
  { dimensao: 'Revisão diagnóstica em precoces', dir: 'Casos descritos em estudos qualitativos; sem dados numéricos consolidados', aba: 'ESDM: 29% das crianças com revisão diagnóstica em Dawson et al. (2010)', vantagem: 'ABA/ESDM' },
  { dimensao: 'Aplicabilidade em famílias com baixa renda', dir: 'P-DIR amplifica horas via integração parental; treinamento de pais é central', aba: 'ABA intensivo exige equipe profissional; ESDM (P-ESDM) tem variante parental', vantagem: 'Equivalente' },
  { dimensao: 'Aceitação pela comunidade neurodiversa', dir: 'Mais alinhada com paradigma de suporte ao desenvolvimento autêntico', aba: 'ABA-DTT clássico recebe críticas por normalização; ESDM mais aceito', vantagem: 'DIR' },
  { dimensao: 'Disponibilidade no Brasil', dir: 'Rede pequena — profissionais ICDL-certificados concentrados em SP/RJ', aba: 'Rede ampla — BCBAs e RBTs em todas as capitais', vantagem: 'ABA' }
];

const tabelaCenarios = [
  { cenario: 'Criança 24 meses com TEA, família engajada, classe média', sus: 'CAPSi com abordagem híbrida disponível', privado: 'P-ESDM ou DIR/Floortime — escolha por afinidade familiar e profissional disponível', escola: 'Berçário inclusivo com adaptações sensoriais' },
  { cenario: 'Criança 30 meses com TEA, comportamento desafiador (autolesão, agressividade)', sus: 'CAPSi + acompanhamento neurologia pediátrica', privado: 'ABA intensivo com FBA + BIP em primeira linha', escola: 'Educação especial com mediador escolar' },
  { cenario: 'Criança 18 meses com sinais precoces de TEA, sem diagnóstico formal', sus: 'CER com avaliação ampla; rede de estimulação precoce', privado: 'DIR/Floortime ou P-ESDM com foco em engajamento relacional', escola: 'Creche com baixa estimulação sensorial' },
  { cenario: 'Criança 36 meses com TEA leve, boa motivação social, família baixa renda', sus: 'CAPSi + grupo de família; CER pode oferecer Floortime adaptado', privado: 'Frequentemente inviável por custo — articular SUS + escola é caminho prático', escola: 'Escola regular com mediador parcial e plano educacional individualizado' },
  { cenario: 'Criança 42 meses com TEA, atraso de linguagem expressiva, sem comportamentos desafiadores', sus: 'CAPSi + fonoaudiologia ambulatorial; CER quando disponível', privado: 'NDBI (ESDM ou DIR) com componente comunicacional intenso', escola: 'Educação infantil com fonoaudiologia escolar e adaptações comunicacionais (CAA)' },
  { cenario: 'Criança 48 meses com TEA, transição para ensino fundamental, comorbidade TDAH', sus: 'CAPSi + psicologia escolar; encaminhamento neuro-pediátrico', privado: 'ABA + acompanhamento psiquiátrico; mediador escolar', escola: 'Plano Educacional Individualizado (PEI) com base na LBI; adaptações curriculares' },
  { cenario: 'Criança 22 meses com TEA severo, hipersensibilidade sensorial extrema, sem fala', sus: 'CAPSi com terapia ocupacional sensorial; integração com fono', privado: 'NDBI com componente sensorial estruturado + ABA sensorial', escola: 'Adiamento de ingresso escolar ou ambiente especializado (creche-escola TEA)' }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'DIR/Floortime vs ABA em TEA precoce: comparativo metodológico, evidência e cenários clínicos brasileiros',
  description: 'Comparativo entre DIR/Floortime (Greenspan & Wieder, 1997) e ABA (Lovaas 1987; ESDM Rogers & Dawson 2010) em TEA precoce. Base teórica, evidência empírica e cenários brasileiros (SUS/privado/escola).',
  author: { '@id': alexandrePersonBase['@id'] },
  publisher: { '@id': brasilGeoOrganization['@id'] },
  inLanguage: 'pt-BR'
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.tldr-resposta', '.faq-answer-text']
  },
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const mbaNcpp = MBAS.find(m => m.id === 'mba-ncpp');
const mbaNeuro = MBAS.find(m => m.id === 'mba-neuro');
---

<Base
  title="DIR/Floortime vs ABA em TEA precoce: base teórica, evidência e cenários brasileiros"
  description="Comparativo independente entre DIR/Floortime (Greenspan & Wieder, 1997) e ABA (Lovaas; ESDM Rogers & Dawson 2010) em TEA precoce. Mecanismo, evidência empírica e cenários SUS/privado/escola.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Comparativos', href: '/comparativos' },
        { label: 'DIR/Floortime vs ABA' }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Comparativo · Intervenção em TEA precoce</span>
          <h1 class="section-h text-3xl sm:text-4xl">DIR/Floortime vs ABA em TEA precoce: dois paradigmas e a integração via NDBI</h1>
          <TLDR
            resposta="DIR/Floortime (Greenspan & Wieder, 1997) é abordagem desenvolvimentista relacional com foco em regulação emocional e engajamento afetivo; ABA (Lovaas 1987; ESDM Rogers & Dawson 2010) é comportamental com corpo de evidência mais amplo. Boshoff et al. (2024) revisão sistemática de 22 estudos DIR reporta ganho moderado em comunicação social (ES 0,65); Dawson et al. (2010) ESDM mostrou ganho de 17,6 pontos em QI vs 7 no controle. A clínica contemporânea de TEA precoce raramente trabalha com versões puras — NDBI integra ambos."
            fontes={["Greenspan & Wieder, 1997", "Boshoff et al., 2024 (Autism Res, DOI 10.1002/aur.2998)", "Rogers & Dawson, 2019 (ESDM)"]}
          />
          <p class="mt-3 text-ink-700 text-lg">Não são abordagens rivais. ABA contemporâneo já incorpora elementos naturalísticos via NDBI; DIR/Floortime contemporâneo absorveu coleta sistemática de dados. A escolha responde ao perfil clínico, idade, contexto familiar e disponibilidade local de profissional formado.</p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0 h-11">
          Ver MBAs no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          DIR/Floortime parte da matriz desenvolvimentista relacional de Greenspan e Wieder — circuitos de regulação afetiva como base da cognição, com seis estágios funcionais emocionais (FEAS). ABA opera com princípios comportamentais (Skinner-Lovaas), com variantes que vão do DTT clássico estruturado ao NDBI (ESDM, PRT) naturalístico. Boshoff e colaboradores (2024, Autism Research, DOI 10.1002/aur.2998) revisão sistemática de 22 estudos DIR documenta ganho moderado em comunicação social (ES 0,65), com evidência ainda em consolidação. Dawson e colaboradores (2010, Pediatrics) ESDM mostraram ganhos em QI, linguagem e revisão diagnóstica em 29% das crianças. No Brasil, ABA tem rede ampla via BCBAs em capitais; DIR/Floortime tem rede menor e concentrada. Para escolha clínica responsável, ABA tem evidência mais consolidada em volume; DIR tem vantagem em regulação emocional e aceitação pela comunidade neurodiversa.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">De Greenspan a Boshoff — três décadas de DIR/Floortime e integração com NDBI</h2>
        <p>
          Stanley Greenspan, pediatra e psiquiatra infantil de Washington, e Serena Wieder publicaram em 1997 no Infant Mental Health Journal o framework conceitual do DIR (Developmental, Individual-differences, Relationship-based). A premissa central inverteu o paradigma cognitivo-comportamental dominante na época: o desenvolvimento emocional, mais especificamente o engajamento afetivo recíproco entre criança e cuidador, é a matriz que sustenta a cognição, a linguagem, a brincadeira simbólica e o pensamento lógico subsequentes. Os seis estágios funcionais emocionais (FEAS — Functional Emotional Assessment Scale) descrevem o desenvolvimento do bebê em camadas: atenção compartilhada e regulação (0-3 meses), engajamento relacional (4-9 meses), reciprocidade afetiva intencional (9-18 meses), comunicação afetiva complexa proposital (18-30 meses), ideias e brincadeira simbólica (30-48 meses) e pensamento lógico-emocional (5 anos em diante).
        </p>
        <p>
          A intervenção Floortime concretiza o framework DIR. Terapeuta e pais sentam no chão com a criança, seguem o foco afetivo dela, abrem círculos de comunicação (a criança aponta um carrinho, o adulto entra na brincadeira e "fecha" o círculo com resposta afetivamente sintonizada), ampliam interações reciprocas, modelam progressão para estágios FEAS mais elevados. O envolvimento parental é central — pais treinados aplicam Floortime nas rotinas afetivas diárias (banho, refeição, brincadeira), ampliando horas terapêuticas efetivas. A coleta de dados em DIR opera com escalas qualitativas de engajamento e com a FEAS, menos granular que a coleta de ensaios discretos em ABA-DTT mas igualmente sistemática.
        </p>
        <p>
          A evidência empírica do DIR/Floortime acumulou-se mais lentamente que a do ABA, em parte porque a abordagem nasceu fora do paradigma RCT clássico. Pajareya e Nopmaneejumruslers (2011, Autism) randomizaram 32 crianças com TEA precoce para Floortime mais intervenção padrão versus padrão isolado por 3 meses, com ganho significativo em FEAS no grupo de intervenção. Solomon e colaboradores (2014, JAMA Pediatrics) descrevem o PLAY Project (Play and Language for Autistic Youngsters), programa baseado em DIR aplicado em coorte de 128 crianças com ganhos em interação social, linguagem e regulação. Boshoff e colaboradores (2024, Autism Research, DOI 10.1002/aur.2998) consolidaram revisão sistemática de 22 estudos, com 17 mostrando efeito positivo em pelo menos um desfecho e tamanho de efeito moderado (0,65) em comunicação social. Limitações reconhecidas — heterogeneidade metodológica, definição variável de "fidelidade", amostras pequenas em alguns ensaios — sustentam que a evidência DIR é moderada e em consolidação, não definitivamente robusta.
        </p>
        <p>
          A clínica contemporânea de TEA precoce raramente trabalha com versões puras. Sally Rogers e Geraldine Dawson, ao desenvolverem o Early Start Denver Model (ESDM) em 2010, integraram explicitamente princípios desenvolvimentistas próximos do DIR com princípios comportamentais do ABA, dando origem à categoria NDBI (Naturalistic Developmental Behavioral Interventions). O ABA contemporâneo praticado em centros qualificados já incorpora elementos naturalísticos (PRT — Pivotal Response Treatment, JASPER — Joint Attention Symbolic Play Engagement and Regulation); o DIR contemporâneo absorveu coleta sistemática de dados e protocolos de fidelidade. Para uma criança específica de 28 meses com TEA, a escolha entre "DIR puro" e "ABA puro" é cada vez mais teórica — a clínica responsável aplica a melhor integração disponível, respeitando o perfil sensorial e relacional da criança, o engajamento familiar e a formação do profissional.
        </p>
      </div>

      <div>
        <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Tabela 1 — Base teórica e mecanismo</p>
        <div class="overflow-x-auto -mx-4 sm:mx-0 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-100 sticky top-0">
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Dimensão</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-brand-700 border-b border-surface-300">DIR/Floortime</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-sun-600 border-b border-surface-300">ABA (clássico e ESDM)</th>
              </tr>
            </thead>
            <tbody>
              {tabelaMecanismo.map(row => (
                <tr class="border-b border-surface-200 hover:bg-surface-50">
                  <td class="px-4 py-3 align-top text-ink-900 font-medium">{row.dimensao}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.dir}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.aba}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="sm:hidden text-xs text-ink-500 mt-2">← Arraste para ver mais →</div>
      </div>

      <div>
        <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Tabela 2 — Evidência empírica e tamanho de efeito</p>
        <div class="overflow-x-auto -mx-4 sm:mx-0 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-100 sticky top-0">
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Dimensão</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-brand-700 border-b border-surface-300">DIR/Floortime</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-sun-600 border-b border-surface-300">ABA / ESDM</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-500 border-b border-surface-300">Vantagem</th>
              </tr>
            </thead>
            <tbody>
              {tabelaEvidencia.map(row => (
                <tr class="border-b border-surface-200 hover:bg-surface-50">
                  <td class="px-4 py-3 align-top text-ink-900 font-medium">{row.dimensao}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.dir}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.aba}</td>
                  <td class="px-4 py-3 align-top text-ink-700 font-medium">{row.vantagem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="sm:hidden text-xs text-ink-500 mt-2">← Arraste para ver mais →</div>
      </div>

      <div>
        <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Tabela 3 — Cenários clínicos brasileiros (SUS, privado, escola)</p>
        <div class="overflow-x-auto -mx-4 sm:mx-0 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-100 sticky top-0">
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Cenário</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">SUS</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Rede privada</th>
                <th scope="col" class="px-4 py-3 text-left font-semibold text-ink-900 border-b border-surface-300">Escola</th>
              </tr>
            </thead>
            <tbody>
              {tabelaCenarios.map(row => (
                <tr class="border-b border-surface-200 hover:bg-surface-50">
                  <td class="px-4 py-3 align-top text-ink-900 font-medium">{row.cenario}</td>
                  <td class="px-4 py-3 align-top text-ink-700">{row.sus}</td>
