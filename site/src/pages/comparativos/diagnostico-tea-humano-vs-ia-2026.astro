    aprovacao: 'Sem aprovação ANVISA como dispositivo médico; uso público amplamente difundido',
    custo: 'Gratuito em plataformas open-access; sem custo financeiro direto',
    integracaoCid: 'Não substitui critério diagnóstico; gera hipótese pré-clínica',
    suportePtBr: 'Versões pt-BR existem em plataformas como autismoematicula; qualidade variável',
    limitacao: 'Auto-relato; suscetível a camuflagem; sem orientação clínica; risco de auto-diagnóstico precipitado'
  },
  {
    nome: 'CAT-Q digital + dashboard interpretativo',
    validacao: 'Instrumento original validado; implementações digitais isoladas sem validação cruzada formal',
    viesAlgoritmico: 'Algoritmo de pontuação simples; viés depende da curadoria da interpretação',
    fenotipoFeminino: 'Específico para fenótipo de camuflagem (predomina em mulheres)',
    aprovacao: 'Sem aprovação ANVISA específica; uso clínico orientado por profissional',
    custo: 'Plataformas privadas variam (US$ 0 a US$ 50); plataformas pt-BR ainda escassas',
    integracaoCid: 'Não diagnostica; orienta hipótese para encaminhamento clínico',
