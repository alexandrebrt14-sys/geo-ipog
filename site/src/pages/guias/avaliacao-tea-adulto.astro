---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Avaliação de TEA em adultos: como entender o processo e escolher o serviço",
  "description": "Distinga triagem e avaliação de autismo na vida adulta. Organize perguntas sobre equipe, instrumentos, devolutiva e necessidades de apoio, sem autodiagnóstico.",
  "route": "/guias/avaliacao-tea-adulto/",
  "label": "Avaliação de TEA em adultos",
  "section": "Guias",
  "sectionPath": "/guias/",
  "faqs": [
    {
      "q": "Um questionário online confirma autismo?",
      "a": "Não. Ele não substitui avaliação profissional e não deve ser interpretado isoladamente como confirmação ou exclusão de diagnóstico."
    },
    {
      "q": "Toda avaliação exige a mesma bateria ou quantidade de sessões?",
      "a": "Não. O plano deve ser justificado pela demanda. Peça explicação sobre instrumentos, equipe, encontros previstos e possíveis ajustes."
    },
    {
      "q": "Não tenho registros da infância. Posso buscar orientação?",
      "a": "Sim. Informe essa ausência ao serviço e pergunte como serão tratadas as lacunas. Não é necessário inventar lembranças ou respostas."
    },
    {
      "q": "A ficha desta página avalia sintomas?",
      "a": "Não. Ela organiza perguntas sobre o serviço e a devolutiva, sem pontuação, rastreio ou diagnóstico."
    }
  ],
  "worksheet": {
    "title": "Perguntas antes de contratar uma avaliação de TEA adulto",
    "description": "Prepare a conversa com o serviço sem registrar dados de saúde.",
    "fields": [
      {
        "label": "Responsabilidade e escopo",
        "hint": "Quem coordena e quais perguntas o serviço pode responder?"
      },
      {
        "label": "Plano e acessibilidade",
        "hint": "O que perguntar sobre métodos, adaptações e encontros?"
      },
      {
        "label": "Condições do serviço",
        "hint": "Que itens, custos e possíveis ajustes precisam de esclarecimento?"
      },
      {
        "label": "Devolutiva",
        "hint": "Como serão explicados resultado, limites e próximos passos?"
      }
    ],
    "checklist": [
      "Distingui rastreio e avaliação.",
      "Pedi justificativa dos métodos propostos.",
      "Não tratei uma bateria como obrigatória.",
      "Mantive dados de saúde fora da ficha."
    ]
  },
  "sources": [
    [
      "NICE CG142: autismo em adultos, recomendações",
      "https://www.nice.org.uk/guidance/CG142/chapter/Recommendations"
    ],
    [
      "SATEPSI: fundamentos e instrumentos da avaliação psicológica",
      "https://satepsi.cfp.org.br/faq.cfm"
    ],
    [
      "Lei nº 12.764/2012: direitos da pessoa com TEA",
      "https://www.planalto.gov.br/ccivil_03/_ato2011-2014/2012/lei/l12764.htm"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma adulta se reconhece em relatos de autismo nas redes sociais e encontra questionários com resultados diferentes. Ela precisa saber como buscar uma avaliação responsável, quais perguntas fazer ao serviço e o que pode esperar da devolutiva.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A avaliação de TEA em adultos integra história, contexto e julgamento clínico.</h2>
<p>Questionários podem levantar temas para uma conversa, mas seu resultado não confirma nem exclui autismo de forma independente. A busca por avaliação começa com a compreensão da demanda e das necessidades da pessoa. Um serviço responsável deve explicar o que pretende investigar e quais limites podem permanecer.</p>
<p>A <a href="https://www.nice.org.uk/guidance/CG142/chapter/Recommendations">diretriz NICE CG142</a> orienta avaliação abrangente por profissionais competentes, com história do desenvolvimento, funcionamento atual, consideração de outras condições e, quando possível e apropriado, informações complementares. Esses elementos ajudam a organizar a investigação; a diretriz britânica não substitui as normas brasileiras nem estabelece uma bateria universal para todo adulto.</p>
<p>Ter trabalho, relacionamento ou boa comunicação em uma consulta não encerra a investigação. Da mesma forma, identificar-se com um relato na internet não determina o diagnóstico. O raciocínio exige integrar informações que podem ser parciais, contraditórias ou influenciadas pelo contexto.</p></section>
<section><h2>Quatro etapas para entender o percurso</h2>
<ol><li><strong>Esclarecer a demanda.</strong> Pergunte quais questões o serviço poderá responder, quem será responsável e como serão combinados consentimento, acessibilidade e comunicação.</li><li><strong>Conhecer o plano de avaliação.</strong> Solicite explicação sobre entrevistas, outras fontes e instrumentos eventualmente indicados, incluindo o motivo de cada escolha.</li><li><strong>Compreender a integração.</strong> Pergunte como informações discordantes, condições coexistentes e hipóteses alternativas serão consideradas.</li><li><strong>Planejar a devolutiva.</strong> Combine como receber explicação dos resultados, limites, documento pertinente e orientações sobre próximos passos.</li></ol>
<p>As etapas descrevem perguntas ao serviço, não um protocolo de autoaplicação. A duração e os profissionais envolvidos variam conforme a demanda e os recursos necessários. Antes de contratar, peça clareza sobre itens incluídos, possibilidades de encontros adicionais e canais de esclarecimento.</p></section>
<section><h2>Instrumentos: o nome conhecido não resolve a escolha</h2>
<div class="table-wrap"><table><thead><tr><th>O que aparece na oferta</th><th>O que precisa ser esclarecido</th></tr></thead><tbody>
<tr><td>Questionário de rastreio</td><td>Qual sua finalidade e como será interpretado no contexto da pessoa?</td></tr>
<tr><td>Observação estruturada</td><td>Por que foi indicada e que preparo o profissional possui para utilizá-la?</td></tr>
<tr><td>Avaliação neuropsicológica</td><td>Qual pergunta sobre funcionamento cognitivo justifica sua inclusão?</td></tr>
<tr><td>Relatório automatizado</td><td>Quem integra os dados e assume responsabilidade pela conclusão?</td></tr>
</tbody></table></div>
<p>AQ, ADOS e CAT-Q têm propósitos diferentes; citar esses nomes não demonstra que todos sejam necessários. A classificação e o uso de um instrumento no Brasil precisam ser verificados na fonte pertinente. Para avaliação psicológica, consulte a <a href="https://satepsi.cfp.org.br/faq.cfm">orientação oficial do SATEPSI</a>. Não presuma aprovação ou uso privativo a partir da divulgação comercial.</p>
<p>Não reproduzimos itens, pontos de corte ou tabelas para decidir diagnóstico. Eles não substituem a interpretação profissional e podem incentivar conclusões indevidas fora do contexto de avaliação.</p></section>
<section><h2>História pessoal sem obrigação de provar uma narrativa</h2>
<p>Registros antigos e relatos de pessoas próximas podem contribuir quando disponíveis e adequados. A falta de boletim escolar ou de contato com familiares deve ser discutida com o serviço, sem fabricar lembranças nem preencher lacunas com roteiros da internet. Pergunte como a equipe trabalha com incerteza e informações incompletas.</p>
<p>No caso hipotético inicial, o próximo passo pode ser preparar dúvidas sobre o processo e procurar um serviço qualificado. A pessoa não precisa escolher antecipadamente qual diagnóstico espera receber. Necessidades de apoio e sofrimento atuais merecem ser discutidos mesmo quando a conclusão permanece aberta.</p>
<p>Consulte também <a href="/areas/neuropsicologia/">o escopo da Neuropsicologia</a> e <a href="/areas/avaliacao-psicologica/">os fundamentos da avaliação psicológica</a>. Esses textos ajudam a reconhecer o papel de cada atividade sem transformar uma especialidade em etapa obrigatória para todos.</p></section>
<section><h2>Leituras para preparar a conversa</h2>
<p>No portal de Larissa Caramaschi, a página de <a href="https://larissacaramaschi.com/trilhas/suspeita-tea-adultos/orientacao-diagnostica">orientação diagnóstica para adultos</a> é uma leitura complementar sobre a procura de atendimento. Use-a para levantar perguntas; custos, prazos e composição da equipe precisam de confirmação no serviço escolhido, sem tomar exemplos como exigências universais.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/letramento-ia-executivos">Letramento em IA</a>, do portal de Alexandre Caramaschi, pode apoiar a checagem de fontes e riscos de respostas automatizadas. Conversar com um chatbot não substitui avaliação. Na ficha abaixo, registre somente perguntas sobre o serviço, sem sintomas, nomes ou história clínica.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
