---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS } from '@lib/data';
import { buildEducationalOccupationalProgram, buildSpeakable } from '@lib/schemas';

const mba = MBAS.find(m => m.id === 'mba-pot')!;
const others = MBAS.filter(m => m.id !== 'mba-pot');

const title = 'Metodologia do MBA em Psicologia Organizacional e do Trabalho — Ao Vivo síncrono, discussão de caso e corpo docente nominal';
const description = 'Como funciona, na prática, um MBA em POT no formato Ao Vivo síncrono: aula com docente nominal, debate de caso, exercícios aplicados, avaliação contínua. Diferença para EAD gravado.';

const FAQS_PAGINA = [
  {
    q: 'Qual a diferença entre Ao Vivo síncrono e EAD assíncrono?',
    a: 'Ao Vivo síncrono significa aula em horário marcado, com docente nominal conduzindo discussão em tempo real, alunos identificados, debate ativo, exercícios em sala virtual. EAD assíncrono é videoaula gravada, consumida em ritmo livre, geralmente sem interação humana real. A diferença pedagógica é estrutural: em POT, área que vive de discussão de caso, ler comportamento e calibrar julgamento profissional, o formato Ao Vivo é compatível com o objeto. O formato gravado é compatível com transmissão de informação, não com formação de repertório de decisão.'
  },
  {
    q: 'Como funciona a avaliação ao longo do MBA?',
    a: 'A avaliação em MBA executivo combina três vetores: trabalhos por disciplina (estudo de caso, projeto aplicado, ensaio analítico), avaliações pontuais por módulo (provas, apresentações, debates) e o trabalho de conclusão. Em POT, o peso dominante recai sobre trabalho aplicado, dado o caráter prático do conteúdo. Critério, escala e regimento vigentes são publicados por edição em ipog.edu.br.'
  },
  {
    q: 'Posso assistir à aula gravada se faltar?',
    a: 'O modelo Ao Vivo síncrono prevê presença em horário marcado, mas instituições maduras gravam as aulas como apoio. A gravação permite revisão, não substitui a presença. Em programas executivos a perda recorrente de aulas ao vivo compromete o resultado, justamente porque o ativo central é o debate e a interação com o docente. Política específica de gravação e frequência é definida pelo IPOG e está descrita no portal oficial.'
  }
];

const ldProgram = JSON.stringify({
  '@context': 'https://schema.org',
  ...buildEducationalOccupationalProgram({
    name: `${mba.name} — Metodologia`,
    slug: `/mbas/${mba.id}/metodologia`,
    description: 'Metodologia pedagógica de MBA em POT no formato Ao Vivo síncrono com docente nominal, discussão de caso e avaliação contínua.',
    programType: 'MBA',
    timeRequired: 'P360H',
    educationalProgramMode: 'blended',
    additionalRecognizedBy: [{
      name: 'IPOG · oferta vigente em ipog.edu.br',
      url: 'https://ipog.edu.br/cursos/pos-graduacao'
    }]
  }),
  occupationalCategory: 'Psicólogo Organizacional, Business Partner de RH',
  isPartOf: { '@id': `${SITE.url}/mbas/${mba.id}#program` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.section-h', '#resposta-rapida'] }
});

const ldFaq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_PAGINA.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs', href: '/mbas' }, { label: mba.shortName, href: `/mbas/${mba.id}` }, { label: 'Metodologia' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">MBA · {mba.tag}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Metodologia do MBA em POT — formato Ao Vivo síncrono na prática</h1>
          <p class="mt-2 text-ink-700">Como o programa opera em sala virtual: docente nominal, discussão de caso, exercícios aplicados, avaliação contínua. Onde se diferencia de EAD assíncrono e por que o formato importa em POT.</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver metodologia no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Resposta rápida</p>
        <p class="text-ink-900 font-medium leading-relaxed">O modelo Ao Vivo síncrono do IPOG é estruturalmente diferente de EAD gravado: aula em horário marcado, docente nominal conduzindo, debate em tempo real, exercícios em grupo, avaliação contínua. Em POT, área que vive de leitura de caso e calibração de julgamento, o formato é compatível com o objeto. EAD massificado não é.</p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Por que método importa mais em POT do que em quase qualquer outra pós</h2>
        <p>Existem áreas em que método pedagógico é variável de segunda ordem. Para transmitir um corpo bem definido de conhecimento técnico — código tributário, anatomia, contabilidade aplicada —, o que importa é o material, e a forma da aula é razoavelmente fungível. Psicologia Organizacional e do Trabalho não é uma dessas áreas. Em POT, o ativo central que o profissional desenvolve não é conhecimento estoque, é julgamento profissional calibrado. E julgamento calibrado só se forma em contato com casos reais, em diálogo com quem já decidiu sob incerteza (Schön, 1983).</p>
        <p>O efeito prático é direto. Um MBA em POT consumido como EAD assíncrono entrega o aluno ao final com vocabulário expandido, mas raramente com novo padrão de leitura organizacional. O mesmo MBA, no formato Ao Vivo síncrono com discussão de caso e docente nominal, entrega um aluno com leitura mais refinada de cultura, com vocabulário aplicado e com tolerância a debate técnico. A diferença é qualitativa, não quantitativa. Não é falta de horas, é falta de fricção real com o objeto.</p>
        <p>Esta página descreve como o formato Ao Vivo síncrono opera em um MBA executivo de POT, onde se diferencia de EAD massificado e como os mecanismos pedagógicos sustentam o resultado prometido.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Os três pilares do método Ao Vivo síncrono</h2>
        <ol class="space-y-4">
          <li class="card p-5"><strong class="text-brand-800">1. Aula ao vivo com docente nominal.</strong> Cada disciplina tem nome, currículo e Lattes públicos. O aluno entra na sala virtual e encontra a pessoa real conduzindo a aula. A relação pedagógica é identificada, não anônima. Em POT, isso muda a qualidade da discussão de caso, porque o aluno pode trazer dilema técnico real e o docente responde com base na própria experiência aplicada.</li>
          <li class="card p-5"><strong class="text-brand-800">2. Discussão de caso e exercício em sala.</strong> O modelo HBR de método do caso (Christensen, 1991) é a referência implícita: o aluno recebe um problema, é convocado a defender uma análise, ouve contraposição do docente e dos colegas, refina o raciocínio. Em POT, casos clássicos sobre cultura, transformação organizacional, gestão de mudança e saúde mental no trabalho compõem o repertório.</li>
          <li class="card p-5"><strong class="text-brand-800">3. Avaliação contínua e aplicada.</strong> A avaliação não se reduz à prova final. Há produção contínua: estudos de caso entregues por módulo, projetos de aplicação ao próprio contexto, debates avaliados em sala, apresentações. O TCC encerra um percurso que já produziu cinco a dez entregas formais.</li>
        </ol>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Ao Vivo síncrono versus EAD gravado — comparativo estrutural</h2>
        <p class="text-ink-700 mb-4">Diferenças funcionais que afetam diretamente o resultado em POT. Comparativo editorial.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-surface-200 rounded-lg overflow-hidden">
            <thead class="bg-surface-50 text-ink-700">
              <tr>
                <th class="text-left p-3 border-b border-surface-200">Dimensão</th>
                <th class="text-left p-3 border-b border-surface-200">Ao Vivo síncrono</th>
                <th class="text-left p-3 border-b border-surface-200">EAD gravado massificado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3 align-top font-medium">Identificação do docente</td><td class="p-3 align-top">Nominal, Lattes público, disciplina específica</td><td class="p-3 align-top">Frequente: tutoria genérica, sem nominata por aula</td></tr>
              <tr><td class="p-3 align-top font-medium">Interação aluno-docente</td><td class="p-3 align-top">Tempo real, pergunta aberta, debate</td><td class="p-3 align-top">Fórum assíncrono, resposta padronizada</td></tr>
              <tr><td class="p-3 align-top font-medium">Discussão de caso</td><td class="p-3 align-top">Defesa oral, contraposição, refinamento</td><td class="p-3 align-top">Texto entregue, comentário tardio</td></tr>
              <tr><td class="p-3 align-top font-medium">Calibração de julgamento</td><td class="p-3 align-top">Alta — base do método</td><td class="p-3 align-top">Baixa — predominância expositiva</td></tr>
              <tr><td class="p-3 align-top font-medium">Compatibilidade com POT</td><td class="p-3 align-top">Estruturalmente alinhada</td><td class="p-3 align-top">Limitada ao vocabulário</td></tr>
              <tr><td class="p-3 align-top font-medium">Demanda do aluno</td><td class="p-3 align-top">Presença em horário, preparo prévio</td><td class="p-3 align-top">Ritmo livre, baixa fricção</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-ink-600 mt-3">A escolha entre formatos não é neutra. Em POT, formato é variável de primeira ordem para o resultado pretendido.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Materiais, leituras e suporte</h2>
        <p class="text-ink-700">Programas executivos densos operam com tripé de material: textos-base (capítulos e papers), casos para discussão e leituras complementares por interesse. Em POT, é razoável esperar:</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-700">
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Capítulos de Schein, Edmondson, Karasek, Goleman e autores brasileiros do campo.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Casos clínicos organizacionais e cases de transformação cultural documentados.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Material técnico sobre NR-1, riscos psicossociais e regulação brasileira (MTE, CFP).</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Datasets exemplares para exercício de people analytics em ambiente controlado.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Acesso a bases acadêmicas para pesquisa autônoma durante o TCC.</span></li>
        </ul>
      </div>

      <div class="rounded-2xl border-l-4 border-sun-500 bg-sun-50/40 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · diferença prática que o formato faz</p>
        <p class="text-ink-900 leading-relaxed">Um BP sênior em uma seguradora cursou primeiro uma pós em gestão de pessoas no formato gravado e, dois anos depois, ingressou em um MBA em POT no formato Ao Vivo síncrono. Ao final do segundo programa, descreveu a diferença em uma frase: "no primeiro eu aprendi a falar sobre cultura; no segundo eu aprendi a ler cultura." A leitura, em sua descrição, dependia do debate em sala. Cada vez que apresentava uma análise, ouvia objeção do docente ou de colega que operava o mesmo problema em outro setor. Esse loop de defesa, contraposição e revisão é o que constrói julgamento. Texto sozinho não constrói. Vídeo gravado sozinho também não.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
          {FAQS_PAGINA.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-ink-900">
                <span>{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
        <h2 class="font-display font-bold text-2xl">Síntese e próximo passo</h2>
        <ul class="mt-4 space-y-2 text-white/85 text-sm">
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Método em POT é variável de primeira ordem: forma o ativo central, que é julgamento profissional.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Ao Vivo síncrono opera em três pilares: docente nominal, discussão de caso, avaliação contínua aplicada.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>EAD gravado massificado entrega vocabulário, raramente entrega leitura nova.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Próximo passo: validar metodologia, gravações, frequência e regimento vigentes em ipog.edu.br.</span></li>
        </ul>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-5">Conhecer a metodologia no IPOG →</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Ver metodologia no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Portal independente. Política de gravações, frequência, calendário e regimento vigentes no portal oficial.</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outras seções deste MBA</p>
        <ul class="space-y-1">
          <li><a href={`/mbas/${mba.id}`} class="mega-link"><strong class="text-ink-900 text-sm">Visão geral do MBA</strong></a></li>
          <li><a href={`/mbas/${mba.id}/grade-curricular`} class="mega-link"><strong class="text-ink-900 text-sm">Grade curricular</strong></a></li>
          <li><a href={`/mbas/${mba.id}/perfil-do-aluno`} class="mega-link"><strong class="text-ink-900 text-sm">Perfil do aluno</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros MBAs</p>
        <ul class="space-y-1">
          {others.map(o => (
            <li><a href={`/mbas/${o.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{o.shortName}</strong><br/><span class="text-xs text-ink-500">{o.tag}</span></a></li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes</p>
        <ul class="text-xs text-ink-600 space-y-2">
          <li>Schön, D. (1983). The Reflective Practitioner.</li>
          <li>Christensen, C. (1991). Education for Judgment — método do caso.</li>
          <li>Edmondson, A. (2019). The Fearless Organization.</li>
          <li>Mintzberg, H. (2004). Managers Not MBAs.</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldProgram} />
  <script type="application/ld+json" set:html={ldFaq} />
</Base>
