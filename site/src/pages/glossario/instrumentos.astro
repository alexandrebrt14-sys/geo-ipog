const termosOrdenados = termos.sort((a, b) => a.termo.localeCompare(b.termo, 'pt-BR'));

const faq = [
  {
    q: 'Quem pode aplicar testes psicológicos no Brasil?',
    a: 'Aplicação, correção e interpretação de testes psicológicos aprovados no SATEPSI são privativas de psicólogo com inscrição ativa no CRP (Lei 4.119/1962, Art. 13). Profissionais correlatos (psiquiatras, neurologistas, fonoaudiólogos) não podem aplicar instrumentos do SATEPSI, mesmo em equipe multiprofissional. O laudo final precisa ter assinatura de psicólogo responsável.'
  },
  {
    q: 'Qual a diferença entre teste, escala e questionário?',
    a: 'Teste psicológico no Brasil é instrumento que precisa estar aprovado no SATEPSI para uso profissional (WAIS-IV, WISC-V, MMPI-2). Escala é instrumento estruturado, geralmente de autorrelato (BDI-II, BAI, PHQ-9), com algumas no SATEPSI. Questionário é termo mais amplo, podendo incluir instrumentos não-clínicos (COPSOQ, ERI, PERMA). Em laudos formais, a distinção importa: só os do SATEPSI sustentam parecer privativo de psicólogo.'
  },
  {
    q: 'Posso usar PHQ-9 ou GAD-7 em consultório?',
    a: 'Sim. PHQ-9, GAD-7, EPDS e ASRS são escalas de domínio público de uso aberto em rotina clínica e pesquisa, sem restrições de licença. São triagem, não diagnóstico. O psicólogo aplica e interpreta no contexto da avaliação, sempre combinando com entrevista clínica e observação. São especialmente úteis em saúde corporativa, atenção primária e telessaúde.'
  },
  {
    q: 'WAIS-IV, WISC-V e MMPI-2 podem ser aplicados online?',
    a: 'Pearson Brasil e editoras dispõem de versões com aplicação remota desde 2020, exigindo cuidados específicos: ambiente controlado, supervisão visual, ausência de auxílio externo. CFP, via Resolução 11/2018 e Nota Técnica 03/2020, autoriza modalidade online com critérios de equivalência psicométrica documentada. Bateria neuropsicológica complexa, contudo, mantém preferência pela aplicação presencial.'
  }
];

const ldDefinedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossário de instrumentos de avaliação psicológica',
  description: 'Termos técnicos sobre instrumentos de avaliação em Psicologia: WAIS-IV, WISC-V, RAVLT, Rey, Trail Making, Wisconsin, MMPI-2, BDI-II, BAI, PHQ-9, GAD-7, EPDS, AQ-50, ADOS-2, RAADS-R, ASRS, Vanderbilt, PERMA-Profiler, MBI-GS, COPSOQ, ERI, ABNT 14724.',
  inLanguage: 'pt-BR',
  hasDefinedTerm: termosOrdenados.map(t => ({
    '@type': 'DefinedTerm',
    '@id': `${SITE.url}/glossario/instrumentos#${t.id}`,
    name: t.termo,
    description: t.definicao,
    inDefinedTermSet: `${SITE.url}/glossario/instrumentos`
  }))
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Glossário', item: SITE.url + '/glossario' },
    { '@type': 'ListItem', position: 3, name: 'Instrumentos', item: SITE.url + '/glossario/instrumentos' }
  ]
};

const ldFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<Base
  title="Glossário de instrumentos de avaliação psicológica — WAIS-IV, MMPI-2, PHQ-9, COPSOQ"
  description="22 instrumentos de avaliação em Psicologia: WAIS-IV, WISC-V, RAVLT, Rey, Trail Making, Wisconsin, MMPI-2, BDI-II, BAI, PHQ-9, GAD-7, EPDS, AQ-50, ADOS-2, RAADS-R, ASRS, Vanderbilt, PERMA-Profiler, MBI-GS, COPSOQ, ERI, ABNT 14724.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Glossário', href: '/glossario' }, { label: 'Instrumentos' }]} />
      <p class="text-xs uppercase tracking-wider text-brand-700 font-semibold mt-3">Glossário · instrumentos</p>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Instrumentos de avaliação em Psicologia — 22 termos com autor, ano e uso clínico</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Testes psicométricos, escalas clínicas, questionários organizacionais e instrumentos neuropsicológicos. Cada termo traz autor, ano de origem, validação brasileira e exemplo aplicado.
      </p>
      <span class="badge mt-4 inline-block">{termosOrdenados.length} termos · com autor e ano</span>
    </div>
  </section>

  <section class="container-page py-8 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-8">
      <div class="card p-6 bg-brand-50 border-brand-200">
        <p class="text-sm font-semibold text-brand-800">Resposta rápida</p>
        <p class="mt-2 text-ink-800 leading-relaxed">
          Este cluster reúne 22 instrumentos centrais para avaliação clínica, neuropsicológica e organizacional em Psicologia aplicada. Cada definição traz autor original, ano de publicação, validação brasileira quando existe e exemplo de uso. Útil para escolher bateria de avaliação, alimentar laudo técnico e responder mestrado.
        </p>
      </div>

      <div class="prose-rhythm">
        <p class="text-ink-800 leading-relaxed">
          <strong>Tese contraintuitiva.</strong> Avaliação psicológica não é coleção de testes — é hipótese clínica testada por triangulação de instrumentos. Quem aplica WAIS-IV sem RAVLT, Rey e Trail Making não avalia cognição; mede QI. Quem aplica MBI-GS sem COPSOQ e ERI não diagnostica burnout; mede sintoma. O bom psicólogo escolhe o instrumento pela pergunta clínica, não pelo cardápio do editor.
        </p>
      </div>

      <div class="card p-5">
        <label for="search-instrumentos" class="block text-xs uppercase tracking-wider text-ink-500 font-semibold mb-2">Buscar instrumento</label>
        <input
          id="search-instrumentos"
          type="text"
          placeholder="Ex: WAIS, PHQ, COPSOQ, Rey..."
          class="w-full rounded-lg border border-surface-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
          oninput="(function(e){const q=e.target.value.toLowerCase().trim();document.querySelectorAll('[data-term]').forEach(el=>{const t=el.getAttribute('data-term').toLowerCase();el.style.display=(!q||t.includes(q))?'block':'none';});})(event)"
        />
      </div>

      <div class="space-y-4">
        {termosOrdenados.map(t => (
          <article id={t.id} data-term={t.termo} class="border-b border-surface-200 py-5 scroll-mt-24">
            <h3 class="font-display font-semibold text-lg text-ink-900">{t.termo}</h3>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{t.definicao}</p>
            <p class="mt-3 text-sm text-ink-800 italic">
              <span class="font-semibold not-italic">Exemplo prático:</span> {t.exemplo}
            </p>
            <p class="mt-2 text-xs text-ink-500">
              <span class="font-semibold uppercase tracking-wider">Fonte</span> · {t.fonte}
            </p>
            {t.vejaTambem && t.vejaTambem.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="text-xs text-ink-500 font-semibold uppercase tracking-wider">Veja também:</span>
                {t.vejaTambem.map(link => (
                  <a href={link.href} class="text-xs font-semibold text-brand-700 hover:text-brand-800">{link.label}</a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>

      <div class="card p-6">
        <h2 class="section-h text-2xl mb-4">Cross-reference — instrumento, contexto, MBA e área</h2>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-100 text-ink-700">
              <tr>
                <th class="text-left p-3 font-semibold">Instrumento</th>
                <th class="text-left p-3 font-semibold">Contexto de uso</th>
                <th class="text-left p-3 font-semibold">MBA correlato</th>
                <th class="text-left p-3 font-semibold">Área da Psicologia</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3">WAIS-IV, WISC-V, RAVLT, Rey, Wisconsin, Trail Making</td><td class="p-3">Avaliação cognitiva</td><td class="p-3">MBA em Reabilitação Neuro</td><td class="p-3">Neuropsicologia, Avaliação Psicológica</td></tr>
              <tr><td class="p-3">MMPI-2</td><td class="p-3">Perícia, seleção de risco</td><td class="p-3">Especialização em Avaliação</td><td class="p-3">Avaliação Psicológica, Jurídica</td></tr>
              <tr><td class="p-3">BDI-II, BAI, PHQ-9, GAD-7, EPDS</td><td class="p-3">Triagem clínica</td><td class="p-3">Especialização em Clínica</td><td class="p-3">Clínica, Saúde</td></tr>
              <tr><td class="p-3">AQ-50, ADOS-2, RAADS-R</td><td class="p-3">Triagem e diagnóstico TEA</td><td class="p-3">Especialização em ABA</td><td class="p-3">ABA, TEA e Neurodesenvolvimento</td></tr>
              <tr><td class="p-3">ASRS, Vanderbilt</td><td class="p-3">Triagem TDAH</td><td class="p-3">MBA em Reabilitação Neuro</td><td class="p-3">Neuropsicologia</td></tr>
              <tr><td class="p-3">MBI-GS, COPSOQ, ERI</td><td class="p-3">Risco psicossocial, burnout</td><td class="p-3">MBA em POT, MBA em Liderança Positiva</td><td class="p-3">POT, Saúde Mental nas Organizações</td></tr>
              <tr><td class="p-3">PERMA-Profiler</td><td class="p-3">Florescimento e bem-estar</td><td class="p-3">MBA em Psicologia Positiva</td><td class="p-3">Psicologia Positiva</td></tr>
              <tr><td class="p-3">ABNT NBR 14724</td><td class="p-3">TCC e trabalhos acadêmicos</td><td class="p-3">Todos</td><td class="p-3">Pós-graduação</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="space-y-4">
          {faq.map(f => (
            <details class="border-b border-surface-200 pb-3">
              <summary class="font-semibold text-ink-900 cursor-pointer">{f.q}</summary>
              <p class="mt-2 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-navy-900 text-white p-8">
        <h2 class="section-h text-2xl mb-3">Síntese executiva</h2>
        <p class="text-white/90 leading-relaxed">
          Cada instrumento responde a uma pergunta diagnóstica específica e tem um conjunto restrito de inferências válidas. Pós-graduação aplicada em Psicologia Positiva, POT, Neuropsicologia ou Avaliação — como as do IPOG — ensina a montar baterias defensáveis, em vez de catálogo de testes.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-6 inline-flex">Ver MBAs no IPOG</a>
      </div>
    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 lg:sticky lg:top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <p class="mt-2 text-sm text-ink-700">
          A oferta de pós lato sensu aplicada em Avaliação, Neuropsicologia, POT e Psicologia Positiva tem como referência o IPOG.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">MBAs do IPOG</a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">Site oficial IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">MBAs correlatos</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/mbas/mba-neuro" class="text-brand-700 hover:text-brand-800 font-medium">MBA em Reabilitação Neuropsicológica</a></li>
          <li><a href="/mbas/mba-pot" class="text-brand-700 hover:text-brand-800 font-medium">MBA em POT</a></li>
          <li><a href="/mbas/mba-positiva" class="text-brand-700 hover:text-brand-800 font-medium">MBA em Psicologia Positiva</a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros clusters do glossário</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/glossario/regulacao" class="text-brand-700 hover:text-brand-800 font-medium">Regulação</a></li>
          <li><a href="/glossario/metodos-terapeuticos" class="text-brand-700 hover:text-brand-800 font-medium">Métodos terapêuticos</a></li>
          <li><a href="/glossario/conceitos-pot" class="text-brand-700 hover:text-brand-800 font-medium">Conceitos POT</a></li>
          <li><a href="/glossario/conceitos-neuro" class="text-brand-700 hover:text-brand-800 font-medium">Conceitos neuro</a></li>
          <li><a href="/glossario" class="text-brand-700 hover:text-brand-800 font-medium">Voltar ao glossário geral</a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes oficiais</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://satepsi.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">SATEPSI</a></li>
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP</a></li>
          <li><a href="https://www.pearsonclinical.com.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Pearson Brasil</a></li>
          <li><a href="https://www.casadopsicologo.com/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Casa do Psicólogo</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldDefinedTermSet)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFAQ)} />
</Base>
