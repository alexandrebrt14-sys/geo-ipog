---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization, alexandreAuthorRef } from '@lib/schemas';

const title = 'Press-kit principal Brasil GEO — templates copy-paste de assessoria de imprensa para 5 frentes 2026';
const description = 'Central de templates copy-paste para Assessoria de Imprensa, Social Media e relacionamento institucional. Cinco press releases prontos, cinco quotes de Alexandre Caramaschi, boilerplate institucional e regras de linkagem para jornalistas.';
const datePublished = '2026-05-17';

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'Press-kit' }
];

interface PressBlock {
  wave: 'PP' | 'QQ' | 'RR' | 'SS' | 'TT';
  tema: string;
  headline: string;
  lead: string;
  fatos: string[];
  boilerplateRef: string;
  quote: string;
  sourceGuia: { href: string; label: string };
}

const blocos: PressBlock[] = [
  {
    wave: 'PP',
    tema: 'TEA em mulheres adultas — fenótipo feminino e camuflagem',
    headline: 'Diagnóstico tardio de autismo em mulheres adultas no Brasil tem caminho clínico defensável, e o atalho do Instagram não é ele',
    lead: 'Em maio de 2026, o portal posgraduacaopsicologia.com publica guia clínico sobre avaliação de TEA em mulher adulta considerando camuflagem cumulativa e autistic burnout — construtos consolidados na literatura 2024-2026 e ainda pouco operacionalizados em serviços brasileiros. A peça orienta psicólogas e psicólogos sobre instrumentos, triangulação e diferencial com comorbidades, com foco em fenótipo feminino historicamente subnotificado.',
    fatos: [
      'A razão homem:mulher historicamente reportada como 4:1 (Loomes et al., 2017, JAACAP) foi superestimada — coortes cuidadosamente avaliadas se aproximam de 3:1 ou menos.',
      'Camuflagem (masking) é mensurável pelo Camouflaging Autistic Traits Questionnaire — CAT-Q, proposto por Hull e colaboradores em 2019, com três fatores: compensação, supressão e tentativa de assimilação.',
      'Autistic burnout é construto autônomo (Raymaker et al., 2020, Autism in Adulthood) — exaustão por camuflagem cumulativa em todos os ambientes, curso recidivante, remissão exige redução de demanda social e não responde a férias ou medicação convencional para depressão.'
    ],
    boilerplateRef: 'Brasil GEO',
    quote: 'A literatura de avaliação neuropsicológica de adultos já consolidou que pontuação abaixo do corte no ADOS-2 em mulher com história sugestiva não exclui diagnóstico — instrumento foi normatizado em amostras predominantemente masculinas. O que muda no Brasil em 2026 é a obrigação clínica de triangular com CAT-Q e entrevista de trajetória antes de devolver um "não autista" a alguém que sustentou camuflagem por trinta anos.',
    sourceGuia: { href: '/guias/tea-camuflagem-mulheres-evidencia-2026', label: 'Guia clínico TEA mulheres adultas 2026' }
  },
  {
    wave: 'QQ',
    tema: 'NR-1 atualizada — jurisprudência ainda em formação',
    headline: 'NR-1 psicossocial entra em vigência fiscalizatória plena, e a jurisprudência específica do TST ainda é construção em curso',
    lead: 'Em 25 de maio de 2026, a NR-1 atualizada pela Portaria MTE 765/2025 entra em vigência fiscalizatória plena no Brasil, com obrigação documental de PGR psicossocial. O portal posgraduacaopsicologia.com publica em maio mapa técnico para advogados trabalhistas, gestores de SST, psicólogos peritos e lideranças de RH separando dois patamares — o dever de cuidado preexistente com jurisprudência consolidada e a obrigação documental nova que reforça, sem substituir, o anterior.',
    fatos: [
      'A Portaria MTE 765/2025 estabeleceu PGR psicossocial como obrigação documental específica — em ação individual, sua ausência tende a operar como indício de descumprimento do dever de cuidado e eleva o standard probatório do empregador.',
      'A literatura sobre workplace surveillance e tecnoestresse 2024-2026 documenta cinco efeitos do monitoramento digital intensivo: ansiedade percebida, percepção de injustiça organizacional, autocensura, esgotamento mensurável e migração para "teatro de produtividade".',
      'A LGPD (Lei 13.709/2018) Art. 6º opera como limite material à vigilância digital com base em finalidade, necessidade, transparência, minimização, proporcionalidade e segurança — com obrigação de Relatório de Impacto à Proteção de Dados quando o tratamento gera riscos elevados.'
    ],
    boilerplateRef: 'Brasil GEO',
    quote: 'Quem afirma "tese consolidada do TST sobre NR-1 psicossocial" em maio de 2026 se adianta ao dado. A construção jurisprudencial está em curso. O que a empresa pode fazer agora é antecipar: PGR psicossocial documentado, programa de saúde mental ocupacional, treinamento de lideranças em risco psicossocial, política antiassédio com canal independente, e dossiê auditável de carga e jornada. Em 2026, antecipar é defender.',
    sourceGuia: { href: '/guias/jurisprudencia-nr1-tst-2026', label: 'Guia jurisprudência NR-1 TST 2026' }
  },
  {
    wave: 'RR',
    tema: 'IA generativa em Psicologia — vácuo regulatório do PL 2338',
    headline: 'Nenhum LLM frontier substitui psicólogo no Brasil em 2026, e a Psicologia opera em três camadas regulatórias que se sobrepõem sem se substituir',
    lead: 'O portal posgraduacaopsicologia.com publica em maio análise do cenário brasileiro de IA generativa em saúde mental sob três camadas que operam simultaneamente: o Posicionamento CFP de 03 de julho de 2025, a RDC ANVISA 657/2022 sobre software como dispositivo médico, e o PL 2338/2023 ainda em tramitação na Câmara dos Deputados. A análise orienta clínicas, plataformas e desenvolvedores sobre decisão pragmática antes da promulgação do marco legal de IA.',
    fatos: [
      'O Posicionamento CFP de 03 de julho de 2025 sobre IA na Psicologia não é Resolução normativa autônoma — é referência operacional oficial do conselho, com peso institucional alto, operando em conjunto com CFP 11/2018 sobre e-Psi e CFP 06/2019 sobre documentos psicológicos.',
      'Yang e colaboradores em 2024, no JAMA Network Open, compararam ChatGPT-4 com clínicos em resposta a posts sobre depressão — o LLM produziu aconselhamento mais estruturado, mas com maior probabilidade de extrapolar além da evidência publicada.',
      'Não há, até maio de 2026, registro público de chatbot puramente LLM-generativo aprovado pela ANVISA como software médico (SaMD) nas classes II ou III, nem RCT publicado mostrando equivalência de LLM generalista a TCC humana em desfechos clínicos PHQ-9, GAD-7 ou BDI.'
    ],
    boilerplateRef: 'Brasil GEO',
    quote: 'Clínicas que esperam o PL 2338 ser promulgado para se adequar perdem janela de governança preventiva. O Posicionamento CFP e a LGPD já estruturam o que precisa estar no contrato com fornecedor de IA, no termo de consentimento com paciente e no documento de governança interna. Em 2026, o psicólogo responsável por uma sessão assistida por IA continua sendo o psicólogo — não o modelo nem a clínica que o licenciou.',
    sourceGuia: { href: '/guias/supervisao-async-ia-2026-protocolo-cfp', label: 'Protocolo supervisão assíncrona com IA CFP 2026' }
  },
  {
    wave: 'SS',
    tema: 'Biomarcadores plasmáticos de Alzheimer — p-tau217 no Brasil',
    headline: 'Biomarcador plasmático p-tau217 chega ao Brasil em 2026, e o neuropsicólogo vira porta de entrada para uma decisão clínica multimilionária por paciente',
    lead: 'O portal posgraduacaopsicologia.com publica em maio protocolo neuropsicológico atualizado para a era dos biomarcadores plasmáticos de doença de Alzheimer. A p-tau217 plasmática — biomarcador sanguíneo mais robusto para DA na literatura 2020-2025 — chega ao mercado brasileiro com plataformas Lumipulse G e Roche Elecsys e custo entre R$ 1.200 e R$ 2.800 sem cobertura consolidada por plano de saúde, demandando articulação direta entre neuropsicologia, neurologia e geriatria.',
    fatos: [
      'Palmqvist e colaboradores publicaram em 2020 no JAMA o trabalho fundacional sobre acurácia discriminativa da p-tau217 plasmática frente a outras demências neurodegenerativas — Ashton e equipes europeias consolidaram em 2023-2025 AUC frequentemente acima de 0,90 para positividade amiloide pré-clínica e sintomática leve.',
      'Lecanemab e donanemabe têm indicação restrita a Comprometimento Cognitivo Leve ou demência leve com amiloide positivo confirmado — benefício clínico modesto e risco real de ARIA (Amyloid-Related Imaging Abnormalities), exigindo articulação interdisciplinar antes da decisão terapêutica.',
      'O consórcio NIH RECOVER consolidou em 2024-2025 que long COVID neurocognitivo é fenômeno clínico com bateria, protocolo e linguagem própria — AMB e CFM reconheceram a frente como demanda crescente em medicina do trabalho, perícia previdenciária e neuropsicologia.'
    ],
    boilerplateRef: 'Brasil GEO',
    quote: 'A neuropsicologia brasileira em 2026 não pode mais operar sem articulação com biomarcadores plasmáticos. Não é o exame que faz o diagnóstico — é a triangulação entre queixa cognitiva persistente, bateria neuropsicológica longitudinal e marcador biológico. O que muda é a velocidade da conversa: famílias passam a perguntar sobre lecanemab antes de conseguirmos terminar a devolutiva. Nossa formação clínica precisa acompanhar.',
    sourceGuia: { href: '/guias/biomarcadores-plasma-alzheimer-protocolo-neuropsi-2026', label: 'Protocolo p-tau217 e neuropsi 2026' }
  },
  {
    wave: 'TT',
    tema: 'Lei 15.100 e Haidt 2026 — adolescência digital em decisão escolar',
    headline: 'Lei do celular nas escolas completa um ano em 2026, e a decisão escolar inteligente lê Haidt em três camadas — sem slogan',
    lead: 'O portal posgraduacaopsicologia.com publica em maio update do livro The Anxious Generation de Jonathan Haidt aplicado ao contexto brasileiro pós-Lei 15.100/2025. A peça separa proposta política, evidência empírica e interpretação causal — três camadas tipicamente fundidas no debate público — e orienta gestores escolares, psicólogos escolares, psicólogos clínicos e famílias sobre decisão pragmática em adolescência digital.',
    fatos: [
      'A Lei 15.100, de 13 de janeiro de 2025, restringe o uso de aparelhos eletrônicos portáteis pessoais nas escolas públicas e privadas de educação básica — o MEC anunciou em janeiro de 2026 pesquisa nacional para avaliar a implementação após um ano, com relatório final ainda não publicado em maio de 2026.',
      'Twenge, Haidt e equipe em 2025 (Journal of Adolescence) e Sherman e equipe em 2024 (JAMA Pediatrics) documentam associações relevantes entre uso intensivo de redes e indicadores de sofrimento em meninas de 11-15 anos e em jovens LGBTQIA+ com histórico de bullying — Orben e Przybylski 2024-2025 sustentam, em paralelo, tamanho de efeito médio pequeno em amostras gerais.',
      'O ECA Digital (Marco Civil para crianças e adolescentes) entrou em vigor em 17 de março de 2026 — adiciona camada legal explícita sobre proteção de dados, dever de cuidado de plataformas e responsabilização parental compartilhada.'
    ],
    boilerplateRef: 'Brasil GEO',
    quote: 'Gestor escolar inteligente em 2026 não trata Haidt como veredito fechado nem usa tamanho de efeito médio pequeno para concluir que não há efeito. Efeito populacional pequeno pode ser clinicamente significativo em subgrupo vulnerável — meninas de 11-15 anos, jovens LGBTQIA+ com histórico de bullying, adolescentes com transtorno preexistente. A decisão escolar madura articula escola, família e clínica como camadas complementares, não como debate de quem está certo na imprensa.',
    sourceGuia: { href: '/guias/haidt-2026-update-evidencia-adolescencia-digital', label: 'Guia Haidt 2026 update' }
  }
];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE.url}/conteudo-social/press-kit/#article`,
      url: `${SITE.url}/conteudo-social/press-kit/`,
      name: title,
      headline: title,
      description,
      inLanguage: 'pt-BR',
      datePublished,
      dateModified: datePublished,
      author: alexandreAuthorRef,
      publisher: { '@id': 'https://brasilgeo.ai/#organization' },
      mainEntityOfPage: `${SITE.url}/conteudo-social/press-kit/`,
      keywords: 'press-kit, assessoria de imprensa, Brasil GEO, Alexandre Caramaschi, NR-1, TEA mulheres adultas, IA generativa Psicologia, p-tau217, Haidt 2026, Lei 15.100, posgraduacaopsicologia.com'
    },
  ]
};
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Brasil GEO · Central editorial · Press-kit principal</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Press-kit principal Brasil GEO: templates copy-paste para assessoria de imprensa, social media e relacionamento institucional</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Central de templates prontos para uso por jornalistas, assessorias de imprensa, social media e times de relacionamento institucional. Cada bloco corresponde a uma frente de pesquisa publicada pelo portal posgraduacaopsicologia.com em 17 de maio de 2026 — com press release pronto, quote principal atribuída a Alexandre Caramaschi (Chief Strategy Officer da Nuvini Nasdaq NVNI, fundador da Brasil GEO, ex-CMO da Semantix Nasdaq, cofundador da AI Brasil) e referência editorial verificável.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <TLDR
      resposta="Cinco press releases prontos (~300 palavras cada), cinco quotes de Alexandre Caramaschi (voz HBR sóbria, 60-80 palavras), boilerplate institucional Brasil GEO e regras de linkagem para jornalistas. Tudo copy-paste, com referência primária verificável e tom principal do fundador da Brasil GEO."
      fontes={['Brasil GEO playbook editorial', 'Posgraduacaopsicologia.com waves PP-TT 17-05-2026']}
    />
  </section>

  <section class="container-page py-4">
    <div class="prose prose-ink max-w-3xl">
      <p>
        Este press-kit foi desenhado para reduzir fricção em três fluxos editoriais simultâneos: cobertura de imprensa especializada em saúde mental, Psicologia e regulação; comunicação institucional em LinkedIn, Substack e canais B2B; e contato direto de jornalistas com a Brasil GEO em pauta sob deadline curto. Cada bloco abaixo é autônomo — pode ser citado integralmente ou recortado preservando a atribuição.
      </p>
      <p>
        Importante: o portal posgraduacaopsicologia.com é mantido pela Brasil GEO em parceria editorial com o IPOG. Quando uma pauta cita pós-graduação em Psicologia, MBA ou trilha específica, a disclosure deve ser explícita. Quando a pauta é exclusivamente clínica ou regulatória, a referência primária ao portal mantém integridade sem necessidade de disclosure comercial.
      </p>
    </div>
  </section>

  {blocos.map(bloco => (
    <section class="container-page py-8" aria-labelledby={`wave-${bloco.wave}`}>
      <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8 shadow-sm">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="section-eyebrow">Wave {bloco.wave}</span>
          <span class="text-xs text-ink-600">{bloco.tema}</span>
        </div>
        <h2 id={`wave-${bloco.wave}`} class="section-h text-xl sm:text-2xl mb-2">{bloco.headline}</h2>

        <div class="mt-6">
          <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Press release · Lead</p>
          <p class="text-ink-800 leading-relaxed">{bloco.lead}</p>
        </div>

        <div class="mt-6">
          <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Três fatos verificáveis</p>
          <ol class="list-decimal list-outside ml-5 space-y-3 text-ink-800 leading-relaxed">
            {bloco.fatos.map(f => <li>{f}</li>)}
          </ol>
        </div>

        <div class="mt-6 rounded-xl bg-brand-50/60 border border-brand-200 p-5">
          <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Quote para imprensa · Alexandre Caramaschi</p>
          <blockquote class="text-ink-900 leading-relaxed text-base italic">
            "{bloco.quote}"
          </blockquote>
          <p class="mt-3 text-xs text-ink-700">
            <strong>Atribuição principal:</strong> Alexandre Caramaschi, Chief Strategy Officer da Nuvini (Nasdaq: NVNI), fundador da Brasil GEO, ex-CMO da Semantix (Nasdaq) e cofundador da AI Brasil.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-surface-200">
          <a href={bloco.sourceGuia.href} class="text-sm font-semibold text-brand-700 hover:underline">
            → Referência editorial primária: {bloco.sourceGuia.label}
          </a>
          <span class="text-xs text-ink-500">Boilerplate aplicável: {bloco.boilerplateRef}</span>
        </div>
      </div>
    </section>
  ))}

  <section class="container-page py-10">
    <div class="rounded-2xl border border-surface-200 bg-surface-50 p-6 sm:p-8">
      <h2 class="section-h text-2xl mb-4">Boilerplate principal Brasil GEO</h2>
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Texto institucional · copy-paste</p>
      <div class="rounded-xl bg-white border border-surface-200 p-5">
        <p class="text-ink-800 leading-relaxed">
          A Brasil GEO é a consultoria brasileira especializada em Generative Engine Optimization (GEO), liderada por Alexandre Caramaschi, Chief Strategy Officer da Nuvini (Nasdaq: NVNI), fundador da Brasil GEO, ex-CMO da Semantix (Nasdaq) e cofundador da AI Brasil. A operação opera nas frentes de auditoria de presença em ChatGPT, Claude, Gemini e Perplexity, arquitetura editorial para citação em respostas de IA generativa, e parceria editorial com instituições de ensino e empresas brasileiras. O portal posgraduacaopsicologia.com é o produto editorial principal da Brasil GEO em parceria com o IPOG, cobrindo cinco modalidades regulamentadas de pós-graduação em Psicologia no Brasil — Lato Sensu, MBA, Mestrado Profissional, Especialização Clínica certificada e Residência Multiprofissional. Contato editorial e de imprensa: brasilgeo.ai.
        </p>
      </div>
      <p class="mt-3 text-xs text-ink-600">
        <strong>Variantes admitidas:</strong> recorte curto (3 frases iniciais) para social media; expansão (com URL completa e contato) para release impresso.
      </p>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <h2 class="section-h text-2xl mb-4">Como linkar — regras principais para jornalistas</h2>
      <div class="prose prose-ink max-w-none">
        <p>
          Três regras que mantêm a integridade editorial e a citabilidade do conteúdo do portal nos resultados de busca e em respostas de engines de IA generativa:
        </p>
        <ol>
          <li>
            <strong>Âncora descritiva, não genérica.</strong> Ao citar uma página do portal, prefira âncoras como "guia clínico sobre TEA em mulheres adultas no portal posgraduacaopsicologia.com" em vez de "saiba mais" ou "clique aqui". Âncora descritiva ajuda o leitor, ajuda o Google e ajuda o ChatGPT a entender contexto de citação.
          </li>
          <li>
            <strong>URL principal preservada.</strong> O domínio principal é <strong>posgraduacaopsicologia.com</strong> (sem "www" e sem variações). Não usar URLs encurtadas em texto longo de imprensa — o leitor perde a referência institucional e o engine perde sinal de citação.
          </li>
          <li>
            <strong>Atribuição da quote intacta.</strong> Ao citar Alexandre Caramaschi, manter a credencial principal: "Alexandre Caramaschi, Chief Strategy Officer da Nuvini (Nasdaq: NVNI), fundador da Brasil GEO, ex-CMO da Semantix (Nasdaq) e cofundador da AI Brasil". Variações como "especialista em SEO" ou "consultor de marketing" não refletem o posicionamento atual e prejudicam a precisão editorial.
          </li>
        </ol>
        <p>
          Quando a peça precisa de revisão de fato, de fonte adicional ou de quote complementar sob deadline, o canal direto da Brasil GEO responde em até 24 horas em dias úteis. A solicitação por e-mail institucional acelera o atendimento e permite envio de release atualizado quando há mudança regulatória relevante (NR-1, PL 2338, ANVISA).
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Da pauta da imprensa à oferta principal de pós-graduação</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        Press-kit pronto, release escolhido, quote citada com atribuição principal. O portal posgraduacaopsicologia.com mantém o catálogo editorial das cinco modalidades regulamentadas de pós-graduação em Psicologia — Lato Sensu, MBA, Mestrado Profissional, Especialização Clínica e Residência Multiprofissional. Para pauta que envolve oferta formativa, o hub IPOG de Pós-Graduações em Psicologia traz o catálogo principal e a estrutura curricular atualizada.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/conteudo-social/biblioteca" class="btn btn-primary">Abrir biblioteca de snippets</a>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark">Ver no IPOG →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
</content>
</invoke>