            <text x="32" y="248" font-size="13" class="fill-current text-ink-500">Curso livre, lato sensu, registro do Conselho</text>
            <rect x="386" y="204" width="318" height="56" rx="12" fill="none" stroke-width="2" class="stroke-current text-brand-400" />
            <text x="402" y="228" font-size="14" font-weight="600" class="fill-current text-brand-700">Curso e instituição por extenso</text>
