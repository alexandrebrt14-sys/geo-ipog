---
import {
  SITE,
  MBAS,
  AREAS,
  PERSONAS,
  GUIAS,
  FAQS_DEEP,
  GLOSSARIO_CLUSTERS,
  TEMAS_EMERGENTES_2025_2026
} from '@lib/data';
import MegaMenu from './MegaMenu.astro';

interface Props {
  showSearch?: boolean;
}
const { showSearch = true } = Astro.props;

const areasCluster1 = AREAS.filter(a => a.cluster === 'pot-bem-estar');
const areasCluster2 = AREAS.filter(a => a.cluster === 'neuro-avaliacao');
const areasCluster3 = AREAS.filter(a => a.cluster === 'demais');
---

<header id="main-header" class="sticky top-0 z-40 bg-white/90 glass-strong border-b border-surface-200 transition-shadow">
  <div class="container-page h-16 flex items-center gap-3 sm:gap-4">
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="Início">
      <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-brand-800 text-white font-display font-bold text-sm group-hover:scale-105 transition-transform">pP</span>
      <span class="hidden md:flex flex-col leading-tight">
        <span class="font-display font-bold text-brand-800 text-[15px] tracking-tight">posgraduacaopsicologia</span>
        <span class="text-[10px] uppercase tracking-[.18em] text-ink-500">guia independente · 2026</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-0.5 ml-2" aria-label="Navegação principal">
      <a href="/busca" class="nav-link inline-flex items-center gap-1.5" aria-label="Ir para a busca">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        Busca
      </a>

      <MegaMenu label="Guia" panelWidth="640" id="mega-guia">
        <div slot="panel" class="grid grid-cols-3 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Conceitos</p>
            <a href="/regulacao#mba-vs-especializacao" class="mega-link"><strong class="text-ink-900">MBA vs Especialização</strong><span class="text-xs text-ink-500 block">Família lato sensu, mercados diferentes</span></a>
            <a href="/regulacao#lato-stricto" class="mega-link"><strong class="text-ink-900">Lato vs Stricto sensu</strong><span class="text-xs text-ink-500 block">Aplicada vs pesquisa</span></a>
            <a href="/regulacao#modalidades" class="mega-link"><strong class="text-ink-900">Online · ao vivo · presencial</strong><span class="text-xs text-ink-500 block">Compatibilidade com seu contexto</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Regulamentação</p>
            <a href="/regulacao#cfp" class="mega-link"><strong class="text-ink-900">CFP e especialidades</strong><span class="text-xs text-ink-500 block">As 13 especialidades reconhecidas</span></a>
            <a href="/regulacao#satepsi" class="mega-link"><strong class="text-ink-900">SATEPSI</strong><span class="text-xs text-ink-500 block">Testes psicológicos com parecer favorável</span></a>
            <a href="/regulacao#niveis" class="mega-link"><strong class="text-ink-900">Níveis editoriais R0-R4</strong><span class="text-xs text-ink-500 block">O que publicamos e o que não</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Para quem você é</p>
            {PERSONAS.map(p => (
              <a href={`/para-quem/${p.id}`} class="mega-link">
                <strong class="text-ink-900 text-sm leading-tight">{p.name}</strong>
                <span class="text-[11px] text-ink-500 block">→ {p.recommendedMBA}</span>
              </a>
            ))}
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="MBAs" panelWidth="780" id="mega-mbas">
        <div slot="panel" class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">MBAs em destaque do IPOG</p>
            {MBAS.map(m => (
              <a href={`/mbas#${m.id}`} class="mega-link">
                <span class="inline-flex w-7 h-7 rounded-md bg-brand-50 text-brand-700 items-center justify-center text-[10px] font-bold uppercase shrink-0 mt-0.5">{m.tag.slice(0,3)}</span>
                <span>
                  <strong class="text-ink-900 block leading-snug">{m.shortName}</strong>
                  <span class="text-xs text-ink-500 line-clamp-1">{m.topics.slice(0,4).join(' · ')}</span>
                </span>
              </a>
            ))}
            <a href="/mbas" class="mega-link mt-2 border-t border-surface-200 pt-3">
              <strong class="text-brand-700 text-sm">Ver hub completo →</strong>
            </a>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-white p-4 border border-surface-200">
            <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Caminho oficial</p>
            <p class="text-sm text-ink-700">Valor, modalidade e turma são tratados diretamente no portal IPOG.</p>
            <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary btn-sm mt-4">
              Ver todos no IPOG
              <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
            </a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Áreas" panelWidth="920" id="mega-areas">
        <div slot="panel" class="grid grid-cols-4 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">POT + Bem-estar</p>
            {areasCluster1.map(a => (
              <a href={`/areas/${a.id}`} class="mega-link"><strong class="text-ink-900 text-sm leading-tight">{a.name}</strong></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Neuro + Avaliação</p>
            {areasCluster2.map(a => (
              <a href={`/areas/${a.id}`} class="mega-link"><strong class="text-ink-900 text-sm leading-tight">{a.name}</strong></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Demais áreas</p>
            {areasCluster3.map(a => (
              <a href={`/areas/${a.id}`} class="mega-link"><span class="text-ink-900 text-sm leading-tight">{a.short}</span></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Atalhos</p>
            <a href="/areas" class="mega-link"><strong class="text-ink-900 text-sm">Ver todas as 18 áreas</strong></a>
            <a href="/comparativos" class="mega-link"><strong class="text-ink-900 text-sm">Comparativos</strong><span class="text-[11px] text-ink-500 block">Áreas e MBAs lado a lado</span></a>
            <a href="/mapa-do-site" class="mega-link"><strong class="text-ink-900 text-sm">Mapa do site</strong><span class="text-[11px] text-ink-500 block">Visão completa do portal</span></a>
            <a href="/busca" class="mega-link mt-2 border-t border-surface-200 pt-3"><strong class="text-brand-700 text-sm">Buscar área →</strong></a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Conhecimento" panelWidth="920" id="mega-conhecimento">
        <div slot="panel" class="grid grid-cols-4 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Evidências · papers 2025-2026</p>
            <a href="/evidencias" class="mega-link"><strong class="text-ink-900">Hub Evidências</strong><span class="text-xs text-ink-500 block">Síntese da literatura atual</span></a>
            <a href="/evidencias/nr1-riscos-psicossociais-2026" class="mega-link"><span class="text-ink-900 text-sm">NR-1 · riscos psicossociais</span></a>
            <a href="/evidencias/burnout-gen-z" class="mega-link"><span class="text-ink-900 text-sm">Burnout Gen Z</span></a>
            <a href="/evidencias/ia-generativa-saude-mental" class="mega-link"><span class="text-ink-900 text-sm">IA generativa · saúde mental</span></a>
            <a href="/evidencias/mindfulness-corporativo" class="mega-link"><span class="text-ink-900 text-sm">Mindfulness corporativo</span></a>
            <a href="/evidencias/terapias-terceira-onda" class="mega-link"><span class="text-ink-900 text-sm">Terapias de 3ª onda</span></a>
            <a href="/evidencias/fadiga-digital" class="mega-link"><span class="text-ink-900 text-sm">Fadiga digital · tecnostress</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Estudos de caso</p>
            <a href="/casos" class="mega-link"><strong class="text-ink-900">Hub Casos compostos</strong><span class="text-xs text-ink-500 block">HBR-grade · sigilo preservado</span></a>
            <a href="/casos/pot-fabrica-nr1" class="mega-link"><span class="text-ink-900 text-sm">POT · fábrica NR-1</span></a>
            <a href="/casos/positiva-burnout-fintech" class="mega-link"><span class="text-ink-900 text-sm">Positiva · burnout em fintech</span></a>
            <a href="/casos/reabilitacao-pos-avc" class="mega-link"><span class="text-ink-900 text-sm">Reabilitação pós-AVC</span></a>
            <a href="/casos/lideranca-positiva-startup-escalando" class="mega-link"><span class="text-ink-900 text-sm">Liderança Positiva · scale-up</span></a>
            <a href="/casos/aba-rede-escolar" class="mega-link"><span class="text-ink-900 text-sm">ABA · rede escolar</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Protocolos de intervenção</p>
            <a href="/intervencoes" class="mega-link"><strong class="text-ink-900">Hub Intervenções</strong><span class="text-xs text-ink-500 block">Stepped Care · IAPT · matriciamento</span></a>
            <a href="/intervencoes/stepped-care" class="mega-link"><span class="text-ink-900 text-sm">Stepped Care</span></a>
            <a href="/intervencoes/iapt-nhs" class="mega-link"><span class="text-ink-900 text-sm">IAPT · NHS</span></a>
            <a href="/intervencoes/atencao-primaria-matriciamento" class="mega-link"><span class="text-ink-900 text-sm">Atenção primária · matriciamento</span></a>
            <a href="/intervencoes/intervencao-crise" class="mega-link"><span class="text-ink-900 text-sm">Intervenção em crise</span></a>
            <a href="/intervencoes/retorno-ao-trabalho" class="mega-link"><span class="text-ink-900 text-sm">Retorno ao trabalho</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Métodos terapêuticos</p>
            <a href="/metodos" class="mega-link"><strong class="text-ink-900">Hub Métodos</strong><span class="text-xs text-ink-500 block">Evidence-based · NICE · APA</span></a>
            <a href="/metodos/tcc" class="mega-link"><span class="text-ink-900 text-sm">TCC · Cognitivo-Comportamental</span></a>
            <a href="/metodos/act" class="mega-link"><span class="text-ink-900 text-sm">ACT · Aceitação e Compromisso</span></a>
            <a href="/metodos/dbt" class="mega-link"><span class="text-ink-900 text-sm">DBT · Dialética</span></a>
            <a href="/metodos/mindfulness" class="mega-link"><span class="text-ink-900 text-sm">Mindfulness · MBSR/MBCT</span></a>
            <a href="/metodos/emdr" class="mega-link"><span class="text-ink-900 text-sm">EMDR</span></a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Guias & FAQs" panelWidth="720" id="mega-guias">
        <div slot="panel" class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Guias práticos · passo-a-passo</p>
            <a href="/guias" class="mega-link"><strong class="text-ink-900">Hub Guias</strong><span class="text-xs text-ink-500 block">HowTo · 8-9 passos cada</span></a>
            {GUIAS.map(g => (
              <a href={`/guias/${g.id}`} class="mega-link"><span class="text-ink-900 text-sm">{g.name}</span><span class="text-[11px] text-ink-500 block">{g.steps} passos</span></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">FAQs aprofundadas</p>
            <a href="/faq" class="mega-link"><strong class="text-ink-900">Hub FAQ-deep</strong><span class="text-xs text-ink-500 block">82 Q&As otimizadas para AI Overview</span></a>
            {FAQS_DEEP.map(f => (
              <a href={`/faq/${f.id}`} class="mega-link"><span class="text-ink-900 text-sm">{f.name}</span><span class="text-[11px] text-ink-500 block">{f.qas} perguntas</span></a>
            ))}
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Glossário & Temas 2026" panelWidth="720" id="mega-glossario">
        <div slot="panel" class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Glossário · 115 termos</p>
            <a href="/glossario" class="mega-link"><strong class="text-ink-900">Hub Glossário</strong><span class="text-xs text-ink-500 block">5 clusters · termos definidos</span></a>
            {GLOSSARIO_CLUSTERS.map(c => (
              <a href={`/glossario#${c.id}`} class="mega-link"><span class="text-ink-900 text-sm">{c.name}</span></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Temas emergentes 2025-2026</p>
            <a href="/temas" class="mega-link"><strong class="text-ink-900">Hub Temas</strong><span class="text-xs text-ink-500 block">Sinais que organizam a agenda atual</span></a>
            {TEMAS_EMERGENTES_2025_2026.slice(0, 7).map(t => (
              <a href={`/temas/${t.id}`} class="mega-link"><span class="text-ink-900 text-sm">{t.name}</span></a>
            ))}
          </div>
        </div>
      </MegaMenu>

      <a href="/por-estado" class="nav-link">Por estado</a>
      <a href="/carreira" class="nav-link">Carreira</a>
      <a href="/regulacao" class="nav-link">Regulação</a>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {showSearch && (
        <button
          type="button"
          data-open-search
          class="hidden sm:inline-flex items-center gap-2 pl-3 pr-2 py-2 border border-surface-200 rounded-xl text-sm text-ink-500 hover:border-brand-400 hover:text-brand-800 bg-white transition w-[260px] xl:w-[320px]"
          aria-label="Abrir busca">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="flex-1 text-left truncate">Buscar áreas, MBAs, temas...</span>
          <span class="kbd hidden xl:inline-flex">⌘</span><span class="kbd hidden xl:inline-flex">K</span>
        </button>
      )}
      <button
        type="button"
        data-open-search
        class="sm:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-surface-200 text-ink-700"
        aria-label="Abrir busca">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <a href={SITE.ipogOfficial} target="_blank" rel="noopener external"
        class="hidden md:inline-flex btn btn-secondary btn-sm">
        IPOG oficial
        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
      </a>
    </div>
  </div>
</header>
