---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Psicologia em Saúde: SUS, eMulti e formação atualizada em 2026",
  "description": "Conheça o trabalho da Psicologia na rede de saúde, as atualizações de eMulti em 2026 e critérios para formação e planejamento compartilhado.",
  "route": "/areas/psicologia-saude/",
  "label": "Psicologia em Saúde",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "Psicologia em Saúde exclui atendimento individual?",
      "a": "Não. Diferentes formatos podem ser necessários. A escolha deve considerar necessidades, contexto e continuidade, sem oposição rígida entre individual e coletivo."
    },
    {
      "q": "A Portaria de 2023 é suficiente para estudar eMulti hoje?",
      "a": "Não. A Nota Técnica Conjunta 77/2026 aborda mudanças decorrentes da Portaria 9.584/2025. Consulte também a organização local."
    },
    {
      "q": "Uma pós garante pontuação em concurso?",
      "a": "Não. Requisitos e critérios dependem do edital. Confira a correspondência entre curso, documentação e oportunidade específica."
    }
  ],
  "worksheet": {
    "title": "Mapa educativo de um percurso de cuidado",
    "description": "Examine articulação de serviços usando uma situação fictícia.",
    "fields": [
      {
        "label": "Necessidade e contexto",
        "hint": "Qual demanda fictícia chega ao serviço?"
      },
      {
        "label": "Funções e recursos",
        "hint": "Quem pode contribuir e quais recursos estão disponíveis?"
      },
      {
        "label": "Continuidade",
        "hint": "Como a equipe saberá o que aconteceu após o encaminhamento?"
      },
      {
        "label": "Fonte e dúvida normativa",
        "hint": "Qual documento atual orienta a organização estudada?"
      }
    ],
    "checklist": [
      "Considerei necessidades individuais e contexto.",
      "Não usei redução de fila como único resultado.",
      "Conferi atualização normativa de eMulti.",
      "Usei apenas situação fictícia e fontes públicas."
    ]
  },
  "sources": [
    [
      "Ministério da Saúde: equipes multiprofissionais na APS",
      "https://www.gov.br/saude/pt-br/composicao/saps/acoes-interprofissionais/emulti/emulti"
    ],
    [
      "Nota Técnica Conjunta nº 77/2026: organização das eMulti",
      "https://www.gov.br/saude/pt-br/centrais-de-conteudo/publicacoes/notas-tecnicas/2026/nota-tecnica-conjunta-no-77-2026-cocip-codip-dgci-saps-ms"
    ],
    [
      "Ministério da Saúde: cuidado paliativo na rede",
      "https://www.gov.br/saude/pt-br/composicao/saes/cuidados-paliativos/cuidados-paliativos/"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma psicóloga começa a trabalhar na atenção primária e recebe uma fila de encaminhamentos. A equipe precisa compreender necessidades, recursos e continuidade do cuidado antes de decidir como organizar atendimentos, grupos e trabalho compartilhado.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>O cuidado em saúde articula necessidades individuais, território e trabalho em equipe.</h2>
<p>A Psicologia em Saúde envolve promoção, prevenção, acompanhamento e cuidado em diferentes pontos da rede. A atuação precisa considerar a pessoa, suas condições de vida e a organização dos serviços. Isso inclui demandas relacionadas ao adoecimento físico e não apenas diagnósticos de saúde mental.</p>
<p>Atendimento individual, atividades coletivas e apoio às equipes podem cumprir funções distintas. Nenhum formato deve ser descartado por princípio ou adotado apenas para esvaziar uma fila. O planejamento começa pelas necessidades e pela capacidade de responder a elas com continuidade.</p></section>
<section><h2>eMulti: atualize a referência além de 2023</h2>
<p>O <a href="https://www.gov.br/saude/pt-br/composicao/saps/acoes-interprofissionais/emulti/emulti">Ministério da Saúde descreve as eMulti</a> como equipes multiprofissionais que atuam de forma complementar e integrada às demais equipes da atenção primária, compartilhando população e território. A estratégia não deve ser reduzida a uma simples troca de nome do antigo NASF.</p>
<p>A <a href="https://www.gov.br/saude/pt-br/centrais-de-conteudo/publicacoes/notas-tecnicas/2026/nota-tecnica-conjunta-no-77-2026-cocip-codip-dgci-saps-ms">Nota Técnica Conjunta nº 77/2026-COCIP/COPID/DGCI/SAPS/MS</a> apresenta orientações após a Portaria GM/MS nº 9.584/2025, com ajustes na organização e composição das equipes. Para estudar financiamento, modalidades ou requisitos locais, consulte o documento e a gestão responsável, sem tomar um material de 2023 como descrição completa do cenário atual.</p>
<p>Uma pós precisa ensinar a localizar atualizações e distinguir política nacional, organização municipal e rotina do serviço. Essas camadas se relacionam, mas uma portaria não comprova abertura de vagas nem garante a presença de todas as profissões em cada unidade.</p></section>
<section><h2>O que significa compartilhar o cuidado</h2>
<p>O trabalho compartilhado pode envolver discussão de demandas, construção de perguntas entre profissionais, atendimentos articulados e planejamento de continuidade. Encaminhar não deve significar perder a informação sobre o percurso da pessoa. É preciso combinar quem acompanha, como as dúvidas circulam e como as decisões serão revistas.</p>
<p>No exemplo hipotético, a equipe pode mapear os motivos dos encaminhamentos e os recursos existentes antes de reorganizar a agenda. Algumas situações podem exigir cuidado individual; outras pedem ações coletivas ou articulação entre serviços. A análise não promete redução numérica da fila nem trata a substituição de consultas por grupos como solução universal.</p>
<p>Considere também barreiras de transporte, horários, comunicação e acessibilidade. Uma ausência ao encontro não revela, por si só, desinteresse ou falta de adesão. O serviço precisa compreender o que impede a participação e quais ajustes estão ao seu alcance.</p></section>
<section><h2>Critérios para comparar formações</h2>
<div class="table-wrap"><table><thead><tr><th>Competência</th><th>Evidência a solicitar</th></tr></thead><tbody>
<tr><td>Leitura da rede</td><td>Atividade que relacione serviços, responsabilidades e fluxos de cuidado</td></tr>
<tr><td>Trabalho interprofissional</td><td>Discussão de casos simulados com decisões compartilhadas</td></tr>
<tr><td>Território</td><td>Análise de barreiras, recursos comunitários e participação</td></tr>
<tr><td>Políticas e atualizações</td><td>Bibliografia normativa com data e fonte original</td></tr>
<tr><td>Avaliação do trabalho</td><td>Critérios que considerem acesso, continuidade e necessidades, além do volume</td></tr>
</tbody></table></div>
<p>Para concurso ou contratação, leia o edital específico. A utilidade de um curso depende de seu conteúdo e das exigências da oportunidade; não há pontuação ou retorno garantido apenas pelo nome da especialização. Verifique docentes, supervisão e atividades práticas antes de decidir.</p></section>
<section><h2>Uma ferramenta para estudar o percurso do cuidado</h2>
<p>Desenhe um percurso fictício com entrada no serviço, funções envolvidas, dúvidas e ponto de retorno. Registre onde faltam informações e quem poderia fornecê-las. Esse exercício permite comparar a formação desejada com uma competência concreta, sem criar um encaminhamento real.</p>
<p>A <a href="/areas/psicologia-hospitalar/">Psicologia Hospitalar</a> aprofunda o cuidado no hospital e a <a href="/areas/psicologia-social/">Psicologia Social</a> contribui para compreender território e direitos. A <a href="https://www.gov.br/saude/pt-br/composicao/saes/cuidados-paliativos/cuidados-paliativos/">política de cuidados paliativos</a> também destaca continuidade em diferentes pontos da rede.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/dados-com-python">Dados com Python</a>, do portal de Alexandre Caramaschi, pode apoiar exercícios com indicadores públicos ou sintéticos. Não use listas de usuários ou dados individuais de saúde. Preencha a ficha com um percurso fictício e uma pergunta que a formação precisa ajudar a responder.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
