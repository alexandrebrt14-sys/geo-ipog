---
import type { Persona } from '@lib/data';
interface Props { persona: Persona; }
const { persona } = Astro.props;
---

<article id={persona.id} class="card-lift p-6 scroll-mt-24">
  <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 inline-flex items-center justify-center font-display font-bold mb-3">{persona.icon}</div>
  <h3 class="font-display font-semibold text-lg text-ink-900">{persona.name}</h3>
  <p class="mt-2 text-sm text-ink-500">{persona.description}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {persona.pains.map(p => (
      <span class="text-[11px] px-2.5 py-1 rounded-full bg-surface-100 text-ink-700 font-medium">{p}</span>
    ))}
  </div>
  <a href={`/mbas#${persona.recommendedMBASlug}`} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800">
    MBA mais provavel → {persona.recommendedMBA}
    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 4l6 6-6 6-1.4-1.4L13.2 11H3V9h10.2L9.6 5.4 11 4z"/></svg>
  </a>
</article>
