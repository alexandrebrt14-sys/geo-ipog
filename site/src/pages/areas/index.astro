---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AreasFilteredGrid from '@components/AreasFilteredGrid.tsx';
import { AREAS } from '@lib/data';
---

<Base title="Áreas da Psicologia — 18 áreas mapeadas (CFP + correlatas)" description="Explore as 13 especialidades reconhecidas pelo CFP e áreas correlatas estrategicas para carreira em Psicologia.">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Áreas' }]} />
      <h1 class="section-h text-3xl sm:text-4xl mt-3">Áreas da Psicologia mapeadas.</h1>
      <p class="mt-2 text-ink-700 max-w-2xl">As 13 especialidades reconhecidas pelo CFP mais áreas correlatas estrategicas para carreira em Psicologia aplicada. Filtre por cluster e nível regulatorio.</p>
    </div>
  </section>

  <section class="container-page py-10">
    <AreasFilteredGrid client:load initial={AREAS} />
  </section>
</Base>
