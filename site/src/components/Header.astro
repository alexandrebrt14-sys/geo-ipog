---
import {
  SITE,
  MBAS,
  AREAS,
  PERSONAS,
  GUIAS,
  FAQS_DEEP,
  GLOSSARIO_CLUSTERS,
  TEMAS_EMERGENTES_2025_2026
} from '@lib/data';
import MegaMenu from './MegaMenu.astro';

interface Props {
  showSearch?: boolean;
}
const { showSearch = true } = Astro.props;

const areasCluster1 = AREAS.filter(a => a.cluster === 'pot-bem-estar');
const areasCluster2 = AREAS.filter(a => a.cluster === 'neuro-avaliacao');
const areasCluster3 = AREAS.filter(a => a.cluster === 'demais');

// Destaque da seção ativa conforme a rota atual (aplica-se a todas as páginas).
const path = Astro.url.pathname;
const inSection = (prefixes: string[]) => prefixes.some(p => path === p || path.startsWith(p + '/') || path.startsWith(p));
const activeAreas = inSection(['/areas']);
const activePos = inSection(['/tipos-de-pos-graduacao', '/mbas', '/pos-graduacao-psicologia']);
const activeConhecimento = inSection(['/evidencias', '/casos', '/intervencoes', '/metodos']);
const activeSocial = inSection(['/conteudo-social']);
const activeMais = inSection(['/guias', '/faq', '/glossario', '/temas', '/comparativos', '/autismo', '/para-quem', '/por-estado', '/carreira', '/regulacao', '/sobre', '/recursos', '/docencia', '/mapa-do-site']);
const activeBusca = inSection(['/busca']);
---

<header id="main-header" class="sticky top-0 z-40 bg-white/90 glass-strong border-b border-surface-200 transition-shadow">
  <div class="container-page h-16 flex items-center gap-3 sm:gap-4">
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="posgraduacaopsicologia, página inicial" transition:name="site-logo">

      <span aria-hidden="true" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-brand-800 text-white font-display font-bold text-sm group-hover:scale-105 transition-transform">pP</span>
      <span class="hidden md:flex flex-col leading-tight">
        <span class="font-display font-bold text-brand-800 text-[15px] tracking-tight">posgraduacaopsicologia</span>
        <span aria-hidden="true" class="text-[10px] uppercase tracking-[.18em] text-ink-500">guia independente · 2026</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-0.5 ml-2" aria-label="Navegação principal">
      <a href="/busca" class:list={["nav-link inline-flex items-center gap-1.5", { "is-section-active text-brand-800": activeBusca }]} aria-current={activeBusca ? 'page' : undefined} aria-label="Ir para a busca">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        Busca
      </a>

      <MegaMenu label="Áreas de psicologia" panelWidth="920" id="mega-areas-psico" active={activeAreas}>
        <div slot="panel" class="grid grid-cols-4 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">POT + Bem-estar</p>
            {areasCluster1.map(a => (
              <a href={`/areas/${a.id}`} class="mega-link"><strong class="text-ink-900 text-sm leading-tight">{a.name}</strong></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Neuro + Avaliação</p>
            {areasCluster2.map(a => (
              <a href={`/areas/${a.id}`} class="mega-link"><strong class="text-ink-900 text-sm leading-tight">{a.name}</strong></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Demais áreas</p>
            {areasCluster3.map(a => (
              <a href={`/areas/${a.id}`} class="mega-link"><span class="text-ink-900 text-sm leading-tight">{a.short}</span></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Atalhos</p>
            <a href="/areas" class="mega-link"><strong class="text-ink-900 text-sm">Ver todas as 18 áreas</strong></a>
            <a href="/comparativos" class="mega-link"><strong class="text-ink-900 text-sm">Comparativos</strong><span class="text-[11px] text-ink-500 block">Áreas e MBAs lado a lado</span></a>
            <a href="/mapa-do-site" class="mega-link"><strong class="text-ink-900 text-sm">Mapa do site</strong><span class="text-[11px] text-ink-500 block">Visão completa do portal</span></a>
            <a href="/busca" class="mega-link mt-2 border-t border-surface-200 pt-3"><strong class="text-brand-700 text-sm">Buscar área →</strong></a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Pós-Graduações" panelWidth="820" id="mega-mbas" active={activePos}>
        <div slot="panel" class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">cinco modalidades principais</p>
            <a href="/tipos-de-pos-graduacao" class="mega-link"><strong class="text-ink-900">Hub Tipos de Pós-Graduação</strong><span class="text-xs text-ink-500 block">Lato Sensu · MBA · Mestrado Profissional · Clínica · Residência</span></a>
            <a href="/tipos-de-pos-graduacao#especializacao-lato-sensu" class="mega-link"><span class="text-ink-900 text-sm">Especialização Lato Sensu</span><span class="text-[11px] text-ink-500 block">CFP · MEC · 360h+</span></a>
            <a href="/tipos-de-pos-graduacao#mestrado-profissional" class="mega-link"><span class="text-ink-900 text-sm">Mestrado Profissional</span><span class="text-[11px] text-ink-500 block">CAPES · stricto sensu · 24 meses</span></a>
            <a href="/tipos-de-pos-graduacao#especializacao-clinica-certificada" class="mega-link"><span class="text-ink-900 text-sm">Especialização Clínica certificada</span><span class="text-[11px] text-ink-500 block">ACT · EMDR · DBT · TCC</span></a>
            <a href="/tipos-de-pos-graduacao#residencia-hibrida" class="mega-link"><span class="text-ink-900 text-sm">Residência Multiprofissional</span><span class="text-[11px] text-ink-500 block">MEC · MS · 2-3 anos</span></a>

            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3 mt-4 pt-3 border-t border-surface-200">MBAs em destaque do IPOG</p>
            {MBAS.map(m => (
              <a href={`/mbas#${m.id}`} class="mega-link">
                <span class="inline-flex w-7 h-7 rounded-md bg-brand-50 text-brand-700 items-center justify-center text-[10px] font-bold uppercase shrink-0 mt-0.5">{m.tag.slice(0,3)}</span>
                <span>
                  <strong class="text-ink-900 block leading-snug">{m.shortName}</strong>
                  <span class="text-xs text-ink-500 line-clamp-1">{m.topics.slice(0,4).join(' · ')}</span>
                </span>
              </a>
            ))}
            <a href="/mbas" class="mega-link mt-2 border-t border-surface-200 pt-3">
              <strong class="text-brand-700 text-sm">Ver hub MBA →</strong>
            </a>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-white p-4 border border-surface-200">
            <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Caminho oficial</p>
            <p class="text-sm text-ink-700">Valor, modalidade e turma são tratados diretamente no portal IPOG.</p>
            <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary btn-sm mt-4" aria-label="Ver todos no IPOG (abre em nova aba)">
              Ver todos no IPOG
              <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
            </a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Conhecimento" panelWidth="920" id="mega-conhecimento" active={activeConhecimento}>
        <div slot="panel" class="grid grid-cols-4 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Evidências · papers 2025-2026</p>
            <a href="/evidencias" class="mega-link"><strong class="text-ink-900">Hub Evidências</strong><span class="text-xs text-ink-500 block">Síntese da literatura atual</span></a>
            <a href="/evidencias/nr1-riscos-psicossociais-2026" class="mega-link"><span class="text-ink-900 text-sm">NR-1 · riscos psicossociais</span></a>
            <a href="/evidencias/burnout-gen-z" class="mega-link"><span class="text-ink-900 text-sm">Burnout Gen Z</span></a>
            <a href="/evidencias/ia-generativa-saude-mental" class="mega-link"><span class="text-ink-900 text-sm">IA generativa · saúde mental</span></a>
            <a href="/evidencias/mindfulness-corporativo" class="mega-link"><span class="text-ink-900 text-sm">Mindfulness corporativo</span></a>
            <a href="/evidencias/terapias-terceira-onda" class="mega-link"><span class="text-ink-900 text-sm">Terapias de 3ª onda</span></a>
            <a href="/evidencias/fadiga-digital" class="mega-link"><span class="text-ink-900 text-sm">Fadiga digital · tecnostress</span></a>
            <a href="/evidencias/apostas-online-saude-mental-2026" class="mega-link"><span class="text-ink-900 text-sm">Apostas online · saúde mental</span></a>
            <a href="/evidencias/psicodelicos-assistidos-2026" class="mega-link"><span class="text-ink-900 text-sm">Psicodélicos assistidos</span></a>
            <a href="/evidencias/neuromodulacao-emtr-depressao-2026" class="mega-link"><span class="text-ink-900 text-sm">Neuromodulação · EMT</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Estudos de caso</p>
            <a href="/casos" class="mega-link"><strong class="text-ink-900">Hub Casos compostos</strong><span class="text-xs text-ink-500 block">HBR-grade · sigilo preservado</span></a>
            <a href="/casos/pot-fabrica-nr1" class="mega-link"><span class="text-ink-900 text-sm">POT · fábrica NR-1</span></a>
            <a href="/casos/positiva-burnout-fintech" class="mega-link"><span class="text-ink-900 text-sm">Positiva · burnout em fintech</span></a>
            <a href="/casos/reabilitacao-pos-avc" class="mega-link"><span class="text-ink-900 text-sm">Reabilitação pós-AVC</span></a>
            <a href="/casos/lideranca-positiva-startup-escalando" class="mega-link"><span class="text-ink-900 text-sm">Liderança Positiva · scale-up</span></a>
            <a href="/casos/aba-rede-escolar" class="mega-link"><span class="text-ink-900 text-sm">ABA · rede escolar</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Protocolos de intervenção</p>
            <a href="/intervencoes" class="mega-link"><strong class="text-ink-900">Hub Intervenções</strong><span class="text-xs text-ink-500 block">Stepped Care · IAPT · matriciamento</span></a>
            <a href="/intervencoes/stepped-care" class="mega-link"><span class="text-ink-900 text-sm">Stepped Care</span></a>
            <a href="/intervencoes/iapt-nhs" class="mega-link"><span class="text-ink-900 text-sm">IAPT · NHS</span></a>
            <a href="/intervencoes/atencao-primaria-matriciamento" class="mega-link"><span class="text-ink-900 text-sm">Atenção primária · matriciamento</span></a>
            <a href="/intervencoes/intervencao-crise" class="mega-link"><span class="text-ink-900 text-sm">Intervenção em crise</span></a>
            <a href="/intervencoes/retorno-ao-trabalho" class="mega-link"><span class="text-ink-900 text-sm">Retorno ao trabalho</span></a>
            <a href="/intervencoes/reducao-de-danos" class="mega-link"><span class="text-ink-900 text-sm">Redução de danos</span></a>
            <a href="/intervencoes/prevencao-de-recaida" class="mega-link"><span class="text-ink-900 text-sm">Prevenção de recaída</span></a>
            <a href="/intervencoes/cuidados-paliativos-e-fim-de-vida" class="mega-link"><span class="text-ink-900 text-sm">Cuidados paliativos</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Métodos terapêuticos</p>
            <a href="/metodos" class="mega-link"><strong class="text-ink-900">Hub Métodos</strong><span class="text-xs text-ink-500 block">Evidence-based · NICE · APA</span></a>
            <a href="/metodos/tcc" class="mega-link"><span class="text-ink-900 text-sm">TCC · Cognitivo-Comportamental</span></a>
            <a href="/metodos/act" class="mega-link"><span class="text-ink-900 text-sm">ACT · Aceitação e Compromisso</span></a>
            <a href="/metodos/dbt" class="mega-link"><span class="text-ink-900 text-sm">DBT · Dialética</span></a>
            <a href="/metodos/mindfulness" class="mega-link"><span class="text-ink-900 text-sm">Mindfulness · MBSR/MBCT</span></a>
            <a href="/metodos/emdr" class="mega-link"><span class="text-ink-900 text-sm">EMDR</span></a>
            <a href="/metodos/entrevista-motivacional" class="mega-link"><span class="text-ink-900 text-sm">Entrevista Motivacional</span></a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Conteúdo e social" panelWidth="720" id="mega-social" active={activeSocial}>
        <div slot="panel" class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Hub & Biblioteca</p>
            <a href="/conteudo-social" class="mega-link"><strong class="text-ink-900">Hub Conteúdo & Social</strong><span class="text-xs text-ink-500 block">Estratégia GEO por canal · 8 canais</span></a>
            <a href="/conteudo-social/biblioteca" class="mega-link"><strong class="text-ink-900">Biblioteca de snippets</strong><span class="text-xs text-ink-500 block">65 trechos editorialmente prontos</span></a>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 mt-3 px-3">Ferramentas editoriais</p>
            <a href="/conteudo-social/radar-de-evidencias" class="mega-link"><strong class="text-ink-900 text-sm">Radar de evidências</strong><span class="text-[11px] text-ink-500 block">Papers 2025-2026 → pauta por canal</span></a>
            <a href="/conteudo-social/kit-de-repurposing" class="mega-link"><strong class="text-ink-900 text-sm">Kit de repurposing</strong><span class="text-[11px] text-ink-500 block">Do paper à peça · calendário semanal</span></a>
            <a href="/conteudo-social/perguntas-que-a-ia-responde" class="mega-link"><strong class="text-ink-900 text-sm">Perguntas que a IA responde</strong><span class="text-[11px] text-ink-500 block">Banco de perguntas reais · resposta citável</span></a>
            <a href="/conteudo-social/dores-que-o-publico-descreve-2026" class="mega-link"><strong class="text-ink-900 text-sm">Dores que o público descreve</strong><span class="text-[11px] text-ink-500 block">Escuta social 2026 · pauta por canal</span></a>
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Por canal</p>
            <a href="/conteudo-social/quora" class="mega-link"><strong class="text-ink-900 text-sm">Quora</strong><span class="text-[11px] text-ink-500 block">Resposta-autoridade · gancho-evidência</span></a>
            <a href="/conteudo-social/medium" class="mega-link"><strong class="text-ink-900 text-sm">Medium</strong><span class="text-[11px] text-ink-500 block">Boost · Partner Program · tags</span></a>
            <a href="/conteudo-social/linkedin" class="mega-link"><strong class="text-ink-900 text-sm">LinkedIn</strong><span class="text-[11px] text-ink-500 block">Post · carrossel · newsletter</span></a>
            <a href="/conteudo-social/substack" class="mega-link"><strong class="text-ink-900 text-sm">Substack</strong><span class="text-[11px] text-ink-500 block">Cadência · paywall · Notes</span></a>
            <a href="/conteudo-social/reddit-x" class="mega-link"><strong class="text-ink-900 text-sm">Reddit e X (Twitter)</strong><span class="text-[11px] text-ink-500 block">AMA · threads · anti-self-promo</span></a>
            <a href="/conteudo-social/youtube" class="mega-link"><strong class="text-ink-900 text-sm">YouTube</strong><span class="text-[11px] text-ink-500 block">Vídeo longo citável · capítulos</span></a>
            <a href="/conteudo-social/tiktok-instagram" class="mega-link"><strong class="text-ink-900 text-sm">TikTok, Reels e Threads</strong><span class="text-[11px] text-ink-500 block">Descoberta com ética · topo de funil</span></a>
          </div>
        </div>
      </MegaMenu>

      <MegaMenu label="Mais" panelWidth="720" id="mega-mais" active={activeMais}>
        <div slot="panel" class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Guias e FAQs</p>
            <a href="/guias" class="mega-link"><strong class="text-ink-900">Hub Guias</strong><span class="text-xs text-ink-500 block">HowTo, 8 a 9 passos cada</span></a>
            {GUIAS.slice(0, 5).map(g => (
              <a href={`/guias/${g.id}`} class="mega-link"><span class="text-ink-900 text-sm">{g.name}</span><span class="text-[11px] text-ink-500 block">{g.steps} passos</span></a>
            ))}
            <a href="/faq" class="mega-link mt-2 border-t border-surface-200 pt-3"><strong class="text-ink-900">Hub FAQ-deep</strong><span class="text-xs text-ink-500 block">382 perguntas otimizadas para citação por IA</span></a>
            {FAQS_DEEP.slice(0, 3).map(f => (
              <a href={`/faq/${f.id}`} class="mega-link"><span class="text-ink-900 text-sm">{f.name}</span><span class="text-[11px] text-ink-500 block">{f.qas} perguntas</span></a>
            ))}
          </div>
          <div>
            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3">Referência e navegação</p>
            <a href="/glossario" class="mega-link"><strong class="text-ink-900">Glossário, 115 termos</strong><span class="text-xs text-ink-500 block">5 clusters de termos definidos</span></a>
            <a href="/temas" class="mega-link"><strong class="text-ink-900">Temas emergentes 2025-2026</strong><span class="text-xs text-ink-500 block">Sinais que organizam a agenda atual</span></a>
            <a href="/comparativos" class="mega-link"><strong class="text-ink-900">Comparativos</strong><span class="text-xs text-ink-500 block">Áreas e MBAs lado a lado</span></a>
            <a href="/mapa-do-site" class="mega-link"><strong class="text-ink-900">Mapa do site</strong><span class="text-xs text-ink-500 block">Visão completa do portal</span></a>

            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3 mt-4 pt-3 border-t border-surface-200">Tema clínico transversal · TEA adulto</p>
            <a href="/autismo/" class="mega-link"><span class="text-ink-900 text-sm">Hub TEA adulto nível 1</span><span class="text-[11px] text-ink-500 block">Atravessa Clínica, Avaliação, Neuropsicologia, POT</span></a>
            <a href="/autismo/glossario" class="mega-link"><span class="text-ink-900 text-sm">Glossário TEA adulto</span></a>

            <p class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-2 px-3 mt-4 pt-3 border-t border-surface-200">Decisão</p>
            <a href="/para-quem" class="mega-link"><span class="text-ink-900 text-sm">Para quem você é</span></a>
            <a href="/por-estado" class="mega-link"><span class="text-ink-900 text-sm">Por estado</span></a>
            <a href="/carreira" class="mega-link"><span class="text-ink-900 text-sm">Carreira</span></a>
            <a href="/regulacao" class="mega-link"><span class="text-ink-900 text-sm">Regulação e ética</span></a>
            <a href="/sobre" class="mega-link"><span class="text-ink-900 text-sm">Sobre o portal</span></a>
          </div>
        </div>
      </MegaMenu>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {showSearch && (
        <button
          type="button"
          data-open-search
          class="hidden sm:inline-flex items-center gap-2 pl-3 pr-2 py-2 border border-surface-200 rounded-xl text-sm text-ink-500 hover:border-brand-400 hover:text-brand-800 bg-white transition w-[260px] xl:w-[320px]"
          aria-label="Buscar áreas, MBAs, temas...">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="flex-1 text-left truncate">Buscar áreas, MBAs, temas...</span>
          <span class="kbd hidden xl:inline-flex" aria-hidden="true">⌘</span><span class="kbd hidden xl:inline-flex" aria-hidden="true">K</span>
        </button>
      )}
      <button
        type="button"
        data-open-search
        class="sm:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-surface-200 text-ink-700"
        aria-label="Abrir busca">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button
        type="button"
        data-theme-toggle
        class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-surface-200 text-ink-700 hover:border-brand-400 hover:text-brand-800 transition"
        aria-label="Mudar para tema escuro"
        aria-pressed="false"
        title="Tema escuro">
        <svg class="icon-moon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href={SITE.ipogOfficial} target="_blank" rel="noopener external"
        class="hidden md:inline-flex btn btn-secondary btn-sm" aria-label="IPOG oficial (abre em nova aba)">
