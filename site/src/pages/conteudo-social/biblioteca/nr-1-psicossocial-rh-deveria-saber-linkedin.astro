---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const title = 'Post LinkedIn + carrossel 8 slides: o que todo RH deveria saber sobre NR-1 psicossocial em 2026 — Biblioteca Brasil GEO';
const description = 'Peça reaproveitável de 1.300 caracteres para LinkedIn + roteiro de carrossel 8 slides sobre NR-1 psicossocial e Portaria MTE 765/2025. Voz Caramaschi, fonte oficial.';
const slug = 'nr-1-psicossocial-rh-deveria-saber-linkedin';
const datePublished = '2026-05-17';

const copyPostLinkedIn = `A NR-1 atualizada pela Portaria MTE 765/2025 obrigou empresas brasileiras a gerenciar riscos psicossociais no PGR. Não é recomendação. É auditoria.

Seis indicadores que separam o programa que passa pela fiscalização do que vira multa:

→ 1. Levantamento quantitativo por equipe — não enquete de clima.
→ 2. Análise das seis dimensões de Maslach & Leiter (carga, controle, recompensa, justiça, comunidade, valores).
→ 3. Plano de ação que mexe na demanda, não no indivíduo.
→ 4. Responsabilidade gerencial atribuída e datada.
→ 5. Monitoramento trimestral com indicador comparável.
→ 6. Cláusula de revisão em mudança estrutural (reestruturação, fusão, novo sistema).

O que não passa em auditoria: campanha de Outubro Rosa, palestra anual, app de meditação corporativo e treinamento de soft skills sem mudança de KPI gerencial.

O psicólogo organizacional virou agente de compliance trabalhista. Quem se forma em 2026 sai direto para esse mercado.

#NR1 #SaudeMentalNoTrabalho #PsicologiaOrganizacional`;

const carrosselSlides = [
  {
    n: 1,
    titulo: 'NR-1 mudou em 2025. E não é programa de bem-estar.',
    corpo: 'Portaria MTE 765/2025 integrou riscos psicossociais ao PGR. Mesmo regime aplicado a risco químico e ergonômico: identificar, avaliar, controlar, monitorar.'
  },
  {
    n: 2,
    titulo: 'Auditor não pede campanha. Pede documento.',
    corpo: 'O que o fiscal do MTE pede: identificação de fatores psicossociais por função, plano de controle e evidência de implementação. Folder colorido não cumpre.'
  },
  {
    n: 3,
    titulo: 'Modelo Maslach & Leiter é a régua.',
    corpo: 'Seis dimensões: carga, controle, recompensa, justiça, comunidade, valores. Auditoria moderna usa esse framework (World Psychiatry 15(2):103-111).'
  },
  {
    n: 4,
    titulo: 'Autonomia formal sem controle real adoece mais, não menos.',
    corpo: 'Schaufeli (2017): trabalhador com direito formal de escolher mas avaliado por output sem teto desenvolve exaustão acelerada. NR-1 não diferencia.'
  },
  {
    n: 5,
    titulo: 'Gestor direto pesa mais que cultura da empresa.',
    corpo: 'Edmondson (2019): mesmo em empresa "saudável", gestor que não tolera divergência técnica produz exaustão mensurável em seis meses. Treinamento gerencial vira plano de controle válido.'
  },
  {
    n: 6,
    titulo: 'Intervenção que cumpre NR-1 é nível primário.',
    corpo: 'Mexer na arquitetura da demanda (carga, política de turno, processo de decisão). Ginástica laboral e psicoterapia subsidiada são nível terciário — mitigam consequência, não cumprem norma.'
  },
  {
    n: 7,
    titulo: 'Psicólogo organizacional é o profissional mais escasso de 2026.',
    corpo: 'Formação em POT virou requisito prático. MBA em Psicologia Organizacional reconhecido como Lato Sensu — IPOG, PUC, FGV oferecem — habilita atuação imediata.'
  },
  {
    n: 8,
    titulo: 'Próximo passo.',
    corpo: 'Auditoria do programa atual com os seis indicadores. Identificar gap. Contratar psicólogo organizacional ou treinar consultoria interna. Documentar tudo. Material aberto: posgraduacaopsicologia.com/evidencias/nr1-riscos-psicossociais-2026.'
  }
];

const comoAdaptar = [
  'Substack: vire edição com 6-8 seções (uma por slide), abra com "Premissa" e adicione um caso real composto de uma fintech ou indústria.',
  'Medium: junte slides 2-7 em ensaio de 1.500 palavras com H2 por seção e adicione tabela das seis dimensões de Maslach.',
  'Quora: pegue slides 1-3 como resposta de 600 palavras para a pergunta "O que mudou na NR-1 em 2025?". Termine com fonte (gov.br/trabalho/normas).',
  'Reddit r/recursoshumanos: poste com flair "Compliance Trabalhista", remova as hashtags, adicione disclosure de função profissional.',
  'YouTube Shorts: cada slide vira short de 30 segundos. Sequência de 8 dias gera série completa com call-to-action no final do oitavo.'
];

const tags = ['linkedin', 'nr-1', 'portaria-mte-765', 'riscos-psicossociais', 'compliance-trabalhista', 'pot-psicologia-organizacional', 'maslach-leiter'];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE.url}/conteudo-social/biblioteca/${slug}/#article`,
      url: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      headline: 'O que todo RH deveria saber sobre NR-1 psicossocial em 2026',
      description,
      inLanguage: 'pt-BR',
      datePublished,
      dateModified: datePublished,
      author: { '@id': `${SITE.url}/#alexandre-caramaschi` },
      publisher: { '@id': `${SITE.url}/#brasil-geo` },
      mainEntityOfPage: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      articleSection: 'Biblioteca editorial',
      keywords: tags.join(', ')
    },
    alexandrePersonBase,
    brasilGeoOrganization
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'Biblioteca', href: '/conteudo-social/biblioteca' },
  { label: 'NR-1 psicossocial (LinkedIn)' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Biblioteca · Peça pronta</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">LinkedIn: NR-1 psicossocial em 2026 (post + carrossel 8 slides)</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Post de 1.300 caracteres pronto para LinkedIn + roteiro de carrossel de 8 slides com voz Caramaschi, citação a Maslach & Leiter, Schaufeli e Edmondson, e referência à Portaria MTE 765/2025.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Onde usar esta peça</p>
      <h2 class="font-display font-semibold text-xl text-ink-900">Canais alvo: LinkedIn (primário) e Substack (secundário)</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        LinkedIn é canal natural para CHRO, head de People e psicólogo organizacional. O carrossel de 8 slides dobra dwell time e aumenta share orgânico em ~3x em comparação a post longo único. Em segundo lugar, Substack para newsletter editorial recorrente sobre compliance trabalhista.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Copy do post (1.300 caracteres)</h2>
    <article class="prose prose-ink max-w-3xl bg-surface-50 rounded-2xl p-6 sm:p-8 border border-surface-200 whitespace-pre-line">{copyPostLinkedIn}</article>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Roteiro do carrossel (8 slides)</h2>
    <p class="text-ink-700 max-w-3xl mb-6">Use Canva ou Figma. Padrão: fundo branco, tipografia serifada para título, sans-serif para corpo, número do slide no canto inferior direito. Cada slide tem título de até 8 palavras e corpo de até 35 palavras.</p>
    <div class="grid sm:grid-cols-2 gap-5">
      {carrosselSlides.map(s => (
        <article class="card-lift p-6">
          <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">Slide {s.n}/8</p>
          <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">{s.titulo}</h3>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{s.corpo}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Como adaptar para outros canais</h2>
    <ul class="space-y-3 max-w-3xl">
      {comoAdaptar.map(item => (
        <li class="flex gap-3 text-ink-800 text-sm leading-relaxed">
          <span class="text-brand-700 font-bold mt-0.5">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-6">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Author box</p>
      <p class="text-ink-900 font-display font-semibold text-lg">Alexandre Caramaschi</p>
      <p class="text-ink-700 text-sm mt-1">CEO da Brasil GEO, ex-CMO da Semantix (Nasdaq), cofundador da AI Brasil. Edita o portal posgraduacaopsicologia.com.</p>
    </div>
  </section>

  <section class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      {tags.map(t => (
        <span class="chip">{t}</span>
      ))}
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Aprofundar em formação em POT</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        A área de Psicologia Organizacional e do Trabalho tem hub próprio no portal. MBAs reconhecidos em POT — caso de IPOG, FGV e PUC — habilitam atuação imediata em compliance NR-1.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/areas/psicologia-organizacional" class="btn btn-primary">Ver POT no portal</a>
        <a href="/conteudo-social/biblioteca" class="btn btn-ghost-dark">Voltar à biblioteca</a>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark">Ver MBA POT no IPOG →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
