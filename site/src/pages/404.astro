---
import Base from '@layouts/Base.astro';
---
<Base title="Página não encontrada | Pós-graduação em Psicologia" description="O endereço solicitado não corresponde a uma página do portal. Use a busca para encontrar o conteúdo." noindex={true}>
  <section class="container-page py-16 sm:py-24">
    <div class="max-w-2xl mx-auto">
      <span class="section-eyebrow">Erro 404</span>
      <h1 class="section-h mt-3">Página não encontrada</h1>
      <p class="mt-5 text-lg text-ink-700 text-justify">Este endereço pode ter mudado ou estar incompleto. Busque pelo tema para encontrar as páginas disponíveis no portal.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/busca/" class="btn btn-primary">Buscar no portal</a>
        <a href="/mapa-do-site/" class="btn btn-ghost">Abrir mapa do site</a>
      </div>
    </div>
  </section>
</Base>
