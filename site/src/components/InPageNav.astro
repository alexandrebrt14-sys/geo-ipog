---
/**
 * InPageNav: sumário sticky com scrollspy via IntersectionObserver.
 *
 * Uso:
 *   <InPageNav headings={[
 *     { id: 'tese', text: 'Tese', level: 2 },
 *     { id: 'mecanismo', text: 'Mecanismo', level: 2 },
 *   ]} />
 *
 * Em desktop: coluna lateral sticky.
 * Em mobile: botão "Sumário ▾" que abre drawer.
 *
 * Recomenda-se posicionar dentro de um grid 12 cols como `lg:col-span-3`.
 */
interface Heading {
  id: string;
  text: string;
  level: number;
}

interface Props {
  headings: Heading[];
  title?: string;
  ariaLabel?: string;
}

const { headings, title = 'Nesta página', ariaLabel = 'Sumário da página' } = Astro.props as Props;

const safeHeadings = (headings || []).filter(h => h && h.id && h.text);
const minLevel = safeHeadings.length > 0 ? Math.min(...safeHeadings.map(h => h.level || 2)) : 2;

// IDs únicos para a11y do botão mobile
const nonce = Math.random().toString(36).slice(2, 8);
const drawerId = 'inpage-nav-drawer-' + nonce;
const buttonId = 'inpage-nav-button-' + nonce;
const navId = 'inpage-nav-' + nonce;
---

{safeHeadings.length > 0 && (
  <>
    {/* Mobile: botão + drawer fixo */}
    <div class="lg:hidden">
      <button
        id={buttonId}
        data-inpage-toggle
        type="button"
        aria-controls={drawerId}
        aria-expanded="false"
        class="w-full inline-flex items-center justify-between gap-2 rounded-xl border border-surface-200 bg-white px-4 py-2.5 text-sm font-semibold text-ink-900 hover:border-brand-400 hover:text-brand-800 transition outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
      >
        <span class="inline-flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 5h14v2H3V5zm0 4h14v2H3V9zm0 4h10v2H3v-2z"/></svg>
          {title}
        </span>
        <svg class="w-4 h-4 text-ink-500 transition-transform" data-inpage-chevron viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
      </button>
      <div
        id={drawerId}
        hidden
        class="mt-2 rounded-xl border border-surface-200 bg-white p-3 shadow-soft"
      >
        <nav aria-label={ariaLabel}>
          <ul class="space-y-1">
            {safeHeadings.map(h => (
              <li>
                <a
                  href={`#${h.id}`}
                  data-inpage-link
                  data-target={h.id}
                  class={`block px-3 py-1.5 rounded-lg text-sm text-ink-700 hover:bg-surface-50 hover:text-brand-800 transition outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${h.level > minLevel ? 'pl-6 text-[13px]' : 'font-semibold'}`}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    {/* Desktop: sticky sidebar */}
    <nav id={navId} aria-label={ariaLabel} class="hidden lg:block lg:sticky lg:top-24">
      <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-500 mb-3">{title}</p>
      <ul class="space-y-1 border-l border-surface-200">
        {safeHeadings.map(h => (
          <li>
            <a
              href={`#${h.id}`}
              data-inpage-link
              data-target={h.id}
              class={`block -ml-px pl-4 py-1.5 border-l text-sm border-transparent text-ink-500 hover:text-brand-800 hover:border-brand-300 transition outline-none focus-visible:text-brand-800 focus-visible:border-brand-500 ${h.level > minLevel ? 'pl-7 text-[13px]' : 'font-medium'}`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>


  </>
)}

<script>
  let observer: IntersectionObserver | undefined;

  function initInPageNav() {
    observer?.disconnect();
    document.querySelectorAll<HTMLButtonElement>('[data-inpage-toggle]').forEach(btn => {
      if (btn.dataset.inpageBound === '1') return;
      const drawer = document.getElementById(btn.getAttribute('aria-controls') || '');
      if (!drawer) return;
      btn.dataset.inpageBound = '1';
      const chevron = btn.querySelector<SVGElement>('[data-inpage-chevron]');
      const setOpen = (open: boolean) => {
        drawer.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : '';
      };
      btn.addEventListener('click', () => setOpen(drawer.hidden));
      drawer.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        setOpen(false);
        btn.focus();
      });
      drawer.querySelectorAll<HTMLAnchorElement>('a[data-inpage-link]').forEach(link => {
        link.addEventListener('click', () => {
          setOpen(false);
          const target = document.getElementById(link.dataset.target || '');
          if (target) {
            if (!target.hasAttribute('tabindex')) target.tabIndex = -1;
            target.focus({ preventScroll: true });
          }
        });
      });
    });

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-inpage-link]'));
    const targetIds = [...new Set(links.map(link => link.dataset.target).filter(Boolean))];
    const targets = targetIds.map(id => document.getElementById(id!)).filter((el): el is HTMLElement => !!el);
    if (!targets.length || !('IntersectionObserver' in window)) return;
    const setActive = (id: string) => {
      links.forEach(link => {
        const active = link.dataset.target === id;
        link.classList.toggle('text-brand-800', active);
        link.classList.toggle('border-brand-500', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const visible = new Set<string>();
    observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      });
      const first = targets.find(target => visible.has(target.id));
      if (first) setActive(first.id);
    }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] });
    targets.forEach(target => observer!.observe(target));
  }

  initInPageNav();
  document.addEventListener('astro:page-load', initInPageNav);
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
