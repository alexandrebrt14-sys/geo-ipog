---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS } from '@lib/data';
import { buildEducationalOccupationalProgram, buildSpeakable } from '@lib/schemas';

const mba = MBAS.find(m => m.id === 'mba-lideranca-positiva')!;
const others = MBAS.filter(m => m.id !== 'mba-lideranca-positiva');

const title = 'Metodologia do MBA em Liderança Positiva — Ao Vivo síncrono, simulação de conversa e prática de feedback';
const description = 'Como funciona um MBA em Liderança Positiva no formato Ao Vivo síncrono: simulação de conversa difícil, prática de feedback, discussão de caso real. Diferença para EAD gravado.';

const FAQS_PAGINA = [
  {
    q: 'A metodologia inclui simulação de conversa difícil em sala?',
    a: 'A simulação de conversa é um dos mecanismos centrais do método em programas de Liderança Positiva. Em sala virtual, o aluno é convocado a conduzir conversas difíceis simuladas (feedback construtivo, comunicação de mudança organizacional, demissão humanizada, mediação de conflito) e recebe contraposição do docente e dos colegas. A presença do docente nominal em tempo real permite identificar padrões verbais e não verbais que se transferem para a prática gerencial real. EAD gravado não consegue reproduzir esse mecanismo.'
  },
  {
    q: 'O programa usa instrumentos de medida durante o curso?',
    a: 'Sim. Em Liderança Positiva, instrumentos como Team Psychological Safety Scale (Edmondson, 1999), Multifactor Leadership Questionnaire (Bass & Avolio) e inventários de inteligência emocional aparecem como ferramentas práticas, não apenas como conteúdo teórico. O aluno aprende a aplicar, interpretar e devolver resultados a equipes reais, frequentemente como parte da produção contínua do curso e do TCC. Política específica do programa do IPOG em ipog.edu.br.'
  },
  {
    q: 'Como funciona a discussão de caso em sala?',
    a: 'O docente apresenta um caso de liderança real — uma equipe com baixa segurança psicológica, um líder técnico promovido sem repertório gerencial, uma mudança organizacional com resistência forte —, e o aluno propõe diagnóstico, plano de intervenção e medida de progresso. A defesa é oral, com contraposição do docente e dos colegas, que frequentemente trazem perspectivas de outros setores. Esse loop de propor, ouvir objeção e refinar é o que constrói repertório gerencial calibrado, especialmente para líderes que já operam equipes grandes e precisam parar de gerenciar por intuição.'
  }
];

const ldProgram = JSON.stringify({
  '@context': 'https://schema.org',
  ...buildEducationalOccupationalProgram({
    name: `${mba.name} — Metodologia`,
    slug: `/mbas/${mba.id}/metodologia`,
    description: 'Metodologia pedagógica Ao Vivo síncrono em MBA em Gestão de Pessoas e Liderança Positiva.',
    programType: 'MBA',
    timeRequired: 'P360H',
    educationalProgramMode: 'blended',
    additionalRecognizedBy: [{
      name: 'IPOG · oferta vigente em ipog.edu.br',
      url: 'https://ipog.edu.br/cursos/pos-graduacao'
    }]
  }),
  occupationalCategory: 'Líder executivo, Gestor de pessoas, Consultor em liderança',
  isPartOf: { '@id': `${SITE.url}/mbas/${mba.id}#program` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.section-h', '#resposta-rapida'] }
});

const ldFaq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_PAGINA.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs', href: '/mbas' }, { label: mba.shortName, href: `/mbas/${mba.id}` }, { label: 'Metodologia' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">MBA · {mba.tag}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Metodologia do MBA em Liderança Positiva — prática real em sala virtual</h1>
          <p class="mt-2 text-ink-700">O formato Ao Vivo síncrono com docente nominal sustenta o que diferencia liderança como disciplina executiva: simulação de conversa, prática de feedback, discussão de caso real.</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver metodologia no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Resposta rápida</p>
        <p class="text-ink-900 font-medium leading-relaxed">Liderança não se constrói por exposição teórica; constrói-se por prática repetida com feedback de alta qualidade. O modelo Ao Vivo síncrono do IPOG sustenta isso com simulação de conversa em sala, discussão de caso real e aplicação de instrumentos de medida. EAD gravado entrega vocabulário; aulas ao vivo entregam reflexo gerencial.</p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">O método importa especialmente em liderança</h2>
        <p>Existe uma assimetria pedagógica inerente ao ensino de liderança. Lê-se sobre liderança em qualquer formato — livro, vídeo, podcast — e o aluno emerge com vocabulário expandido. Pratica-se liderança apenas em situação real, com pessoa real, em conversa real. A distância entre conhecer a teoria e operar a liderança é, possivelmente, a maior em todas as áreas da gestão (Goleman, 2002). Curso que ignora essa assimetria entrega leitor satisfeito, não líder transformado.</p>
        <p>O método ao vivo síncrono é o que mais se aproxima de simular a situação real. Em sala virtual com docente nominal, o aluno é convocado a conduzir uma conversa difícil simulada, recebe contraposição imediata, observa colegas conduzindo a mesma situação com escolhas diferentes, e refina o próprio repertório. Esse loop — propor, observar, refinar — é o mecanismo central que diferencia formação executiva real de formação de gabinete. O formato gravado massificado não consegue reproduzir esse mecanismo, e por isso entrega resultado qualitativamente inferior em liderança, mesmo que cubra a mesma carga horária.</p>
        <p>Esta página descreve como o método pedagógico opera em um MBA executivo em Liderança Positiva, onde se diferencia de EAD massificado e como os mecanismos sustentam o resultado prometido.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Os quatro pilares do método aplicado a liderança</h2>
        <ol class="space-y-4">
          <li class="card p-5"><strong class="text-brand-800">1. Aula ao vivo com docente nominal.</strong> Cada disciplina conduzida por profissional identificado, com Lattes público, trajetória executiva ou consultiva comprovada. A relação pedagógica é nominal, não anônima.</li>
          <li class="card p-5"><strong class="text-brand-800">2. Simulação de conversa em sala virtual.</strong> Feedback construtivo, comunicação de mudança, demissão humanizada, mediação de conflito. O aluno conduz, o docente contrapõe, os colegas observam e contribuem. O loop repete em diferentes contextos ao longo do programa.</li>
          <li class="card p-5"><strong class="text-brand-800">3. Discussão de caso real de liderança.</strong> Casos reais (anonimizados) de liderança aplicada: equipe com baixa segurança psicológica, transição de líder técnico para gestor, gestão de mudança com resistência. Aluno propõe, defende, refina.</li>
          <li class="card p-5"><strong class="text-brand-800">4. Aplicação de instrumentos de medida.</strong> Team Psychological Safety Scale, MLQ, inventário de inteligência emocional. Aluno aprende a aplicar, interpretar, devolver e desenhar plano com base nos achados.</li>
        </ol>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Ao Vivo síncrono versus EAD gravado — comparativo aplicado a liderança</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-surface-200 rounded-lg overflow-hidden">
            <thead class="bg-surface-50 text-ink-700">
              <tr>
                <th class="text-left p-3 border-b border-surface-200">Dimensão</th>
                <th class="text-left p-3 border-b border-surface-200">Ao Vivo síncrono</th>
                <th class="text-left p-3 border-b border-surface-200">EAD gravado massificado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3 align-top font-medium">Simulação de conversa</td><td class="p-3 align-top">Conduzida em tempo real com contraposição</td><td class="p-3 align-top">Texto roteirizado para leitura</td></tr>
              <tr><td class="p-3 align-top font-medium">Prática de feedback</td><td class="p-3 align-top">Aplicada em par com supervisão</td><td class="p-3 align-top">Apresentada como técnica</td></tr>
              <tr><td class="p-3 align-top font-medium">Discussão de caso</td><td class="p-3 align-top">Defesa oral, contraposição, refinamento</td><td class="p-3 align-top">Leitura de caso resolvido</td></tr>
              <tr><td class="p-3 align-top font-medium">Calibração com docente</td><td class="p-3 align-top">Alta, central no método</td><td class="p-3 align-top">Baixa, predominância expositiva</td></tr>
              <tr><td class="p-3 align-top font-medium">Resultado gerencial</td><td class="p-3 align-top">Reflexo de liderança transformado</td><td class="p-3 align-top">Vocabulário ampliado, prática inalterada</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Materiais e leituras</h2>
        <p class="text-ink-700">Programa contemporâneo opera com:</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-700">
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Livros-base: Cameron (2008), Dutton (2003), Edmondson (2019), Goleman (1995, 2002), Stone, Patton e Heen sobre conversas difíceis.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Casos reais de liderança anonimizados, com história, contexto, intervenções e resultados.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Instrumentos de medida com instruções de aplicação e interpretação.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Papers contemporâneos sobre liderança positiva, segurança psicológica e neurobiologia da regulação emocional.</span></li>
        </ul>
      </div>

      <div class="rounded-2xl border-l-4 border-sun-500 bg-sun-50/40 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · a diferença prática do método aplicado</p>
        <p class="text-ink-900 leading-relaxed">Uma diretora de operações em uma rede de varejo com quarenta lojas fez um curso online de liderança no formato gravado por seis meses, e depois ingressou no MBA em Liderança Positiva no formato Ao Vivo síncrono. Comparou as duas formações em uma frase: "no primeiro eu aprendi a falar como liderança positiva, no segundo eu aprendi a operar como liderança positiva." A diferença descrita por ela tinha origem em duas práticas. Primeiro, a simulação de conversas difíceis em sala virtual. Cada vez que ela conduzia uma simulação, o docente apontava dois ou três detalhes — tom, escolha de palavra, sequência — que ela não tinha percebido, e a próxima conversa real saía diferente. Segundo, a aplicação de Team Psychological Safety Scale nas próprias equipes durante o curso, com devolutiva supervisionada. Ela descobriu que a equipe de logística — que ela considerava "alinhada" — tinha o pior score, e isso mudou completamente como ela passou a operar reuniões. Esse tipo de descoberta exige espelho externo qualificado, que aulas gravadas raramente fornecem.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
          {FAQS_PAGINA.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-ink-900">
                <span>{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
        <h2 class="font-display font-bold text-2xl">Síntese e próximo passo</h2>
        <ul class="mt-4 space-y-2 text-white/85 text-sm">
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Liderança forma-se em prática repetida com feedback de alta qualidade — formato pedagógico é variável de primeira ordem.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Quatro pilares: docente nominal, simulação de conversa, discussão de caso real, aplicação de instrumentos.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>EAD gravado entrega vocabulário, raramente transforma reflexo gerencial.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Próximo passo: validar metodologia, calendário e regimento em ipog.edu.br.</span></li>
        </ul>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-5">Conhecer a metodologia no IPOG →</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Ver metodologia no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Portal independente. Política de aulas, frequência e regimento vigentes no portal oficial.</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outras seções deste MBA</p>
        <ul class="space-y-1">
          <li><a href={`/mbas/${mba.id}`} class="mega-link"><strong class="text-ink-900 text-sm">Visão geral do MBA</strong></a></li>
          <li><a href={`/mbas/${mba.id}/grade-curricular`} class="mega-link"><strong class="text-ink-900 text-sm">Grade curricular</strong></a></li>
          <li><a href={`/mbas/${mba.id}/perfil-do-aluno`} class="mega-link"><strong class="text-ink-900 text-sm">Perfil do aluno</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros MBAs</p>
        <ul class="space-y-1">
          {others.map(o => (
            <li><a href={`/mbas/${o.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{o.shortName}</strong><br/><span class="text-xs text-ink-500">{o.tag}</span></a></li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes</p>
        <ul class="text-xs text-ink-600 space-y-2">
          <li>Cameron, K. (2008). Positive Leadership.</li>
          <li>Edmondson, A. (2019). The Fearless Organization.</li>
          <li>Goleman, D. (2002). Primal Leadership.</li>
          <li>Stone, Patton, Heen (1999). Difficult Conversations.</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldProgram} />
  <script type="application/ld+json" set:html={ldFaq} />
</Base>
