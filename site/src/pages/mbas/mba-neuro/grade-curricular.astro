---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS } from '@lib/data';
import { buildEducationalOccupationalProgram, buildSpeakable } from '@lib/schemas';

const mba = MBAS.find(m => m.id === 'mba-neuro')!;
const others = MBAS.filter(m => m.id !== 'mba-neuro');

const title = 'Grade curricular do MBA em Reabilitação Neuropsicológica e Desenvolvimento Cognitivo — eixos esperados';
const description = 'Eixos disciplinares típicos de um MBA em Reabilitação Neuropsicológica: bases neuroanatômicas, funções cognitivas, avaliação, plano de reabilitação, neuroplasticidade. Grade vigente em ipog.edu.br.';

const FAQS_PAGINA = [
  {
    q: 'Quais autores fundamentais são esperados nessa grade?',
    a: 'Programa contemporâneo em Reabilitação Neuropsicológica apoia-se em autores que estruturaram o campo: Damásio (1994) sobre integração emoção-cognição, Kandel (2000) sobre bases neuronais da memória, Lezak (2012) sobre avaliação neuropsicológica, Mesulam (2000) sobre redes corticais, Wilson (2009) sobre práticas de reabilitação cognitiva. Para neuroplasticidade aplicada, costuma-se referenciar Doidge (2007) e literatura recente sobre intervenção intensiva. Ementa vigente em ipog.edu.br.'
  },
  {
    q: 'A grade inclui prática clínica supervisionada?',
    a: 'Em lato sensu, a prática supervisionada formal varia por instituição. Programas executivos em Reabilitação Neuropsicológica costumam combinar discussão de caso clínico em sala (com material anonimizado), análise de bateria neuropsicológica aplicada, desenho de plano de reabilitação e estudo de caso longitudinal. A prática clínica propriamente dita, com paciente, geralmente requer estágio adicional ou exercício profissional próprio. Aplicação de testes neuropsicológicos formais é privativa de psicólogos com CRP. Configuração específica do programa do IPOG no portal oficial.'
  },
  {
    q: 'É diferente de uma especialização em Neuropsicologia tradicional?',
    a: 'Sim, em ênfase. Especialização em Neuropsicologia tradicional concentra peso maior em avaliação neuropsicológica diagnóstica. O MBA em Reabilitação Neuropsicológica e Desenvolvimento Cognitivo orienta-se à intervenção e ao plano de reabilitação, articulando avaliação como etapa do processo terapêutico, não como produto final. O perfil de saída típico do MBA é profissional que coordena programa de reabilitação, atua em equipe multiprofissional e desenha plano de desenvolvimento cognitivo, frequentemente em contextos institucionais.'
  }
];

const ldProgram = JSON.stringify({
  '@context': 'https://schema.org',
  ...buildEducationalOccupationalProgram({
    name: `${mba.name} — Grade curricular`,
    slug: `/mbas/${mba.id}/grade-curricular`,
    description: 'Eixos disciplinares esperados em MBA em Reabilitação Neuropsicológica e Desenvolvimento Cognitivo.',
    programType: 'MBA',
    timeRequired: 'P360H',
    educationalProgramMode: 'blended',
    additionalRecognizedBy: [{
      name: 'IPOG · oferta vigente em ipog.edu.br',
      url: 'https://ipog.edu.br/cursos/pos-graduacao'
    }]
  }),
  occupationalCategory: 'Neuropsicólogo, Reabilitador cognitivo, Profissional de neurodesenvolvimento',
  isPartOf: { '@id': `${SITE.url}/mbas/${mba.id}#program` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.section-h', '#resposta-rapida'] }
});

const ldBreadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'MBAs', item: `${SITE.url}/mbas` },
    { '@type': 'ListItem', position: 3, name: mba.shortName, item: `${SITE.url}/mbas/${mba.id}` },
    { '@type': 'ListItem', position: 4, name: 'Grade curricular', item: `${SITE.url}/mbas/${mba.id}/grade-curricular` }
  ]
});

const ldFaq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_PAGINA.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs', href: '/mbas' }, { label: mba.shortName, href: `/mbas/${mba.id}` }, { label: 'Grade curricular' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">MBA · {mba.tag}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Grade curricular esperada em um MBA em Reabilitação Neuropsicológica</h1>
          <p class="mt-2 text-ink-700">Leitura editorial dos eixos disciplinares: bases neuroanatômicas, funções cognitivas, avaliação, plano de reabilitação, neuroplasticidade aplicada. Para a grade vigente do programa do IPOG, consulte o portal oficial.</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver grade vigente no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Resposta rápida</p>
        <p class="text-ink-900 font-medium leading-relaxed">Grade típica organiza 9 a 11 eixos: bases neuroanatômicas e funcionais, funções cognitivas específicas (atenção, memória, executivas, linguagem), avaliação neuropsicológica, neuroplasticidade aplicada, plano de reabilitação, neurodesenvolvimento, envelhecimento, intervenção em populações clínicas, ética. Carga típica 432-560h em 18-24 meses. Grade vigente no portal oficial do IPOG.</p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Por que a grade desse MBA pede leitura criteriosa</h2>
        <p>Reabilitação Neuropsicológica é uma das áreas mais técnicas da Psicologia aplicada. O campo dialoga com Neurologia, Geriatria, Pediatria, Fonoaudiologia e Terapia Ocupacional, e exige domínio simultâneo de bases biológicas, instrumentos psicométricos e desenho de intervenção. Grade superficial nessa área entrega profissional desarmado para atuar tecnicamente. A pista correta é a presença de três eixos inegociáveis: bases neuroanatômicas e funcionais, avaliação neuropsicológica estruturada e desenho de plano de reabilitação fundamentado em neuroplasticidade aplicada (Wilson, 2009).</p>
        <p>A literatura de neuroplasticidade da última década reorganizou o que se entende por reabilitação cognitiva. O cérebro adulto mantém capacidade significativa de reorganização funcional, e isso muda o desenho de intervenção: protocolos passam a ser intensivos, com tarefa específica, dose calibrada e medida de progresso (Doidge, 2007; Kandel, 2000). Programa contemporâneo deveria refletir essa virada na grade. Programa que ainda trata reabilitação como atividade genérica de estimulação está estruturalmente desatualizado.</p>
        <p>Esta página descreve o que esperar tecnicamente de uma grade contemporânea de MBA em Reabilitação Neuropsicológica. Para a grade vigente do programa do IPOG, com disciplinas, ementas e nominata de docentes, consulte ipog.edu.br.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Eixos disciplinares esperados</h2>
        <ol class="space-y-3">
          <li class="card p-5"><strong class="text-brand-800">1. Bases neuroanatômicas e funcionais.</strong> Anatomia funcional do córtex, sistemas subcorticais, redes neurais, neurotransmissores, integração emoção-cognição (Damásio, 1994).</li>
          <li class="card p-5"><strong class="text-brand-800">2. Funções cognitivas — atenção e funções executivas.</strong> Modelos atencionais, controle inibitório, memória de trabalho, planejamento, flexibilidade cognitiva, lobos frontais.</li>
          <li class="card p-5"><strong class="text-brand-800">3. Memória e aprendizagem.</strong> Sistemas mnêmicos, codificação, consolidação, recuperação, base molecular (Kandel), aplicações em reabilitação.</li>
          <li class="card p-5"><strong class="text-brand-800">4. Linguagem e comunicação.</strong> Bases neurais, afasias, distúrbios da comunicação, intervenção em parceria com fonoaudiologia.</li>
          <li class="card p-5"><strong class="text-brand-800">5. Avaliação neuropsicológica.</strong> Bateria, instrumentos validados, interpretação, laudo, ética em avaliação, integração com exames complementares (Lezak, 2012).</li>
          <li class="card p-5"><strong class="text-brand-800">6. Neuroplasticidade aplicada e princípios de reabilitação.</strong> Doidge (2007), princípios de Kleim & Jones (2008), tarefa específica, dose, intensidade, transferência.</li>
          <li class="card p-5"><strong class="text-brand-800">7. Reabilitação em populações adultas e idosas.</strong> AVC, TCE, demências, envelhecimento patológico, manejo de declínio cognitivo.</li>
          <li class="card p-5"><strong class="text-brand-800">8. Neurodesenvolvimento e infância.</strong> Transtornos do neurodesenvolvimento, TDAH, TEA, dificuldades de aprendizagem, intervenção precoce.</li>
          <li class="card p-5"><strong class="text-brand-800">9. Intervenção em equipe multiprofissional.</strong> Articulação com neurologia, geriatria, terapia ocupacional, fonoaudiologia, fisioterapia.</li>
          <li class="card p-5"><strong class="text-brand-800">10. Tecnologia aplicada à reabilitação.</strong> Software de treino cognitivo, realidade virtual, telerreabilitação, evidência empírica disponível.</li>
          <li class="card p-5"><strong class="text-brand-800">11. Ética, regulação e atuação responsável.</strong> CFP, SATEPSI, LGPD, limites do exercício profissional, atuação em equipe.</li>
        </ol>
        <p class="text-sm text-ink-600 mt-4">Ordem real e nomes formais variam por edição. Grade vigente em ipog.edu.br.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Distribuição típica de carga horária</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-surface-200 rounded-lg overflow-hidden">
            <thead class="bg-surface-50 text-ink-700">
              <tr>
                <th class="text-left p-3 border-b border-surface-200">Bloco</th>
                <th class="text-left p-3 border-b border-surface-200">Conteúdo dominante</th>
                <th class="text-left p-3 border-b border-surface-200">Carga esperada</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3 align-top font-medium">Neuroanatomia e bases</td><td class="p-3 align-top">Anatomia funcional, redes neurais</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Funções cognitivas</td><td class="p-3 align-top">Atenção, memória, executivas, linguagem</td><td class="p-3 align-top">72-96h</td></tr>
              <tr><td class="p-3 align-top font-medium">Avaliação neuropsicológica</td><td class="p-3 align-top">Bateria, instrumentos, laudo</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Reabilitação aplicada</td><td class="p-3 align-top">Neuroplasticidade, plano, dose</td><td class="p-3 align-top">72-96h</td></tr>
              <tr><td class="p-3 align-top font-medium">Populações clínicas</td><td class="p-3 align-top">Adulto, idoso, infância</td><td class="p-3 align-top">48-72h</td></tr>
              <tr><td class="p-3 align-top font-medium">Equipe e tecnologia</td><td class="p-3 align-top">Multiprofissional, software, telerreabilitação</td><td class="p-3 align-top">32-48h</td></tr>
              <tr><td class="p-3 align-top font-medium">Metodologia e TCC</td><td class="p-3 align-top">Estudo de caso, orientação, defesa</td><td class="p-3 align-top">40-80h</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-ink-600 mt-3">Total típico 432-560h. Mínimo regulatório de 360h para lato sensu (CNE/CES 01/2018).</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">TCC e estudo de caso longitudinal</h2>
        <p class="text-ink-700">Em Reabilitação Neuropsicológica, o formato dominante de TCC é o estudo de caso longitudinal: paciente acompanhado por meses, com avaliação inicial estruturada, plano de reabilitação documentado, intervenções com medida de progresso e devolutiva técnica. O formato funciona como simulação realista do que será a prática profissional futura.</p>
        <div class="grid sm:grid-cols-3 gap-4 mt-4">
          <div class="card p-5"><p class="font-semibold text-brand-800">Estudo de caso clínico</p><p class="text-sm text-ink-700 mt-2">Paciente real ou caso documentado, avaliação completa, plano e medida de evolução.</p></div>
          <div class="card p-5"><p class="font-semibold text-brand-800">Projeto de programa</p><p class="text-sm text-ink-700 mt-2">Desenho de programa de reabilitação para população específica (idosos com declínio leve, pós-AVC, infância).</p></div>
          <div class="card p-5"><p class="font-semibold text-brand-800">Paper analítico</p><p class="text-sm text-ink-700 mt-2">Revisão crítica de literatura sobre intervenção específica, com proposta de protocolo fundamentado.</p></div>
        </div>
      </div>

      <div class="rounded-2xl border-l-4 border-sun-500 bg-sun-50/40 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · TCC típico em formato longitudinal</p>
        <p class="text-ink-900 leading-relaxed">Uma psicóloga em consultório particular escolheu como TCC um estudo de caso de paciente de 67 anos com declínio cognitivo leve e queixa principal de prejuízo em memória episódica. Aplicou bateria estruturada (Mini-Mental, FAB, RBMT, BDI), construiu um perfil cognitivo, identificou três funções-alvo (memória episódica, atenção sustentada e nomeação) e desenhou plano de doze semanas com sessões de quarenta e cinco minutos, três vezes por semana. Utilizou princípios de Kleim & Jones (2008): tarefa específica, dose calibrada, intensidade, transferência para atividades de vida diária. Reavaliação ao fim de doze semanas mostrou ganho significativo em memória episódica e estabilização nas demais funções. O TCC virou referência interna na sua clínica para casos semelhantes. O ganho real foi metodológico — ela passou a operar com protocolo, não com tentativa.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
          {FAQS_PAGINA.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-ink-900">
                <span>{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
        <h2 class="font-display font-bold text-2xl">Síntese e próximo passo</h2>
        <ul class="mt-4 space-y-2 text-white/85 text-sm">
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Grade contemporânea exige três eixos inegociáveis: bases neuroanatômicas, avaliação estruturada e plano de reabilitação com neuroplasticidade aplicada.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>9 a 11 eixos típicos, total 432-560h em 18-24 meses.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>TCC predominante: estudo de caso longitudinal com medida de progresso.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Próximo passo: validar grade, bibliografia e docentes em ipog.edu.br.</span></li>
        </ul>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-5">Conhecer a grade no IPOG →</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Ver grade vigente no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Portal independente. Grade, ementas, bibliografia e docentes vigentes no portal oficial.</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outras seções deste MBA</p>
        <ul class="space-y-1">
          <li><a href={`/mbas/${mba.id}`} class="mega-link"><strong class="text-ink-900 text-sm">Visão geral do MBA</strong></a></li>
          <li><a href={`/mbas/${mba.id}/metodologia`} class="mega-link"><strong class="text-ink-900 text-sm">Metodologia</strong></a></li>
          <li><a href={`/mbas/${mba.id}/perfil-do-aluno`} class="mega-link"><strong class="text-ink-900 text-sm">Perfil do aluno</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros MBAs</p>
        <ul class="space-y-1">
          {others.map(o => (
            <li><a href={`/mbas/${o.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{o.shortName}</strong><br/><span class="text-xs text-ink-500">{o.tag}</span></a></li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes</p>
        <ul class="text-xs text-ink-600 space-y-2">
          <li>Lezak, M. (2012). Neuropsychological Assessment.</li>
          <li>Kandel, E. (2000). Principles of Neural Science.</li>
          <li>Damásio, A. (1994). Descartes' Error.</li>
          <li>Wilson, B. (2009). Memory Rehabilitation.</li>
          <li>Kleim, J., Jones, T. (2008). Principles of neuroplasticity.</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldProgram} />
  <script type="application/ld+json" set:html={ldBreadcrumb} />
  <script type="application/ld+json" set:html={ldFaq} />
</Base>
