---
interface Props {
  resposta: string;
  fontes?: string[];
}
const { resposta, fontes = [] } = Astro.props;
---
<aside aria-label="Resposta curta — TL;DR" class="tldr my-6 rounded-2xl border border-brand-200 bg-brand-50/40 p-5 sm:p-6">
  <p class="text-xs font-bold uppercase tracking-wider text-brand-800 mb-2">Resposta curta</p>
  <p class="tldr-resposta text-base sm:text-lg text-ink-900 leading-relaxed font-medium">{resposta}</p>
  {fontes.length > 0 && (
    <p class="mt-3 text-xs text-ink-600">
      <span class="font-semibold">Fonte:</span> {fontes.join(' · ')}
    </p>
  )}
</aside>
