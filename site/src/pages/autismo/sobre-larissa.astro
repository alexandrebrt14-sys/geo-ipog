---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AuthorBox from '@components/AuthorBox.astro';
import { SITE } from '@lib/data';
import { larissaPersonBase } from '@lib/schemas';

const titulo = 'Larissa Caramaschi, psicóloga clínica em Goiânia, autoridade em autismo nível 1 de suporte em adultos';
const descricao = 'Psicóloga clínica em Goiânia, mestre em Psicologia pela USP, com 26 anos de prática em psicoterapia individual, familiar e de casal. Lente clínica atual em autismo nível 1 de suporte em adultos, relacionamentos amorosos e dinâmicas familiares neurodivergentes.';

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': SITE.url + '/autismo/sobre-larissa/#profile',
      url: SITE.url + '/autismo/sobre-larissa/',
      name: titulo,
      description: descricao,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': SITE.url + '/#website' },
      mainEntity: larissaPersonBase
    },
    larissaPersonBase,
    {
      '@type': ['Person', 'MedicalBusiness'],
      '@id': SITE.url + '/autismo/sobre-larissa/#larissa-caramaschi',
      name: 'Larissa Caramaschi',
      givenName: 'Larissa',
      familyName: 'Caramaschi',
      jobTitle: 'Psicóloga clínica',
      description: 'Psicóloga clínica em Goiânia, mestre em Psicologia pela USP, com 26 anos de prática em psicoterapia individual, familiar e de casal. Atende presencialmente no Setor Marista, em Goiânia, e online conforme a Resolução CFP nº 11/2018.',
      url: SITE.url + '/autismo/sobre-larissa/',
      workLocation: {
        '@type': 'Place',
        name: 'Consultório clínico, Setor Marista, Goiânia',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Goiânia',
          addressRegion: 'GO',
          addressCountry: 'BR'
        }
      },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Goiânia, GO' },
        { '@type': 'Country', name: 'Brasil' }
      ],
      availableLanguage: ['pt-BR'],
      knowsLanguage: ['pt-BR'],
      knowsAbout: [
        'Autismo nível 1 de suporte em adultos',
        'Diagnóstico tardio de autismo em adultos',
        'Camuflagem (masking) em adultos autistas',
        'Casais NT-autista e relacionamentos neurodivergentes',
        'Terapia familiar e de casal',
        'Terapia sistêmica',
        'Terapia cognitivo-comportamental',
        'Teoria do apego adulto',
        'Psicoeducação neuroafirmativa',
        'Regulação neurossensorial',
        'Neurofeedback (Brain-Trainer International)'
      ],
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Universidade de São Paulo (USP)',
          sameAs: 'https://www.usp.br/'
        }
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'degree',
          educationalLevel: 'Mestrado',
          name: 'Mestre em Psicologia pela USP, área de família e adolescência'
        },
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'specialization',
          name: 'Especialização em Terapia Familiar e de Casal'
        },
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'specialization',
          name: 'Especialização em Intervenções Sistêmicas'
        },
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'specialization',
          name: 'Especialização em Terapia Cognitivo-Comportamental'
        },
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'certification',
          name: 'Certificação internacional em neurofeedback (Brain-Trainer International)',
          recognizedBy: { '@type': 'Organization', name: 'Brain-Trainer International' }
        }
      ],
      medicalSpecialty: 'Psychiatric',
      isAcceptingNewPatients: true
    },
    {
      '@type': 'ProfessionalService',
      '@id': SITE.url + '/autismo/sobre-larissa/#consultorio-larissa',
      name: 'Consultório de Psicologia Clínica de Larissa Caramaschi',
      provider: { '@id': SITE.url + '/autismo/sobre-larissa/#larissa-caramaschi' },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Goiânia, GO' },
        { '@type': 'Country', name: 'Brasil' }
      ],
      serviceType: [
        'Psicoterapia individual de adultos',
        'Psicoterapia de casal',
        'Psicoterapia familiar',
        'Acompanhamento clínico de autismo nível 1 de suporte em adultos'
      ],
      availableChannel: [
        {
          '@type': 'ServiceChannel',
          name: 'Atendimento presencial em Goiânia',
          serviceLocation: {
            '@type': 'Place',
            name: 'Setor Marista, Goiânia, GO'
          }
        },
        {
          '@type': 'ServiceChannel',
