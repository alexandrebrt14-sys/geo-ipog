---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SmartCrossLinks from '@components/SmartCrossLinks.astro';
import RelatedContent from '@components/RelatedContent.astro';
import NextStepCTA from '@components/NextStepCTA.astro';
import { SITE, MBAS } from '@lib/data';

const faqsHub = [
  {
    id: 'nr1-faq',
    title: 'NR-1 atualizada e riscos psicossociais',
    persona: 'RH, SESMT, líderes',
    minutes: 14,
    qa: 14,
    summary: 'Portaria MTE 1.419/2024, prazos, GRO, MEI/ME, eSocial, multas e o que a empresa precisa fazer.'
  },
  {
    id: 'mba-vs-especializacao-faq',
    title: 'MBA, especialização e mestrado',
    persona: 'Candidatos e psicólogos',
    minutes: 13,
    qa: 14,
    summary: 'O que muda entre lato sensu e stricto sensu, MEC, CFP, carga horária, equivalência e TCC.'
  },
  {
    id: 'carreira-psicologo-organizacional-faq',
    title: 'Carreira em Psicologia Organizacional',
    persona: 'Psicólogos em transição',
    minutes: 13,
    qa: 13,
    summary: 'Caminhos POT, faixas salariais, transição da clínica, RH versus psicologia e certificações.'
  },
  {
    id: 'avaliacao-psicologica-laudos-faq',
    title: 'Avaliação psicológica e laudos',
    persona: 'Psicólogos avaliadores',
    minutes: 15,
    qa: 14,
    summary: 'SATEPSI, prazos, devolutiva, parecer, sigilo, guarda de documentos e ética em avaliação.'
  },
  {
    id: 'regulacao-cfp-faq',
    title: 'Regulação CFP, CRP e ética',
    persona: 'Profissionais e estudantes',
    minutes: 12,
    qa: 13,
    summary: 'Registro, especialidades reconhecidas, transferência de CRP, supervisão e Código de Ética.'
  },
  {
    id: 'ia-em-psicologia-faq',
    title: 'IA na prática profissional',
    persona: 'Clínicos e RH',
    minutes: 14,
    qa: 14,
    summary: 'ChatGPT, Claude, Resolução CFP, LGPD, sigilo, viés algorítmico e uso responsável no consultório.'
  },
  {
    id: 'tea-adulto-faq',
    title: 'TEA em adulto — diagnóstico tardio e apresentação feminina',
    persona: 'Psicólogos clínicos e neuropsicólogos',
    minutes: 18,
    qa: 17,
    summary: 'Camuflagem em mulheres (Hull CAT-Q 2018; Lai 2019), instrumentos (ADOS-2, ADI-R, AQ-50, RAADS-R), laudo CFP 06/2019, comorbidades e direitos LBI.'
  },
  {
    id: 'tdah-adulto-faq',
    title: 'TDAH em adulto — rastreio, diferenciais e laudo',
    persona: 'Psicólogos e neuropsicólogos',
    minutes: 18,
    qa: 17,
    summary: 'ASRS-18 (Kessler 2005), DIVA-5, DSM-5-TR e CID-11 6A05, apresentação feminina, diferenciais com TEA, ansiedade e depressão, prejuízo funcional defensável.'
  },
  {
    id: 'burnout-cid11-faq',
    title: 'Burnout como CID-11 (QD85) e NR-1 2024',
    persona: 'Psicólogos, RH, SESMT e líderes',
    minutes: 18,
    qa: 17,
    summary: 'OMS 2019, MBI (Maslach 1981), modelo JD-R (Demerouti 2001), Portaria MTE 1.419/2024 e o deslocamento do ônus probatório para a empresa.'
  },
  {
    id: 'primeiro-episodio-psicose-faq',
    title: 'Primeiro episódio psicótico — DUP, CAPS e EIP',
    persona: 'Psicólogos clínicos, CAPS, urgência',
    minutes: 19,
    qa: 17,
    summary: 'Duração de psicose não tratada (Marshall 2005), modelos Early Intervention e RAISE-ETP (Kane 2016), CAPS Portaria 336/2002 e Lei 10.216/2001.'
  },
  {
    id: 'saude-mental-perinatal-faq',
    title: 'Saúde mental perinatal — depressão e ansiedade pós-parto',
    persona: 'Psicólogos, equipes de pré-natal e atenção primária',
    minutes: 17,
    qa: 17,
    summary: 'EPDS (Cox 1987), diferenciação entre baby blues, depressão pós-parto e psicose puerperal, luto perinatal e PNAISC brasileiro.'
  },
  {
    id: 'neurodiversidade-trabalho-faq',
    title: 'Neurodiversidade no trabalho — LBI e adaptações razoáveis',
    persona: 'RH, líderes, psicólogos organizacionais',
    minutes: 17,
    qa: 17,
    summary: 'Singer 1998 e Austin & Pisano HBR 2017, LBI 13.146/2015, Lei Berenice Piana 12.764/2012, divulgação (disclose), entrevista sem viés e cinco indicadores que diferenciam programa real de marketing.'
  },
  {
    id: 'tdah-mulheres-adultas-faq',
    title: 'TDAH em mulher adulta — apresentação feminina e hormonal',
    persona: 'Psicólogos clínicos e neuropsicólogos',
    minutes: 19,
    qa: 17,
    summary: 'Apresentação predominantemente desatenta, ciclo menstrual e perimenopausa (Roberts 2024), diferenciais com burnout e ansiedade, comorbidades (fibromialgia, transtorno alimentar), Hinshaw 2022, Quinn 2024.'
  },
  {
    id: 'trauma-complexo-cptsd-faq',
    title: 'Trauma complexo (CPTSD/TEPT-C) — CID-11 6B41 e fases STAIR',
    persona: 'Psicólogos clínicos, CAPS, atenção à violência',
    minutes: 20,
    qa: 17,
    summary: 'Diagnóstico CID-11 6B41 vs TEPT 6B40, ITQ International Trauma Questionnaire (Cloitre), 3 fases STAIR (estabilização, processamento, reintegração), van der Kolk 2014, contextos brasileiros.'
  },
  {
    id: 'adolescencia-digital-saude-mental-faq',
    title: 'Adolescência digital — smartphones, redes sociais e Anxious Generation',
    persona: 'Psicólogos escolares, clínicos infantojuvenis, RH educacional',
    minutes: 18,
    qa: 17,
    summary: 'Tese Haidt The Anxious Generation 2024, rewiring of childhood, dados CETIC Brasil, escolas livres de celular, Family Media Plans AAP, prevenção familiar e sinais de alerta.'
  },
  {
    id: 'long-covid-saude-mental-faq',
    title: 'Long COVID e saúde mental — brain fog e reabilitação cognitiva',
    persona: 'Neuropsicólogos, psicólogos clínicos e hospitalares',
    minutes: 18,
    qa: 17,
    summary: 'Davis 2023 Nature Medicine, NICE NG188 2024, perfil cognitivo característico, diferencial com depressão pós-COVID, reabilitação cognitiva (Wilson) e dados FioCruz/HC-USP.'
  },
  {
    id: 'prevencao-suicidio-faq',
    title: 'Prevenção de suicídio — Zero Suicide, C-SSRS e Safety Planning',
    persona: 'Psicólogos, urgência, CAPS, atenção primária',
    minutes: 20,
    qa: 17,
    summary: 'Modelo Zero Suicide (Hogan, Henry Ford), CFP Resolução 003/2024, C-SSRS Columbia, Safety Planning Stanley & Brown 2012, means restriction, populações específicas, fluxo CVV-CAPS, sigilo profissional.'
  }
];

const metaFaq = [
  {
    q: 'O que é o hub de FAQs Aprofundados deste portal?',
    a: 'O hub reúne dezessete páginas independentes de perguntas frequentes, cada uma dedicada a um tema único da Psicologia profissional. A estrutura prioriza resposta direta na primeira sentença, fontes oficiais e profundidade técnica, com 13 a 17 perguntas por página.'
  },
  {
    q: 'Como cada FAQ está organizada?',
    a: 'Cada FAQ segue um padrão: resposta rápida no topo, lista de perguntas em accordion com primeira sentença declarativa de até 30 palavras, tabela síntese, recursos principais externos e síntese executiva. O formato é o mesmo aplicado em respostas que costumam aparecer em AI Overview do Google.'
  },
  {
    q: 'O conteúdo deste hub substitui orientação oficial do CFP ou do MEC?',
    a: 'Não. O conteúdo é independente e educacional. Para registro de especialista, escopo profissional, regulação e inscrição em programas oficiais consulte o CFP, o CRP de sua jurisdição, o MEC e a instituição responsável pelo curso.'
  }
];

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: metaFaq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: SITE.url + '/faq/' }
  ]
};

const ldCollection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'FAQs Aprofundados — Psicologia, RH e regulação',
  description: 'Hub de 17 FAQs Aprofundados em Psicologia, RH e saúde: NR-1, MBA, carreira POT, avaliação, regulação CFP, IA em Psicologia, TEA, TDAH adulto, TDAH em mulheres, burnout CID-11, primeiro episódio psicótico, perinatal, neurodiversidade, trauma complexo CPTSD, adolescência digital, long COVID e prevenção de suicídio.',
  url: SITE.url + '/faq/',
  inLanguage: 'pt-BR',
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
  hasPart: faqsHub.map(f => ({
    '@type': 'WebPage',
    name: f.title,
    url: SITE.url + '/faq/' + f.id + '/'
  }))
};
---
<Base
  title="FAQs Aprofundados — Psicologia, RH, NR-1 e regulação | Hub de perguntas frequentes"
  description="Seis FAQs com 12 a 15 perguntas cada, em formato direto e estruturado. Cobre NR-1, MBA versus especialização, carreira em POT, avaliação psicológica, regulação CFP e IA no consultório.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'FAQ' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <span class="section-eyebrow">FAQs Aprofundados · 1 tema por página · respostas verificadas</span>
          <h1 class="section-h text-3xl sm:text-4xl">Perguntas frequentes, respondidas com profundidade técnica e fontes.</h1>
          <p class="mt-3 text-ink-700 text-lg">Seis temas, uma página cada, perguntas que candidatos, psicólogos e profissionais de RH realmente fazem. Resposta direta na primeira sentença, expansão técnica em seguida.</p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver cursos no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <SmartCrossLinks href="/faq" />

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          Este hub agrupa seis FAQs independentes sobre temas que se repetem em consultas profissionais de Psicologia e RH. Cada FAQ tem entre 12 e 15 perguntas, com resposta começando por sentença declarativa direta seguida de expansão com fontes oficiais. O objetivo é resolver dúvida real, não inflar texto. Use o hub como índice e abra apenas o tema que pertence ao seu trabalho.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Pergunta certa devolve mais que resposta inflada</h2>
        <p>
          A maior parte dos portais brasileiros ainda trata FAQ como espaço de palavra-chave. O resultado: textos longos, vagos e que não terminam de responder nada. A literatura recente sobre answer-first search aponta o contrário (Google Search Central, 2024): respostas que começam com sentença declarativa direta e depois expandem com evidência têm taxa de aparição em AI Overview e em respostas de LLM significativamente superior. A inversão de prioridade é simples, mas exige disciplina editorial.
        </p>
        <p>
          Os seis FAQs deste hub seguem o mesmo protocolo: primeira sentença responde em até 30 palavras, parágrafos seguintes adicionam contexto, fonte oficial, exceção e exemplo. Quando há limite regulatório, ele aparece no início. Quando há controvérsia legítima, o texto explicita o ponto e indica onde verificar resolução vigente.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Os seis FAQs do hub</h2>
        <div class="grid md:grid-cols-2 gap-4 mt-4">
          {faqsHub.map(f => (
            <a href={`/faq/${f.id}`} class="card-lift block p-6 group">
              <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">FAQ · {f.persona}</p>
              <h3 class="font-display font-semibold text-lg mt-1 text-ink-900 group-hover:text-brand-700">{f.title}</h3>
              <p class="mt-2 text-sm text-ink-700 leading-relaxed">{f.summary}</p>
              <p class="mt-3 text-xs text-ink-500"><strong>{f.qa}</strong> perguntas · {f.minutes} min de leitura</p>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl">Tabela síntese dos seis FAQs</h2>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">FAQ</th>
                <th class="text-left px-4 py-3">Persona alvo</th>
                <th class="text-left px-4 py-3">Tempo de leitura</th>
                <th class="text-left px-4 py-3">Nº de perguntas</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {faqsHub.map(f => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink-900"><a href={`/faq/${f.id}`} class="text-brand-700 hover:text-brand-800">{f.title}</a></td>
                  <td class="px-4 py-3 text-ink-700">{f.persona}</td>
                  <td class="px-4 py-3 text-ink-700">{f.minutes} min</td>
                  <td class="px-4 py-3 text-ink-700">{f.qa}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-2xl bg-sun-500/10 border border-sun-500/30 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Caso composto · ilustrativo</p>
        <h3 class="font-display font-semibold text-lg text-ink-900">A pergunta certa que substituiu uma consulta</h3>
        <p class="mt-3 text-ink-700 leading-relaxed">
          Uma analista de RH em empresa de varejo precisava elaborar plano de adequação à NR-1 atualizada antes da auditoria interna prevista para o trimestre seguinte. A primeira tentativa foi marcar consulta com escritório especializado em segurança e saúde do trabalho — orçamento estimado em quatro horas de honorário. Antes de assinar o contrato, ela buscou pelo termo prazo de adequação da NR-1 atualizada.
        </p>
        <p class="mt-3 text-ink-700 leading-relaxed">
          O FAQ deste portal devolveu, na primeira sentença, a resposta operacional: a Portaria MTE 1.419/2024 estabeleceu prazo de adequação progressiva, com obrigatoriedade plena para identificação e avaliação de riscos psicossociais a partir de 2026 e detalhamento por porte de empresa. A pergunta seguinte explicou o que muda para MEI e ME. A terceira pergunta detalhou o que precisa estar no GRO. Em quinze minutos a analista tinha estrutura suficiente para escrever o plano interno e levar a consultoria apenas para revisão final — não para diagnóstico do zero. O FAQ não substituiu a especialista, mas substituiu três horas das quatro do orçamento original.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Perguntas sobre este hub</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white mt-4">
          {metaFaq.map((f, i) => (
            <details class="group p-5" open={i === 0}>
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <span class="font-semibold text-ink-900">{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese</p>
        <h3 class="font-display font-semibold text-xl">FAQ não é palavra-chave inflada; é resposta direta com fonte verificável.</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          Os seis FAQs deste hub foram desenhados para serem citáveis por LLMs e por AI Overview do Google porque obedecem a uma regra simples: a primeira sentença é a resposta. O resto é prova. Se você procura formação aplicada em Psicologia com método e densidade, o IPOG mantém MBAs Ao Vivo síncronos com corpo docente nominal. Próximo passo: abrir o FAQ pertinente ao seu trabalho ou consultar a página de pós-graduação no portal oficial.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary mt-4">
          Pós-graduação no IPOG
        </a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">MBAs IPOG em Psicologia</h3>
        <p class="text-sm text-ink-700 mt-2">
          O IPOG oferece MBA em Psicologia Organizacional e do Trabalho, em Psicologia Positiva, em Neuropsicologia e outros programas em formato Ao Vivo síncrono. Para grade, valor, modalidade e turma vigentes, consulte o portal oficial.
        </p>
        <p class="text-xs text-ink-500 mt-2 italic">Portal independente. Não é o site oficial do IPOG.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">Home IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">MBAs relacionados</p>
        <ul class="space-y-1">
          {MBAS.slice(0, 5).map(m => (
            <li>
              <a href={`/mbas/${m.id}`} class="mega-link">
                <strong class="text-ink-900 text-sm">{m.shortName}</strong>
              </a>
            </li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes oficiais</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP — Conselho Federal de Psicologia</a></li>
          <li><a href="https://satepsi.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">SATEPSI</a></li>
          <li><a href="https://www.gov.br/trabalho-e-emprego/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">MTE — NR-1</a></li>
          <li><a href="https://www.gov.br/mec/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">MEC — Pós lato sensu</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <RelatedContent href="/faq" />
  <NextStepCTA href="/faq" />

  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldCollection)} />
</Base>
