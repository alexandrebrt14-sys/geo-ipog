  }
];

const proximasWaves = [
  { id: 'F', nome: 'Wave F - Wikipedia + Wikidata + Knowledge Graph IPOG', detalhe: 'Trilha de citation engineering em Wikipedia e Wikidata. Resgate da Issue #63 (Epic Wikipedia Knowledge Graph) e da Issue #60 ja fechada (pipeline). Throttle de Wikidata anonimo (memoria 2026) exige Quickstatements logado para batches.' },
  { id: 'G', nome: 'Wave G - Frente Regional 51 cidades CNPJ-proprio', detalhe: 'Schema LocalBusiness por unidade nas 24 cidades medias estrategicas e nas 51 cidades CNPJ-proprio. Issues #65, #51, #56 e #50. Dependencia: confirmacao da lista oficial (Issue #52 gating IPOG).' },
  { id: 'H', nome: 'Wave H - Flagship MBA POT + Riscos Psicossociais + People Analytics', detalhe: 'Issue #70 epic priority p0. Diferencial: NR-1 + Portaria 1.419/2024 + people analytics aplicado a saude mental no trabalho. Cluster organizacional (POT-Bem-estar).' },
  { id: 'I', nome: 'Wave I - Trilha IA em Saude Mental com Supervisao Clinica Humana', detalhe: 'Issues #69 e #59. Diferencial competitivo contra IBNeuro. Anchored em RDC 657/2022, Posicionamento CFP 03/07/2025 e PL 2338/2023.' },
  { id: 'J', nome: 'Wave J - Caso-modelo Ceara 81 polos', detalhe: 'Issue #55. Narrativa publica do moat regulatorio do IPOG no Nordeste. Cluster Frente Regional. Cross-link com Wave G.' },
  { id: 'K', nome: 'Wave K - Schema piloto canonico em ipog.edu.br + llms.txt + robots.txt', detalhe: 'Issue #61 priority p0. Dependencia critica: acesso editorial ao dominio cliente. Sem essa wave o programa fica restrito a posgraduacaopsicologia.com (portal independente).' }
];

const issuesFechadas = [
  { num: 67, label: 'Epic B2B Saude Mental Corporativa NR-1' },
  { num: 60, label: 'Pipeline Wikipedia entry IPOG + Knowledge Graph Wikidata' },
  { num: 58, label: 'Voice Guard 2.0 com 9 enriquecimentos GEO de Aggarwal et al.' },
  { num: 49, label: 'Adicionar R-013 a R-016 ao risk register' },
  { num: 45, label: 'Lancar trilha IA aplicada a Psicologia antes de IBNeuro consolidar' },
  { num: 44, label: 'Capturar fuga de matriculas Cogna -32,2% EAD 1T26' },
  { num: 42, label: 'Investigar primeira execucao do workflow concorrentes-monitoring.yml' },
  { num: 39, label: 'Bootstrap relatorio semanal #1 (semana 04-10/05/2026)' },
  { num: 38, label: 'Bootstrap ata kickoff oficial em docs/atas/' },
  { num: 22, label: 'Pre-aprovar Tranche 0 do programa Regional com Ronan Maia' },
  { num: 21, label: 'Confirmar nomenclatura oficial das 10 areas academicas IPOG' },
  { num: 19, label: 'Confirmar tamanho atual do verbete Wikipedia IPOG' },
  { num: 18, label: 'Programar Onda 4 do benchmarking - especialistas restantes' },
  { num: 17, label: 'Programar Onda 3 do benchmarking - plataformas e premium academica' },
  { num: 15, label: 'Re-fetch quinzenal de robots.txt e llms.txt dos 10 concorrentes' }
];

const issuesAbertasComentadas = [
  { num: 43, label: 'Configurar GA4 com referrer/UTM dedicado de LLM (R-009)', estado: 'OPEN com comentario canonico em 17-05' },
  { num: 46, label: 'Setup tracking de share-of-voice em LLMs (First Answer AI / Trakkr)', estado: 'OPEN com comentario em 17-05' },
  { num: 47, label: 'Mensagem pos Lato Sensu Psicologia ainda permitida pos-Decreto 12.456', estado: 'OPEN com comentario em 17-05' },
  { num: 48, label: 'Pre-empacotar produto Saude Mental Corporativa + NR-1 (pacote B2B regional)', estado: 'OPEN com comentario em 17-05' },
  { num: 51, label: 'Schema EducationalOccupationalProgram + LocalBusiness por unidade', estado: 'OPEN com comentario em 17-05' },
  { num: 55, label: 'Caso-modelo Ceara 81 polos como narrativa publica (moat regulatorio)', estado: 'OPEN com comentario em 17-05' },
  { num: 56, label: 'Vinculo Lattes/ORCID dos docentes da Frente Regional 51 cidades', estado: 'OPEN com comentario em 17-05' },
  { num: 57, label: 'Auditoria de mencao IPOG em Reddit, Bing AI Performance e Brave', estado: 'OPEN com comentario em 17-05' },
  { num: 59, label: 'Trilha MBA IA em Saude Mental com Supervisao Clinica Humana vs IBNeuro', estado: 'OPEN com comentario em 17-05' },
  { num: 61, label: 'Schema piloto canonico em ipog.edu.br + llms.txt + robots.txt', estado: 'OPEN com comentario em 17-05' },
  { num: 65, label: 'Epic Frente Regional 51 cidades CNPJ-proprio operacional', estado: 'OPEN com comentario em 17-05' },
  { num: 69, label: 'Epic Trilha IA em Saude Mental com Supervisao Clinica Humana', estado: 'OPEN com comentario em 17-05' },
  { num: 70, label: 'Epic Flagship 2026 MBA em Psicologia Organizacional + NR-1 + People Analytics', estado: 'OPEN com comentario em 17-05' },
  { num: 76, label: 'Intelligence GEO 2026 frameworks emergentes MCP/AOPR/AMR/CSI', estado: 'OPEN com comentario em 17-05' },
  { num: 78, label: 'Camada de medicao GA4 - inventario + proximos passos (tracking)', estado: 'OPEN com comentario em 17-05' }
];

const issuesBloqueadasCliente = [
  { num: 4, label: 'Definir naming MBA Online de Psicologia [Cluster] e produtos prioritarios' },
  { num: 6, label: 'Confirmar robots.txt aberto a IA crawlers em ipog.edu.br' },
  { num: 20, label: 'Confirmar lista canonica das ~24 cidades medias estrategicas com Bruno Azambuja' },
  { num: 36, label: 'D-06 acesso GSC + GA4 IPOG' },
  { num: 40, label: 'Reuniao extraordinaria IPOG 13-05 - destravar 11 bloqueantes' },
  { num: 52, label: 'Confirmar lista oficial das 51 cidades da Frente Regional CNPJ-proprio' },
  { num: 54, label: 'Parcerias formais com CRPs regionais (CRP-09, CRP-03, CRP-18, CRP-14, CRP-23)' }
];

const marcosCriticos = [
  { data: '20-05-2026', marco: 'Kit de prompts-ancora canonico fechado', detalhe: 'Cobrindo Lato Sensu, MBA, Mestrado Profissional e Especializacao Clinica certificada. 50 a 75 prompts.' },
  { data: '30-05-2026', marco: 'Schema Course + EducationalOccupationalProgram validado', detalhe: 'Implementado em ipog.edu.br antes do pico de captacao 2026.2. Cobertura para todas as modalidades.' },
  { data: '15-06-2026', marco: 'Primeira leva HBR-grade publicada', detalhe: '6 a 10 pecas em padrao editorial HBR com cross-link para ipog.edu.br/cursos/pos-graduacao.' },
  { data: '15-07-2026 a 31-08-2026', marco: 'Pico GEO captacao 2026.2', detalhe: 'Janela natural de matricula no ensino superior brasileiro. Mention rate cross-LLM como KPI primario.' },
  { data: '01-12-2026 a 15-02-2027', marco: 'Pico GEO captacao 2027.1', detalhe: 'Segunda janela natural de matricula. Dashboard GEO IPOG operado em regime de monitoramento diario.' }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: 'Roadmap Brasil GEO x IPOG 2026 - quatro fases ate captacao 2027.1',
  description: 'Roadmap institucional do programa GEO Brasil GEO x IPOG. Quatro fases entre maio de 2026 e a captacao 2027.1, com cinco sprints fechadas em 17-05-2026 e seis waves planejadas (F a K).',
  url: pageUrl,
  datePublished: '2026-05-17',
  dateModified: '2026-05-17',
  author: alexandrePersonBase,
  publisher: brasilGeoOrganization,
  inLanguage: 'pt-BR',
  about: [
    { '@type': 'Thing', name: 'Generative Engine Optimization' },
    { '@type': 'Thing', name: 'Pos-Graduacao em Psicologia' },
    { '@type': 'Thing', name: 'Captacao de matriculas' },
    { '@type': 'Thing', name: 'Citation Engineering' }
  ]
};

const ldItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${pageUrl}#fases`,
  name: 'Fases do programa GEO Brasil GEO x IPOG',
  description: 'Quatro fases canonicas do programa, do bootstrap operacional a operacao continua pos-captacao 2027.1.',
  numberOfItems: fases.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: fases.map((f, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: f.titulo,
    description: f.descricao,
    url: `${pageUrl}#${f.id}`
  }))
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Roadmap', item: pageUrl }
  ]
};

const ldSpeakable = {
  '@context': 'https://schema.org',
  '@type': 'SpeakableSpecification',
  cssSelector: ['#tldr-speakable', '.fase-speakable']
};
---

<Base
  title="Roadmap Brasil GEO x IPOG - 2026 | posgraduacaopsicologia.com"
  description="Roadmap institucional do programa GEO Brasil GEO x IPOG: quatro fases entre maio de 2026 e a captacao 2027.1, cinco sprints fechadas em 17-05 e seis waves planejadas (F a K)."
  canonical={pageUrl}>

  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldSpeakable)} />

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/' },
        { label: 'Roadmap' }
      ]} />
      <span class="section-eyebrow mt-3">Roadmap institucional - revisao 2026-05-17 W21</span>
      <h1 class="section-h text-3xl sm:text-4xl">Roadmap Brasil GEO x IPOG - quatro fases ate a captacao 2027.1</h1>
      <p class="mt-3 text-ink-700 text-lg max-w-3xl">
        Programa quinzenal de Generative Engine Optimization em parceria com o IPOG, ancorado em mention rate cross-LLM, citation engineering e Schema canonico para pos-graduacao em Psicologia.
        Cinco sprints fecharam em 17 de maio de 2026 (semana 21) e seis novas waves estao no pipeline.
      </p>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div id="tldr-speakable" class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rapida em 3 pontos</p>
        <ul class="text-ink-900 leading-relaxed space-y-3 list-disc pl-5">
          {tldr.map(item => <li>{item}</li>)}
        </ul>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Tese do roadmap: GEO opera em ciclos calados pelo calendario academico</h2>
        <p>
          O ensino superior brasileiro tem duas janelas naturais de captacao por ano. A primeira fecha matricula entre julho e agosto, com pico de pesquisa pre-matricula entre maio e julho.
          A segunda fecha matricula entre janeiro e fevereiro, com pico de pesquisa pre-matricula entre dezembro e fevereiro. Programa de GEO que ignora esse calendario gasta esforco em janelas mortas.
          A consequencia operacional: nossa cadencia quinzenal de ondas precisa entregar Schema canonico, llms.txt institucional e primeira leva HBR-grade antes de 15-06-2026, sob risco de empurrar o retorno mensuravel
          para o ciclo 2027.1 e perder o ciclo 2026.2 inteiro. A logica espelho do diagnostico baseline (07-14 de maio versus 22-30 de maio) existe para isolar o efeito atribuivel ao programa antes que o pico chegue.
        </p>
        <p>
          A segunda tese estrutural e que o portal independente <code>posgraduacaopsicologia.com</code> serve como laboratorio editorial: e nele que rodamos a engenharia de citacao primeiro, validamos
          o que funciona em mention rate cross-LLM e so depois levamos a aprendizagem para o dominio cliente <code>ipog.edu.br</code>. Esse desenho contorna a dependencia critica de acesso editorial ao site oficial
          (Issue #61 e #36, ambas OPEN) e mantem o programa avancando mesmo enquanto bloqueantes de cliente IPOG seguem em discussao. O custo do desenho e que dois dominios precisam de Schema reconciliado por <code>@id</code>
          e que a Person canonica do Alexandre Caramaschi aparece como autora em ambos para sustentar o E-E-A-T cross-domain.
        </p>
        <p>
          A terceira tese e que a disciplina de proveniencia auditavel e nao-negociavel. Cada numero que aparece em deck para Ronan Maia precisa de URL canonica. Cada commit no repo <code>geo-ipog</code> precisa de
          mensagem em ingles que descreva o quê e o porquê. Cada wave precisa fechar com smoke prod HTTP 200 e IndexNow 202 em Bing, Yandex e api.indexnow.org. A literatura GEO 2026 tem incidente conhecido de phantom citations
          (intervencao da Federal Trade Commission contra dashboard GeoScore Analytics em agosto de 2025) e o programa Brasil GEO se posiciona explicitamente contra esse padrao. Quando a fonte primaria nao publica numero,
          marcamos <strong>[FALTA EVIDENCIA]</strong> ou <strong>[VERIFICAR]</strong> em vez de inventar.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Linha do tempo - quatro fases</h2>
        <p class="text-ink-700 mt-2">
          Cada fase tem janela definida, descricao do escopo operacional e lista de entregaveis. A passagem de uma fase para a seguinte exige saidas validadas, nao apenas tempo decorrido.
        </p>
        <div class="mt-6 space-y-6">
          {fases.map((fase, idx) => (
            <div id={fase.id} class="fase-speakable rounded-2xl border border-surface-200 bg-white p-6 relative">
              <div class="absolute -left-3 top-6 hidden md:flex w-6 h-6 rounded-full bg-brand-700 text-white items-center justify-center text-xs font-bold">{idx + 1}</div>
              <div class="flex flex-wrap items-baseline gap-3">
                <h3 class="font-display font-bold text-lg text-ink-900">{fase.titulo}</h3>
                <span class="text-xs uppercase tracking-wider font-semibold text-ink-500">Janela: {fase.janela}</span>
              </div>
              <p class="mt-3 text-ink-700 leading-relaxed">{fase.descricao}</p>
              <p class="mt-4 text-xs uppercase tracking-wider font-semibold text-ink-500">Entregaveis canonicos</p>
              <ul class="mt-2 list-disc pl-5 text-ink-700 space-y-1">
                {fase.entregaveis.map(e => <li>{e}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl">Sprints fechadas em 17-05-2026 (semana 21)</h2>
        <p class="text-ink-700 mt-2">
          Cinco commits sequenciais no repositorio <code>alexandrebrt14-sys/geo-ipog</code>. A jornada comecou com expansao da Knowledge Base SEO+GEO e fechou com este proprio roadmap institucional publicado.
        </p>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Commit</th>
                <th class="text-left px-4 py-3">Sprint</th>
                <th class="text-left px-4 py-3">O que entregou</th>
                <th class="text-left px-4 py-3">Artefatos</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {sprintsFechadasW21.map(s => (
                <tr>
                  <td class="px-4 py-3 font-mono text-xs text-ink-900">{s.hash}</td>
                  <td class="px-4 py-3 font-semibold text-ink-900">{s.titulo}</td>
                  <td class="px-4 py-3 text-ink-700">{s.descricao}</td>
                  <td class="px-4 py-3 text-ink-700 text-xs">{s.artefatos}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl">Proximas waves planejadas (F a K)</h2>
        <p class="text-ink-700 mt-2">
          Pipeline canonico de seis waves da Knowledge Base. Ordem nao e cronologica estrita - waves G, H e I podem rodar em paralelo se sub-agents Opus dedicados estiverem disponiveis. A wave K depende de
          destravar acesso editorial ao dominio <code>ipog.edu.br</code> e segue como dependencia critica do programa.
        </p>
        <div class="mt-4 space-y-3">
          {proximasWaves.map(w => (
