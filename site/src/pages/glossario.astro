    fonte: 'Conselho Federal de Psicologia',
    links: [{ label: 'Ver regulação', href: '/regulacao#satepsi' }]
  },
  {
    id: 'saude-mental-trabalho',
    termo: 'Saúde Mental no Trabalho',
