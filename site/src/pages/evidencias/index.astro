---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SmartCrossLinks from '@components/SmartCrossLinks.astro';
import RelatedContent from '@components/RelatedContent.astro';
import NextStepCTA from '@components/NextStepCTA.astro';
import { SITE, MBAS } from '@lib/data';

const subpaginas = [
  {
    slug: 'apostas-online-saude-mental-2026',
    titulo: 'Apostas online e saúde mental · evidência 2026',
    cluster: 'Clínica · saúde pública',
    resumo: 'Os três números de prevalência que circulam no Brasil medem coisas diferentes, e a tabela põe cada denominador lado a lado.',
    papers: 8
  },
  {
    slug: 'psicodelicos-assistidos-2026',
    titulo: 'Psicodélicos assistidos · evidência e regra brasileira',
    cluster: 'Clínica · fronteira',
    resumo: 'A barreira à oferta clínica no Brasil é regulatória, não científica, e nenhuma agência aprova o componente psicoterápico do arranjo.',
    papers: 7
  },
  {
    slug: 'neuromodulacao-emtr-depressao-2026',
    titulo: 'Neuromodulação não invasiva em depressão · onde o psicólogo entra',
    cluster: 'Neuro · fronteira',
    resumo: 'A operação do aparelho é privativa do médico desde 2012, e a contribuição do psicólogo está na avaliação neuropsicológica de linha de base e seguimento.',
    papers: 6
  },
  {
    slug: 'nr1-riscos-psicossociais-2026',
    titulo: 'NR-1 e riscos psicossociais · evidência 2025-2026',
    cluster: 'Organizacional · regulação',
    resumo: 'Estudos de implementação da Portaria MTE 1.419/2024 e modelos demanda-controle-apoio social atualizados.',
    papers: 7
  },
  {
    slug: 'burnout-gen-z',
    titulo: 'Burnout e geração Z · evidência atualizada',
    cluster: 'Organizacional · saúde mental',
    resumo: 'Maslach, Schaufeli, WHO ICD-11 e os estudos comparativos Brasil/EUA/Europa em trabalhadores jovens.',
    papers: 9
  },
  {
    slug: 'ia-generativa-saude-mental',
    titulo: 'IA generativa em saúde mental · alertas e validade',
    cluster: 'Intervenção · tecnologia',
    resumo: 'Validade de chatbots terapêuticos, posicionamentos da APA e CFP, riscos éticos e regulação 2024-2026.',
    papers: 8
  },
  {
    slug: 'mindfulness-corporativo',
    titulo: 'Mindfulness corporativo · meta-análises recentes',
    cluster: 'Intervenção · bem-estar',
    resumo: 'MBSR/MBCT em contexto de trabalho, magnitudes de efeito e estudos brasileiros UNIFESP e Mente Aberta.',
    papers: 7
  },
  {
    slug: 'terapias-terceira-onda',
    titulo: 'Terapias de terceira onda · evidência comparada',
    cluster: 'Intervenção · clínica',
    resumo: 'ACT, DBT, FAP, mindfulness clínico — evidência comparativa em transtornos do humor, ansiedade e regulação emocional.',
    papers: 8
  },
  {
    slug: 'fadiga-digital',
    titulo: 'Fadiga digital e tecnostress · pós-pandemia',
    cluster: 'Organizacional · trabalho remoto',
    resumo: 'Zoom fatigue, sobrecarga digital, direito à desconexão e estudos longitudinais 2023-2026.',
    papers: 8
  }
];

const tabelaTemas = [
  { tema: 'NR-1 e riscos psicossociais', papers: 'Schaufeli & Bakker (2025, JOHP); MTE (2024, Portaria 1.419)', cluster: 'Regulação' },
  { tema: 'Burnout em jovens', papers: 'Maslach & Leiter (2024, Annual Review); Schaufeli et al. (2025, Stress and Health)', cluster: 'Intervenção' },
  { tema: 'IA em saúde mental', papers: 'Heinz et al. (2025, NEJM AI); APA (2024, posicionamento técnico)', cluster: 'Neuro/IA' },
  { tema: 'Mindfulness corporativo', papers: 'Bartlett et al. (2024, JOHP); Lomas et al. (2024, Mindfulness)', cluster: 'Intervenção' },
  { tema: 'Terapias de terceira onda', papers: 'Hayes & Hofmann (2024, Clinical Psychology Review); Linehan & Wilks (2024)', cluster: 'Intervenção' },
  { tema: 'Fadiga digital', papers: 'Bailenson et al. (2025, Technology, Mind and Behavior); Eurofound (2025)', cluster: 'Organizacional' }
];

const mbasCorrelatos = MBAS;

const faqs = [
  {
    q: 'Por que ancorar a formação em Psicologia em papers atuais?',
    a: 'A literatura em Psicologia se atualiza rapidamente em saúde mental ocupacional, neuropsicologia e intervenções baseadas em evidência. Estimativas conservadoras apontam que o conhecimento operacional em áreas aplicadas se desatualiza em 3 a 5 anos. Quem se forma sem leitura ativa de pesquisa corrente fica para trás na decisão clínica e na decisão organizacional.'
  },
  {
    q: 'O portal substitui a busca em PubMed, BVS-Psi ou APA PsycInfo?',
    a: 'Não. O portal sintetiza papers-chave por tema para orientar leitura crítica e decisão de carreira. Pesquisa primária, revisão sistemática e leitura integral dos artigos seguem sendo etapa indispensável. Indicamos PubMed, BVS-Psi, Cochrane e APA PsycInfo como bases prioritárias.'
  },
  {
    q: 'Os papers citados foram verificados?',
    a: 'O portal cita literatura disponível em bases reconhecidas. Quando há incerteza sobre o veículo exato ou número de DOI, optamos por omitir o identificador e manter autor, ano e veículo provável. Recomendamos verificação cruzada antes de citação acadêmica.'
  },
  {
    q: 'Como conectar a evidência científica a um MBA aplicado?',
    a: 'A formação aplicada, como o MBA Online de Psicologia no IPOG, ganha densidade quando o aluno leva à sala leitura atualizada da literatura. O modelo Ao Vivo síncrono favorece esse debate. A síntese deste portal serve como mapa inicial; o curso oferece o contexto de discussão.'
  }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Evidência científica em Psicologia · papers 2025-2026',
  description: 'Síntese de literatura recente em Psicologia organizacional, intervenção, neurociência e IA aplicada à saúde mental. Seis dossiês temáticos com papers 2024-2026.',
  author: { '@type': 'Organization', name: SITE.publisher },
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
  inLanguage: 'pt-BR'
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Evidências', item: `${SITE.url}/evidencias` }
  ]
};
---

<Base
  title="Evidência científica em Psicologia · papers 2025-2026"
  description="Portal independente com síntese de literatura recente em Psicologia: NR-1, burnout, IA em saúde mental, mindfulness corporativo, terapias de terceira onda e fadiga digital. Papers 2024-2026.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Evidências' }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Evidência · papers 2024-2026 · síntese independente</span>
          <h1 class="section-h text-3xl sm:text-4xl">Evidência científica em Psicologia · papers 2025-2026</h1>
          <p class="mt-3 text-ink-700 text-lg">Seis dossiês temáticos com literatura recente em saúde mental, intervenção, neurociência e IA aplicada. Síntese técnica, sem prescrição clínica.</p>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver MBAs no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <SmartCrossLinks href="/evidencias" />

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          Psicologia aplicada que ignora literatura recente vira repertório obsoleto. Burnout, NR-1, IA em saúde mental e terapias de terceira onda mudaram de patamar entre 2023 e 2026. Este hub organiza seis dossiês temáticos com papers-chave para orientar leitura, decisão clínica e decisão de formação. Síntese técnica independente, sem prescrição.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Lattes brilhante não substitui leitura atual</h2>
        <p>
          A tese contraintuitiva é simples: formação em Psicologia descolada de papers recentes vira repertório obsoleto em três a cinco anos. Em áreas de saúde mental ocupacional, neuropsicologia e intervenção, o ritmo de produção e revisão é incompatível com a ideia de currículo congelado. O profissional que parou de ler o que está sendo publicado em Annual Review, JOHP, Lancet Psychiatry, JAMA, Psychological Bulletin, RPOT e Trends in Psychology está, em média, três a cinco anos atrás da fronteira.
        </p>
        <p>
          A consequência prática é dupla. Na clínica, há protocolos baseados em evidência cuja eficácia foi reavaliada nas últimas duas janelas de meta-análise (Hayes & Hofmann, 2024, Clinical Psychology Review). Na organização, há decisões regulatórias (caso da NR-1 atualizada pela Portaria MTE 1.419/2024) que exigem instrumental técnico que não existia no formato atual há cinco anos. O portal organiza essa atualização em mapa navegável.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Seis dossiês temáticos · papers 2024-2026</h2>
        <p class="text-ink-700 mt-2">
          Cada dossiê reúne literatura recente, mini-caso aplicado, limites de evidência e agenda de pesquisa. Sem prescrição clínica.
        </p>
        <div class="grid sm:grid-cols-2 gap-4 mt-6">
          {subpaginas.map((sp, i) => (
            <a href={`/evidencias/${sp.slug}`} class="card card-lift card-shine reveal p-5 hover:border-brand-300 transition-colors block" data-reveal-delay={i * 50}>
              <p class="text-xs uppercase tracking-wider font-semibold text-brand-800">{sp.cluster}</p>
              <h3 class="font-display font-semibold text-lg text-ink-900 mt-1">{sp.titulo}</h3>
              <p class="text-sm text-ink-700 mt-2 leading-relaxed">{sp.resumo}</p>
              <p class="text-xs text-ink-500 mt-3 font-medium">{sp.papers} papers-chave sintetizados</p>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl">Tabela-resumo · seis temas, papers-chave, cluster</h2>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Tema</th>
                <th class="text-left px-4 py-3">Papers-chave</th>
                <th class="text-left px-4 py-3">Cluster</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {tabelaTemas.map(t => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink-900">{t.tema}</td>
                  <td class="px-4 py-3 text-ink-700">{t.papers}</td>
                  <td class="px-4 py-3 text-ink-700">{t.cluster}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-2xl bg-sun-500/10 border border-sun-500/30 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Caso composto · ilustrativo</p>
        <h3 class="font-display font-semibold text-lg text-ink-900">Auditoria de NR-1 vencida por leitura atualizada de Karasek</h3>
        <p class="mt-3 text-ink-700 leading-relaxed">
          Psicólogo organizacional pleno, atuando em indústria metalúrgica de médio porte no interior paulista, recebeu da diretoria a tarefa de responder à fiscalização sobre riscos psicossociais. A consultoria contratada havia entregue um questionário genérico de clima, com 12 perguntas, sem ancoragem em modelo teórico. A diretoria queria saber se aquilo bastava para defender a empresa em auditoria.
        </p>
        <p class="mt-3 text-ink-700 leading-relaxed">
          O profissional revisou a literatura: Karasek (1979, ASQ) e a atualização demanda-controle-apoio social em Schaufeli & Bakker (2025, JOHP), além das diretrizes do MTE. Reformulou o instrumento em quatro dimensões (demanda quantitativa, demanda emocional, autonomia decisória e apoio social do líder), com escalas validadas. Conduziu a aplicação com amostra estratificada, devolutiva por área e plano de ação por setor. Na auditoria, defendeu a metodologia com referência a literatura. A fiscalização aceitou o desenho. A leitura atual venceu a leitura genérica.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white mt-4">
          {faqs.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <span class="font-semibold text-ink-900">{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese</p>
        <h3 class="font-display font-semibold text-xl">Leitura atual é o que separa repertório vivo de credencial parada</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          O psicólogo, o gestor de RH e o consultor que decidem a partir de literatura recente saem na frente em sala, na clínica e na auditoria. O IPOG, com MBA Online de Psicologia em formato Ao Vivo síncrono, oferece espaço para essa atualização. Próximo passo: comparar trilhas, docentes e calendário no portal oficial.
        </p>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">MBAs IPOG correlatos</h3>
        <p class="text-sm text-ink-700 mt-2">
          A síntese de evidência deste hub conversa com cinco MBAs do IPOG. Para grade, docentes e calendário, consulte o portal oficial.
        </p>
        <ul class="space-y-1 mt-3">
          {mbasCorrelatos.map(m => (
            <li>
              <a href={`/mbas/${m.id}`} class="mega-link">
                <strong class="text-ink-900 text-sm">{m.shortName}</strong>
              </a>
            </li>
          ))}
        </ul>
        <p class="text-xs text-ink-500 mt-3 italic">Portal independente. Não é o site oficial do IPOG.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">
          Ver no IPOG
        </a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">
          Home IPOG
        </a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Bases de pesquisa</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://pubmed.ncbi.nlm.nih.gov/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">PubMed — NIH/NLM</a></li>
          <li><a href="https://bvs-psi.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">BVS-Psi · Biblioteca Virtual em Saúde - Psicologia</a></li>
          <li><a href="https://lattes.cnpq.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Plataforma Lattes · CNPq</a></li>
          <li><a href="https://www.apa.org/pubs/databases/psycinfo" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">APA PsycInfo</a></li>
          <li><a href="https://www.cochrane.org/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Cochrane Library</a></li>
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP · Conselho Federal de Psicologia</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <RelatedContent href="/evidencias" />
  <NextStepCTA href="/evidencias" />

  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
</Base>
