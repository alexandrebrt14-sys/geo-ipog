      </div>

      <div>
        <h2 class="section-h text-2xl">Tabela 3 — Cenários de uso ético</h2>
        <div class="overflow-x-auto rounded-2xl border border-surface-200 mt-4">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50">
              <tr>
                <th class="text-left p-3 font-display font-semibold text-ink-900">Cenário</th>
                <th class="text-left p-3 font-display font-semibold text-brand-700">Psicoeducação adjuvante</th>
                <th class="text-left p-3 font-display font-semibold text-sun-600">Psicoterapia formal</th>
                <th class="text-left p-3 font-display font-semibold text-ink-500">Crise / risco</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr>
                <td class="p-3 font-medium text-ink-900">Chatbot especializado (Woebot, Wysa)</td>
                <td class="p-3 text-ink-700">Adequado, com supervisão clínica</td>
                <td class="p-3 text-ink-700">Insuficiente como terapia primária</td>
                <td class="p-3 text-ink-700">Apenas como ponte para profissional / CVV</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-ink-900">Chatbot de companhia (Replika, Character.ai)</td>
                <td class="p-3 text-ink-700">Não recomendado para uso clínico</td>
                <td class="p-3 text-ink-700">Contraindicado</td>
                <td class="p-3 text-ink-700">Contraindicado — risco documentado</td>
              </tr>
