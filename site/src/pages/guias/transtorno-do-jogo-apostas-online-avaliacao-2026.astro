        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full h-11">Ver no IPOG</a>
        <a href="/tipos-de-pos-graduacao" class="btn btn-ghost mt-2 w-full h-11">Tipos de pós-graduação</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Áreas e MBAs correlatos</p>
        <ul class="space-y-1">
          <li><a href={`/areas/${areaClinica.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{areaClinica.name}</strong></a></li>
          <li><a href={`/areas/${areaSaude.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{areaSaude.name}</strong></a></li>
          <li><a href={`/mbas#${mbaPositiva.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{mbaPositiva.shortName}</strong></a></li>
          <li><a href={`/mbas#${mbaPot.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{mbaPot.shortName}</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes principais</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://www.gov.br/saude/pt-br/centrais-de-conteudo/publicacoes/guias-e-manuais/2026/guia-de-cuidado-para-pessoas-com-problemas-relacionados-a-jogos-de-apostas.pdf" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Ministério da Saúde, Guia de Cuidado (2026)</a></li>
          <li><a href="https://www.ncbi.nlm.nih.gov/books/n/niceng248guid/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">NICE NG248 (2025)</a></li>
          <li><a href="https://www.bcb.gov.br/conteudo/relatorioinflacao/EstudosEspeciais/EE119_Analise_tecnica_sobre_o_mercado_de_apostas_online_no_Brasil_e_o_perfil_dos_apostadores.pdf" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Banco Central, Estudo Especial 119/2024</a></li>
          <li><a href="https://portal.tcu.gov.br/imprensa/noticias/apostas-on-line-tcu-avalia-acoes-de-prevencao-do-governo" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">TCU, Acórdão 1173/2025</a></li>
          <li><a href="https://www.cvv.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CVV, 188</a></li>
        </ul>
        <p class="text-xs text-ink-500 mt-3">Tempo de leitura: ~21 min</p>
      </div>
    </aside>
  </section>

