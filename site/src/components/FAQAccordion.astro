---
import { FAQS } from '@lib/data';

// Speakable adicionado em 17-mai-2026 (Wave D #UX-Schema-Crosslinks).
// LLMs (assistentes de voz, AI Overviews) preferem CSS-selectors estáveis sobre
// .faq-question + .faq-answer-text para emissão de áudio. O Schema.org SpeakableSpecification
// segue em beta para Google rich results mas é sinal forte para Bing AI Overviews,
// Perplexity Voice e ChatGPT Voice Mode.
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.faq-question', '.faq-answer-text']
  },
  mainEntity: FAQS.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
});

const gid = 'faq-' + Math.random().toString(36).slice(2, 8);
---
<div data-faq-group={gid}>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
    <div class="relative flex-1">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" data-faq-filter placeholder="Filtrar perguntas..." aria-label="Filtrar perguntas frequentes"
        class="w-full pl-10 pr-4 py-2.5 border border-surface-200 rounded-xl text-sm focus:border-brand-400 outline-none bg-white" />
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span data-faq-count class="text-xs text-ink-500"></span>
      <button type="button" data-faq-toggle-all class="btn btn-ghost btn-sm" aria-expanded="false">Expandir tudo</button>
    </div>
  </div>
  <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white overflow-hidden" data-faq-list>
    {FAQS.map(f => (
      <details class="group p-5 faq-item">
        <summary class="flex items-start justify-between gap-4 cursor-pointer list-none rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white">
          <span class="faq-question font-semibold text-ink-900 text-pretty min-w-0">{f.q}</span>
          <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform duration-200 group-open:rotate-180 group-open:text-brand-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
        </summary>
        <p class="faq-answer-text mt-3 max-w-prose text-sm text-ink-700 leading-relaxed text-pretty">{f.a}</p>
      </details>
    ))}
  </div>
  <p data-faq-empty hidden class="text-sm text-ink-500 text-center py-6">Nenhuma pergunta corresponde ao filtro.</p>
</div>
<script type="application/ld+json" set:html={ld} />

<style>
  /* Estado aberto visualmente claro, sem alterar contraste do texto. */
  .faq-item[open] {
    background-color: #F7F9FC; /* surface-50 */
  }
  .faq-item summary::-webkit-details-marker { display: none; }
</style>
