            </details>
          ))}
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl">referências principais para TDAH em mulher adulta</h2>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Referência</th>
                <th class="text-left px-4 py-3">Finalidade</th>
                <th class="text-left px-4 py-3">Autor / Ano</th>
                <th class="text-left px-4 py-3">Etapa</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Sex differences in ADHD</td>
                <td class="px-4 py-3 text-ink-700">Apresentação feminina, fenótipo desatento</td>
                <td class="px-4 py-3 text-ink-700">Hinshaw et al., 2022 (Annu Rev Clin Psychol)</td>
                <td class="px-4 py-3 text-ink-700">Base conceitual</td>
              </tr>
              <tr>
