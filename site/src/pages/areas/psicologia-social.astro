---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "Psicologia Social: território, direitos, SUAS e formação",
  "description": "Entenda campos de atuação e limites no SUAS. Compare formações em Psicologia Social e planeje uma análise participativa com fontes oficiais.",
  "route": "/areas/psicologia-social/",
  "label": "Psicologia Social",
  "section": "Áreas",
  "sectionPath": "/areas/",
  "faqs": [
    {
      "q": "O PAIF deve oferecer psicoterapia?",
      "a": "As orientações do PAIF distinguem trabalho social com famílias de práticas clínicas. Demandas de saúde devem ser articuladas com a rede correspondente."
    },
    {
      "q": "Trabalho em grupo substitui qualquer atendimento individual?",
      "a": "Não. O formato precisa corresponder à demanda, à finalidade do serviço e às condições de participação."
    },
    {
      "q": "Psicologia Social se limita a CRAS e CREAS?",
      "a": "Não. O campo também contribui para pesquisa, projetos comunitários, análise institucional e outras políticas, conforme qualificação e responsabilidades."
    }
  ],
  "worksheet": {
    "title": "Mapa participativo de uma demanda social",
    "description": "Planeje perguntas para um cenário fictício de atuação territorial.",
    "fields": [
      {
        "label": "Demanda e origem",
        "hint": "Quem formulou o pedido e qual é a finalidade?"
      },
      {
        "label": "Perspectivas ausentes",
        "hint": "Quem precisa ser ouvido e que barreiras existem?"
      },
      {
        "label": "Serviço e responsabilidades",
        "hint": "Quais funções cabem ao serviço e quais exigem articulação?"
      },
      {
        "label": "Devolutiva e revisão",
        "hint": "Como os participantes conhecerão e discutirão os resultados?"
      }
    ],
    "checklist": [
      "Distingui assistência social e cuidado clínico.",
      "Incluí participação e possibilidade de discordância.",
      "Não tratei número de encontros como prova de impacto.",
      "Usei situação fictícia sem registros de famílias."
    ]
  },
  "sources": [
    [
      "CFP: referências para CRAS/SUAS",
      "https://site.cfp.org.br/publicacao/referencias-tecnicas-para-atuacao-de-psicologasos-no-cras-suas/"
    ],
    [
      "MDS: orientações técnicas do PAIF, volume 1",
      "https://www.mds.gov.br/webarquivos/publicacao/assistencia_social/cadernos/orientacoes_paif_1.pdf"
    ],
    [
      "CONPAS/CFP: biblioteca de assistência social",
      "https://conpas.cfp.org.br/publicacao/cfp/"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma equipe recebe pedido para criar grupos com famílias e reduzir a fila de atendimento. Antes de escolher o formato, precisa ouvir as pessoas, compreender barreiras de acesso e saber qual serviço está sendo ofertado.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>Uma intervenção social começa pela compreensão do território e dos direitos.</h2>
<p>A Psicologia Social estuda relações entre pessoas, grupos, instituições e contextos históricos. O campo reúne tradições e métodos diversos; não se limita a um local de emprego nem exige apagar experiências individuais para reconhecer desigualdades e relações de poder.</p>
<p>Na prática, isso pode envolver pesquisa, trabalho comunitário, políticas públicas e análise institucional. A pergunta precisa ser construída com atenção aos participantes e à finalidade do serviço. Uma técnica de grupo não garante participação, e reunir pessoas não significa que todas possam falar ou discordar em condições semelhantes.</p></section>
<section><h2>SUAS: finalidade do serviço e limites profissionais</h2>
<p>As <a href="https://site.cfp.org.br/publicacao/referencias-tecnicas-para-atuacao-de-psicologasos-no-cras-suas/">referências do CFP para CRAS/SUAS</a> ajudam a compreender a atuação na proteção social e sua relação com direitos e território. O CRAS e o CREAS têm funções diferentes na rede; a formação deve ensinar a consultar a organização dos serviços, sem usar uma descrição genérica para todos os equipamentos.</p>
<p>As <a href="https://www.mds.gov.br/webarquivos/publicacao/assistencia_social/cadernos/orientacoes_paif_1.pdf">orientações técnicas do PAIF</a> distinguem o trabalho social com famílias de práticas clínicas. O PAIF não deve ser apresentado como psicoterapia ou psicodiagnóstico. Necessidades de cuidado em saúde exigem articulação com a rede correspondente, preservando o acompanhamento socioassistencial pertinente.</p>
<p>Esse limite não significa ignorar sofrimento. Significa responder a ele conforme a finalidade do serviço e as responsabilidades profissionais. Um encaminhamento precisa ter pergunta, destino e possibilidade de continuidade, evitando simplesmente transferir o problema para outra equipe.</p></section>
<section><h2>Compare contextos antes de escolher uma pós</h2>
<div class="table-wrap"><table><thead><tr><th>Contexto de interesse</th><th>Competência a investigar na formação</th></tr></thead><tbody>
<tr><td>Assistência social</td><td>Leitura do SUAS, trabalho com famílias e articulação de direitos</td></tr>
<tr><td>Projetos comunitários</td><td>Construção participativa de demandas, devolutiva e negociação de objetivos</td></tr>
<tr><td>Pesquisa</td><td>Coerência entre pergunta, método, análise e proteção dos participantes</td></tr>
<tr><td>Gestão e avaliação</td><td>Uso responsável de indicadores e escuta de pessoas afetadas</td></tr>
</tbody></table></div>
<p>Peça atividades que mostrem como o aluno aprende a lidar com conflitos, diferenças culturais e limites institucionais. A formação deve discutir quem define o problema, quem decide e quem terá acesso ao resultado. A simples presença da palavra “impacto” na ementa não responde a essas questões.</p>
<p>Confira público de ingresso, supervisão e certificado. Conhecimentos sociais podem ser compartilhados entre profissões, mas uma pós não amplia automaticamente atribuições regulamentadas. Não confunda trabalho interdisciplinar com autorização para desempenhar qualquer função da equipe.</p></section>
<section><h2>Um roteiro de análise participativa</h2>
<ol><li>Descreva a demanda institucional e identifique de quem ela parte.</li><li>Mapeie quais perspectivas ainda não foram ouvidas e quais barreiras dificultam a participação.</li><li>Defina a finalidade do serviço e as responsabilidades envolvidas.</li><li>Discuta alternativas com os participantes, incluindo limites de recursos e proteção da informação.</li><li>Planeje uma devolutiva compreensível e um momento de revisão.</li></ol>
<p>No caso hipotético inicial, a análise pode revelar que horário, transporte ou receio de exposição interferem na participação. O grupo pode ser uma alternativa a discutir, mas não deve substituir automaticamente atenção individual ou outros apoios. O resultado do exercício é uma pergunta melhor e uma decisão situada, não uma porcentagem inventada de melhora.</p>
<p>Ao avaliar um projeto, frequência e quantidade de encontros descrevem atividade. Para compreender utilidade, é preciso relacionar esses registros à finalidade acordada e à experiência dos participantes. Uma variação no comparecimento não prova, isoladamente, que direitos foram ampliados.</p></section>
<section><h2>Ferramentas para organizar o estudo</h2>
<p>Leia também <a href="/areas/psicologia-saude/">Psicologia em Saúde</a> e <a href="/areas/psicologia-escolar-educacional/">Psicologia Escolar e Educacional</a> para observar como finalidades e responsabilidades mudam entre políticas. A <a href="https://conpas.cfp.org.br/publicacao/cfp/">biblioteca da CONPAS/CFP</a> reúne referências de assistência social para aprofundamento.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/dados-com-python">Dados com Python</a>, do portal educacional de Alexandre Caramaschi, pode apoiar exercícios com bases públicas e sintéticas. Evite cadastrar famílias ou converter relatos pessoais em material de IA. Use a ficha para um cenário fictício, registrando perspectivas, responsabilidades e dúvidas de formação.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
