---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import MBACard from '@components/MBACard.astro';
import { ESTADOS, MBAS, SITE } from '@lib/data';

export function getStaticPaths() {
  return ESTADOS.map(e => ({ params: { uf: e.uf.toLowerCase() } }));
}

const { uf } = Astro.params;
const estado = ESTADOS.find(e => e.uf.toLowerCase() === uf);
if (!estado) return Astro.redirect('/por-estado');

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Pós-graduação em Psicologia em ${estado.nome}`,
  description: `Mapa de MBAs e pós-graduações em Psicologia para ${estado.nome} (${estado.uf}).`,
  about: { '@type': 'Place', name: estado.nome }
});
---

<Base
  title={`Pós-graduação em Psicologia em ${estado.nome} (${estado.uf})`}
  description={`MBAs e pós-graduações em Psicologia disponíveis para ${estado.nome}. Modalidades online é ao vivo do IPOG.`}>

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/' },
        { label: 'Por estado', href: '/por-estado' },
        { label: estado.nome }
      ]} />
      <div class="mt-3 flex items-end gap-4">
        <span class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-brand-50 text-brand-700 text-xl font-display font-bold">{estado.uf}</span>
        <div>
          <span class="section-eyebrow">Regiao {estado.regiao}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Pós-graduação em Psicologia em {estado.nome}.</h1>
        </div>
      </div>
      <p class="mt-3 text-ink-700 max-w-3xl">
        O IPOG atende {estado.nome} principalmente nas modalidades online é ao vivo. Selecione o MBA que combina
        com seu momento e siga para o portal oficial para inscrição.
      </p>
    </div>
  </section>

  <section class="container-page py-10">
    <h2 class="section-h text-2xl mb-5">MBAs disponíveis</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {MBAS.map(m => <MBACard mba={m} />)}
    </div>

    <div class="mt-10 card p-6 sm:p-8 bg-gradient-to-br from-brand-50 to-white">
      <span class="section-eyebrow">Modalidades em {estado.uf}</span>
      <h3 class="font-display font-semibold text-xl mt-1">Online ao vivo, gravado e presencial</h3>
      <p class="text-ink-700 mt-2">
        A maioria dos MBAs do IPOG funciona ao vivo via plataforma EAD com aulas semanais é atividades práticas.
        Algumas turmas tem encontros presenciais agendados em polos parceiros — confira disponibilidade em sua regiao
        no portal oficial.
      </p>
      <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-5">
        Ver turmas para {estado.uf} no IPOG
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={ld} />
</Base>
