  {
    nome: 'Análise de voz + linguagem (NLP em entrevista gravada)',
    validacao: 'Estudos exploratórios 2024-2026; resultados promissores em triagem precoce infantil; sem validação consolidada para adultos',
    viesAlgoritmico: 'Risco de viés por dialeto, sotaque, idioma; pt-BR sub-representado',
    fenotipoFeminino: 'Não validado',
    aprovacao: 'Sem aprovação ANVISA',
    custo: 'Em desenvolvimento; sem produto comercial em pt-BR',
    integracaoCid: 'Indireta; gera marcador linguístico complementar',
    suportePtBr: 'Limitado; pesquisa em curso',
    limitacao: 'Tecnologia em desenvolvimento; risco LGPD por gravação; sem produto consolidado'
  },
  {
    nome: 'Triagem automatizada por questionário online (M-CHAT-R, AQ-10)',
    validacao: 'M-CHAT-R amplamente validado em crianças (Robins et al., 2014); AQ-10 (Allison, Auyeung, Baron-Cohen, 2012) como triagem em adultos',
    viesAlgoritmico: 'Algoritmo de pontuação simples; viés se desloca para auto-relato',
    fenotipoFeminino: 'Sensibilidade limitada — instrumentos não otimizados para fenótipo feminino',
    aprovacao: 'Triagem, não diagnóstico; aceito em primary care e pediatria; CFP permite uso por profissional',
    custo: 'Gratuito em plataformas open-access',
    integracaoCid: 'Não diagnostica; encaminha para avaliação completa',
    suportePtBr: 'Versões pt-BR disponíveis',
    limitacao: 'Sensibilidade limitada em fenótipo feminino; risco de falso negativo em mulher com camuflagem'
