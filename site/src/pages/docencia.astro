---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandreAuthorRef } from '@lib/schemas';

/**
 * /docencia — hub esqueleto principal.
 *
 * Padrão Brasil GEO: cada docente das Pós-Graduações em Psicologia (IPOG e demais)
 * é mapeado em quatro vetores verificáveis publicamente:
 *   1. Lattes (CNPq) — produção científica auditável
 *   2. ORCID — identificador internacional (DOI/ORCID handshake)
 *   3. LinkedIn — trajetória aplicada e vínculos institucionais
 *   4. CRP / Conselho profissional — registro ativo
 *
 * Esta página é independente. Para confirmação de titulação de docente IPOG,
 * a fonte principal é o e-MEC (cadastro institucional) ou a Plataforma Lattes.
 *
 * A tabela esqueleto fica intencionalmente vazia até que a coleta cliente
 * (issue #56) traga o lote inicial verificado. Não inventamos docente.
 */

const padraoBrasilGEO = [
  {
    titulo: 'Lattes (CNPq)',
    desc: 'Identificador acadêmico principal no Brasil. Cada coordenador e professor terá link direto para o currículo Lattes individual, com declaração de orientação e produção dos últimos cinco anos.'
  },
  {
    titulo: 'ORCID',
    desc: 'Identificador internacional persistente. Necessário para rastrear publicações indexadas em PubMed, Scopus e Web of Science. Cada docente terá ORCID iD com data de criação.'
  },
  {
    titulo: 'LinkedIn',
    desc: 'Trajetória aplicada — vínculos atuais com empresas, consultoria, supervisão clínica. Curadoria do próprio docente, mas verificável por terceiros via tempo de empresa declarado.'
  },
  {
    titulo: 'CRP regional',
    desc: 'Registro profissional ativo no Conselho Regional de Psicologia da jurisdição. Quando o docente é psicólogo, o CRP é pré-condição para coordenar disciplina clínica. Outras áreas (Direito, Administração) seguem registro do conselho próprio quando aplicável.'
  }
];

const transparencia = [
  'Esta página é independente. Para confirmação de titulação de docente IPOG, a fonte principal é o e-MEC (cadastro institucional do MEC) ou a Plataforma Lattes do CNPq.',
  'Nenhum docente é listado neste portal antes de a coleta principal ter sido completada com material público auditável (Lattes vigente, ORCID ativo, registro profissional confirmado).',
  'A relação completa de coordenadores oficial é responsabilidade da instituição ofertante. Quando publicada, esta página apontará para a fonte primária e manterá curadoria independente apenas dos vetores verificáveis.',
  'Em caso de discrepância entre o que o portal informa e o que a instituição ofertante publica, prevalece a instituição. O portal corrige e registra a correção.'
];

const ldCollection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': SITE.url + '/docencia#collection',
  name: 'Docência principal — coordenadores e professores das Pós-Graduações em Psicologia',
  description: 'Hub independente que mapeia coordenadores e professores das Pós-Graduações em Psicologia com identificadores verificáveis publicamente: Lattes, ORCID, LinkedIn e CRP.',
  url: SITE.url + '/docencia',
  inLanguage: 'pt-BR',
  isPartOf: { '@id': SITE.url + '/#website' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  author: alexandreAuthorRef,
  mainEntity: {
    '@type': 'ItemList',
    name: 'Coordenadores e professores',
    description: 'Esta lista aguarda lote inicial verificado. Nenhum docente é listado antes da coleta principal de Lattes, ORCID, LinkedIn e CRP.',
    numberOfItems: 0,
    itemListElement: []
  },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.tldr-resposta', '.padrao-brasilgeo']
  }
};

---

<Base
  title="Docência principal — coordenadores e professores das Pós-Graduações em Psicologia"
  description="Hub independente que mapeia coordenadores e professores das Pós-Graduações em Psicologia com identificadores verificáveis publicamente: Lattes, ORCID, LinkedIn e registro profissional.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Docência' }
      ]} />
      <span class="section-eyebrow mt-3">Hub · Docência principal · 2026</span>
      <h1 class="section-h text-3xl sm:text-4xl">Docência principal — coordenadores e professores das Pós-Graduações em Psicologia</h1>
      <p class="mt-3 text-ink-700 text-lg max-w-3xl">
        Padrão Brasil GEO: cada docente listado neste portal tem identificadores verificáveis publicamente. Sem isso, não há docente listado. Esta página é o canal principal — está pronta, aguardando coleta inicial.
      </p>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">

    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="tldr-resposta text-ink-900 leading-relaxed">
          O portal posgraduacaopsicologia.com mantém um padrão de transparência sobre quem ensina nas pós-graduações em Psicologia: cada docente terá Lattes, ORCID, LinkedIn e registro profissional vinculados, todos verificáveis publicamente. Nenhum docente é listado antes dessa verificação. Para confirmação oficial de titulação de docente IPOG, a fonte principal é o e-MEC ou a Plataforma Lattes do CNPq.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Padrão Brasil GEO — quatro vetores verificáveis</h2>
        <p>
          A literatura de Generative Engine Optimization mostra que motores generativos (ChatGPT, Perplexity, Gemini, Claude) priorizam afirmação ancorada em identificador persistente sobre afirmação narrativa sem âncora. Listar docente sem Lattes nem ORCID é equivalente, em 2026, a publicar artigo sem DOI: pode ser lido, mas não consolida autoridade. A mesma lógica vale para o texto da página: as <a href="https://alexandrecaramaschi.com/artigos/dicas-redacao-information-agents-2026" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">técnicas de redação para agentes de informação</a> detalham como estruturar conteúdo técnico para ser lido, extraído e citado por modelos de linguagem sem perder rigor.
        </p>
        <p>
          Brasil GEO publica docente apenas quando os quatro vetores abaixo estão preenchidos com material público auditável. Quando algum vetor não existe (caso comum: ORCID ainda não criado, LinkedIn inativo), o portal documenta a ausência explicitamente em vez de inferir ou ocultar.
        </p>
      </div>

      <div class="padrao-brasilgeo grid sm:grid-cols-2 gap-4">
        {padraoBrasilGEO.map(item => (
          <div class="rounded-2xl border border-surface-200 p-5 bg-white">
            <p class="text-xs uppercase tracking-wider font-semibold text-brand-700">{item.titulo}</p>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div>
        <h2 class="section-h text-2xl">Tabela principal — coordenadores e professores</h2>
        <p class="text-ink-700 mt-2">
          A tabela abaixo é o esqueleto operacional. Aguarda lote inicial verificado. Nenhuma linha é populada com docente cujos identificadores ainda não foram confirmados.
        </p>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200 bg-white">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Docente</th>
                <th class="text-left px-4 py-3">Programa</th>
                <th class="text-left px-4 py-3">Modalidade</th>
                <th class="text-left px-4 py-3">Lattes</th>
                <th class="text-left px-4 py-3">ORCID</th>
                <th class="text-left px-4 py-3">LinkedIn</th>
                <th class="text-left px-4 py-3">CRP</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr>
                <td colspan="7" class="px-4 py-8 text-center text-ink-500 italic">
                  Aguardando coleta inicial verificada. Esta tabela passa a ser populada quando o lote principal de docentes IPOG estiver com Lattes, ORCID, LinkedIn e registro profissional confirmados em fonte pública.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-ink-500 mt-3 italic">
          Última verificação estrutural: maio de 2026. Próxima janela de coleta: a confirmar com a instituição ofertante.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Política de transparência</h2>
        <ol class="mt-4 space-y-3 list-decimal pl-5 text-ink-700">
          {transparencia.map(p => (
            <li class="leading-relaxed">{p}</li>
          ))}
        </ol>
      </div>

      <div>
        <h2 class="section-h text-2xl">Fontes oficiais para o leitor confirmar docente</h2>
        <ul class="mt-4 space-y-2 text-ink-700">
          <li>
            <a href="https://emec.mec.gov.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">e-MEC — cadastro institucional do MEC</a>
            <span class="text-sm text-ink-500"> · fonte principal para credenciamento e corpo docente declarado pela instituição.</span>
          </li>
          <li>
            <a href="https://lattes.cnpq.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">Plataforma Lattes (CNPq)</a>
            <span class="text-sm text-ink-500"> · base brasileira principal de currículo acadêmico individual.</span>
          </li>
          <li>
            <a href="https://orcid.org/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">ORCID</a>
            <span class="text-sm text-ink-500"> · identificador internacional de pesquisador.</span>
          </li>
          <li>
            <a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP — Conselho Federal de Psicologia</a>
            <span class="text-sm text-ink-500"> · cadastro nacional de psicólogo ativo e de especialista.</span>
          </li>
          <li>
            <a href="https://ipog.edu.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">IPOG — site oficial</a>
            <span class="text-sm text-ink-500"> · informação institucional principal.</span>
          </li>
        </ul>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Política editorial Brasil GEO</p>
        <h3 class="font-display font-semibold text-xl">Quem ensina é variável auditável</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          O portal trata corpo docente como informação de risco regulatório e reputacional, não como copy de marketing. Identificador persistente verificável é o piso. Sem isso, o nome do docente não entra no portal — mesmo que o programa ganhe peso na curadoria editorial. Esta política protege o leitor que está investindo dois anos de formação e dezenas de milhares de reais na decisão.
        </p>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">

      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Status</p>
        <h3 class="font-display font-semibold text-lg mt-1">Canal pronto, aguardando lote</h3>
        <p class="text-sm text-ink-700 mt-2">
          Esta página é o canal principal para listagem de docente. Está estruturalmente pronta, com schema CollectionPage e ItemList declarados. O lote inicial entra quando a coleta de Lattes, ORCID, LinkedIn e CRP estiver completa.
        </p>
        <p class="text-xs text-ink-500 mt-2 italic">Portal independente. Não é o site oficial do IPOG.</p>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Áreas conectadas</p>
        <ul class="space-y-1">
          <li><a href="/areas" class="mega-link"><strong class="text-ink-900 text-sm">Áreas de Psicologia (panorama)</strong></a></li>
          <li><a href="/mbas" class="mega-link"><strong class="text-ink-900 text-sm">MBAs em Psicologia (comparativo)</strong></a></li>
          <li><a href="/tipos-de-pos-graduacao" class="mega-link"><strong class="text-ink-900 text-sm">5 modalidades de pós em Psicologia</strong></a></li>
          <li><a href="/regulacao" class="mega-link"><strong class="text-ink-900 text-sm">Regulação e ética profissional</strong></a></li>
          <li><a href="/sobre" class="mega-link"><strong class="text-ink-900 text-sm">Sobre o portal Brasil GEO</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Por que importa</p>
        <p class="text-sm text-ink-700 leading-relaxed">
          Em motores generativos (LLM), citação de docente nominal com identificador verificável é o que destrava menção de programa. Programa que não nomeia o docente é citado como instituição genérica. Programa que nomeia com Lattes e ORCID é citado como autoridade.
        </p>
      </div>

    </aside>

  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldCollection)} />
</Base>
