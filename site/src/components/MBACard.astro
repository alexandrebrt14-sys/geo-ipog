---
import type { MBA } from '@lib/data';
import { SITE } from '@lib/data';

interface Props {
  mba: MBA;
  featured?: boolean;
}
const { mba, featured = false } = Astro.props;
---

<article id={mba.id} class={`card-lift card-shine reveal p-6 ${featured ? 'sm:col-span-2' : ''} scroll-mt-24`}>
  <div class="flex items-start gap-3 mb-3">
    <span class="tag"><span class="text-brand-700">●</span> {mba.tag}</span>
  </div>
  <h3 class="font-display font-semibold text-xl text-ink-900">{mba.name}</h3>
  <p class="mt-3 text-sm text-ink-500">{mba.description}</p>
  <ul class="mt-4 flex flex-wrap gap-1.5">
    {mba.topics.slice(0, 6).map(t => (
      <li class="text-[11px] px-2.5 py-1 rounded-full bg-brand-50 text-brand-700 font-medium">{t}</li>
    ))}
  </ul>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-surface-200">
    <div class="text-xs text-ink-500">
      Para: <span class="font-medium text-ink-700">{mba.personas.join(' · ')}</span>
    </div>
    <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary btn-sm">
      Ver no IPOG
      <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
    </a>
  </div>
</article>
