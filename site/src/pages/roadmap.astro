  description: 'Quatro fases principais do programa, do bootstrap operacional à operação contínua pós-captação 2027.1.',
  numberOfItems: fases.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: fases.map((f, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: f.titulo,
    description: f.descricao,
