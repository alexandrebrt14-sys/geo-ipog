---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization, alexandreAuthorRef } from '@lib/schemas';

const title = 'Post LinkedIn + carrossel pronto: neuropsicologia, a carreira que cresce no Brasil pós-lecanemab — Biblioteca Brasil GEO';
const description = 'Peça reaproveitável para LinkedIn (post + carrossel de 7 slides) sobre crescimento de carreira em Neuropsicologia no Brasil após aprovação do lecanemab pela ANVISA em 2025.';
const slug = 'neuropsicologia-carreira-linkedin';
const datePublished = '2026-05-17';

const copyPostLinkedIn = `O lecanemab (Leqembi) foi aprovado pela ANVISA em 2025 para Alzheimer leve. A consequência para neuropsicólogos brasileiros começa agora.

Por que isso muda o mercado:

→ 1. Identificar CCL (Comprometimento Cognitivo Leve, critério Petersen 2024) cedo virou prioridade clínica para indicação medicamentosa.
→ 2. p-tau217 plasmático (Ashton et al., 2024) com AUC > 0,95 está disponível em laboratórios brasileiros — neuropsicólogo precisa saber interpretar.
→ 3. ARIA-E (edema cerebral) ocorre em ~13% dos pacientes em lecanemab — devolutiva técnica vira parte do trabalho.

Três consequências práticas:

A. Bateria neuropsicológica em paciente acima de 60 anos com queixa de memória sai do anual para o semestral.
B. Hospital universitário, neurologista de consultório e centro de longevidade estão contratando.
C. Pós-graduação em Neuropsicologia com currículo pré-2023 está desatualizada — sem CCL revisado, sem p-tau217, sem lecanemab.

O psicólogo brasileiro formado em Neuropsicologia atualizada pós-2024 entra em mercado quente. Quem se formou antes precisa de educação continuada explícita.

Curso atualizado precisa cobrir: critério Petersen 2024 para CCL, p-tau217 plasmático, lecanemab e ARIA-E, instrumentos com parecer favorável SATEPSI vigente, supervisão prática mínima de 360h.

Lato Sensu reconhecido pelo CFP é o caminho regulatório padrão. Especialização Clínica certificada por instituto de Neuropsicologia (ANP, ABRATEC) é complemento técnico relevante.

#Neuropsicologia #Alzheimer #lecanemab #CarreiraPsicologia`;

const carrosselSlides = [
  {
    n: 1,
    titulo: 'Neuropsicologia virou carreira em alta no Brasil em 2026.',
    corpo: 'O motivo é regulatório: lecanemab (Leqembi) aprovado pela ANVISA em 2025 para Alzheimer leve. Cadeia clínica inteira precisa de profissional formado pós-2024.'
  },
  {
    n: 2,
    titulo: 'CCL deixou de ser categoria observacional.',
    corpo: 'Comprometimento Cognitivo Leve (critério revisado por Petersen 2024) virou alvo terapêutico com chance de progressão de 10-15% ao ano para Alzheimer.'
  },
  {
    n: 3,
    titulo: 'p-tau217 plasmático é o exame que muda a conversa.',
    corpo: 'Ashton et al. (2024): AUC > 0,95 para diferenciar CCL biomarcador-positivo. Custo médio < R$ 500 em laboratório de referência. Não invasivo. Não substitui PET-amiloide, mas filtra encaminhamento.'
  },
  {
    n: 4,
    titulo: 'Neuropsicólogo virou porta de entrada de decisão multimilionária.',
    corpo: 'Identificação precoce de CCL define quem é candidato a lecanemab. Devolutiva clínica precisa ser tecnicamente impecável: paciente e família tomam decisão grande com base nela.'
  },
  {
    n: 5,
    titulo: 'ARIA-E em ~13% dos pacientes não é detalhe.',
    corpo: 'Edema cerebral relacionado a anticorpo monoclonal anti-amiloide é o evento adverso mais comum. Conversa de risco/benefício técnico vira parte do trabalho do neuropsi.'
  },
  {
    n: 6,
    titulo: 'Pós-graduação pré-2023 está defasada.',
    corpo: 'Currículo sem CCL revisado, sem p-tau217, sem lecanemab é currículo do mundo anterior. Antes de matricular: peça ementa e verifique se esses três pontos aparecem.'
  },
  {
    n: 7,
    titulo: 'Próximo passo de carreira em 18 meses.',
    corpo: 'Lato Sensu em Neuropsicologia reconhecido pelo CFP + supervisão prática mínima 360h + atualização semestral em conferência ou journal. MBAs em Neuropsicologia (IPOG, PUC) entram como modalidade complementar.'
  }
];

const comoAdaptar = [
  'Substack: vire edição com cada slide como seção H2, adicione caso clínico composto de devolutiva a paciente com biomarcador positivo, encerre com agenda de próxima edição.',
  'Medium: amplie para 1.500 palavras com referências completas (DOIs Ashton 2024, Petersen 2024, bula ANVISA lecanemab) e adicione tabela com bateria neuropsi atualizada.',
  'Quora: pegue slides 1-4 como resposta para "vale a pena pós em Neuropsicologia em 2026?". Termine com fonte (ANVISA, satepsi.cfp.org.br).',
  'Reddit r/Neuropsicologia ou r/psicologia: cole versão completa com disclosure profissional e ao menos um link primário (anvisa.gov.br).',
  'YouTube: roteiro de 12-15 min com convidado neuropsicólogo praticante para validar a relevância clínica do p-tau217 em ambiente real.'
];

const tags = ['linkedin', 'neuropsicologia', 'lecanemab', 'alzheimer', 'ccl-petersen-2024', 'p-tau217-ashton-2024', 'satepsi'];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE.url}/conteudo-social/biblioteca/${slug}/#article`,
      url: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      headline: 'Neuropsicologia: a carreira que cresce no Brasil pós-lecanemab',
      description,
      inLanguage: 'pt-BR',
      datePublished,
      dateModified: datePublished,
      author: alexandreAuthorRef,
      publisher: { '@id': 'https://brasilgeo.ai/#organization' },
      mainEntityOfPage: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      articleSection: 'Biblioteca editorial',
      keywords: tags.join(', ')
    },
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'Biblioteca', href: '/conteudo-social/biblioteca' },
  { label: 'Neuropsicologia (LinkedIn)' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Biblioteca · Peça pronta</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">LinkedIn: Neuropsicologia, a carreira que cresce no Brasil pós-lecanemab</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Post longo de ~1.300 palavras totais (post + carrossel de 7 slides) com citações reais (Petersen 2024, Ashton et al. 2024) e estrutura editorial Caramaschi.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Onde usar esta peça</p>
      <h2 class="font-display font-semibold text-xl text-ink-900">Canais alvo: LinkedIn (primário) e Substack (secundário)</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        LinkedIn é o canal natural para neuropsicólogo, neurologista, geriatra e gestor de centro de longevidade. Carrossel de 7 slides dobra dwell time. Substack pega o mesmo conteúdo para newsletter de educação continuada.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Copy do post (~1.300 caracteres)</h2>
    <article class="prose prose-ink max-w-3xl bg-surface-50 rounded-2xl p-6 sm:p-8 border border-surface-200 whitespace-pre-line">{copyPostLinkedIn}</article>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Roteiro do carrossel (7 slides)</h2>
    <p class="text-ink-700 max-w-3xl mb-6">Use Canva ou Figma. Padrão: cor de fundo neutra clara, tipografia serifada para título e sans-serif para corpo, citação científica em rodapé do slide quando aplicável.</p>
    <div class="grid sm:grid-cols-2 gap-5">
      {carrosselSlides.map(s => (
        <article class="card-lift p-6">
          <p class="text-[11px] uppercase tracking-wider font-semibold text-brand-700">Slide {s.n}/7</p>
          <h3 class="font-display font-semibold text-lg mt-2 text-ink-900">{s.titulo}</h3>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{s.corpo}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Como adaptar para outros canais</h2>
    <ul class="space-y-3 max-w-3xl">
      {comoAdaptar.map(item => (
        <li class="flex gap-3 text-ink-800 text-sm leading-relaxed">
          <span class="text-brand-700 font-bold mt-0.5">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-6">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Author box</p>
      <p class="text-ink-900 font-display font-semibold text-lg">Alexandre Caramaschi</p>
      <p class="text-ink-700 text-sm mt-1">Chief Strategy Officer da Nuvini (Nasdaq: NVNI), fundador da Brasil GEO, ex-CMO da Semantix (Nasdaq) e cofundador da AI Brasil. Edita o portal posgraduacaopsicologia.com.</p>
    </div>
  </section>

  <section class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      {tags.map(t => (
        <span class="chip">{t}</span>
      ))}
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Hub Neuropsicologia</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        Cobertura editorial independente da área em /areas/neuropsicologia. Para matrícula em programa IPOG de pós em Neuropsicologia, ipog.edu.br.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/areas/neuropsicologia" class="btn btn-primary">Ver Neuropsicologia</a>
        <a href="/conteudo-social/biblioteca" class="btn btn-ghost-dark">Voltar à biblioteca</a>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark">Ver no IPOG →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
