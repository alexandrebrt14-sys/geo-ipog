---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import InPageNav from '@components/InPageNav.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization, alexandreAuthorRef } from '@lib/schemas';

const title = 'Google Discover e Google Notícias em Psicologia: elegibilidade automática não é exibição · Brasil GEO';
const description = 'A diferença entre Discover e Google Notícias, o que faz uma peça ser tratada como notícia, as políticas de spam do Search Central e o critério para decidir entre guia e notícia.';

const datePublished = '2026-09-07';
const pagePath = '/conteudo-social/google-discover-e-noticias';

const headings = [
  { id: 'contrato', text: 'Contrato do canal', level: 2 },
  { id: 'diferenca', text: 'Discover e Notícias são superfícies distintas', level: 2 },
  { id: 'elegibilidade', text: 'Elegibilidade automática contra exibição', level: 2 },
  { id: 'o-que-e-noticia', text: 'O que faz uma peça ser tratada como notícia', level: 2 },
  { id: 'spam', text: 'O erro clássico e as políticas de spam', level: 2 },
  { id: 'etica', text: 'Ética profissional nesta superfície', level: 2 },
  { id: 'decisao', text: 'Guia no portal ou notícia: o critério', level: 2 },
  { id: 'checklist', text: 'Checklist antes de publicar', level: 2 },
  { id: 'perguntas', text: 'Perguntas frequentes', level: 2 }
];

const contrato = [
  {
    item: 'Público real',
    texto: 'Leitor que ainda não conhece o portal e demonstra interesse em saúde mental, educação, carreira e regulação profissional. Ele chega sem ter feito busca, por recomendação no celular.'
  },
  {
    item: 'Formato canônico',
    texto: 'Artigo noticioso ou análise editorial em .html, com autoria assinada, data visível, imagem grande e representativa a partir de 1.200 pixels de largura, marcação estruturada coerente e carregamento rápido.'
  },
  {
    item: 'Gancho de abertura',
    texto: 'O fato novo dito na primeira frase, com o nome do documento, a data e quem é afetado. A abertura de uma notícia responde o que mudou antes de explicar por que aquilo importa.'
  },
  {
    item: 'Regra que quebra a conta',
    texto: 'O Google declara que o conteúdo fica automaticamente elegível ao Discover quando está indexado e cumpre as políticas de conteúdo, e declara na mesma página que ser elegível não garante aparecer. Violação de política gera ação manual visível no Search Console.'
  },
  {
    item: 'Erro clássico',
    texto: 'Republicar um guia atemporal com data nova para parecer notícia. O Discover aceita conteúdo útil mais antigo, e o Google Notícias exige substância jornalística; a data trocada sem fato novo entrega as duas coisas erradas de uma vez.'
  },
  {
    item: 'Métrica honesta',
    texto: 'Impressões e cliques em Discover pelo relatório do Search Console, entrada por Google Notícias quando existe notícia real, recirculação para as páginas de guia e citação por outros veículos. Pico isolado sem retorno qualificado descreve atenção.'
  }
];

const comparacao = [
  {
    criterio: 'Como o leitor chega',
    discover: 'Sem busca. O conteúdo é recomendado no feed do celular a partir de interesse declarado e histórico.',
    noticias: 'Por consulta ativa a um tema em curso ou por navegação na superfície de notícias.'
  },
  {
    criterio: 'Elegibilidade',
    discover: 'Automática para conteúdo indexado que cumpre as políticas de conteúdo do Discover.',
    noticias: 'Automática para conteúdo que segue as políticas de conteúdo; desde a transição de 2025 a página de publicação é gerada pelo Google.'
  },
  {
    criterio: 'Tipo de peça que cabe',
    discover: 'Conteúdo oportuno ou com percepção original, inclusive material que não é notícia estrita.',
    noticias: 'Peça com fato, temporalidade e interesse público, com data e assinatura claras.'
  },
  {
    criterio: 'O que reprova',
    discover: 'Chamada sensacionalista, imagem pequena ou pouco representativa, experiência de página ruim.',
    noticias: 'As categorias proibidas das políticas de conteúdo, entre elas conteúdo médico, prática enganosa e mídia manipulada.'
  },
  {
    criterio: 'Onde aparece a punição',
    discover: 'Ação manual do Discover listada no Search Console, em segurança e ações manuais.',
    noticias: 'Remoção da superfície de notícias e, em caso grave ou repetido, perda de elegibilidade.'
  }
];

const passos = [
  {
    nome: 'Confirmar que existe fato novo com data e documento',
    texto: 'Norma publicada, decisão judicial, posicionamento de conselho, resultado de pesquisa ou mudança de política de plataforma. Sem documento datado que alguém possa abrir, a peça é guia e segue como guia.'
  },
  {
    nome: 'Escrever a notícia respondendo o que mudou, para quem e desde quando',
    texto: 'Primeiro parágrafo com o fato, o nome do documento, a data de vigência e a população afetada. O contexto histórico entra depois, com link para a página do portal que já cobre o tema.'
  },
  {
    nome: 'Assinar, datar e mostrar as duas coisas na página',
    texto: 'Autoria identificada com biografia acessível, data de publicação visível e data de atualização quando houver. As políticas de conteúdo do Google Notícias pedem data e assinatura claras.'
  },
  {
    nome: 'Preparar imagem grande e representativa',
    texto: 'Imagem a partir de 1.200 pixels de largura, que descreva o assunto de forma honesta. Fotografia de sofrimento usada como isca reprova por ética antes de reprovar por política.'
  },
  {
    nome: 'Atualizar o guia correspondente com nota de mudança datada',
    texto: 'O guia do portal ganha um bloco dizendo o que mudou, quando e qual decisão profissional fica diferente. A data de atualização acompanha uma alteração real de conteúdo.'
  },
  {
    nome: 'Ligar as duas peças nos dois sentidos e medir separado',
    texto: 'A notícia aponta para o guia, o guia aponta para a notícia, e o relatório do Search Console separa a entrada por Discover da entrada por busca comum.'
  }
];

const checklist = [
  'Existe um documento datado por trás da peça, e o leitor consegue abrir esse documento pelo link.',
  'O primeiro parágrafo diz o que mudou, quem é afetado e desde quando.',
  'A página traz autoria identificada e data de publicação visível, com data de atualização quando houver alteração real.',
  'A imagem principal tem pelo menos 1.200 pixels de largura e representa o assunto sem dramatizar sofrimento.',
  'Nenhum título promete desfecho clínico nem sugere diagnóstico de pessoa identificável.',
  'Nenhuma peça usa tragédia recente, morte ou crise de figura pública como chamada.',
  'Nenhum guia atemporal foi republicado com data nova sem alteração de conteúdo.',
  'O guia correspondente foi atualizado com nota de mudança datada e link para a notícia.',
  'A marcação estruturada da página descreve o mesmo tipo de peça que o texto entrega.',
  'A medição separa impressão e clique em Discover da entrada por busca comum.'
];

const faqs = [
  {
    q: 'Qual a diferença entre Google Discover e Google Notícias?',
    a: 'Discover é um feed de recomendação: a pessoa recebe o conteúdo sem ter feito busca, a partir de interesses e de histórico, e ele aceita material oportuno ou com percepção original, inclusive peças que não são notícia estrita. Google Notícias é uma superfície de conteúdo jornalístico, alimentada por peças com fato, temporalidade e interesse público, com data e assinatura claras. As duas usam elegibilidade automática e as duas dependem das políticas de conteúdo do Google.'
  },
  {
    q: 'Preciso cadastrar o portal no Publisher Center para aparecer no Google Notícias?',
    a: 'O Google informa que, desde a transição concluída em 2025, as páginas de publicação passaram a ser geradas automaticamente e que publicadores não precisam mais criar ou manter uma publicação no Publisher Center. Conteúdo que segue as políticas de conteúdo fica automaticamente elegível para consideração no Google Notícias, e o ranqueamento leva em conta relevância, atualidade e autoridade.'
  },
  {
    q: 'Ser elegível ao Discover significa que a página vai aparecer?',
    a: 'A documentação do Google diz que o conteúdo fica automaticamente elegível quando está indexado e cumpre as políticas de conteúdo do Discover, e diz na mesma página que ser elegível não é garantia de aparecer. A recomendação depende dos mesmos sinais de qualidade usados na busca. Quando há violação de política, ação manual do Discover aparece no Search Console, na seção de segurança e ações manuais.'
  },
  {
    q: 'Por que republicar um guia com data nova é um problema?',
    a: 'Porque a data passa a afirmar algo que o conteúdo não sustenta. As políticas de spam do Google Search Central descrevem como abuso a geração de páginas cujo propósito principal é manipular classificação sem ajudar o usuário, e a mesma lógica alcança a data trocada sem alteração de conteúdo. A prática correta é atualizar de fato, registrar o que mudou em uma nota datada e reservar a data nova para a alteração real.'
  },
  {
    q: 'Posso escrever sobre o diagnóstico de uma figura pública?',
    a: 'O Código de Ética Profissional do Psicólogo veda diagnóstico a distância, sensacionalismo e promessa de cura, e esses limites valem para conteúdo publicado em superfície de notícias. Comentar em abstrato um quadro clínico que voltou ao debate público é legítimo quando a peça explica o que a evidência mostra e onde ela para. Atribuir um quadro a uma pessoa específica a partir de aparição pública fica fora, mesmo com ressalva.'
  },
  {
    q: 'Quando a resposta certa é guia no portal, e não notícia?',
    a: 'Quando o material é atemporal, quando ele responde a uma decisão recorrente e quando não existe documento novo por trás dele. Guia bem feito trabalha por anos e sustenta citação por mecanismo generativo. Notícia trabalha por dias e traz leitor novo. As duas peças convivem quando a notícia aponta para o guia e o guia registra a atualização. Para quem quer aprofundar a formação em comunicação e regulação, o catálogo de pós-graduação do IPOG está em ipog.edu.br.'
  }
];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE.url}${pagePath}/#article`,
      url: `${SITE.url}${pagePath}/`,
      headline: 'Google Discover e Google Notícias em Psicologia: elegibilidade automática não é exibição',
      description,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${SITE.url}/#website` },
      datePublished,
      dateModified: datePublished,
      articleSection: 'Conteúdo e Social',
      about: 'Google Discover, Google Notícias, elegibilidade, políticas de spam, ética editorial em saúde mental',
      author: alexandreAuthorRef,
      publisher: { '@id': 'https://brasilgeo.ai/#organization' }
    },
    {
      '@type': 'HowTo',
      '@id': `${SITE.url}${pagePath}/#howto`,
      name: 'Levar um fato novo do portal ao Google Discover e ao Google Notícias',
      description: 'Seis passos para transformar um documento datado em notícia publicável e atualizar o guia correspondente sem trocar a data à toa.',
      inLanguage: 'pt-BR',
      totalTime: 'PT5H',
      step: passos.map((p, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: p.nome,
        text: p.texto
      }))
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}${pagePath}/#faq`,
      inLanguage: 'pt-BR',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo e Social', href: '/conteudo-social' },
  { label: 'Google Discover e Notícias' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Conteúdo e Social · Superfícies do Google</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Google Discover e Google Notícias: elegibilidade automática, exibição sem garantia</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        O Google diz na própria documentação que o conteúdo indexado que cumpre as políticas fica automaticamente elegível ao Discover, e diz na mesma página que elegibilidade não garante aparecer. Entre as duas frases mora quase toda a frustração de quem publica em saúde mental.
      </p>
    </div>
  </section>

  <section class="container-page py-8 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-8 space-y-10">

      <TLDR
        resposta="Discover recomenda conteúdo a quem não buscou nada, e aceita peça oportuna ou com percepção original. Google Notícias exige fato, temporalidade e interesse público, com data e assinatura visíveis. As duas superfícies usam elegibilidade automática, e nenhuma das duas garante exibição. Republicar guia atemporal com data nova falha nas duas e ainda encosta nas políticas de spam do Search Central."
        fontes={['Google Search Central, documentação do Google Discover', 'Google Publisher Center, políticas do Google Notícias', 'Google Search Central, políticas de spam']}
      />

      <div class="prose prose-ink max-w-none">
        <p>
          Uma norma de saúde mental no trabalho é publicada numa quinta-feira. Na sexta, três portais de Psicologia sobem a mesma peça: um explica o que mudou e desde quando, outro atualiza um guia antigo com nota datada, e o terceiro troca a data de um texto de 2024 e escreve novidade no título. O terceiro é o que costuma reclamar de alcance depois, e a explicação está escrita nas políticas públicas do Google.
        </p>
        <p>
          A documentação do Discover afirma que o conteúdo fica automaticamente elegível quando está indexado e cumpre as políticas de conteúdo da superfície, e afirma logo em seguida que estar elegível não garante aparecer. O Google Notícias segue a mesma lógica de elegibilidade automática desde a transição concluída em 2025, quando as páginas de publicação passaram a ser geradas pelo próprio sistema e o cadastro manual no Publisher Center deixou de ser exigido. Nenhuma das duas superfícies tem porta de entrada para conquistar; as duas têm porta de saída, e ela se chama política de conteúdo.
        </p>
        <p>
          Para um portal de Psicologia isso muda a pergunta de trabalho. Em vez de perguntar como entrar no Discover, a pergunta útil é qual peça merece ser tratada como notícia e qual peça trabalha melhor como guia permanente. A resposta tem consequência de calendário, de escrita e de medição, e ela é o assunto desta página. O <a href="/conteudo-social/radar-de-evidencias">radar de evidências</a> do portal existe justamente para separar o que é fato novo do que é repercussão.
        </p>
      </div>

      <section id="contrato" class="scroll-mt-24">
        <h2 class="section-h text-2xl">Contrato do canal</h2>
        <p class="text-ink-700 mt-2 leading-relaxed">Seis linhas que decidem se a peça vira notícia. A linha da regra de plataforma vem antes da linha de formato.</p>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3 w-52">Item do contrato</th>
                <th class="text-left px-4 py-3">O que ele exige</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {contrato.map(c => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink-900 align-top">{c.item}</td>
                  <td class="px-4 py-3 text-ink-700 align-top">{c.texto}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="diferenca" class="scroll-mt-24">
        <h2 class="section-h text-2xl">Discover e Notícias são superfícies distintas</h2>
        <p class="text-ink-700 mt-2 leading-relaxed">Cinco critérios lado a lado, com a origem de cada afirmação na documentação pública do Google.</p>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3 w-44">Critério</th>
                <th class="text-left px-4 py-3">Google Discover</th>
                <th class="text-left px-4 py-3">Google Notícias</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {comparacao.map(c => (
                <tr class="align-top">
                  <td class="px-4 py-3 font-semibold text-ink-900">{c.criterio}</td>
                  <td class="px-4 py-3 text-ink-700">{c.discover}</td>
                  <td class="px-4 py-3 text-ink-700">{c.noticias}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-ink-700 mt-4 leading-relaxed max-w-3xl">
          As políticas de conteúdo do Google Notícias listam categorias proibidas, e uma delas se chama conteúdo médico. Isso põe um portal de Psicologia dentro da faixa de maior atenção da superfície, junto com prática enganosa e mídia manipulada. Vale ler a lista inteira em <a href="https://support.google.com/news/publisher-center/answer/6204050?hl=en" target="_blank" rel="noopener external">políticas do Google Notícias</a> antes de planejar pauta de saúde.
        </p>
      </section>

      <figure id="elegibilidade" class="scroll-mt-24">
        <h2 class="section-h text-2xl">Elegibilidade automática contra exibição</h2>
        <p class="text-ink-700 mt-2 leading-relaxed">A figura separa o que o Google promete do que ele decide, e mostra onde a punição aparece quando algo dá errado.</p>
        <div class="overflow-x-auto rounded-2xl border border-surface-200 bg-surface-50 p-4 mt-4">
          <svg role="img" aria-labelledby="gdn-eleg-titulo gdn-eleg-desc" viewBox="0 0 660 300" width="660" height="300" style="min-width:660px" class="block">
            <title id="gdn-eleg-titulo">Da indexação à exibição, com o ponto em que a decisão deixa de ser do publicador</title>
            <desc id="gdn-eleg-desc">Uma sequência horizontal de quatro caixas ligadas por setas, com uma quinta caixa isolada abaixo. A primeira caixa se chama Página indexada e representa o que depende do publicador. A segunda caixa se chama Políticas de conteúdo cumpridas e também depende do publicador. A terceira caixa se chama Elegibilidade automática e é descrita como estado declarado pelo Google, alcançado quando as duas primeiras condições existem. A quarta caixa se chama Exibição no feed e está marcada como decisão do sistema, com a observação de que elegibilidade não garante aparecer. Uma linha tracejada vertical separa as duas primeiras caixas das duas últimas, com o rótulo de que o controle do publicador termina ali. A quinta caixa, abaixo e ligada à terceira por uma linha, se chama Ação manual no Search Console e registra que a violação de política aparece na seção de segurança e ações manuais e retira a página da superfície.</desc>
            <text x="20" y="28" font-size="15" font-weight="600" class="fill-ink-900">O controle do publicador termina na segunda caixa</text>
            <rect x="20" y="60" width="140" height="70" rx="10" class="fill-brand-50 stroke-brand-300" stroke-width="1.5" />
            <text x="34" y="86" font-size="13" font-weight="600" class="fill-ink-900">Página indexada</text>
            <text x="34" y="106" font-size="12" class="fill-ink-700">depende de você</text>
            <rect x="180" y="60" width="150" height="70" rx="10" class="fill-brand-50 stroke-brand-300" stroke-width="1.5" />
            <text x="194" y="86" font-size="13" font-weight="600" class="fill-ink-900">Políticas cumpridas</text>
            <text x="194" y="106" font-size="12" class="fill-ink-700">depende de você</text>
            <rect x="360" y="60" width="140" height="70" rx="10" class="fill-brand-100 stroke-brand-600" stroke-width="2" />
            <text x="374" y="86" font-size="13" font-weight="600" class="fill-ink-900">Elegibilidade</text>
            <text x="374" y="106" font-size="12" class="fill-ink-700">estado automático</text>
            <rect x="520" y="60" width="120" height="70" rx="10" class="fill-surface-100 stroke-surface-200" stroke-width="1.5" />
            <text x="534" y="86" font-size="13" font-weight="600" class="fill-ink-900">Exibição</text>
            <text x="534" y="106" font-size="12" class="fill-ink-700">decisão do sistema</text>
            <line x1="160" y1="95" x2="180" y2="95" stroke-width="2" class="stroke-ink-500" />
            <line x1="330" y1="95" x2="360" y2="95" stroke-width="2" class="stroke-ink-500" />
            <line x1="500" y1="95" x2="520" y2="95" stroke-width="2" class="stroke-ink-500" />
            <line x1="345" y1="46" x2="345" y2="200" stroke-width="2" stroke-dasharray="6 6" class="stroke-ink-500" />
            <text x="360" y="164" font-size="12" class="fill-ink-500">Elegibilidade declarada pelo Google. Aparecer segue sem garantia.</text>
            <line x1="430" y1="130" x2="430" y2="196" stroke-width="2" class="stroke-ink-500" />
            <rect x="300" y="196" width="340" height="70" rx="10" class="fill-surface-100 stroke-brand-600" stroke-width="2" />
            <text x="316" y="222" font-size="13" font-weight="600" class="fill-ink-900">Ação manual no Search Console</text>
            <text x="316" y="242" font-size="12" class="fill-ink-700">Violação de política aparece em segurança e ações manuais</text>
            <text x="316" y="260" font-size="12" class="fill-ink-700">e retira a página da superfície.</text>
            <text x="20" y="222" font-size="12" class="fill-ink-500">O que você controla é</text>
            <text x="20" y="240" font-size="12" class="fill-ink-500">indexação, política,</text>
            <text x="20" y="258" font-size="12" class="fill-ink-500">assinatura, data e imagem.</text>
          </svg>
        </div>
        <figcaption class="text-sm text-ink-500 mt-3">Montado a partir da documentação pública do Google Discover no Search Central e da página de transição do Google Notícias, ambas consultadas em 7 de setembro de 2026. A figura descreve regra declarada, sem estimativa de desempenho.</figcaption>
      </figure>

      <figure id="o-que-e-noticia" class="scroll-mt-24">
        <h2 class="section-h text-2xl">O que faz uma peça ser tratada como notícia</h2>
        <p class="text-ink-700 mt-2 leading-relaxed">Três perguntas em sequência, e uma delas descarta a maior parte das pautas de portal editorial.</p>
        <div class="overflow-x-auto rounded-2xl border border-surface-200 bg-surface-50 p-4 mt-4">
          <svg role="img" aria-labelledby="gdn-fluxo-titulo gdn-fluxo-desc" viewBox="0 0 660 330" width="660" height="330" style="min-width:660px" class="block">
            <title id="gdn-fluxo-titulo">Fluxo de decisão entre publicar notícia e publicar guia</title>
            <desc id="gdn-fluxo-desc">Um fluxo de decisão com três perguntas em sequência vertical e três destinos. A primeira pergunta é: existe documento datado por trás da pauta, como norma, decisão, posicionamento de conselho, pesquisa publicada ou mudança de política de plataforma. A resposta não leva ao destino Guia no portal, sem data nova. A resposta sim leva à segunda pergunta: o fato interessa a alguém além de quem já acompanha o portal. A resposta não leva ao destino Nota curta dentro do guia existente. A resposta sim leva à terceira pergunta: alguma decisão profissional fica diferente por causa desse fato. A resposta não leva ao mesmo destino de nota curta. A resposta sim leva ao destino Notícia assinada e datada, com link para o guia. Ao lado do primeiro destino há um aviso de que republicar guia com data nova sem alteração de conteúdo reprova nas duas superfícies do Google.</desc>
            <text x="20" y="28" font-size="15" font-weight="600" class="fill-ink-900">Três perguntas antes de chamar a peça de notícia</text>
            <rect x="20" y="50" width="300" height="56" rx="10" class="fill-brand-50 stroke-brand-300" stroke-width="1.5" />
            <text x="36" y="74" font-size="13" font-weight="600" class="fill-ink-900">1. Existe documento datado por trás?</text>
            <text x="36" y="94" font-size="12" class="fill-ink-700">norma, decisão, posicionamento, pesquisa, política</text>
            <rect x="20" y="126" width="300" height="56" rx="10" class="fill-brand-50 stroke-brand-300" stroke-width="1.5" />
            <text x="36" y="150" font-size="13" font-weight="600" class="fill-ink-900">2. Interessa além de quem já acompanha?</text>
            <text x="36" y="170" font-size="12" class="fill-ink-700">interesse público, e não interesse do portal</text>
            <rect x="20" y="202" width="300" height="56" rx="10" class="fill-brand-100 stroke-brand-600" stroke-width="2" />
            <text x="36" y="226" font-size="13" font-weight="600" class="fill-ink-900">3. Alguma decisão fica diferente?</text>
            <text x="36" y="246" font-size="12" class="fill-ink-700">quem decide, o que muda, a partir de quando</text>
            <line x1="170" y1="106" x2="170" y2="126" stroke-width="2" class="stroke-ink-500" />
            <line x1="170" y1="182" x2="170" y2="202" stroke-width="2" class="stroke-ink-500" />
            <line x1="320" y1="78" x2="380" y2="78" stroke-width="2" class="stroke-ink-500" />
            <text x="330" y="70" font-size="12" class="fill-ink-500">não</text>
            <line x1="320" y1="154" x2="380" y2="154" stroke-width="2" class="stroke-ink-500" />
            <text x="330" y="146" font-size="12" class="fill-ink-500">não</text>
            <line x1="320" y1="230" x2="380" y2="230" stroke-width="2" class="stroke-brand-600" />
            <text x="330" y="222" font-size="12" class="fill-ink-500">sim</text>
            <rect x="380" y="52" width="260" height="52" rx="10" class="fill-surface-100 stroke-surface-200" stroke-width="1.5" />
            <text x="396" y="74" font-size="13" font-weight="600" class="fill-ink-900">Guia no portal, sem data nova</text>
            <text x="396" y="92" font-size="12" class="fill-ink-700">o texto atemporal trabalha por anos</text>
