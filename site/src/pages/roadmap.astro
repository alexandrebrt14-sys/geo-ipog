  { data: '15-07-2026 a 31-08-2026', marco: 'Pico GEO captação 2026.2', detalhe: 'Janela natural de matrícula no ensino superior brasileiro. Mention rate cross-LLM como KPI primário.' },
  { data: '01-12-2026 a 15-02-2027', marco: 'Pico GEO captação 2027.1', detalhe: 'Segunda janela natural de matrícula. Dashboard GEO IPOG operado em regime de monitoramento diário.' }
