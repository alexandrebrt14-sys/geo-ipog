            <line x1="346" y1="152" x2="386" y2="152" stroke-width="2" class="stroke-current text-ink-500" />

            <line x1="181" y1="180" x2="181" y2="204" stroke-width="2" class="stroke-current text-ink-500" />

            <rect x="16" y="204" width="330" height="56" rx="12" fill="none" stroke-width="2" class="stroke-current text-ink-300" />
