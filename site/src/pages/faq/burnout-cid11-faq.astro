      <div>
        <h2 class="section-h text-2xl">Verbetes relacionados no glossário</h2>
        <div class="mt-4 grid sm:grid-cols-2 gap-3">
    <a href="/glossario/conceitos-pot/#burnout-cid11" class="card p-4 hover:shadow-md transition-shadow">
      <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Conceito</p>
      <p class="font-semibold text-ink-900 mt-1 text-sm">Burnout CID-11 (QD85)</p>
