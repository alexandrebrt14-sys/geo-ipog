const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: 'Roadmap Brasil GEO x IPOG 2026 - quatro fases até captação 2027.1',
  description: 'Roadmap institucional do programa Brasil GEO x IPOG. Quatro fases entre maio de 2026 e a captação 2027.1, com cinco sprints fechadas em 17-05-2026 e seis waves planejadas (F a K).',
  url: pageUrl,
  datePublished: '2026-05-17',
  dateModified: '2026-05-17',
  author: { '@id': alexandrePersonBase['@id'] },
  publisher: { '@id': brasilGeoOrganization['@id'] },
