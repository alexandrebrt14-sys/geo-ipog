    ]
  },
  {
    id: 'fase-3',
    titulo: 'Fase 3 - Q4-2026 - Captacao 2027.1',
    janela: 'outubro, novembro e dezembro de 2026',
    cor: 'brand',
    descricao: 'Segunda leva de conteudo HBR com foco em decisao de matricula para o ciclo 2027.1, monitoramento diario de mention rate e share-of-voice nas semanas que antecedem o pico, ajuste fino de Schema e revisao de llms.txt, calibracao de prompts canonicos com base no que rendeu mais Citation Rate na Fase 2 e abertura formal de produto Saude Mental Corporativa + NR-1 como pacote B2B regional. Pico GEO esperado entre 01-12-2026 e 15-02-2027.',
    entregaveis: [
