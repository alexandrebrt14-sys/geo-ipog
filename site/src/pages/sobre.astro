---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';

const title = 'Sobre o portal e quem o assina · posgraduacaopsicologia.com';
const description = 'Portal editorial independente sobre pós-graduação em Psicologia no Brasil, publicado pela Brasil GEO sob responsabilidade editorial de Alexandre Caramaschi. Caminho oficial das matrículas: ipog.edu.br.';

const ldOrganization = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': SITE.url + '#brasil-geo',
  name: 'Brasil GEO',
  url: SITE.url,
  logo: SITE.url + '/og-image.jpg',
  description: 'Brasil GEO é o programa de Generative Engine Optimization que executa o trabalho técnico e editorial do posgraduacaopsicologia.com. Pesquisa GEO baseada em corpus reprodutível de 14.171 queries cross-LLM (papers Caramaschi 2026).',
  founder: { '@id': SITE.url + '#alexandre-caramaschi' },
  sameAs: [
    'https://github.com/alexandrebrt14-sys/geo-ipog',
    'https://alexandrecaramaschi.com'
  ],
  knowsAbout: [
    'Generative Engine Optimization',
    'GEO',
    'Search Engine Optimization',
    'AI citation tracking',
    'Schema.org',
    'LLM mention rate',
    'Pós-graduação em Psicologia',
    'MBA Online',
    'Educational Marketing'
  ]
});

const ldPerson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': SITE.url + '#alexandre-caramaschi',
  name: 'Alexandre Caramaschi',
  givenName: 'Alexandre',
  familyName: 'Caramaschi',
  jobTitle: 'CEO da Brasil GEO',
  description: 'CEO da Brasil GEO, ex-CMO da Semantix (Nasdaq), cofundador da AI Brasil. Lead editorial do programa GEO IPOG e autor do corpus de pesquisa Caramaschi 2026 sobre citation behavior em LLMs (4 papers, 14.171 queries cross-LLM).',
  worksFor: { '@id': SITE.url + '#brasil-geo' },
  alumniOf: [
    { '@type': 'EducationalOrganization', name: 'Semantix', url: 'https://semantix.com.br/' }
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'CEO · Lead de pesquisa GEO',
    occupationalCategory: 'Marketing executivo · pesquisador aplicado em LLMs'
  },
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'CEO da Brasil GEO' },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Ex-CMO da Semantix (Nasdaq: STIX)' },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Cofundador da AI Brasil' }
  ],
  knowsAbout: [
    'Generative Engine Optimization',
    'Marketing científico aplicado a LLMs',
    'Citation behavior em ChatGPT, Claude, Gemini, Perplexity, Copilot',
    'Schema.org para educação superior',
    'Análise estatística cross-LLM (GLMM, BH-FDR, Monte Carlo)',
    'Educação superior brasileira',
    'Pós-graduação lato sensu'
  ],
  sameAs: [
    'https://alexandrecaramaschi.com',
    'https://github.com/alexandrebrt14-sys',
    'https://alexandrecaramaschi.com/papers-roadmap'
  ],
  award: [
    'Autor do corpus de pesquisa Caramaschi 2026 — 4 papers sobre citation behavior em LLMs (14.171 queries cross-LLM, dataset reprodutível MIT-licensed)'
  ]
});

const ldWebPage = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': SITE.url + '/sobre',
  name: title,
  description,
  inLanguage: 'pt-BR',
  about: { '@id': SITE.url + '#brasil-geo' },
  mainEntity: { '@id': SITE.url + '#alexandre-caramaschi' },
  isPartOf: { '@type': 'WebSite', url: SITE.url, name: SITE.name }
});

const ldBreadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Sobre', item: SITE.url + '/sobre' }
  ]
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Sobre' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">Sobre · publisher · responsabilidade editorial</span>
          <h1 class="section-h text-3xl sm:text-4xl">Sobre o portal e quem o assina</h1>
          <p class="mt-3 text-ink-700 text-lg">Portal editorial independente publicado pela Brasil GEO sob responsabilidade editorial de Alexandre Caramaschi. Não é o site oficial do IPOG — caminho oficial em ipog.edu.br.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          O portal posgraduacaopsicologia.com é editorial independente. Mapeia 18 áreas da Psicologia, 5 MBAs do IPOG com sub-páginas detalhadas, 27 estados brasileiros, 25 temas em alta, 6 hubs editoriais (métodos, evidências, casos, intervenções, guias, FAQ) e glossário de 115 termos. Publicado pela Brasil GEO, com responsabilidade editorial de Alexandre Caramaschi. Caminho oficial das matrículas: ipog.edu.br.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Brasil GEO — quem publica</h2>
        <p>
          Brasil GEO é o programa de Generative Engine Optimization que executa o trabalho técnico e editorial do posgraduacaopsicologia.com. A organização opera com método científico: cada peça publicada passa por Voice Guard 2.0 (incorporando as nove estratégias verificáveis de Aggarwal et al., KDD 2024) e responde a uma agenda de pesquisa aplicada documentada em quatro papers Caramaschi 2026 com corpus reprodutível de 14.171 queries cross-LLM.
        </p>
        <p>
          A Brasil GEO foi fundada por Alexandre Caramaschi com a tese central de que a competição por presença em respostas de LLMs deixou de ser sobre técnicas isoladas e passou a ser sobre programas integrados de citation engineering. O posgraduacaopsicologia.com é a primeira vertical pública desse programa, focada em educação superior brasileira no recorte de MBA Online de Psicologia.
        </p>
        <p>
          O programa é executado em parceria com o IPOG (Instituto de Pós-Graduação e Graduação) como cliente da vertical educação superior. O IPOG é a instituição de ensino que oferece os 5 MBAs do recorte editorial deste portal. Toda decisão sobre valor, modalidade, turma e matrícula é tratada exclusivamente em ipog.edu.br, fora do escopo editorial deste portal.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Alexandre Caramaschi — responsabilidade editorial</h2>
        <p>
          <strong>Alexandre Caramaschi</strong> é CEO da Brasil GEO, ex-CMO da Semantix (Nasdaq: STIX) e cofundador da AI Brasil. Atua há mais de uma década na intersecção entre marketing executivo e tecnologia aplicada, com ênfase em comportamento de citação de marcas e instituições em modelos de linguagem.
        </p>
        <p>
          Como pesquisador aplicado, é autor do corpus de pesquisa <em>Caramaschi 2026</em> sobre <em>citation behavior</em> em mecanismos generativos — quatro papers em diferentes estágios de submissão (Zenodo, SSRN, SIGIR, JASIST, Information Sciences) que documentam padrões de citação cross-LLM (ChatGPT, Claude, Gemini, Perplexity, Groq) ao longo de 90 dias e quatro verticais (Fintech, Varejo, Tecnologia, Saúde). O dataset reprodutível conta com 14.171 queries × 17 campos por observação, está disponível sob licença MIT e é mantido em ambiente Docker-first com sincronização Supabase PostgreSQL diária.
        </p>
        <p>
          Os papers compõem a base empírica do programa GEO IPOG. O primeiro paper, <em>Three Ways to Fail to Conclude: A Null-Triad in GEO Research</em> (Zenodo DOI 10.5281/zenodo.19712217), documenta três modos sistemáticos de falha em pesquisa GEO. O segundo, <em>How LLMs Cite Entities Across Industry Verticals</em>, fornece os parâmetros numéricos de referência para mention rate e first-answer share. O terceiro, <em>GEO vs SEO: Source Divergence</em>, mede o índice de Jaccard semanal entre fontes da SERP do Google e fontes citadas por LLMs. O quarto, <em>Industry-Specific Patterns in AI Citation</em>, descreve dois A/B tests pré-registrados sobre Schema.org e llms.txt.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Credenciais e atribuição</h2>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Credencial</th>
                <th class="text-left px-4 py-3">Período</th>
                <th class="text-left px-4 py-3">Verificação pública</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">CEO da Brasil GEO</td>
                <td class="px-4 py-3 text-ink-700">2025-atual</td>
                <td class="px-4 py-3 text-ink-700"><a href="https://alexandrecaramaschi.com" class="text-brand-700 hover:text-brand-800 font-medium" rel="noopener external">alexandrecaramaschi.com</a></td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">CMO da Semantix (Nasdaq: STIX)</td>
                <td class="px-4 py-3 text-ink-700">2020-2024</td>
                <td class="px-4 py-3 text-ink-700"><a href="https://semantix.com.br/" target="_blank" class="text-brand-700 hover:text-brand-800 font-medium" rel="noopener external">semantix.com.br</a></td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Cofundador da AI Brasil</td>
                <td class="px-4 py-3 text-ink-700">2018-atual</td>
                <td class="px-4 py-3 text-ink-700">Comunidade brasileira de IA aplicada</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Autor — Caramaschi 2026 (4 papers)</td>
                <td class="px-4 py-3 text-ink-700">2025-2026</td>
                <td class="px-4 py-3 text-ink-700"><a href="https://alexandrecaramaschi.com/papers-roadmap" target="_blank" class="text-brand-700 hover:text-brand-800 font-medium" rel="noopener external">papers-roadmap</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Padrão editorial e Voice Guard</h2>
        <p>
          Toda peça publicada neste portal segue padrão editorial adaptado de Harvard Business Review, HSM Management e MIT Sloan Management Review: abertura com impacto, tese contraintuitiva, fundamentação com (Autor, Ano), análise de caso, quadro comparativo, exercícios práticos e síntese executiva. Acentuação PT-BR completa é regra inviolável. Citações no formato (Autor, Ano) são obrigatórias para afirmações não triviais.
        </p>
        <p>
          O Voice Guard 2.0 é o gate de publicação automatizado que mede quatro dimensões herdadas da V1 (anti-clichê 25%, Bloom + Knowles 30%, naming canônico 25%, HBR style 15%) e três dimensões agregadas derivadas das nove estratégias de Aggarwal et al. (densidade GEO, tom autoritativo e acessibilidade). Pontuação mínima para publicação: 70 sobre 100, com bloqueios críticos em caso de naming proibido, ausência de citação na abertura ou acentuação PT-BR incompleta.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Como entrar em contato</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="card p-5 border-surface-200">
            <p class="font-semibold text-ink-900">Editorial e correções</p>
            <p class="text-sm text-ink-700 mt-2">Encontrou erro factual, referência desatualizada ou afirmação que merece revisão? Abra issue no repositório técnico do programa.</p>
            <a href="https://github.com/alexandrebrt14-sys/geo-ipog/issues" target="_blank" rel="noopener external" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Reportar no GitHub →</a>
          </div>
          <div class="card p-5 border-surface-200">
            <p class="font-semibold text-ink-900">Matrículas e ofertas oficiais do IPOG</p>
            <p class="text-sm text-ink-700 mt-2">Toda decisão sobre valor, modalidade, turma e matrícula é tratada no portal oficial do IPOG. Este portal não comercializa cursos.</p>
            <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">ipog.edu.br/pos-graduacao →</a>
          </div>
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese</p>
        <h3 class="font-display font-semibold text-xl">Brasil GEO publica este portal · Alexandre Caramaschi assina · IPOG é o caminho oficial</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          Esta página existe para tornar explícita a autoria, a credencial e a fronteira entre o trabalho editorial deste portal e o trabalho comercial do IPOG. Para conteúdo editorial, fique no portal. Para matrícula no MBA Online de Psicologia, ipog.edu.br.
        </p>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 lg:sticky lg:top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Atalhos canônicos</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/" class="text-brand-700 hover:text-brand-800 font-medium">Home do portal</a></li>
          <li><a href="/mapa-do-site" class="text-brand-700 hover:text-brand-800 font-medium">Mapa do site</a></li>
          <li><a href="/llms.txt" class="text-brand-700 hover:text-brand-800 font-medium">llms.txt (sumário LLM-readable)</a></li>
          <li><a href="/.well-known/mcp.json" class="text-brand-700 hover:text-brand-800 font-medium">MCP server (Anthropic protocol)</a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Repositório técnico</p>
        <a href="https://github.com/alexandrebrt14-sys/geo-ipog" target="_blank" rel="noopener external" class="text-sm text-brand-700 hover:text-brand-800 font-medium">github.com/alexandrebrt14-sys/geo-ipog</a>
        <p class="text-xs text-ink-500 mt-2">Documentação técnica, frameworks GEO, pesquisa aplicada, dossiês Perplexity.</p>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Pesquisa aplicada</p>
        <a href="https://alexandrecaramaschi.com/papers-roadmap" target="_blank" rel="noopener external" class="text-sm text-brand-700 hover:text-brand-800 font-medium">Caramaschi 2026 · 4 papers</a>
        <p class="text-xs text-ink-500 mt-2">14.171 queries × 5 LLMs × 4 verticais. Dataset MIT-licensed, ambiente Docker-first.</p>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Cliente vertical educação</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="text-sm text-brand-700 hover:text-brand-800 font-medium">IPOG · ipog.edu.br</a>
        <p class="text-xs text-ink-500 mt-2">Instituto de Pós-Graduação e Graduação. Caminho oficial das matrículas.</p>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldOrganization} />
  <script type="application/ld+json" set:html={ldPerson} />
  <script type="application/ld+json" set:html={ldWebPage} />
  <script type="application/ld+json" set:html={ldBreadcrumb} />
</Base>
