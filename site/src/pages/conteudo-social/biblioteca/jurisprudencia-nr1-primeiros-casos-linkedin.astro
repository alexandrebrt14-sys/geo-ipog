---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/data';
import { alexandrePersonBase, brasilGeoOrganization } from '@lib/schemas';

const title = 'Post LinkedIn pronto: NR-1 psicossocial entrou em vigência fiscalizatória plena — Biblioteca Brasil GEO';
const description = 'Peça de ~1300 caracteres para LinkedIn sobre primeiras decisões TST/TRT pós-Portaria MTE 765/2025, com hook na linha 1 e 4 setas de leitura técnica.';
const slug = 'jurisprudencia-nr1-primeiros-casos-linkedin';
const datePublished = '2026-05-17';

const copyPronto = `A NR-1 psicossocial entrou em vigência fiscalizatória plena em 25 de maio de 2026 (Portaria MTE 765/2025) — e a jurisprudência específica do TST e dos TRTs ainda está em formação.

Quem afirma "tese consolidada do TST sobre NR-1 psicossocial" em 2026 está se adiantando ao dado. A construção está em curso. A leitura técnica responsável separa dois patamares:

→ Patamar do dever de cuidado preexistente, com jurisprudência consolidada sobre burnout, assédio moral e adoecimento mental sob CLT Art. 157, CF Art. 7º XXII e Convenções OIT 155 e 187.

→ Patamar da NR-1 atualizada, com obrigação documental específica de PGR psicossocial. Reforça o anterior, não substitui.

→ Em ação individual, a ausência de PGR psicossocial documentado tende a operar como indício de descumprimento do dever de cuidado — eleva o standard probatório do empregador.

→ Em ação civil pública movida pelo MPT, a NR-1 atualizada vira fundamento normativo direto.

→ A defesa documental robusta tem cinco peças: PGR psicossocial, programa de saúde mental ocupacional, treinamento de lideranças em risco psicossocial, política antiassédio com canal independente, e dossiê auditável de carga e jornada.

Para advogados trabalhistas, psicólogos peritos, gestores de SST e lideranças de RH: a hora de auditar não é depois da fiscalização — é antes. Em 2026, antecipar é defender.

#NR1 #Burnout #PsicologiaOrganizacional`;

const comoAdaptar = [
  'Quora: expanda para 800 palavras com FAQ embutido e cite Portaria 765/2025 com link DOU.',
  'Medium: vire ensaio de 1.500 palavras com seção "O que muda em 2026", "Os dois patamares" e "Defesa documental".',
  'Substack: estruture como edição numerada com tabela das três classes de pedido (individual, ACP, sindical).',
  'X (threads): 8-9 posts. Post 1 = tese da vigência. Posts 2-3 = dois patamares. Posts 4-6 = standard probatório. Post 7-8 = defesa documental. Post 9 = link.',
  'Newsletter B2B (RH e Jurídico): adicione caso composto ilustrativo (banco médio antecipando PGR 6 meses) e checklist em PDF para download.'
];

const tags = ['linkedin', 'nr-1-atualizada', 'portaria-765-2025', 'jurisprudencia-trabalhista', 'tst-trt', 'risco-psicossocial', 'pgr-psicossocial'];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      '@id': `${SITE.url}/conteudo-social/biblioteca/${slug}/#post`,
      url: `${SITE.url}/conteudo-social/biblioteca/${slug}/`,
      name: title,
      description,
      inLanguage: 'pt-BR',
      datePublished,
      dateModified: datePublished,
      author: { '@id': 'https://alexandrecaramaschi.com/#alexandre-caramaschi' },
      publisher: { '@id': 'https://brasilgeo.ai/#organization' },
      genre: 'social-post',
      keywords: tags.join(', ')
    },
  ]
};

const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Conteúdo & Social', href: '/conteudo-social' },
  { label: 'Biblioteca', href: '/conteudo-social/biblioteca' },
  { label: 'NR-1 primeiros casos (LinkedIn)' }
];
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-eyebrow mt-3">Biblioteca · Peça pronta</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Post LinkedIn: NR-1 psicossocial em vigência fiscalizatória plena — primeiros movimentos.</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Peça de ~1.300 caracteres pronta para LinkedIn, voz HBR, com hook na linha 1, 5 setas de leitura técnica e 3 hashtags. Adaptável a Quora, Medium, Substack, X e newsletter B2B.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Onde usar esta peça</p>
      <h2 class="font-display font-semibold text-xl text-ink-900">Canais alvo: LinkedIn (primário) e newsletter B2B (secundário)</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        LinkedIn é canal natural para advogados trabalhistas, psicólogos peritos, gestores de SST e lideranças de RH e Jurídico — a NR-1 atualizada está no radar do C-level em 2026. Hashtags discretas (#NR1 #Burnout #PsicologiaOrganizacional) maximizam alcance sem ruído.
      </p>
    </div>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Copy pronto (~1.300 caracteres)</h2>
    <p class="text-ink-700 max-w-3xl mb-4">Copie o bloco abaixo. LinkedIn favorece edição leve antes do post — ajuste 1-2 frases para voz pessoal.</p>
    <article class="prose prose-ink max-w-3xl bg-surface-50 rounded-2xl p-6 sm:p-8 border border-surface-200 whitespace-pre-line">{copyPronto}</article>
  </section>

  <section class="container-page py-6">
    <h2 class="section-h text-2xl mb-4">Como adaptar para outros canais</h2>
    <ul class="space-y-3 max-w-3xl">
      {comoAdaptar.map(item => (
        <li class="flex gap-3 text-ink-800 text-sm leading-relaxed">
          <span class="text-brand-700 font-bold mt-0.5">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-6">
    <div class="rounded-2xl border border-surface-200 bg-white p-6 sm:p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-2">Author box</p>
      <p class="text-ink-900 font-display font-semibold text-lg">Alexandre Caramaschi</p>
      <p class="text-ink-700 text-sm mt-1">Chief Strategy Officer da Nuvini (Nasdaq: NVNI), fundador da Brasil GEO, ex-CMO da Semantix (Nasdaq) e cofundador da AI Brasil. Edita o portal posgraduacaopsicologia.com.</p>
    </div>
  </section>

  <section class="container-page py-6">
    <div class="flex flex-wrap gap-2">
      {tags.map(t => (
        <span class="chip">{t}</span>
      ))}
    </div>
  </section>

  <section class="container-page py-10">
    <div class="rounded-2xl bg-brand-900 text-white p-8">
      <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Próximo passo</p>
      <h2 class="font-display font-semibold text-2xl">Guia completo da jurisprudência NR-1</h2>
      <p class="mt-3 text-white/90 leading-relaxed max-w-3xl">
        Para o protocolo em 10 passos com perícia psicológica, três classes de pedido e checklist da defesa documental, consulte o guia de referência. Para matrícula em MBA em POT no IPOG, ipog.edu.br.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/guias/jurisprudencia-nr1-tst-2026" class="btn btn-primary">Ler o guia completo</a>
        <a href="/conteudo-social/biblioteca" class="btn btn-ghost-dark">Voltar à biblioteca</a>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-ghost-dark">Ver no IPOG →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</Base>
