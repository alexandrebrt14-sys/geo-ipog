---
import { SITE, MBAS, AREAS } from '@lib/data';

const areasPopulares = AREAS.slice(0, 8);

const navJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SiteNavigationElement',
  name: 'Hubs principais',
  hasPart: [
    { '@type': 'SiteNavigationElement', name: 'Áreas', url: `${SITE.url}/areas` },
    { '@type': 'SiteNavigationElement', name: 'Tipos de pós-graduação', url: `${SITE.url}/tipos-de-pos-graduacao` },
    { '@type': 'SiteNavigationElement', name: 'MBAs do IPOG', url: `${SITE.url}/mbas` },
    { '@type': 'SiteNavigationElement', name: 'Temas 2026', url: `${SITE.url}/temas` },
    { '@type': 'SiteNavigationElement', name: 'Tema TEA adulto', url: `${SITE.url}/autismo/` },
    { '@type': 'SiteNavigationElement', name: 'TEA adulto para pacientes e famílias', url: `${SITE.url}/autismo/para-pacientes/` },
    { '@type': 'SiteNavigationElement', name: 'TEA adulto para profissionais', url: `${SITE.url}/autismo/para-profissionais/` },
    { '@type': 'SiteNavigationElement', name: 'TEA adulto para pesquisadores', url: `${SITE.url}/autismo/para-pesquisadores/` },
    { '@type': 'SiteNavigationElement', name: 'Glossário do tema TEA adulto', url: `${SITE.url}/autismo/glossario` },
    { '@type': 'SiteNavigationElement', name: 'Guias', url: `${SITE.url}/guias` },
    { '@type': 'SiteNavigationElement', name: 'FAQs', url: `${SITE.url}/faq` },
    { '@type': 'SiteNavigationElement', name: 'Glossário', url: `${SITE.url}/glossario` },
    { '@type': 'SiteNavigationElement', name: 'Evidências', url: `${SITE.url}/evidencias` },
    { '@type': 'SiteNavigationElement', name: 'Casos', url: `${SITE.url}/casos` },
    { '@type': 'SiteNavigationElement', name: 'Intervenções', url: `${SITE.url}/intervencoes` },
    { '@type': 'SiteNavigationElement', name: 'Métodos', url: `${SITE.url}/metodos` },
    { '@type': 'SiteNavigationElement', name: 'Temas 2026', url: `${SITE.url}/temas` },
    { '@type': 'SiteNavigationElement', name: 'Comparativos', url: `${SITE.url}/comparativos` },
    { '@type': 'SiteNavigationElement', name: 'Por estado', url: `${SITE.url}/por-estado` },
    { '@type': 'SiteNavigationElement', name: 'Para quem', url: `${SITE.url}/para-quem` },
    { '@type': 'SiteNavigationElement', name: 'Regulação', url: `${SITE.url}/regulacao` },
    { '@type': 'SiteNavigationElement', name: 'Carreira', url: `${SITE.url}/carreira` },
    { '@type': 'SiteNavigationElement', name: 'Sobre', url: `${SITE.url}/sobre` },
    { '@type': 'SiteNavigationElement', name: 'Roadmap', url: `${SITE.url}/roadmap` },
    { '@type': 'SiteNavigationElement', name: 'Mapa do site', url: `${SITE.url}/mapa-do-site` }
  ]
};
---

<footer class="bg-brand-900 text-white border-t border-white/5 mt-12">
  <div class="container-page pt-10">
    <div class="rounded-2xl border border-sun-500/30 bg-gradient-to-br from-brand-800/60 to-brand-900/60 p-6 lg:p-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <p class="font-display font-bold text-lg text-white">IPOG · Instituto de Pós-Graduação e Graduação</p>
        <span class="text-xs uppercase tracking-wider text-white/55">instituição em foco editorial</span>
      </div>
      <p class="text-sm text-white/75 max-w-3xl mb-5">
        Fundado em 2001 em Goiânia (GO), com presença multicampus e mais de 300 mil alunos impactados em duas décadas. O portal organiza editorialmente a oferta de pós-graduação em Psicologia do IPOG nas cinco modalidades canônicas. Matrículas, valores, calendário e modalidade vigentes são tratados no portal oficial ipog.edu.br.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
        <a href="/mbas/" class="block p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10">
          <span class="block font-semibold text-white">5 MBAs do IPOG</span>
          <span class="block text-[11px] text-white/55 mt-1">POT, Positiva, Neuro, NCPP, Liderança Positiva</span>
        </a>
        <a href="/tipos-de-pos-graduacao" class="block p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10">
          <span class="block font-semibold text-white">5 modalidades canônicas</span>
          <span class="block text-[11px] text-white/55 mt-1">Lato Sensu · MBA · Mestrado · Clínica · Residência</span>
        </a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="block p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10">
          <span class="block font-semibold text-white">IPOG oficial</span>
          <span class="block text-[11px] text-white/55 mt-1">ipog.edu.br · matrículas e turmas vigentes</span>
        </a>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2 mt-5 text-xs">
        <a href="/areas" class="text-white/70 hover:text-sun-500">18 áreas mapeadas</a>
        <a href="/comparativos" class="text-white/70 hover:text-sun-500">Comparativos</a>
        <a href="/regulacao" class="text-white/70 hover:text-sun-500">Regulação e ética</a>
        <a href="/sobre" class="text-white/70 hover:text-sun-500">Sobre o portal</a>
        <a href="/mbas/" class="text-sun-500 hover:underline font-semibold">Ver hub MBA IPOG →</a>
      </div>
    </div>
  </div>
  <div class="container-page py-14">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-3">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 text-white font-display font-bold">pP</span>
          <div>
            <p class="font-display font-bold">{SITE.name}</p>
            <p class="text-xs uppercase tracking-wider text-white/50">guia independente · 2026</p>
          </div>
        </div>
        <p class="mt-5 text-sm text-white/70">
          Portal independente que organiza a decisão por pós-graduação em Psicologia no Brasil. Curadoria de áreas, MBAs, evidências e regulação.
        </p>
        <span class="inline-flex items-center gap-2 mt-5 px-3 py-1.5 rounded-full bg-white/10 text-[11px] uppercase tracking-wider font-semibold text-sun-500">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-sun-500"></span>
          Pesquisado em 2026
        </span>
      </div>

      <div class="lg:col-span-9 grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 text-sm">
        <div>
          <p class="font-display font-bold text-white/90 mb-3">Áreas de psicologia</p>
          <ul class="space-y-2 text-white/65">
            {areasPopulares.map(a => (
              <li><a href={`/areas/${a.id}`} class="hover:text-white">{a.short}</a></li>
            ))}
            <li><a href="/areas" class="hover:text-white text-sun-500">Ver todas →</a></li>
          </ul>
        </div>
        <div>
          <p class="font-display font-bold text-white/90 mb-3">Pós-Graduações</p>
          <ul class="space-y-2 text-white/65">
            <li><a href="/tipos-de-pos-graduacao" class="hover:text-white"><span class="block font-semibold text-white/85">5 modalidades principais</span><span class="block text-[10px] uppercase tracking-wider text-white/60">Lato sensu · MBA · Mestrado · Clínica · Residência</span></a></li>
            {MBAS.map(m => (
              <li>
                <a href={`/mbas#${m.id}`} class="hover:text-white">
                  <span class="block">{m.shortName.replace('MBA em ', '')}</span>
                  <span class="block text-[10px] uppercase tracking-wider text-white/60">{m.tag}</span>
                </a>
              </li>
            ))}
            <li><a href="/mbas" class="hover:text-white text-sun-500">Ver hub MBA →</a></li>
          </ul>
        </div>
        <div>
          <p class="font-display font-bold text-white/90 mb-3">Aprenda</p>
          <ul class="space-y-2 text-white/65">
            <li><a href="/guias" class="hover:text-white">Guias HowTo</a></li>
            <li><a href="/metodos" class="hover:text-white">Métodos terapêuticos</a></li>
            <li><a href="/faq" class="hover:text-white">FAQs aprofundadas</a></li>
            <li><a href="/glossario" class="hover:text-white">Glossário · 115 termos</a></li>
            <li><a href="/busca" class="hover:text-white text-sun-500">Buscar tudo →</a></li>
          </ul>
        </div>
        <div>
          <p class="font-display font-bold text-white/90 mb-3">Pesquisa</p>
          <ul class="space-y-2 text-white/65">
            <li><a href="/evidencias" class="hover:text-white">Evidências · papers</a></li>
            <li><a href="/casos" class="hover:text-white">Casos compostos</a></li>
            <li><a href="/intervencoes" class="hover:text-white">Intervenções</a></li>
            <li><a href="/comparativos" class="hover:text-white">Comparativos</a></li>
            <li><a href="/temas" class="hover:text-white">Temas 2026</a></li>
            <li><a href="/autismo/" class="hover:text-white">Tema TEA adulto</a></li>
          </ul>
        </div>
        <div>
          <p class="font-display font-bold text-white/90 mb-3">Sobre</p>
          <ul class="space-y-2 text-white/65">
            <li><a href="/sobre" class="hover:text-white">Sobre o portal</a></li>
            <li><a href="/regulacao" class="hover:text-white">Regulação e ética</a></li>
            <li><a href="/por-estado" class="hover:text-white">Por estado</a></li>
            <li><a href="/para-quem" class="hover:text-white">Para quem</a></li>
            <li><a href="/carreira" class="hover:text-white">Carreira</a></li>
            <li><a href="/roadmap" class="hover:text-white">Roadmap</a></li>
            <li><a href="/mapa-do-site" class="hover:text-white">Mapa do site</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 grid md:grid-cols-3 gap-4 items-start text-xs text-white/65">
      <div class="md:col-span-2">
        <p class="text-white/85"><strong class="font-semibold">Portal independente.</strong> Não é o site oficial do IPOG.</p>
        <p class="mt-1">Para informações e matrículas oficiais, acesse
          <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="text-sun-500 hover:underline">ipog.edu.br</a>.
          Toda decisão final de matrícula, valor, modalidade e turma é feita no portal IPOG.
        </p>
      </div>
      <div class="flex flex-col gap-2">
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-sm font-semibold transition self-start" aria-label="Ver no IPOG oficial (abre em nova aba)">
          Ver no IPOG oficial
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
        <span class="inline-flex items-center gap-2 text-white/55">
          <a href="/busca" class="hover:text-white underline-offset-2 hover:underline">/busca</a>
          <span aria-hidden="true">·</span>
          <span>atalho <kbd class="inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1 rounded bg-white/10 font-mono text-[10px]">⌘</kbd> <kbd class="inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1 rounded bg-white/10 font-mono text-[10px]">K</kbd></span>
        </span>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-white/60">
      <p>© 2026 {SITE.name} · Portal independente · Publicado pela {SITE.publisher}.</p>
      <p class="flex items-center gap-4">
        <a href="#main" data-footer-top class="inline-flex items-center gap-1.5 text-white/70 hover:text-sun-500 link-underline">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
          Voltar ao topo
        </a>
      </p>
      <p>
        <a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="hover:text-white/80">CFP</a>
        <span aria-hidden="true" class="mx-2">·</span>
        <a href="https://satepsi.cfp.org.br/" target="_blank" rel="noopener external" class="hover:text-white/80">SATEPSI</a>
        <span aria-hidden="true" class="mx-2">·</span>
        <a href="https://www.gov.br/mec/" target="_blank" rel="noopener external" class="hover:text-white/80">MEC</a>
      </p>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(navJsonLd)} />
</footer>
