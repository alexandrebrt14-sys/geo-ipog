---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import StudyWorksheet from '@components/StudyWorksheet.astro';
import { SITE } from '@lib/data';

const page = {
  "title": "DBT: componentes, evidência e critérios para escolher formação",
  "description": "Distinga programa abrangente de DBT e treinamento de habilidades. Confira diretrizes, supervisão e estrutura de serviço com uma ficha educativa.",
  "route": "/metodos/dbt/",
  "label": "Terapia Comportamental Dialética",
  "section": "Métodos",
  "sectionPath": "/metodos/",
  "faqs": [
    {
      "q": "Um grupo de habilidades é o mesmo que DBT abrangente?",
      "a": "Não. A oferta precisa descrever componentes e articulação do cuidado. A evidência de um formato não se transfere automaticamente a outro."
    },
    {
      "q": "DBT exige prazo igual para todas as pessoas?",
      "a": "Não é adequado prometer duração ou resultado universal. O serviço deve explicar seu formato e como o plano é acompanhado e revisto."
    },
    {
      "q": "A ficha avalia risco ou indica tratamento?",
      "a": "Não. Ela compara informações de cursos e serviços, sem escala de risco, dados pessoais ou conduta clínica."
    }
  ],
  "worksheet": {
    "title": "Mapa de componentes de uma oferta de DBT",
    "description": "Registre o que o serviço ou curso oferece e o que ainda precisa ser confirmado.",
    "fields": [
      {
        "label": "Formato anunciado",
        "hint": "Programa abrangente, adaptação ou grupo de habilidades?"
      },
      {
        "label": "Componentes disponíveis",
        "hint": "Quais modalidades estão descritas e como se articulam?"
      },
      {
        "label": "Responsabilidades e limites",
        "hint": "Quem coordena e como canais de apoio são explicados?"
      },
      {
        "label": "Formação e supervisão",
        "hint": "Que qualificação e acompanhamento são demonstrados?"
      }
    ],
    "checklist": [
      "Conferi os componentes efetivamente oferecidos.",
      "Distingui treinamento de habilidades e programa abrangente.",
      "Não interpretei apoio como disponibilidade ilimitada.",
      "Registrei dúvidas sem dados de pacientes."
    ]
  },
  "sources": [
    [
      "ABCT: componentes de DBT",
      "https://www.abct.org/fact-sheets/dialectical-behavior-therapy/"
    ],
    [
      "NICE CG78: recomendações para transtorno de personalidade borderline",
      "https://www.nice.org.uk/guidance/cg78/chapter/Recommendations"
    ],
    [
      "American Psychiatric Association: diretriz de 2024",
      "https://www.psychiatry.org/News-room/News-Releases/Updated-Borderline-Personality-Disorder-Guideline"
    ],
    [
      "Behavioral Tech: equipe de consulta",
      "https://behavioraltech.org/consultation-team/"
    ]
  ]
};
const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': SITE.url + page.route + '#article',
  headline: page.title,
  description: page.description,
  mainEntityOfPage: SITE.url + page.route,
  author: { '@id': 'https://brasilgeo.ai/#organization' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  inLanguage: 'pt-BR',
  citation: page.sources.map(([name, url]) => ({ '@type': 'CreativeWork', name, url }))
};
const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(({q, a}) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<Base title={page.title} description={page.description} pageType="article">
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{label:'Início',href:'/'},{label:page.section,href:page.sectionPath},{label:page.label}]} />
    </div>
  </section>
  <div class="container-page py-12">
    <article class="editorial mx-auto max-w-4xl">
      <header>
        <p class="eyebrow">Formação e prática responsável</p>
        <h1>{page.title}</h1>
        <p class="lead">Caso hipotético: uma clínica anuncia “DBT completa”, mas descreve apenas um grupo de habilidades. Quem busca formação ou atendimento precisa compreender quais componentes estão disponíveis, como se articulam e quem responde pelo cuidado.</p>
        <p class="update">Atualização editorial: 06/10/2026 · Brasil GEO. Conteúdo educativo para leitura crítica e escolha de formação.</p>
      </header>
      <section><h2>A oferta de DBT deve explicar seus componentes e suas responsabilidades.</h2>
<p>A Terapia Comportamental Dialética articula estratégias de aceitação e mudança em um trabalho estruturado. O modelo desenvolvido por Marsha Linehan inclui atenção à regulação emocional e às relações, com avaliação das necessidades da pessoa. O nome da abordagem não dispensa compreensão individual nem garante um resultado.</p>
<p>A <a href="https://www.abct.org/fact-sheets/dialectical-behavior-therapy/">apresentação da ABCT sobre DBT</a> distingue um programa abrangente, com terapia individual, treinamento de habilidades, apoio à aplicação no cotidiano e equipe de consulta. Uma atividade inspirada em habilidades de DBT precisa ser descrita pelo que efetivamente oferece; não deve herdar automaticamente a evidência do programa completo.</p></section>
<section><h2>O que as diretrizes dizem</h2>
<p>A <a href="https://www.nice.org.uk/guidance/cg78/chapter/Recommendations">NICE CG78</a> considera programa abrangente de DBT para mulheres com transtorno de personalidade borderline quando reduzir autoagressão recorrente é prioridade. Essa formulação específica não declara DBT tratamento superior para todas as pessoas ou para todos os desfechos.</p>
<p>A <a href="https://www.psychiatry.org/News-room/News-Releases/Updated-Borderline-Personality-Disorder-Guideline">diretriz de 2024 da American Psychiatric Association</a> recomenda psicoterapia estruturada sustentada pela literatura para esse transtorno e planejamento centrado na pessoa. Não é justificativa para apresentar uma única abordagem como solução universal ou tratar o diagnóstico como sentença de incapacidade.</p>
<p>Para avaliar estudos de adaptações, confira faixa etária, contexto, componentes e comparação. Um resultado em adolescentes não se transfere automaticamente a adultos, e uma pesquisa sobre habilidades não equivale a testar todas as modalidades do programa. O critério é correspondência entre a evidência e a afirmação.</p></section>
<section><h2>Componentes e perguntas ao serviço</h2>
<div class="table-wrap"><table><thead><tr><th>Dimensão</th><th>O que esclarecer</th></tr></thead><tbody>
<tr><td>Cuidado individual</td><td>Quem é responsável por integrar necessidades e acompanhar o plano?</td></tr>
<tr><td>Habilidades</td><td>Qual formato é oferecido e como dialoga com o cuidado individual?</td></tr>
<tr><td>Apoio entre encontros</td><td>Quais canais, horários, limites e alternativas estão combinados?</td></tr>
<tr><td>Equipe de consulta</td><td>Como profissionais recebem apoio e examinam a prática?</td></tr>
</tbody></table></div>
<p>O <a href="https://behavioraltech.org/consultation-team/">Behavioral Tech Institute</a> apresenta a equipe de consulta como parte central do modelo abrangente. Esse espaço tem finalidade própria e não deve ser confundido com reunião administrativa. Para a formação, vale perguntar como o aluno aprenderá a participar desse trabalho coletivo.</p>
<p>A descrição de apoio entre encontros não equivale a promessa de disponibilidade ilimitada nem substitui serviço de emergência. Os limites precisam ser claros antes do início do atendimento. Uma página educativa não deve fornecer algoritmo de avaliação de risco ou técnicas para substituir cuidado em crise.</p></section>
<section><h2>Como avaliar uma formação</h2>
<p>Peça ementa, requisitos de ingresso e forma de avaliação. Procure atividades que exijam raciocínio, comunicação, discussão de prioridades e revisão de decisões com supervisão. Aulas sobre siglas de habilidades podem ser uma introdução, mas não demonstram preparo para organizar um serviço complexo.</p>
<p>Confira separadamente certificado de participação, treinamento aprofundado e certificação privada de competência. Solicite à entidade emissora seus critérios atuais. Nenhuma dessas denominações substitui habilitação profissional ou comprova experiência em todas as populações.</p>
<p>No caso hipotético inicial, a clínica deve esclarecer se oferece um grupo, um programa adaptado ou o modelo abrangente e quais limitações isso implica. A decisão pode ser buscar informação adicional antes de contratar. Evite escolher apenas pelo rótulo ou por relatos de recuperação apresentados como garantia.</p></section>
<section><h2>Organize a comparação</h2>
<p>Leia também os critérios de <a href="/guias/escolher-supervisor-clinico/">supervisão clínica</a> e a discussão sobre <a href="/evidencias/terapias-terceira-onda/">evidências das terapias de terceira onda</a>. Use essas páginas para formular perguntas sobre competência e população, sem montar um protocolo terapêutico público.</p>
<p>O curso <a href="https://alexandrecaramaschi.com/educacao/segundo-cerebro-agentes-pessoais">Segundo cérebro e agentes pessoais</a>, do portal de Alexandre Caramaschi, pode apoiar a organização de manuais, diretrizes e notas bibliográficas públicas. Mantenha registros clínicos fora desse acervo. Na ficha, documente apenas características de formação e serviço.</p></section>
      <StudyWorksheet id="ficha-pratica" title={page.worksheet.title} description={page.worksheet.description} fields={page.worksheet.fields} checklist={page.worksheet.checklist} />
      <section aria-labelledby="perguntas-frequentes">
        <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
        <div class="faq-list">
          {page.faqs.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </section>
      <section class="source-box" aria-labelledby="fontes-consultadas">
        <h2 id="fontes-consultadas">Fontes primárias consultadas</h2>
        <p>Consulte a população, a finalidade e os limites de cada documento. Leitura complementar não equivale a formação clínica ou habilitação profissional.</p>
        <ul>{page.sources.map(([name,url]) => <li><a href={url}>{name}</a></li>)}</ul>
      </section>
    </article>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
<style>
  .editorial { color: var(--color-text-subtle); line-height: 1.8; }
  .editorial header { margin-bottom: 2.75rem; }
  .editorial h1 { color: var(--color-text-strong); font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.15; font-weight: 700; letter-spacing: -.025em; }
  .editorial h2 { color: var(--color-text-strong); font-size: clamp(1.35rem, 3vw, 1.7rem); line-height: 1.35; font-weight: 650; margin-bottom: 1rem; }
  .editorial > section { margin-block: 2.5rem; }
  .editorial p { margin-block: 1rem; text-align: justify; overflow-wrap: anywhere; }
  .editorial .lead { font-size: 1.15rem; }
  .editorial .eyebrow { color: var(--color-primary-ring); font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .editorial .update { font-size: .85rem; color: var(--color-text-muted); border-left: 3px solid var(--color-primary-ring); padding-left: 1rem; text-align: left; }
  .editorial a { color: var(--color-primary-ring); text-decoration: underline; text-underline-offset: .2em; }
  .editorial a:hover { color: var(--color-primary-hover); }
  .editorial ul, .editorial ol { padding-left: 1.4rem; margin-block: 1rem; }
  .editorial ul { list-style: disc; }
  .editorial ol { list-style: decimal; }
  .editorial li { margin-block: .6rem; }
  .table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: .75rem; margin-block: 1.5rem; }
  .editorial table { border-collapse: collapse; width: 100%; min-width: 35rem; font-size: .95rem; }
  .editorial th, .editorial td { text-align: left; vertical-align: top; padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .editorial th { background: var(--color-primary-soft); color: var(--color-text-strong); font-weight: 650; }
  .editorial tbody tr:last-child td { border-bottom: 0; }
  .faq-list details { border-bottom: 1px solid var(--color-border); padding-block: 1rem; }
  .faq-list summary { cursor: pointer; color: var(--color-text-strong); font-weight: 650; }
  .source-box { border-top: 1px solid var(--color-border); padding-top: 2rem; font-size: .95rem; }
  :global([data-theme="dark"]) .editorial { color: var(--d-ink-700); }
  :global([data-theme="dark"]) .editorial h1,
  :global([data-theme="dark"]) .editorial h2,
  :global([data-theme="dark"]) .faq-list summary { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .eyebrow,
  :global([data-theme="dark"]) .editorial a { color: var(--d-brand-text); }
  :global([data-theme="dark"]) .editorial a:hover { color: var(--d-ink-900); }
  :global([data-theme="dark"]) .editorial .update { color: var(--d-ink-500); border-color: var(--d-brand-text); }
  :global([data-theme="dark"]) .table-wrap,
  :global([data-theme="dark"]) .editorial th,
  :global([data-theme="dark"]) .editorial td,
  :global([data-theme="dark"]) .faq-list details,
  :global([data-theme="dark"]) .source-box { border-color: var(--d-border); }
  :global([data-theme="dark"]) .editorial th { background: var(--d-accent-bg); color: var(--d-ink-900); }
</style>
