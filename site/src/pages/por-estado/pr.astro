---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS, ESTADOS } from '@lib/data';

const uf = 'PR';
const estado = ESTADOS.find(e => e.uf === uf)!;

const faqs = [
  {
    q: 'Por que Curitiba e Maringá teriam melhor recepção a saúde mental corporativa que SP?',
    a: 'A composição econômica e cultural do Paraná entrega um terreno específico. Empresas familiares de grande porte com governança formal, ecossistema cooperativista forte e cultura de cuidado ampliada no eixo Curitiba-Maringá geram demanda por programa de saúde mental corporativa estruturado. Em SP a saturação de oferta de wellness comoditizou a categoria; no PR, o produto técnico — com diagnóstico, ciência e plano de longo prazo — encontra empresa disposta a pagar por densidade. O profissional com pós aplicada em Psicologia Positiva ou saúde mental nas organizações encontra menos concorrência relativa e ciclo de venda mais curto.'
  },
  {
    q: 'Faixa salarial de Psicólogo Organizacional no PR é competitiva?',
    a: 'É. Catho e Glassdoor (2025) reportam Psicólogo Organizacional pleno em Curitiba entre R$ 5.800 e R$ 9.800. Sênior em diagnóstico de cultura ou saúde mental corporativa em grande empresa atinge R$ 12.000 a R$ 17.000. Em Maringá e Londrina, mediana pleno entre R$ 4.800 e R$ 8.000, com ticket de consultoria entre R$ 250 e R$ 600 a hora técnica. Custo de vida em Curitiba é cerca de 25% inferior ao da capital paulista, o que devolve poder de compra superior à mediana nacional.'
  },
  {
    q: 'Vale a pena profissional de Curitiba investir em pós online ao vivo?',
    a: 'Vale, especialmente pelo perfil do mercado local. Curitiba tem oferta presencial razoável, mas a maioria dos cursos opera com docentes locais e grade replicada de modelos antigos. O formato Ao Vivo síncrono dá acesso a docente nominal com circulação nacional, discussão de caso real com colegas de outros estados e ritmo executivo compatível com a agenda paranaense. EAD gravado perde a discussão; presencial estrito perde diversidade de docentes. Ao Vivo síncrono equilibra os dois.'
  },
  {
    q: 'Profissional do interior paranaense — Cascavel, Foz, Ponta Grossa — encontra mercado para pós aplicada?',
    a: 'Encontra, especialmente em agro, cooperativismo, energia e tech logístico. As cooperativas de grande porte do Oeste e Sudoeste paranaense — algumas com mais de 10 mil colaboradores — operam com estrutura de gestão de pessoas profissionalizada e contratam regularmente profissional com pós aplicada. Em Foz do Iguaçu, Itaipu mantém demanda em SST e POT. Cascavel é polo de agro e tech logístico. O formato Ao Vivo síncrono é, para esses profissionais, a única forma viável de pós aplicada de alta densidade sem mudar de cidade.'
  }
];

const ldArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Pós-graduação em Psicologia no Paraná: Curitiba, Maringá, saúde mental corporativa e cooperativismo',
  description: 'Mercado paranaense de Psicologia: Curitiba, Maringá, Londrina, Cascavel e Foz do Iguaçu. Saúde mental corporativa, cooperativismo, agro e tech como bases de demanda.',
  author: { '@type': 'Organization', name: SITE.publisher },
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
  inLanguage: 'pt-BR',
  about: { '@type': 'Place', name: 'Paraná', addressRegion: 'PR' }
};

const ldFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<Base
  title="Pós-graduação em Psicologia no Paraná (PR): saúde mental corporativa e cooperativismo"
  description="Mercado paranaense de Psicologia: Curitiba, Maringá, Londrina, Cascavel e Foz do Iguaçu. Saúde mental corporativa, cooperativismo, agro e tech como bases de demanda.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Por estado', href: '/por-estado' },
        { label: 'Paraná' }
      ]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl flex items-end gap-4">
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-brand-50 text-brand-700 text-xl font-display font-bold shrink-0">PR</span>
          <div>
            <span class="section-eyebrow">Região Sul · CRP-08</span>
            <h1 class="section-h text-3xl sm:text-4xl">Pós-graduação em Psicologia no Paraná (PR).</h1>
            <p class="mt-2 text-ink-700 text-lg">Saúde mental corporativa, cooperativismo e tech ganham espaço no eixo Curitiba-Maringá.</p>
          </div>
        </div>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver turmas para PR no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-10 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-800 mb-2">Resposta rápida</p>
        <p class="text-ink-900 leading-relaxed">
          Paraná tem mercado robusto de Psicologia aplicada, com tração diferenciada em saúde mental corporativa, cooperativismo, agro e tech logístico. Curitiba é hub corporativo regional; Maringá e Londrina concentram empresas familiares de grande porte com governança formal; Cascavel e Foz são polos do interior. O CRP-08 registra mais de 30 mil psicólogos ativos. O formato Ao Vivo síncrono é a equação que melhor atende o profissional paranaense — capital ou interior.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">A tese contraintuitiva sobre o Paraná</h2>
        <p>
          A leitura comum subestima o Paraná como mercado de Psicologia aplicada, tratando-o como sombra de São Paulo. Os dados desmentem. O Sistema OCEPAR (Organização das Cooperativas do Paraná, 2024) reportou que as 65 cooperativas agropecuárias do estado, juntas, empregavam mais de 100 mil pessoas em 2024, e que 78% delas tinham programa estruturado de saúde mental e gestão de pessoas profissionalizada. Esse ecossistema cooperativista cria uma demanda específica por Psicologia Organizacional aplicada que não existe na mesma densidade em outros estados.
        </p>
        <p>
          A segunda leitura equivocada confunde Curitiba com o estado inteiro. Não é. O eixo Curitiba-Maringá-Londrina concentra a maior parte da demanda corporativa formal, mas o interior — especialmente Cascavel, Foz do Iguaçu e Ponta Grossa — tem demanda específica e relevante. Foz do Iguaçu, com Itaipu e o ecossistema da Tríplice Fronteira, mantém demanda em SST, POT, segurança e saúde mental em operação. Cascavel é capital do Oeste com agro, tech logístico e cooperativismo. Ponta Grossa é polo industrial dos Campos Gerais.
        </p>
        <p>
          A terceira leitura equivocada é tratar saúde mental corporativa como tendência genérica. No PR ela ganha tração específica porque empresas familiares de grande porte com forte cultura local — alimentos, transportes, indústria de proteína animal, cooperativas — entendem cuidado como parte da identidade. O produto técnico, com diagnóstico e plano de longo prazo, encontra empresa disposta a pagar.
        </p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">O mercado de Psicologia no Paraná</h2>
        <p>
          A Região Metropolitana de Curitiba concentra aproximadamente 45% das vagas formais em Psicologia no estado, segundo dados do CAGED 2024-2025. Os setores com maior densidade são: automotivo (cinturão de São José dos Pinhais e Pinhais), tech (Curitiba como hub regional de software e fintech), energia (Copel e ecossistema de geração distribuída), saúde privada e financeiro regional.
        </p>
        <p>
          Maringá e Londrina, no Norte paranaense, concentram outros 25% das vagas. Maringá tem perfil corporativo com empresas familiares de grande porte em alimentos, vestuário e cosméticos. Londrina é polo de saúde, universitário e agro de média escala. Cascavel é capital do Oeste, com agro, tech logístico, cooperativismo e saúde. Foz do Iguaçu combina Itaipu, turismo e logística da Tríplice Fronteira. Ponta Grossa é industrial nos Campos Gerais.
        </p>
        <p>
          A mediana salarial de Psicólogo Organizacional pleno no PR, segundo Catho e Glassdoor (2025), fica entre R$ 5.800 e R$ 9.800 em Curitiba; R$ 4.800 a R$ 8.000 em Maringá e Londrina; R$ 4.200 a R$ 7.500 no interior. Sênior em diagnóstico de cultura ou saúde mental corporativa em grande cooperativa atinge R$ 12.000 a R$ 17.000. Em programa específico de saúde mental corporativa, o profissional com pós aplicada e portfólio cobra entre R$ 280 e R$ 750 a hora técnica como consultor.
        </p>
        <p>
          O CRP-08, que jurisdiciona o PR, tem agenda forte em Psicologia Organizacional, saúde mental no trabalho, Psicologia escolar e neuropsicologia. As áreas em maior crescimento de inscrição em pós no estado são, em ordem: saúde mental nas organizações, POT, Psicologia Positiva e neuropsicologia clínica.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Cidades-hub, demanda dominante e modalidade preferida</h2>
        <div class="overflow-x-auto mt-4 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3">Cidade-hub</th>
                <th class="text-left px-4 py-3">Demanda dominante</th>
                <th class="text-left px-4 py-3">Modalidade preferida</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Curitiba</td>
                <td class="px-4 py-3 text-ink-700">Automotivo, tech, energia, financeiro, saúde.</td>
                <td class="px-4 py-3 text-ink-700">Online ao vivo + presencial pontual.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Maringá</td>
                <td class="px-4 py-3 text-ink-700">Empresas familiares grandes, alimentos, cosméticos, vestuário.</td>
                <td class="px-4 py-3 text-ink-700">Online ao vivo (forte preferência).</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Londrina</td>
                <td class="px-4 py-3 text-ink-700">Saúde, universitário, agro de média escala.</td>
                <td class="px-4 py-3 text-ink-700">Online ao vivo.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Cascavel</td>
                <td class="px-4 py-3 text-ink-700">Agro, cooperativismo, tech logístico.</td>
                <td class="px-4 py-3 text-ink-700">Online ao vivo.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Foz do Iguaçu</td>
                <td class="px-4 py-3 text-ink-700">Itaipu, energia, turismo, logística da Tríplice Fronteira.</td>
                <td class="px-4 py-3 text-ink-700">Online ao vivo.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-ink-900">Ponta Grossa</td>
                <td class="px-4 py-3 text-ink-700">Indústria dos Campos Gerais, agro, logística.</td>
                <td class="px-4 py-3 text-ink-700">Online ao vivo.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">Modalidade: como o paranaense decide</h2>
        <p>
          Curitiba tem oferta razoável de pós presencial, mas o formato Ao Vivo síncrono entrega algo que o presencial local não consegue — docente nominal com circulação nacional e turma diversa, com colegas de SP, MG, RS e Centro-Oeste. Para profissional de Curitiba que quer evitar parecer com "só mais um curso local", esse é o diferencial.
        </p>
        <p>
          Para o profissional do interior paranaense, a equação é ainda mais clara. Cascavel-Curitiba são 500 km. Foz-Curitiba são 640 km. Maringá-Curitiba são 430 km. Pós presencial de alta qualidade exige mudança de cidade. EAD gravado perde discussão de caso. O formato Ao Vivo síncrono entrega o que falta: aula com docente reconhecido, debate em tempo real e ritmo executivo. É o que o IPOG opera desde a origem.
        </p>
      </div>

      <div class="rounded-2xl bg-sun-500/10 border border-sun-500/30 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · composto e ilustrativo</p>
        <h3 class="font-display font-semibold text-lg text-ink-900">Do RH operacional em cooperativa para coordenação de saúde mental corporativa</h3>
        <p class="mt-3 text-ink-700 leading-relaxed">
          Um profissional de 33 anos, atuando como analista de RH numa cooperativa agroindustrial em Cascavel, queria migrar para área de saúde mental corporativa estruturada. A cooperativa empregava cerca de 6.500 pessoas e tinha programa incipiente de bem-estar, mas faltava profissional com lastro técnico para conduzir diagnóstico, ciclo PDCA e métricas de longo prazo. Em Cascavel não havia oferta presencial de pós aplicada nessa área.
        </p>
        <p class="mt-3 text-ink-700 leading-relaxed">
          Optou por pós em saúde mental nas organizações e Psicologia Positiva em formato Ao Vivo síncrono. Em 14 meses concluiu o curso. Foi promovido a Coordenador de Saúde Mental e Cultura, com escopo de quatro unidades operacionais da cooperativa. A diferença, segundo ele, foi conseguir entregar diagnóstico técnico com framework defensável diante de um conselho cooperativo que valoriza método antes de discurso.
        </p>
      </div>

      <div>
        <h2 class="section-h text-2xl">Oportunidades emergentes no PR</h2>
        <ul class="mt-4 space-y-3">
          <li class="card p-4 border-surface-200">
            <p class="font-semibold text-ink-900">Saúde mental corporativa em cooperativas e empresas familiares</p>
            <p class="text-sm text-ink-700 mt-1">Programas estruturados de prevenção de burnout, NR-1 aplicada e cultura de cuidado. Mercado em expansão com baixa concorrência relativa.</p>
          </li>
          <li class="card p-4 border-surface-200">
            <p class="font-semibold text-ink-900">POT em automotivo e indústria do cinturão curitibano</p>
            <p class="text-sm text-ink-700 mt-1">Montadoras e fornecedores ampliam estrutura de gestão de pessoas. Demanda em diagnóstico de cultura, segurança psicológica e people analytics.</p>
          </li>
          <li class="card p-4 border-surface-200">
            <p class="font-semibold text-ink-900">Psicologia Positiva e liderança em tech paranaense</p>
            <p class="text-sm text-ink-700 mt-1">Software houses, fintechs e empresas de tech logístico em Curitiba e Maringá ampliam contratação de profissional com base científica em desenvolvimento de liderança.</p>
          </li>
          <li class="card p-4 border-surface-200">
            <p class="font-semibold text-ink-900">Neuropsicologia clínica em centros regionais</p>
            <p class="text-sm text-ink-700 mt-1">Clínicas privadas em Curitiba, Maringá e Londrina ampliam serviços. Forte demanda pediátrica (TDAH, TEA) e em geriatria cognitiva.</p>
          </li>
          <li class="card p-4 border-surface-200">
            <p class="font-semibold text-ink-900">POT em energia e Itaipu</p>
            <p class="text-sm text-ink-700 mt-1">Geração de energia e operação de grande porte demandam profissional técnico em SST integrada a riscos psicossociais. Vagas estáveis com salário competitivo.</p>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="section-h text-2xl">Perguntas frequentes — PR</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white mt-4">
          {faqs.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <span class="font-semibold text-ink-900">{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-sun-500 mb-2">Síntese</p>
        <h3 class="font-display font-semibold text-xl">Paraná recebe saúde mental corporativa melhor que SP</h3>
        <p class="mt-3 text-white/90 leading-relaxed">
          O ecossistema paranaense — cooperativismo, empresas familiares grandes, tech em Curitiba, energia em Foz — abre demanda por Psicologia aplicada que ainda tem oferta técnica curta. O IPOG opera com formato Ao Vivo síncrono, ideal tanto para profissional de Curitiba quanto para profissional do interior. Próximo passo: comparar grade e turma vigente no portal oficial do IPOG.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-5">
          Ver turmas vigentes para PR no IPOG
        </a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">IPOG no Paraná</h3>
        <p class="text-sm text-ink-700 mt-2">
          O IPOG atende PR em formato Ao Vivo síncrono, com corpo docente nominal e discussão de caso real. Grade, valor, modalidade e turma vigentes em ipog.edu.br.
        </p>
        <p class="text-xs text-ink-500 mt-2 italic">Portal independente. Não é o site oficial do IPOG.</p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">
          Ver no IPOG
        </a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">
          Home IPOG
        </a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">MBAs que combinam com PR</p>
        <ul class="space-y-2">
          {MBAS.slice(0, 4).map(m => (
            <li>
              <a href={`/mbas#${m.id}`} class="mega-link">
                <strong class="text-ink-900 text-sm">{m.shortName}</strong>
              </a>
            </li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes consultadas</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://www.crppr.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CRP-08 — Paraná</a></li>
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP — Conselho Federal</a></li>
          <li><a href="https://www.gov.br/trabalho-e-emprego/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">MTE — NR-1 e CAGED</a></li>
          <li><a href="https://www.ocepar.coop.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">OCEPAR — Cooperativismo</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
</Base>
