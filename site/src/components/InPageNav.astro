---
/**
 * InPageNav: sumário sticky com scrollspy via IntersectionObserver.
 *
 * Uso:
 *   <InPageNav headings={[
 *     { id: 'tese', text: 'Tese', level: 2 },
 *     { id: 'mecanismo', text: 'Mecanismo', level: 2 },
 *   ]} />
 *
 * Em desktop: coluna lateral sticky.
 * Em mobile: botão "Sumário ▾" que abre drawer.
 *
 * Recomenda-se posicionar dentro de um grid 12 cols como `lg:col-span-3`.
 */
interface Heading {
  id: string;
  text: string;
  level: number;
}

interface Props {
  headings: Heading[];
  title?: string;
  ariaLabel?: string;
}

const { headings, title = 'Nesta página', ariaLabel = 'Sumário da página' } = Astro.props as Props;

const safeHeadings = (headings || []).filter(h => h && h.id && h.text);
const minLevel = safeHeadings.length > 0 ? Math.min(...safeHeadings.map(h => h.level || 2)) : 2;

// IDs únicos para a11y do botão mobile
const nonce = Math.random().toString(36).slice(2, 8);
const drawerId = 'inpage-nav-drawer-' + nonce;
const buttonId = 'inpage-nav-button-' + nonce;
const navId = 'inpage-nav-' + nonce;
---

{safeHeadings.length > 0 && (
  <>
    {/* Mobile: botão + drawer fixo */}
    <div class="lg:hidden">
      <button
        id={buttonId}
        type="button"
        aria-controls={drawerId}
        aria-expanded="false"
        class="w-full inline-flex items-center justify-between gap-2 rounded-xl border border-surface-200 bg-white px-4 py-2.5 text-sm font-semibold text-ink-900 hover:border-brand-400 hover:text-brand-800 transition"
      >
        <span class="inline-flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-700" viewBox="0 0 20 20" fill="currentColor"><path d="M3 5h14v2H3V5zm0 4h14v2H3V9zm0 4h10v2H3v-2z"/></svg>
          {title}
        </span>
        <svg class="w-4 h-4 text-ink-500 transition-transform" data-inpage-chevron viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
      </button>
      <div
        id={drawerId}
        hidden
        class="mt-2 rounded-xl border border-surface-200 bg-white p-3 shadow-soft"
      >
        <nav aria-label={ariaLabel}>
          <ul class="space-y-1">
            {safeHeadings.map(h => (
              <li>
                <a
                  href={`#${h.id}`}
                  data-inpage-link
                  data-target={h.id}
                  class={`block px-3 py-1.5 rounded-lg text-sm text-ink-700 hover:bg-surface-50 hover:text-brand-800 transition ${h.level > minLevel ? 'pl-6 text-[13px]' : 'font-semibold'}`}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    {/* Desktop: sticky sidebar */}
    <nav id={navId} aria-label={ariaLabel} class="hidden lg:block lg:sticky lg:top-24">
      <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-500 mb-3">{title}</p>
      <ul class="space-y-1 border-l border-surface-200">
        {safeHeadings.map(h => (
          <li>
            <a
              href={`#${h.id}`}
              data-inpage-link
              data-target={h.id}
              class={`block -ml-px pl-4 py-1.5 border-l text-sm border-transparent text-ink-500 hover:text-brand-800 hover:border-brand-300 transition ${h.level > minLevel ? 'pl-7 text-[13px]' : 'font-medium'}`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <script is:inline define:vars={{ buttonId, drawerId }}>
      (function () {
        const btn = document.getElementById(buttonId);
        const drawer = document.getElementById(drawerId);
        const chevron = btn && btn.querySelector('[data-inpage-chevron]');
        if (btn && drawer) {
          btn.addEventListener('click', function () {
            const open = drawer.hasAttribute('hidden') === false;
            if (open) {
              drawer.setAttribute('hidden', '');
              btn.setAttribute('aria-expanded', 'false');
              if (chevron) chevron.style.transform = '';
            } else {
              drawer.removeAttribute('hidden');
              btn.setAttribute('aria-expanded', 'true');
              if (chevron) chevron.style.transform = 'rotate(180deg)';
            }
          });
          // Fecha ao clicar em link
          drawer.querySelectorAll('a[data-inpage-link]').forEach(function (a) {
            a.addEventListener('click', function () {
              drawer.setAttribute('hidden', '');
              btn.setAttribute('aria-expanded', 'false');
              if (chevron) chevron.style.transform = '';
            });
          });
        }

        // Scrollspy: marca link ativo com classes (border + cor)
        const links = Array.from(document.querySelectorAll('a[data-inpage-link]'));
        const targets = links
          .map(l => l.getAttribute('data-target'))
          .filter(Boolean)
          .map(id => document.getElementById(id))
          .filter(Boolean);

        if (targets.length === 0 || !('IntersectionObserver' in window)) return;

        const linkByTarget = new Map();
        links.forEach(function (l) {
          const t = l.getAttribute('data-target');
          if (!t) return;
          if (!linkByTarget.has(t)) linkByTarget.set(t, []);
          linkByTarget.get(t).push(l);
        });

        function clearActive() {
          links.forEach(function (l) {
            l.classList.remove('text-brand-800', 'border-brand-500', 'bg-brand-50');
          });
        }

        function setActive(id) {
          clearActive();
          const arr = linkByTarget.get(id) || [];
          arr.forEach(function (l) {
            l.classList.add('text-brand-800', 'border-brand-500');
          });
        }

        const visible = new Set();
        const observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) visible.add(e.target.id);
            else visible.delete(e.target.id);
          });
          // Escolhe o primeiro visível (top-down)
          for (const t of targets) {
            if (visible.has(t.id)) {
              setActive(t.id);
              return;
            }
          }
        }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] });

        targets.forEach(function (t) { observer.observe(t); });
      })();
    </script>
  </>
)}
