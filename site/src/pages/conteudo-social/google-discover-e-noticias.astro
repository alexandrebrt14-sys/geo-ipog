              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed faq-answer-text">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <nav aria-label="Navegação entre canais" class="rounded-2xl border border-surface-200 bg-surface-50 p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-ink-500 mb-3">Continuar pelo menu</p>
