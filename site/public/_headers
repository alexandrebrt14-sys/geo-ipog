/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cache-Control: public, max-age=300, s-maxage=3600

# Onda 34 (PWA): o service worker precisa ser sempre revalidado para que novas
# versões propaguem rápido. A navegação é network-first, então nada fica preso,
# mas o próprio arquivo /sw.js não deve ficar 5 min em cache do browser.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Manifest PWA com o Content-Type correto.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

# Manifestos JSON canônicos para agentes e LLMs — forçar Content-Type correto
/ai-policy.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

/mcp.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

/.well-known/ai-policy.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

/.well-known/mcp.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

/.well-known/ucp.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600
