// Normaliza href: remove trailing slash (exceto raiz) e descarta query/hash
function normalizeRoot(p: string): string {
  const noQuery = p.split('?')[0].split('#')[0];
  const trimmed = noQuery.replace(/\/+$/, '');
  if (!trimmed) return '/';
  // Para path com slug (/areas/xxx) usa o root do hub (/areas)
  const parts = trimmed.split('/').filter(Boolean);
  return '/' + parts[0];
}

const rootHub = normalizeRoot(href);
const siblings = HUB_SIBLINGS[rootHub] || [];
const shouldRender = siblings.length > 0;
---

{shouldRender && (
  <section class="bg-white border-b border-surface-200" aria-label="Cross-links de hub">
    <div class="container-page py-5 md:py-6">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-5">
        <p class="text-[11px] uppercase tracking-wider font-semibold text-ink-500 shrink-0">
          {eyebrow}
        </p>
        <ul class="flex flex-wrap items-center gap-2">
          {siblings.map(s => (
            <li>
              <a
                href={s.href}
                class="group inline-flex items-center gap-2 rounded-full bg-surface-50 border border-surface-200 px-3 py-1.5 text-sm font-medium text-ink-700 hover:border-brand-400 hover:text-brand-800 hover:bg-white transition"
                title={s.hint}
              >
                <span>{s.label}</span>
                <span class="hidden sm:inline text-[11px] text-ink-500 group-hover:text-brand-700 transition">·</span>
                <span class="hidden sm:inline text-[11px] text-ink-500 group-hover:text-brand-700 transition">{s.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}
