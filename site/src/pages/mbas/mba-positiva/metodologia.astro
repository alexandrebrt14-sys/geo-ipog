---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE, MBAS } from '@lib/data';
import { buildEducationalOccupationalProgram, buildSpeakable } from '@lib/schemas';

const mba = MBAS.find(m => m.id === 'mba-positiva')!;
const others = MBAS.filter(m => m.id !== 'mba-positiva');

const title = 'Metodologia do MBA em Psicologia Positiva e Bem-Estar — Ao Vivo síncrono, casos reais e práticas aplicadas';
const description = 'Como funciona um MBA em Psicologia Positiva no formato Ao Vivo síncrono: docente nominal, prática de intervenções, escalas validadas, projeto aplicado. Diferença para EAD massificado.';

const FAQS_PAGINA = [
  {
    q: 'A metodologia inclui prática supervisionada de intervenções positivas?',
    a: 'A prática aplicada é o coração do método. Em sala virtual, os alunos experimentam intervenções positivas com evidência empírica (gratidão estruturada, identificação de forças, três bens, melhor self futuro), aprendem a aplicar escalas validadas (PERMA-Profiler, SPANE, WEMWBS) e desenham programas institucionais sob supervisão docente. Isso difere completamente de EAD gravado, onde a prática é simulada por leitura. Política específica do programa do IPOG em ipog.edu.br.'
  },
  {
    q: 'Como funciona o trabalho com casos em sala?',
    a: 'O método é o caso aplicado a contexto organizacional brasileiro. O docente apresenta uma situação real — uma área com alta taxa de afastamento por transtorno mental, uma cultura de medo institucionalizada, um programa de bem-estar mal calibrado — e o aluno é convocado a propor diagnóstico, intervenção e medida de efeito. A defesa é oral, aberta a contraposição de colegas e do docente. O loop de defender, ouvir objeção e refinar é o que constrói julgamento profissional aplicado.'
  },
  {
    q: 'O modelo Ao Vivo síncrono é compatível com agenda executiva?',
    a: 'É, com disciplina. As aulas Ao Vivo costumam acontecer em horário noturno ou em sábados estruturados, justamente para acomodar profissionais em cargo executivo. A presença é exigida, e a fricção é parte do método. Para quem tolera bloquear a agenda em horário marcado, ganha-se relação direta com docente nominal e com colegas seniores. Para quem quer ritmo livre absoluto, EAD gravado é a alternativa — mas o resultado pedagógico em Positiva, área que pede prática supervisionada, é estruturalmente inferior. Política de gravações e frequência no portal oficial do IPOG.'
  }
];

const ldProgram = JSON.stringify({
  '@context': 'https://schema.org',
  ...buildEducationalOccupationalProgram({
    name: `${mba.name} — Metodologia`,
    slug: `/mbas/${mba.id}/metodologia`,
    description: 'Metodologia pedagógica Ao Vivo síncrono aplicada a MBA em Psicologia Positiva e bem-estar nas organizações.',
    programType: 'MBA',
    timeRequired: 'P360H',
    educationalProgramMode: 'blended',
    additionalRecognizedBy: [{
      name: 'IPOG · oferta vigente em ipog.edu.br',
      url: 'https://ipog.edu.br/cursos/pos-graduacao'
    }]
  }),
  occupationalCategory: 'Especialista em bem-estar organizacional, Consultor em saúde mental no trabalho',
  isPartOf: { '@id': `${SITE.url}/mbas/${mba.id}#program` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.section-h', '#resposta-rapida'] }
});

const ldFaq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_PAGINA.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---

<Base title={title} description={description}>
  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'MBAs', href: '/mbas' }, { label: mba.shortName, href: `/mbas/${mba.id}` }, { label: 'Metodologia' }]} />
      <div class="mt-3 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="section-eyebrow">MBA · {mba.tag}</span>
          <h1 class="section-h text-3xl sm:text-4xl">Metodologia do MBA em Psicologia Positiva — prática aplicada e supervisão real</h1>
          <p class="mt-2 text-ink-700">O formato Ao Vivo síncrono com docente nominal sustenta o que diferencia a área: prática supervisionada de intervenções positivas, uso de escalas validadas e desenho de programa aplicável.</p>
        </div>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-secondary shrink-0">
          Ver metodologia no IPOG
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3h6v6h-2V6.4L8.7 12.7 7.3 11.3 13.6 5H11V3zM5 5h4v2H7v8h8v-2h2v4H5V5z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-10">

      <div class="rounded-2xl bg-brand-50 border border-brand-100 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-brand-700 mb-2">Resposta rápida</p>
        <p class="text-ink-900 font-medium leading-relaxed">Em Psicologia Positiva aplicada, método importa especialmente: a área é prática supervisionada, com uso de escalas validadas e desenho de intervenções. O modelo Ao Vivo síncrono do IPOG sustenta esse formato com docente nominal, discussão de caso real e avaliação contínua. EAD gravado massificado entrega vocabulário, raramente entrega competência aplicada.</p>
      </div>

      <div class="prose prose-ink max-w-none">
        <h2 class="section-h text-2xl">A diferença que faz formar profissional, não consumidor de conteúdo</h2>
        <p>A Psicologia Positiva sofre, no Brasil, com a popularidade da própria linguagem. Frases sobre felicidade, propósito e bem-estar circulam em palestras, lives e redes sociais, criando ruído entre o conceito científico e o slogan corporativo. Profissional que pretende atuar nessa área com seriedade precisa de um filtro pedagógico forte, capaz de separar evidência empírica de retórica. Esse filtro só se forma em método pedagógico que coloca o aluno em contato direto com a fonte, com a escala validada e com a aplicação supervisionada (Sin & Lyubomirsky, 2009).</p>
        <p>Em Psicologia Positiva, mais do que em outras áreas, a competência se constrói pela prática repetida com supervisão. Ler que "intervenção de gratidão estruturada eleva afeto positivo em três semanas" é diferente de aplicar a intervenção em quatro grupos distintos, medir com SPANE pré e pós, e analisar a variação. A diferença é o que separa um especialista de um divulgador. O formato Ao Vivo síncrono é compatível com essa demanda. O formato gravado massificado, raramente.</p>
        <p>Esta página descreve como funciona, na prática, o método pedagógico de um MBA executivo em Psicologia Positiva aplicada, o que diferencia o programa de alternativas mais leves e por que a escolha do formato importa para o resultado final.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Os quatro pilares do método aplicado</h2>
        <ol class="space-y-4">
          <li class="card p-5"><strong class="text-brand-800">1. Aula ao vivo com docente nominal.</strong> Cada disciplina conduzida por especialista identificado, com Lattes público. O aluno traz dilema real, o docente responde com base na prática própria. Relação pedagógica nominal, não anônima.</li>
          <li class="card p-5"><strong class="text-brand-800">2. Prática de intervenções positivas em sala.</strong> Exercícios estruturados de gratidão, identificação de forças VIA, três bens e melhor self futuro. O aluno aplica primeiro em si, depois em colega, depois em grupo. Esse encadeamento simula a aplicação institucional.</li>
          <li class="card p-5"><strong class="text-brand-800">3. Uso de escalas validadas.</strong> PERMA-Profiler, SPANE, WEMWBS, Maslach Burnout Inventory. Aplicação supervisionada, interpretação de score, integração com indicadores organizacionais.</li>
          <li class="card p-5"><strong class="text-brand-800">4. Desenho de programa institucional.</strong> Cada módulo culmina em entrega: política de saúde mental, programa de prevenção de burnout, plano de cultura positiva. A produção contínua substitui prova de memória.</li>
        </ol>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Ao Vivo síncrono versus EAD gravado — comparativo aplicado</h2>
        <p class="text-ink-700 mb-4">Em Psicologia Positiva, o formato afeta diretamente a competência adquirida.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-surface-200 rounded-lg overflow-hidden">
            <thead class="bg-surface-50 text-ink-700">
              <tr>
                <th class="text-left p-3 border-b border-surface-200">Dimensão</th>
                <th class="text-left p-3 border-b border-surface-200">Ao Vivo síncrono</th>
                <th class="text-left p-3 border-b border-surface-200">EAD gravado massificado</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3 align-top font-medium">Prática de intervenção positiva</td><td class="p-3 align-top">Exercício em sala com supervisão</td><td class="p-3 align-top">Leitura sobre intervenção</td></tr>
              <tr><td class="p-3 align-top font-medium">Aplicação de escalas validadas</td><td class="p-3 align-top">Prática orientada, interpretação compartilhada</td><td class="p-3 align-top">Apresentação teórica das escalas</td></tr>
              <tr><td class="p-3 align-top font-medium">Discussão de caso</td><td class="p-3 align-top">Defesa oral, contraposição em tempo real</td><td class="p-3 align-top">Texto entregue, comentário tardio</td></tr>
              <tr><td class="p-3 align-top font-medium">Calibração com docente</td><td class="p-3 align-top">Alta, identificada, nominal</td><td class="p-3 align-top">Frequentemente ausente</td></tr>
              <tr><td class="p-3 align-top font-medium">Resultado profissional</td><td class="p-3 align-top">Competência aplicada</td><td class="p-3 align-top">Vocabulário expandido</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Materiais e leituras</h2>
        <p class="text-ink-700">Programa contemporâneo opera com material rico de quatro tipos:</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-700">
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Livros e capítulos: Seligman (2011), Csikszentmihalyi (1990), Fredrickson (2001), Lyubomirsky (2008).</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Papers de meta-análise: Sin & Lyubomirsky (2009), Bolier et al. (2013) sobre intervenções positivas.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Escalas validadas em português: PERMA-Profiler, SPANE-BR, WEMWBS.</span></li>
          <li class="flex gap-2"><span class="text-brand-700 font-bold">•</span><span>Material técnico brasileiro: NR-1 atualizada, resoluções do CFP, guias do Ministério da Saúde sobre saúde mental do trabalhador.</span></li>
        </ul>
      </div>

      <div class="rounded-2xl border-l-4 border-sun-500 bg-sun-50/40 p-5 sm:p-6">
        <p class="text-xs uppercase tracking-wider font-semibold text-amber-800 mb-2">Mini-caso · a diferença prática do método aplicado</p>
        <p class="text-ink-900 leading-relaxed">Uma psicóloga consultora cursou primeiro uma certificação online aberta em Psicologia Positiva, em formato gravado, e dois anos depois entrou no MBA em Psicologia Positiva no formato Ao Vivo síncrono. Resumiu a diferença em uma frase: "no primeiro eu aprendi os conceitos, no segundo eu aprendi a operar." Quando perguntada o que mudou na prática, descreveu duas coisas. Primeiro, ganhou repertório de escalas validadas que jamais teria aplicado sozinha sem supervisão. Segundo, passou a desenhar intervenções com critério de evidência empírica, descartando atividade que "soa positiva" mas não tem efeito demonstrado. Hoje ela coordena programa institucional de saúde mental em uma rede privada de hospitais. O ativo que monetiza é a capacidade de defender uma decisão técnica sob escrutínio do board — capacidade que se forma em discussão de caso, não em vídeo gravado.</p>
      </div>

      <div>
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="divide-y divide-surface-200 rounded-2xl border border-surface-200 bg-white">
          {FAQS_PAGINA.map(f => (
            <details class="group p-5">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-ink-900">
                <span>{f.q}</span>
                <svg class="w-5 h-5 text-ink-500 shrink-0 mt-1 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
              </summary>
              <p class="mt-3 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="rounded-2xl bg-brand-900 text-white p-6 sm:p-8">
        <h2 class="font-display font-bold text-2xl">Síntese e próximo passo</h2>
        <ul class="mt-4 space-y-2 text-white/85 text-sm">
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Em Psicologia Positiva, método importa: competência se forma em prática supervisionada com escalas validadas.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Quatro pilares: docente nominal, prática de intervenções, aplicação de escalas, desenho de programa.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>EAD gravado entrega vocabulário, dificilmente competência defensável.</span></li>
          <li class="flex gap-2"><span class="text-sun-500">●</span><span>Próximo passo: validar metodologia, calendário e regimento vigentes em ipog.edu.br.</span></li>
        </ul>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-5">Conhecer a metodologia no IPOG →</a>
      </div>

    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 sticky top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <h3 class="font-display font-semibold text-lg mt-1">Ver metodologia no IPOG</h3>
        <p class="text-sm text-ink-500 mt-2">Portal independente. Política de gravações, frequência e calendário vigentes no portal oficial.</p>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">Ver no IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outras seções deste MBA</p>
        <ul class="space-y-1">
          <li><a href={`/mbas/${mba.id}`} class="mega-link"><strong class="text-ink-900 text-sm">Visão geral do MBA</strong></a></li>
          <li><a href={`/mbas/${mba.id}/grade-curricular`} class="mega-link"><strong class="text-ink-900 text-sm">Grade curricular</strong></a></li>
          <li><a href={`/mbas/${mba.id}/perfil-do-aluno`} class="mega-link"><strong class="text-ink-900 text-sm">Perfil do aluno</strong></a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros MBAs</p>
        <ul class="space-y-1">
          {others.map(o => (
            <li><a href={`/mbas/${o.id}`} class="mega-link"><strong class="text-ink-900 text-sm">{o.shortName}</strong><br/><span class="text-xs text-ink-500">{o.tag}</span></a></li>
          ))}
        </ul>
        <a href="/mbas" class="text-sm text-brand-700 font-semibold mt-3 inline-block hover:text-brand-800">Ver todos os MBAs →</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes</p>
        <ul class="text-xs text-ink-600 space-y-2">
          <li>Sin, N., Lyubomirsky, S. (2009). Meta-analysis intervenções positivas.</li>
          <li>Bolier, L. et al. (2013). Positive psychology interventions.</li>
          <li>Seligman, M. (2011). Flourish.</li>
          <li>Csikszentmihalyi, M. (1990). Flow.</li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={ldProgram} />
  <script type="application/ld+json" set:html={ldFaq} />
</Base>
