---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TLDR from '@components/TLDR.astro';
import InPageNav from '@components/InPageNav.astro';
import { SITE } from '@lib/data';
import { alexandreAuthorRef } from '@lib/schemas';

const title = 'Repositórios acadêmicos para um portal editorial: o que vira DOI citável e o que é verniz';
const description = 'PsyArXiv, OSF, SciELO Preprints, Zenodo e ResearchGate pelas regras oficiais: o que pode ser depositado, licença, versionamento, o que gera DOI e o que exige um pesquisador de verdade por trás.';
const datePublished = '2026-09-07';
const pageUrl = `${SITE.url}/conteudo-social/repositorios-academicos/`;

const headings = [
  { id: 'contrato-do-canal', text: 'Contrato do canal', level: 2 },
  { id: 'o-que-pode-ser-depositado', text: 'O que pode ser depositado', level: 2 },
  { id: 'vira-deposito', text: 'Este material vira depósito?', level: 2 },
  { id: 'fluxo-do-deposito', text: 'O fluxo do depósito, do envio ao DOI', level: 2 },
  { id: 'licenca-e-versionamento', text: 'Licença e versionamento', level: 2 },
  { id: 'doi-citavel', text: 'O que vira DOI citável', level: 2 },
  { id: 'rede-social-nao-e-repositorio', text: 'Rede social acadêmica não é repositório', level: 2 },
  { id: 'google-scholar', text: 'Como isso chega ao Google Scholar', level: 2 },
  { id: 'o-que-exige-pesquisador', text: 'O que exige um pesquisador de verdade', level: 2 },
  { id: 'etica-cfp', text: 'Ética profissional nesta superfície', level: 2 },
  { id: 'do-portal-para-o-canal', text: 'Do portal para o canal', level: 2 },
  { id: 'checklist', text: 'Checklist antes de depositar', level: 2 },
  { id: 'perguntas-frequentes', text: 'Perguntas frequentes', level: 2 }
];

const contrato = [
  {
    campo: 'Público real',
    valor: 'Pesquisadores, docentes, revisores, bibliotecários, coordenadores de pós-graduação e jornalistas que precisam de um objeto estável para citar. Motores generativos leem o mesmo objeto por metadado, e não por design de página.'
  },
  {
    campo: 'Formato canônico',
    valor: 'Relatório de pesquisa em .pdf com método declarado, dados anonimizados em .csv, protocolo e material suplementar em projeto OSF. Preprint apenas quando existe contribuição acadêmica completa, com pergunta, corpus, critério de inclusão, achados e limites.'
  },
  {
    campo: 'Gancho de abertura',
    valor: 'A pergunta pesquisável não é qual pós-graduação em Psicologia é melhor. É quais dúvidas regulatórias, clínicas e profissionais aparecem de forma recorrente nas buscas e nas respostas geradas, e com qual frequência medida.'
  },
  {
    campo: 'Regra que quebra a conta',
    valor: 'As políticas de moderação do OSF Preprints declaram que conteúdo total ou majoritariamente gerado por ferramentas de modelo de linguagem ou de inteligência artificial não é apropriado para o serviço, e que organizações não podem usar contas do OSF como agregadores de publicação, centrais de distribuição ou serviços de geração de DOI. O serviço opera com pré-moderação: a submissão fica privada e pendente até um moderador aceitar ou recusar.'
  },
  {
    campo: 'Erro clássico',
    valor: 'Depositar artigo editorial com aparência de paper. Repositório acadêmico convive bem com incerteza metodológica declarada e recusa verniz acadêmico sem método.'
  },
  {
    campo: 'Métrica honesta',
    valor: 'Citação em bibliografia de terceiro, uso em ementa de disciplina, link a partir de grupo de pesquisa e download qualificado. DOI criado sem nenhuma citação é arquivo com identificador, não autoridade.'
  }
];

const plataformas = [
  {
    nome: 'PsyArXiv',
    natureza: 'Servidor de preprints de Psicologia, criado pela Society for the Improvement of Psychological Science, hospedado no OSF do Center for Open Science e administrado pelo PsyArXiv Scientific Advisory Board.',
    aceita: 'Working papers, preprints e cópias de autor de trabalhos publicados, incluindo relatos originais qualitativos e quantitativos, registered reports de estágios 1 e 2, livros, capítulos, revisões, críticas, pôsteres e comentários de pesquisa.',
    modera: 'Sim. Os moderadores avaliam se o material está no escopo, com duas perguntas declaradas: é trabalho acadêmico e é Psicologia. Submissão de brincadeira é recusada.',
    ia: 'Uso de modelo de linguagem para apoiar a preparação do manuscrito, como revisão ortográfica, reestruturação de frase e checagem gramatical, é permitido, e qualquer uso substantivo deve ser explicitamente divulgado no manuscrito.'
  },
  {
    nome: 'OSF Preprints',
    natureza: 'Infraestrutura que hospeda serviços de preprint da comunidade, mantida pelo Center for Open Science.',
    aceita: 'Conteúdo original criado pelo usuário, ou publicado com permissão explícita e atribuição apropriada de quem o criou.',
    modera: 'Pré-moderação. A submissão fica em estado privado e pendente até um moderador aceitar ou recusar, com a justificativa devolvida ao autor.',
    ia: 'Conteúdo total ou majoritariamente gerado por ferramentas de modelo de linguagem ou de inteligência artificial não é apropriado para o OSF Preprints.'
  },
  {
    nome: 'SciELO Preprints',
    natureza: 'Servidor de preprints da rede SciELO, aberto a manuscritos de todas as disciplinas e assuntos científicos.',
    aceita: 'Manuscrito relacionado a pesquisa, depositado em PDF, com declaração de que não foi depositado em outro servidor nem publicado em periódico.',
    modera: 'Triagem básica para identificar se o material é manuscrito relacionado a pesquisa, com um caminho de postagem automática para autor com histórico de publicação. [FALTA EVIDENCIA: o limiar exato de artigos anteriores que dispara a postagem automática.]',
    ia: '[FALTA EVIDENCIA: política específica do SciELO Preprints sobre uso de modelo de linguagem na preparação do manuscrito.]'
  },
  {
    nome: 'Zenodo',
    natureza: 'Repositório geral de resultados de pesquisa, operado no ambiente do CERN.',
    aceita: 'Todos os campos de pesquisa e todos os tipos de artefato de pesquisa, desde que o conteúdo não viole privacidade nem direito autoral e não quebre confidencialidade. Limite de 50 GB por registro, com cota maior mediante pedido avaliado caso a caso.',
    modera: 'Sem revisão de mérito. O controle é de direitos e de escopo, com remoção prevista para violação de política.',
    ia: '[FALTA EVIDENCIA: política específica do Zenodo sobre conteúdo gerado por modelo de linguagem.]'
  },
  {
    nome: 'ResearchGate',
    natureza: 'Rede social acadêmica. A própria plataforma declara que não é editora e não aceita artigos ou trabalhos para publicação.',
    aceita: 'Depende do contrato que o autor assinou com a editora do periódico. A plataforma avisa que muitas editoras não permitem compartilhar publicamente a versão final publicada em nenhum momento.',
    modera: 'A responsabilidade é do usuário. A plataforma declara que você responde por qualquer conteúdo que enviar ou compartilhar e que precisa conferir antes se tem todos os direitos necessários.',
    ia: '[FALTA EVIDENCIA: política específica do ResearchGate sobre conteúdo gerado por modelo de linguagem.]'
  }
];

const passos = [
  {
    nome: 'Escolha a pergunta que sobrevive fora do portal',
    texto: 'A pergunta precisa ser respondível por método, e não por opinião editorial. Comparar a frequência com que dúvidas regulatórias aparecem nas buscas é pesquisável; afirmar qual formação é melhor não é. Escreva a pergunta em uma frase antes de qualquer outra coisa, porque ela decide o corpus.'
  },
  {
    nome: 'Declare corpus, critério de inclusão e período',
    texto: 'Quantos itens, colhidos de onde, entre quais datas, com qual critério de entrada e de saída, e quantos foram descartados e por quê. Esse parágrafo é o que separa relatório de pesquisa de ensaio com números. Sem denominador, o achado não é auditável.'
  },
  {
    nome: 'Escreva o documento no formato que o repositório aceita',
    texto: 'PDF com título em fonte grande na primeira página, autores logo abaixo em linha própria, resumo, método, achados, limites e uma seção final de referências. O SciELO Preprints exige PDF; o Google Scholar pede PDF ou HTML, com no máximo 5 MB por arquivo, título em fonte grande no topo da primeira página e seção de bibliografia ao final.'
  },
  {
    nome: 'Declare autoria, afiliação, conflito de interesse e uso de IA',
    texto: 'Cada autor com ORCID, a afiliação institucional real, e o vínculo econômico do portal declarado no próprio documento. Uso de modelo de linguagem para apoio de redação é aceito pelo PsyArXiv, e qualquer uso substantivo precisa ser divulgado explicitamente no manuscrito.'
  },
  {
    nome: 'Escolha o repositório pela natureza do objeto',
    texto: 'Manuscrito acadêmico de Psicologia vai a servidor de preprint de Psicologia. Conjunto de dados, protocolo, código e material suplementar vão ao Zenodo, que aceita todos os tipos de artefato de pesquisa. Depositar em dois servidores de preprint ao mesmo tempo é vedado pela declaração exigida no SciELO Preprints.'
  },
  {
    nome: 'Publique o DOI de volta no portal e registre a data',
    texto: 'Depois do aceite, o preprint recebe DOI e URL persistente que permitem citá-lo. A página HTML do portal passa a citar o próprio DOI, e o registro interno guarda a data do depósito, a versão e o repositório. Sem esse fechamento, o depósito vira arquivo esquecido com identificador.'
  }
];

const checklist = [
  'A pergunta de pesquisa está escrita em uma frase e é respondível por método.',
  'O documento declara corpus, período, critério de inclusão, critério de exclusão e quantos itens foram descartados.',
  'Os limites do trabalho estão escritos pelo próprio autor, antes de qualquer revisor apontá-los.',
  'O documento não foi gerado total ou majoritariamente por modelo de linguagem, conforme a política de moderação do OSF Preprints.',
  'Qualquer uso substantivo de modelo de linguagem está divulgado explicitamente no manuscrito, conforme a política do PsyArXiv.',
  'Cada autor tem ORCID declarado e a afiliação institucional está correta.',
  'O vínculo econômico entre portal, agência e instituição de ensino está declarado dentro do documento.',
  'A licença está escolhida e escrita: o SciELO Preprints publica o manuscrito aprovado sob CC-BY, e o Zenodo exige licença especificada para todo arquivo público.',
  'O mesmo manuscrito não foi depositado em dois servidores de preprint, declaração exigida na submissão do SciELO Preprints.',
  'O arquivo em PDF tem título em fonte grande no topo da primeira página, autores em linha própria abaixo, seção de referências ao final e menos de 5 MB, conforme as diretrizes de inclusão do Google Scholar.',
  'O DOI recebido foi citado de volta na página HTML do portal, com a data do depósito registrada.'
];

const faqs = [
  {
    q: 'Um portal editorial pode depositar seus artigos em PsyArXiv?',
    a: 'Pode depositar o que for trabalho acadêmico em Psicologia, e é essa a régua que os moderadores aplicam. O PsyArXiv declara ser destinado a pesquisadores de qualquer área da Psicologia para enviar working papers, preprints e cópias de autor de trabalhos publicados, e a moderação avalia se a submissão está no escopo com duas perguntas: é trabalho acadêmico e é Psicologia. Um artigo de blog reescrito com aparência de paper falha na primeira pergunta. Um relatório com pergunta, corpus, critério de inclusão, achados e limites declarados passa a ter chance real, ainda que o tema seja o mercado de formação em vez de intervenção clínica.'
  },
  {
    q: 'Depositar um preprint gera DOI mesmo sem revisão por pares?',
    a: 'Gera, e essa é justamente a diferença entre identificador e validação. No OSF, a documentação registra que, se aceito, o preprint recebe um DOI e uma URL persistente que permitem citá-lo. No SciELO Preprints, imediatamente após a aceitação o preprint recebe um DOI e fica disponível ao público. O DOI resolve permanência e citabilidade, e não diz nada sobre qualidade metodológica. Confundir os dois é o erro que transforma depósito em argumento de autoridade indevido.'
  },
  {
    q: 'Posso usar o repositório para gerar DOI de material do portal em série?',
    a: 'Não. As políticas de moderação do OSF Preprints dizem que organizações não podem usar contas do OSF como agregadores de publicação, centrais de distribuição ou serviços de geração de DOI, e o caminho previsto para organização que queira hospedar conteúdo é a associação oficial ao OSF Preprints. O ponto vale como princípio geral: repositório existe para dar permanência a objeto de pesquisa, e usá-lo como máquina de identificadores queima a conta e a reputação de quem assina.'
  },
  {
    q: 'ResearchGate conta como repositório?',
    a: 'Conta como rede social acadêmica, com regra de direito autoral própria e responsabilidade transferida ao usuário. A plataforma declara que não é editora e não aceita artigos ou trabalhos para publicação, que você responde por qualquer conteúdo que enviar e precisa conferir antes se tem todos os direitos necessários, e que remove o material identificado quando o titular de direitos apresenta notificação de infração conforme os procedimentos e a lei internacional. A plataforma ainda avisa que muitas editoras não permitem o compartilhamento público da versão final publicada em nenhum momento. A consequência prática é direta: o objeto citável nasce no repositório, e o perfil na rede social serve para divulgar o link, não para hospedar o arquivo.'
  },
  {
    q: 'Como o depósito chega ao Google Scholar?',
    a: 'Pelas diretrizes de inclusão do Scholar, que são técnicas e verificáveis. O serviço cobre artigos de periódico, trabalhos de congresso, relatórios técnicos ou seus rascunhos, teses, preprints, postprints e resumos, e deixa de fora notícias, matérias de revista, resenhas de livro e editoriais. Os arquivos precisam estar em HTML ou PDF, com no máximo 5 MB cada, e o texto completo ou o resumo escrito pelo autor precisa estar livremente disponível e visível ao clicar na URL. Para trabalho depositado por autor individual, o Scholar pede o texto completo em PDF terminado em ponto pdf, título em fonte grande no topo da primeira página, autores em linha separada logo abaixo do título e uma seção final chamada References ou Bibliography.'
  },
  {
    q: 'O que este portal pode depositar sozinho, sem um pesquisador vinculado a instituição?',
    a: 'Análise documental de fonte pública, que dispensa participante humano e por isso dispensa comitê de ética. Levantamento de resoluções de conselho, portarias e séries do censo, com corpus declarado, é pesquisa documental legítima; o mesmo vale para relatório metodológico sobre como se mede citação de domínio em resposta gerada, contanto que o método esteja escrito e os limites também. Estudo com participantes, coleta de dado identificável ou aplicação de instrumento psicométrico exige pesquisador responsável, protocolo aprovado e vínculo institucional, e nenhum deles se resolve com boa redação. Quem quiser trilhar o caminho da formação acadêmica formal encontra o mapa das cinco modalidades em tipos de pós-graduação, com o catálogo de MBAs do IPOG entre as opções listadas ali.'
  }
];

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: 'Repositórios acadêmicos para um portal editorial: o que vira DOI citável',
      description,
      datePublished,
      author: alexandreAuthorRef,
      publisher: { '@id': 'https://brasilgeo.ai/#organization' },
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${SITE.url}/#website` },
      mainEntityOfPage: pageUrl,
      articleSection: 'Conteúdo e Social',
      keywords: 'PsyArXiv, OSF Preprints, SciELO Preprints, Zenodo, ResearchGate, DOI, preprint, Google Scholar, licença CC-BY'
    },
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: 'Transformar um dossiê do portal em depósito legítimo com DOI',
      description: 'Seis passos para converter material editorial em relatório de pesquisa depositável, do desenho da pergunta ao DOI citado de volta na página.',
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${SITE.url}/#website` },
      author: alexandreAuthorRef,
      publisher: { '@id': 'https://brasilgeo.ai/#organization' },
      step: passos.map((p, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: p.nome,
        text: p.texto,
        url: `${pageUrl}#do-portal-para-o-canal`
      }))
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${SITE.url}/#website` },
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  ]
};
---

<Base title={title} description={description} pageType="article" datePublished={datePublished}>

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Conteúdo e Social', href: '/conteudo-social' },
        { label: 'Repositórios acadêmicos' }
      ]} />
      <span class="section-eyebrow mt-3">Por canal · Infraestrutura de pesquisa</span>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Repositórios acadêmicos: o que vira DOI citável e o que é verniz</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        Um depósito em PsyArXiv, OSF, SciELO Preprints ou Zenodo transforma um documento em objeto permanente, citável e legível por qualquer sistema que consuma metadados. A entrada tem porteiro: a pré-moderação recusa texto gerado por máquina e recusa material sem método, e o preço de tentar contornar isso é a conta e a assinatura de quem tentou.
      </p>
    </div>
  </section>

  <section class="container-page py-8">
    <TLDR
      resposta="O que vira depósito legítimo é o documento que declara pergunta, corpus, critério de inclusão, achados e limites. O OSF Preprints opera com pré-moderação, recusa conteúdo total ou majoritariamente gerado por modelo de linguagem e proíbe que organizações usem contas como serviços de geração de DOI. O DOI resolve permanência e citabilidade, e não substitui revisão por pares."
      fontes={['OSF Preprints, políticas de moderação', 'PsyArXiv, políticas do serviço', 'SciELO Preprints, sobre e diretrizes de submissão', 'Zenodo, políticas gerais', 'ResearchGate, guia de direito autoral', 'Google Scholar, diretrizes de inclusão']}
    />
  </section>

  <section class="container-page pb-12 grid lg:grid-cols-12 gap-10">
    <aside class="lg:col-span-3 order-first">
      <InPageNav headings={headings} />
    </aside>

    <article class="lg:col-span-9 space-y-12">

      <div>
        <h2 id="contrato-do-canal" class="section-h text-2xl">Contrato do canal</h2>
        <p class="mt-3 text-ink-700 leading-relaxed max-w-3xl">
          Repositório acadêmico é a única superfície desta lista em que o objeto sobrevive ao site que o produziu. Essa permanência tem contrapartida, e ela está escrita nas políticas de cada plataforma.
        </p>
        <div class="overflow-x-auto mt-5 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3 w-56">Cláusula</th>
                <th class="text-left px-4 py-3">O que ela obriga</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {contrato.map(c => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink-900 align-top">{c.campo}</td>
                  <td class="px-4 py-3 text-ink-700 align-top leading-relaxed">{c.valor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 id="o-que-pode-ser-depositado" class="section-h text-2xl">O que pode ser depositado</h2>
        <p class="mt-3 text-ink-700 leading-relaxed max-w-3xl">
          Cada plataforma tem natureza jurídica e editorial distinta, e a escolha errada custa uma recusa pública. A tabela reúne o que cada uma declara nas próprias políticas, consultadas em 7 de setembro de 2026.
        </p>
        <div class="overflow-x-auto mt-5 rounded-2xl border border-surface-200">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-50 text-ink-900 font-semibold">
              <tr>
                <th class="text-left px-4 py-3 w-40">Plataforma</th>
                <th class="text-left px-4 py-3">Natureza</th>
                <th class="text-left px-4 py-3">O que aceita</th>
                <th class="text-left px-4 py-3">Como modera</th>
                <th class="text-left px-4 py-3">Regra sobre texto gerado por máquina</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              {plataformas.map(p => (
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink-900 align-top">{p.nome}</td>
                  <td class="px-4 py-3 text-ink-700 align-top leading-relaxed">{p.natureza}</td>
                  <td class="px-4 py-3 text-ink-700 align-top leading-relaxed">{p.aceita}</td>
                  <td class="px-4 py-3 text-ink-700 align-top leading-relaxed">{p.modera}</td>
                  <td class="px-4 py-3 text-ink-700 align-top leading-relaxed">{p.ia}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-ink-700 leading-relaxed max-w-3xl">
          Três recusas concentram quase todos os casos. A primeira é de escopo, e atinge o material que não é Psicologia nem trabalho acadêmico. A segunda é de origem, e atinge o texto que a moderação identifica como total ou majoritariamente produzido por máquina. A terceira é de direito, e atinge o arquivo que o autor não podia distribuir. Nenhuma delas se resolve reescrevendo o título.
        </p>
      </div>

      <figure>
        <h2 id="vira-deposito" class="section-h text-2xl">Este material vira depósito?</h2>
        <div class="overflow-x-auto rounded-2xl border border-surface-200 bg-surface-50 p-4 mt-4">
          <svg role="img" aria-labelledby="repo-triagem-titulo repo-triagem-desc" viewBox="0 0 720 320" width="720" height="320" style="min-width:720px" class="block">
            <title id="repo-triagem-titulo">Quatro perguntas de triagem que decidem se um material do portal pode ser depositado</title>
            <desc id="repo-triagem-desc">Quatro caixas de pergunta dispostas da esquerda para a direita, cada uma com uma saída negativa apontando para baixo. A primeira pergunta se existe uma pergunta de pesquisa respondível por método, e não por opinião editorial; a saída negativa manda manter o material como página do portal. A segunda pergunta se corpus, período, critério de inclusão e critério de exclusão estão escritos; a saída negativa é a mesma, manter como página. A terceira pergunta se o documento foi escrito por pessoa, com qualquer uso substantivo de modelo de linguagem divulgado explicitamente no manuscrito; a saída negativa registra recusa na moderação, porque as políticas do OSF Preprints declaram inapropriado o conteúdo total ou majoritariamente gerado por essas ferramentas. A quarta pergunta se existe direito de distribuir cada elemento do arquivo; a saída negativa impede o depósito. Uma faixa final registra que, com resposta afirmativa nas quatro, a escolha do repositório segue a natureza do objeto: manuscrito acadêmico de Psicologia vai a servidor de preprint da área, e conjunto de dados, protocolo, código e material suplementar vão ao Zenodo, que aceita todos os tipos de artefato de pesquisa.</desc>

            <text x="16" y="26" font-size="15" font-weight="600" class="fill-current text-ink-900">Quatro perguntas antes de abrir a submissão</text>

