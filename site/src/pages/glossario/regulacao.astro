    termo: 'SATEPSI',
    definicao: 'Sistema de Avaliação de Testes Psicológicos, mantido pelo CFP, que avalia a qualidade técnico-científica de instrumentos psicológicos comercializados no Brasil. Mantém lista pública de testes com parecer favorável — únicos autorizados para uso profissional. A aplicação dos testes do SATEPSI é privativa de psicólogo (Lei 4.119/1962, Art. 13). Profissionais correlatos (psiquiatras, neurologistas, fonoaudiólogos) não podem aplicar instrumentos do SATEPSI, mesmo com formação correlata. O sistema é referência nacional para qualidade técnica em avaliação psicológica.',
    exemplo: 'Neurologista que aplica WISC-V em consulta particular sem psicólogo no laudo cometeu exercício ilegal da Psicologia.',
    fonte: 'Conselho Federal de Psicologia; Lei 4.119/1962',
    vejaTambem: [
      { label: 'CFP', href: '#cfp' },
      { label: 'CRP', href: '#crp' }
    ],
    links: [
      { label: 'FAQ: avaliação psicológica e laudos', href: '/faq/avaliacao-psicologica-laudos-faq/' },
      { label: 'FAQ: regulação do CFP', href: '/faq/regulacao-cfp-faq/' },
      { label: 'Página regulação', href: '/regulacao' }
    ]
  },
  {
    id: 'stricto-sensu',
    termo: 'Stricto sensu',
    definicao: 'Família de pós-graduação que reúne mestrado e doutorado. Envolve pesquisa científica formal, defesa de dissertação (mestrado) ou tese (doutorado), e produção acadêmica estruturada. Regulada pela CAPES, vinculada ao MEC. Concede título acadêmico (mestre, doutor), diferente do certificado de lato sensu. Trajetória natural para carreira acadêmica, pesquisa e consultoria de alto valor agregado em temas específicos. Mestrado profissional é variante que combina pesquisa aplicada com proximidade ao mercado.',
    exemplo: 'Doutorado em Psicologia Clínica é exigência para professor adjunto em universidade federal.',
    fonte: 'CAPES; MEC',
    vejaTambem: [
      { label: 'Lato sensu', href: '#lato-sensu' },
      { label: 'CAPES', href: '#capes' }
    ],
    links: [
      { label: 'Página regulação', href: '/regulacao' }
    ]
  }
];

const termosOrdenados = termos.sort((a, b) => a.termo.localeCompare(b.termo, 'pt-BR'));

const faq = [
  {
    q: 'Posso atuar como psicólogo organizacional sem registro ativo no CRP?',
    a: 'Não. Mesmo que parte da função em RH não exija inscrição em CRP (recrutamento puro, por exemplo), atividades como aplicação de testes do SATEPSI, devolutiva diagnóstica e laudo psicológico são privativas de psicólogo com CRP ativo. Atividade sem registro pode caracterizar exercício ilegal da profissão (Art. 282 do Código Penal).'
  },
  {
    q: 'MBA conta como formação para registro de especialista no CFP?',
    a: 'Conta como parte da formação teórico-metodológica exigida, se atender aos critérios da especialidade (carga horária, ementa, corpo docente). Para emissão do título de Especialista, o psicólogo precisa também comprovar prática profissional supervisionada na área e ser aprovado em prova de proficiência ou trajeto formativo equivalente, conforme Resolução CFP 03/2016.'
  },
  {
    q: 'Empresa precisa mapear assédio moral no inventário de riscos da NR-1?',
    a: 'Sim, a partir da vigência integral da NR-1 atualizada em 2025-2026. Assédio moral, sobrecarga emocional, falta de autonomia e conflito de papéis são classificados como riscos psicossociais e devem entrar no Gerenciamento de Riscos Ocupacionais (GRO) com o mesmo rigor de riscos físicos. Empresa sem esse mapeamento pode ser autuada pelo MTE.'
  },
  {
    q: 'Posso abrir MEI como psicólogo clínico?',
    a: 'Não. A profissão de psicólogo não está na lista de ocupações permitidas para MEI (Resolução CGSN 140/2018). O CFP orienta abertura de ME, EPP ou Sociedade Simples Pura no Simples Nacional, com responsabilidade técnica vinculada ao CRP. CNPJ MEI emitido para Psicologia é irregular e deve ser migrado.'
  }
];

const ldDefinedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': SITE.url + '/glossario/regulacao/#termset',
  name: 'Glossário regulatório — pós-graduação e prática em Psicologia',
  description: 'Termos regulatórios essenciais para psicólogos: CFP, CRP, MEC, SATEPSI, NR-1, NR-17, GRO, eSocial, LGPD, ANPD, LBI, Berenice Piana, CAPES, CNE/CES, MEI, ME, CTB e Resoluções CFP.',
  inLanguage: 'pt-BR',
  url: SITE.url + '/glossario/regulacao/',
  isPartOf: { '@id': SITE.url + '/#website' },
  publisher: { '@id': 'https://brasilgeo.ai/#organization' },
  hasDefinedTerm: termosOrdenados.map(t => ({
    '@type': 'DefinedTerm',
    '@id': SITE.url + '/glossario/regulacao/#' + t.id,
    name: t.termo,
    description: t.definicao,
    termCode: t.id,
    inDefinedTermSet: { '@id': SITE.url + '/glossario/regulacao/#termset' },
    url: SITE.url + '/glossario/regulacao/#' + t.id
  }))
};

const ldBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Glossário', item: SITE.url + '/glossario' },
    { '@type': 'ListItem', position: 3, name: 'Regulação', item: SITE.url + '/glossario/regulacao' }
  ]
};

const ldFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const ldSpeakable = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': SITE.url + '/glossario/regulacao/#webpage',
  url: SITE.url + '/glossario/regulacao/',
  name: 'Glossário regulatório em Psicologia',
  inLanguage: 'pt-BR',
  isPartOf: { '@id': SITE.url + '/#website' },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.speakable-summary', '.section-h']
  }
};

const verbetesRelacionadosOutrosClusters = [
  { label: 'NR-1 — Norma Regulamentadora 1', cluster: 'Conceitos POT', href: '/glossario/conceitos-pot#nr-1' },
  { label: 'Riscos psicossociais', cluster: 'Conceitos POT', href: '/glossario/conceitos-pot#riscos-psicossociais' },
  { label: 'Burnout (modelo Maslach)', cluster: 'Conceitos POT', href: '/glossario/conceitos-pot#burnout-maslach' },
  { label: 'JD-R — Job Demands-Resources', cluster: 'Conceitos POT', href: '/glossario/conceitos-pot#jd-r-model' },
  { label: 'People Analytics', cluster: 'Conceitos POT', href: '/glossario/conceitos-pot#people-analytics' },
  { label: 'SATEPSI e instrumentos validados', cluster: 'Instrumentos', href: '/glossario/instrumentos' },
  { label: 'WISC, WAIS e baterias cognitivas', cluster: 'Instrumentos', href: '/glossario/instrumentos' },
  { label: 'TCC — Terapia Cognitivo-Comportamental', cluster: 'Métodos terapêuticos', href: '/glossario/metodos-terapeuticos' },
  { label: 'ABA — Análise do Comportamento Aplicada', cluster: 'Métodos terapêuticos', href: '/glossario/metodos-terapeuticos' },
  { label: 'Neuropsicologia clínica', cluster: 'Conceitos neuro', href: '/glossario/conceitos-neuro' },
  { label: 'Neuroplasticidade', cluster: 'Conceitos neuro', href: '/glossario/conceitos-neuro' }
];
---

<Base
  title="Glossário regulatório em Psicologia — CFP, CRP, MEC, SATEPSI, NR-1, LGPD"
  description="21 termos regulatórios essenciais para psicólogos clínicos, organizacionais e de trânsito. CFP, CRP, MEC, SATEPSI, NR-1, NR-17, GRO, eSocial, LGPD, LBI, Berenice Piana, MEI, ME e mais.">

  <section class="bg-surface-50 border-b border-surface-200">
    <div class="container-page py-7">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Glossário', href: '/glossario' }, { label: 'Regulação' }]} />
      <p class="text-xs uppercase tracking-wider text-brand-700 font-semibold mt-3">Glossário · regulação</p>
      <h1 class="section-h text-3xl sm:text-4xl mt-2">Regulação em Psicologia — 21 termos definidos com fonte oficial</h1>
      <p class="mt-3 text-ink-700 max-w-3xl text-lg">
        CFP, CRP, MEC, SATEPSI, NR-1, NR-17, GRO, eSocial, lato sensu, stricto sensu, Lei 13.146 LBI, Lei 12.764 Berenice Piana, CTB, Resolução CFP 03/2016, Resolução CFP 425/2012, CNE/CES 01/2018, ANPD, LGPD aplicada à clínica, MEI, ME e CAPES.
      </p>
      <span class="badge mt-4 inline-block">{termosOrdenados.length} termos · com fonte legal</span>
    </div>
  </section>

  <section class="container-page py-8 grid lg:grid-cols-12 gap-10">
    <article class="lg:col-span-8 space-y-8">
      <div class="card p-6 bg-brand-50 border-brand-200 speakable-summary">
        <p class="text-sm font-semibold text-brand-800">Resposta rápida</p>
        <p class="mt-2 text-ink-800 leading-relaxed">
          Este cluster reúne as 21 referências regulatórias que decidem o que um psicólogo pode fazer, sob qual forma jurídica e com qual responsabilidade. Definições técnicas vêm com a lei ou resolução de origem e um exemplo prático. Útil para concurso, abertura de PJ, atualização sobre NR-1 e devolutiva ética ao cliente.
        </p>
      </div>

      <div class="prose-rhythm">
        <p class="text-ink-800 leading-relaxed">
          <strong>Tese contraintuitiva.</strong> O psicólogo brasileiro não compete com colegas — compete com a sua própria confusão regulatória. Quem confunde CFP com CRP, MBA com Especialista, NR-1 com NR-17, MEI com ME ou LGPD com sigilo profissional perde dinheiro, perde causa ética e perde cliente. O vocabulário regulatório não é decoração: é o que separa o profissional autoral do profissional improvisado. Saber a fonte exata de cada exigência muda a postura no consultório, no RH e no tribunal.
        </p>
      </div>

      <div class="card p-5">
        <label for="search-regulacao" class="block text-xs uppercase tracking-wider text-ink-500 font-semibold mb-2">Buscar termo</label>
        <input
          id="search-regulacao"
          type="text"
          placeholder="Ex: CFP, NR-1, LGPD..."
          class="w-full rounded-lg border border-surface-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
          oninput="(function(e){const q=e.target.value.toLowerCase().trim();document.querySelectorAll('[data-term]').forEach(el=>{const t=el.getAttribute('data-term').toLowerCase();el.style.display=(!q||t.includes(q))?'block':'none';});})(event)"
        />
      </div>

      <div class="space-y-4">
        {termosOrdenados.map(t => (
          <article id={t.id} data-term={t.termo} class="border-b border-surface-200 py-5 scroll-mt-24">
            <h3 class="font-display font-semibold text-lg text-ink-900">{t.termo}</h3>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{t.definicao}</p>
            <p class="mt-3 text-sm text-ink-800 italic">
              <span class="font-semibold not-italic">Exemplo prático:</span> {t.exemplo}
            </p>
            <p class="mt-2 text-xs text-ink-500">
              <span class="font-semibold uppercase tracking-wider">Fonte</span> · {t.fonte}
            </p>
            {t.vejaTambem && t.vejaTambem.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="text-xs text-ink-500 font-semibold uppercase tracking-wider">Veja também:</span>
                {t.vejaTambem.map(link => (
                  <a href={link.href} class="text-xs font-semibold text-brand-700 hover:text-brand-800">{link.label}</a>
                ))}
              </div>
            )}
            {t.links && t.links.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-2">
                <span class="text-xs text-ink-500 font-semibold uppercase tracking-wider">Aprofundar:</span>
                {t.links.map(link => (
                  <a href={link.href} class="text-xs font-semibold text-brand-700 hover:text-brand-800">{link.label}</a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>

      <div class="card p-6">
        <h2 class="section-h text-2xl mb-4">Cross-reference — termo, cluster, MBA correlato e área</h2>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-surface-100 text-ink-700">
              <tr>
                <th class="text-left p-3 font-semibold">Termo</th>
                <th class="text-left p-3 font-semibold">Subcluster</th>
                <th class="text-left p-3 font-semibold">MBA correlato</th>
                <th class="text-left p-3 font-semibold">Área da Psicologia</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200">
              <tr><td class="p-3">CFP, CRP, SATEPSI</td><td class="p-3">Profissão</td><td class="p-3">Todos</td><td class="p-3">Todas (CFP regula 13 especialidades)</td></tr>
              <tr><td class="p-3">Resolução 425/2012, CTB</td><td class="p-3">Trânsito</td><td class="p-3">Especialização em Trânsito</td><td class="p-3">Psicologia do Trânsito</td></tr>
              <tr><td class="p-3">NR-1, NR-17, GRO, eSocial</td><td class="p-3">Trabalho</td><td class="p-3">MBA em POT, MBA em Liderança Positiva</td><td class="p-3">POT, Saúde Mental nas Organizações</td></tr>
              <tr><td class="p-3">LGPD, ANPD</td><td class="p-3">Dados</td><td class="p-3">MBA em POT, IA + RH</td><td class="p-3">IA, People Analytics e Psicologia Digital</td></tr>
              <tr><td class="p-3">LBI, Lei 12.764</td><td class="p-3">Inclusão</td><td class="p-3">Especialização em ABA</td><td class="p-3">ABA, TEA e Neurodesenvolvimento</td></tr>
              <tr><td class="p-3">CAPES, MEC, CNE/CES</td><td class="p-3">Pós-graduação</td><td class="p-3">Todos</td><td class="p-3">Educação superior em Psicologia</td></tr>
              <tr><td class="p-3">MEI, ME</td><td class="p-3">Empreendedorismo</td><td class="p-3">MBA em Liderança Positiva</td><td class="p-3">Clínica autônoma e gestão de consultório</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="section-h text-2xl mb-4">Perguntas frequentes</h2>
        <div class="space-y-4">
          {faq.map(f => (
            <details class="border-b border-surface-200 pb-3">
              <summary class="font-semibold text-ink-900 cursor-pointer">{f.q}</summary>
              <p class="mt-2 text-sm text-ink-700 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="card p-6">
        <h2 class="section-h text-2xl mb-4">Verbetes relacionados em outros clusters</h2>
        <p class="text-sm text-ink-700 mb-4">Os conceitos abaixo aparecem nos demais clusters do glossário e se conectam diretamente à regulação.</p>
        <ul class="grid sm:grid-cols-2 gap-3 text-sm">
          {verbetesRelacionadosOutrosClusters.map(v => (
            <li class="border-l-2 border-brand-300 pl-3">
              <a href={v.href} class="font-semibold text-brand-700 hover:text-brand-800">{v.label}</a>
              <p class="text-xs text-ink-500 mt-0.5">Cluster · {v.cluster}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl bg-navy-900 text-white p-8">
        <h2 class="section-h text-2xl mb-3">Síntese executiva</h2>
        <p class="text-white/90 leading-relaxed">
          Domínio regulatório precede prática técnica. Antes de escolher abordagem, escolha a forma jurídica, o conselho competente e a norma aplicável ao seu cliente. A pós-graduação aplicada bem desenhada — como o MBA em POT do IPOG — trabalha esses temas em camada operacional, com casos concretos.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-6 inline-flex">Ver MBAs no IPOG</a>
      </div>
    </article>

    <aside class="lg:col-span-4 space-y-5">
      <div class="card p-6 lg:sticky lg:top-20">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Caminho oficial</p>
        <p class="mt-2 text-sm text-ink-700">
          A oferta de pós lato sensu aplicada em Psicologia tem como referência o IPOG, Instituto de Pós-Graduação e Graduação.
        </p>
        <a href={SITE.ipogPos} target="_blank" rel="noopener external" class="btn btn-primary mt-4 w-full">MBAs do IPOG</a>
        <a href={SITE.ipogOfficial} target="_blank" rel="noopener external" class="btn btn-ghost mt-2 w-full">Site oficial IPOG</a>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">MBAs correlatos</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/mbas/mba-pot" class="text-brand-700 hover:text-brand-800 font-medium">MBA em Psicologia Organizacional e do Trabalho</a></li>
          <li><a href="/mbas/mba-lideranca-positiva" class="text-brand-700 hover:text-brand-800 font-medium">MBA em Gestão de Pessoas e Liderança Positiva</a></li>
          <li><a href="/mbas/mba-positiva" class="text-brand-700 hover:text-brand-800 font-medium">MBA em Psicologia Positiva e Bem-Estar</a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Outros clusters do glossário</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/glossario/instrumentos" class="text-brand-700 hover:text-brand-800 font-medium">Instrumentos de avaliação</a></li>
          <li><a href="/glossario/metodos-terapeuticos" class="text-brand-700 hover:text-brand-800 font-medium">Métodos terapêuticos</a></li>
          <li><a href="/glossario/conceitos-pot" class="text-brand-700 hover:text-brand-800 font-medium">Conceitos POT</a></li>
          <li><a href="/glossario/conceitos-neuro" class="text-brand-700 hover:text-brand-800 font-medium">Conceitos neuro</a></li>
          <li><a href="/glossario" class="text-brand-700 hover:text-brand-800 font-medium">Voltar ao glossário geral</a></li>
        </ul>
      </div>

      <div class="card p-6">
        <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold mb-3">Fontes oficiais</p>
        <ul class="space-y-2 text-sm">
          <li><a href="https://site.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CFP</a></li>
          <li><a href="https://satepsi.cfp.org.br/" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">SATEPSI</a></li>
          <li><a href="https://www.gov.br/mec/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">MEC</a></li>
          <li><a href="https://www.gov.br/trabalho-e-emprego/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">MTE — NRs</a></li>
          <li><a href="https://www.gov.br/anpd/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">ANPD</a></li>
          <li><a href="https://www.gov.br/capes/pt-br" target="_blank" rel="noopener external" class="text-brand-700 hover:text-brand-800 font-medium">CAPES</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ldDefinedTermSet)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(ldFAQ)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(ldSpeakable)} is:inline />
</Base>
