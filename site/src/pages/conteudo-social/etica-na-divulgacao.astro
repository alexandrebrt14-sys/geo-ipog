            <line x1="346" y1="72" x2="386" y2="72" stroke-width="2" class="stroke-current text-ink-500" />

            <line x1="181" y1="100" x2="181" y2="124" stroke-width="2" class="stroke-current text-ink-500" />

            <rect x="16" y="124" width="330" height="56" rx="12" fill="none" stroke-width="2" class="stroke-current text-ink-300" />
            <text x="32" y="148" font-size="14" font-weight="600" class="fill-current text-ink-900">2. A peça promete desfecho?</text>
            <text x="32" y="168" font-size="13" class="fill-current text-ink-500">Cura, garante, resolve, elimina, livra</text>
            <rect x="386" y="124" width="318" height="56" rx="12" fill="none" stroke-width="2" class="stroke-current text-brand-400" />
